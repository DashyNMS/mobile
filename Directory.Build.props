<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>DashyNMS</Product>
    <Company>DashyNMS</Company>
    <Version>1.1.0</Version>
    <NeutralLanguage>en-GB</NeutralLanguage>
    <!-- Where the desktop repo is checked out (a git submodule) - its Core
         library is compiled into this repo rather than copied. -->
    <DesktopRoot>$(MSBuildThisFileDirectory)external/desktop/</DesktopRoot>
  </PropertyGroup>

</Project>
