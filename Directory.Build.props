<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Audit all restored dependencies; high/critical advisories and unavailable
         vulnerability metadata must stop CI and publication restores. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>high</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1900;NU1903;NU1904;NU1905</WarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>DashyNMS</Product>
    <Company>DashyNMS</Company>
    <Authors>Thomas Pickup</Authors>
    <Copyright>Copyright (c) 2026 Thomas Pickup</Copyright>
    <!-- The version being built towards, and the one the stores show for every
         build of it. Edge and nightly builds are 2.0.0-edge.N and 2.0.0-nightly.N. -->
    <Version>2.0.0</Version>
    <NeutralLanguage>en-GB</NeutralLanguage>
    <!-- Both from GitHub Packages (see nuget.config), moved together as
         docs/DEVELOPMENT.md, "Moving the Core and Shared pins", says.
         Shared is DashyNMS/mcp's 2.0.0-nightly.6 (commit 65580bb), and Core the newer nightly 8, additive over the nightly.5 it
         was compatibility-tested against. -->
    <DashyNMSCoreVersion>2.0.0-nightly.8</DashyNMSCoreVersion>
    <DashyNMSSharedVersion>2.0.0-nightly.6</DashyNMSSharedVersion>
  </PropertyGroup>

</Project>
