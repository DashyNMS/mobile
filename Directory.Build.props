<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>DashyNMS</Product>
    <Company>DashyNMS</Company>
    <Authors>Thomas Pickup</Authors>
    <Copyright>Copyright (c) 2026 Thomas Pickup</Copyright>
    <!-- The version being built towards, and the one the stores show for every
         build of it. Edge and nightly builds are 2.0.0-edge.N and 2.0.0-nightly.N. -->
    <Version>2.0.0</Version>
    <NeutralLanguage>en-GB</NeutralLanguage>
    <!-- Both from GitHub Packages (see nuget.config), moved together as
         docs/DEVELOPMENT.md, "Moving the Core and Shared pins", says.
         Shared is DashyNMS/mcp's 2.0.0-nightly.5 (commit f9a1fde), and Core the one it
         was compatibility-tested against. -->
    <DashyNMSCoreVersion>2.0.0-nightly.3</DashyNMSCoreVersion>
    <DashyNMSSharedVersion>2.0.0-nightly.5</DashyNMSSharedVersion>
  </PropertyGroup>

</Project>
