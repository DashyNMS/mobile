      "candidates": [
        { "deviceId": 5, "hostname": "198.51.100.5", "display": null, "ip": "198.51.100.5" },
        { "deviceId": 8, "hostname": "lab-sw8.example.net", "display": "Lab switch password=‹redacted›", "ip": "198.51.100.8" }
