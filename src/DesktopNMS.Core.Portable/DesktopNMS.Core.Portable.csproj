<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The desktop app's DesktopNMS.Core, compiled for plain net10.0 so Android
    and iOS can use it. Nothing is copied: the sources come straight from the
    external/desktop submodule, so a fix there reaches mobile on the next
    submodule bump.

    Core targets plain net9.0 now (DashyNMS/desktop#152), so it could be
    referenced as a project. It's compiled here instead so it builds for
    net10.0 with mobile's package versions, and nothing is ever built inside
    the submodule's own folders. Secret storage is each app's own: mobile
    keeps secrets in the platform keychain/keystore (DashyNMS.Mobile.Shared).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DesktopNMS.Core</RootNamespace>
    <!-- Same assembly name as on desktop, so the desktop tests' internals
         access (InternalsVisibleTo) and any serialised type names match. -->
    <AssemblyName>DesktopNMS.Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Upstream code, built as upstream builds it: don't fail or nag on
         warnings the desktop repo doesn't see (platform analyzers mostly). -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(DesktopRoot)src/DesktopNMS.Core/**/*.cs"
             Exclude="$(DesktopRoot)src/DesktopNMS.Core/bin/**;$(DesktopRoot)src/DesktopNMS.Core/obj/**"
             LinkBase="DesktopNMS.Core" />
  </ItemGroup>

  <!-- Core's open-source licence texts (DashyNMS/desktop#266), embedded under
       the same names Core's own csproj gives them, so OpenSourceNotices.ReadLicence
       finds them here too (#166). -->
  <ItemGroup>
    <EmbeddedResource Include="$(DesktopRoot)src/DesktopNMS.Core/Licences/Texts/*.txt"
                      LogicalName="DesktopNMS.Core.Licences.%(Filename)%(Extension)"
                      LinkBase="DesktopNMS.Core/Licences/Texts" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DesktopNMS.Core.Tests" />
  </ItemGroup>

</Project>
