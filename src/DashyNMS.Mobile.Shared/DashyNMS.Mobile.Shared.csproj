<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything in the mobile app that isn't a page or a platform API: view
    models, session handling and secret storage over an abstract secure store.
    Plain net10.0, so it builds and tests anywhere without the MAUI workloads.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DashyNMS.Mobile</RootNamespace>
    <AssemblyName>DashyNMS.Mobile.Shared</AssemblyName>
    <!-- Restore records every resolved package and its content hash in packages.lock.json,
         and CI restores in locked mode, so a pinned package replaced on the feed (or any
         unreviewed graph change) fails restore instead of building (#609). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DashyNMS.Core" Version="2.0.0-ci.76" />
    <!-- Typed read-only network operations and the catalogue, shared with MCP.
         Mobile adds reviewed adapters for these operations in epic #236's order.
         Exact CI version from DashyNMS/mcp#162 (core#90 Batch 3), published by
         run 44719120361 (commit bcdbd8f);
         CI checks its SHA-256 and provenance attestation. GeneratePathProperty exposes
         its LICENSE below. -->
    <PackageReference Include="DashyNMS.Agent.Shared" Version="2.0.0-ci.44719120361.1" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DashyNMS.Mobile.Shared.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- What's new in this release (#159), in desktop's WhatsNew.md shape. -->
    <EmbeddedResource Include="WhatsNew.md" LogicalName="DashyNMS.Mobile.WhatsNew.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Intelligence's instruction blocks, laid out as Core's Instructions/*.md (#638). -->
    <EmbeddedResource Include="Intelligence/Instructions/*.md" LogicalName="DashyNMS.Mobile.Intelligence.Instructions.%(Filename).md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Licence texts Core doesn't carry, shown on the licences page. Lucide's is the
         repository copy; the shared package's is the LICENSE it ships, as its README asks. -->
    <EmbeddedResource Include="../../docs/licences/Lucide-LICENSE.txt" LogicalName="DashyNMS.Mobile.Licences.lucide-isc.txt" />
    <EmbeddedResource Include="$(PkgDashyNMS_Agent_Shared)/LICENSE" LogicalName="DashyNMS.Mobile.Licences.dashynms-agent-shared-mit.txt"
                      Condition="'$(PkgDashyNMS_Agent_Shared)' != ''" />
  </ItemGroup>
</Project>
