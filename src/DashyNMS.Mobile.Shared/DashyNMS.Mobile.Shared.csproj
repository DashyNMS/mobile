<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything in the mobile app that isn't a page or a platform API: view
    models, session handling and secret storage over an abstract secure store.
    Plain net10.0, so it builds and tests anywhere without the MAUI workloads.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DashyNMS.Mobile</RootNamespace>
    <AssemblyName>DashyNMS.Mobile.Shared</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DashyNMS.Core" Version="2.0.0-ci.64" />
    <!-- Device search (#596), open alerts (#601), overview (#600) and device sensors (#603)
         shared with the MCP agent: one ranking, grouping, ordering, filtering, assessment and
         redaction implementation instead of mobile's own. Exact CI version from DashyNMS/mcp
         run 43365576634 (commit 812266d);
         CI checks its SHA-256 and provenance attestation. GeneratePathProperty exposes
         its LICENSE below. -->
    <PackageReference Include="DashyNMS.Agent.Shared" Version="2.0.0-ci.43365576634.1" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DashyNMS.Mobile.Shared.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- What's new in this release (#159), in desktop's WhatsNew.md shape. -->
    <EmbeddedResource Include="WhatsNew.md" LogicalName="DashyNMS.Mobile.WhatsNew.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Licence texts Core doesn't carry, shown on the licences page. Lucide's is the
         repository copy; the shared package's is the LICENSE it ships, as its README asks. -->
    <EmbeddedResource Include="../../docs/licences/Lucide-LICENSE.txt" LogicalName="DashyNMS.Mobile.Licences.lucide-isc.txt" />
    <EmbeddedResource Include="$(PkgDashyNMS_Agent_Shared)/LICENSE" LogicalName="DashyNMS.Mobile.Licences.dashynms-agent-shared-mit.txt"
                      Condition="'$(PkgDashyNMS_Agent_Shared)' != ''" />
  </ItemGroup>
</Project>
