<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sections="clr-namespace:DashyNMS.Mobile.DeviceSections;assembly=DashyNMS.Mobile.Shared"
             x:Class="DashyNMS.Mobile.Controls.PortReadout" x:DataType="sections:SectionRow">
    <Grid MinimumHeightRequest="44">
        <VerticalStackLayout Spacing="6" Padding="14" AutomationProperties.ExcludedWithChildren="True">
            <Label Text="{Binding Title}" FontFamily="BodySemibold" LineBreakMode="WordWrap" />
            <Label Text="{Binding PortVisualLabel}" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" LineBreakMode="WordWrap">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding PortHasStatusBorder}" Value="True">
                        <Setter Property="TextColor" Value="{Binding PortVisualStatus, Converter={StaticResource StatusText}}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding PortDisplayFacts}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="sections:SectionField">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="{Binding Name}" Style="{StaticResource Caption}" LineBreakMode="WordWrap" />
                            <Label Text="{Binding Value}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Label Text="Interface graphs unavailable: ifName not reported" LineBreakMode="WordWrap">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsLink}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Label Text="Open interface graphs ›" IsVisible="{Binding IsLink}" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
        <Label Text="" InputTransparent="True" SemanticProperties.Description="{Binding PortActionDescription}" AutomationProperties.IsInAccessibleTree="True">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsLink}" Value="True">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Label.Triggers>
        </Label>
        <Button Text="" BackgroundColor="Transparent" BorderWidth="0" IsVisible="{Binding IsLink}"
                MinimumHeightRequest="44" HorizontalOptions="Fill" VerticalOptions="Fill"
                SemanticProperties.Description="{Binding PortActionDescription}"
                Command="{Binding OpenLinkCommand, Source={RelativeSource AncestorType={x:Type sections:DeviceSectionViewModel}}, x:DataType=sections:DeviceSectionViewModel}"
                CommandParameter="{Binding .}">
            <!-- An explicit empty style prevents the implicit Disabled fill
                 from covering every card during the async graph push. -->
            <Button.Style><Style TargetType="Button" /></Button.Style>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Button>
    </Grid>
</ContentView>
