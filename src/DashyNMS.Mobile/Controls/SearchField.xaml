<?xml version="1.0" encoding="utf-8" ?>
<Border
    x:Class="DashyNMS.Mobile.Controls.SearchField"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Padding="14,0,4,0" HeightRequest="46" StrokeThickness="1" SafeAreaEdges="None"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource ChipStrokeDark}}">
    <Border.StrokeShape>
        <RoundRectangle CornerRadius="23" />
    </Border.StrokeShape>
    <Border.Content>
        <Grid x:Name="FieldGrid" ColumnDefinitions="Auto,*" ColumnSpacing="2" SafeAreaEdges="None">
            <Path Data="M10.5 4A6.5 6.5 0 1 0 10.5 17A6.5 6.5 0 1 0 10.5 4Z M15.5 15.5 20 20"
                  StrokeThickness="2" StrokeLineCap="Round" WidthRequest="18" HeightRequest="18"
                  Aspect="Uniform" VerticalOptions="Center" InputTransparent="True"
                  Stroke="{AppThemeBinding Light={StaticResource TextFaintLight}, Dark={StaticResource TextFaintDark}}" />
        </Grid>
    </Border.Content>
</Border>
