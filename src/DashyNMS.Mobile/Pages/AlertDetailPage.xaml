<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.AlertDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    xmlns:sections="clr-namespace:DashyNMS.Mobile.DeviceSections;assembly=DashyNMS.Mobile.Shared"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    x:DataType="vm:AlertDetailViewModel"
    ios:Page.UseSafeArea="True"
    Title="{Binding Title}">

    <!-- As the Alert detail mock-up: "‹ Alerts", a header card with the
         severity, rule, device and the actions, then a card per section -
         why it fired, the rule, and its history on the device. -->
    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="16,4,16,24" Spacing="12">

                <controls:BackBar x:Name="TopBar" />

                <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
                <controls:LoadingIndicator IsVisible="{Binding IsLoadingFirstTime}" />

                <!-- A recovery notification can point at an alert LibreNMS has since dropped. -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding IsGone}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="This alert has cleared, and LibreNMS no longer lists it." />
                        <Button Style="{StaticResource SecondaryButton}" Text="Open device" Command="{Binding OpenDeviceCommand}" IsVisible="{Binding HasDevice}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" IsVisible="{Binding HasAlert}">
                    <VerticalStackLayout Spacing="8">
                        <Border Style="{StaticResource Pill}" BackgroundColor="{Binding Alert.Severity, Converter={StaticResource StatusTint}}">
                            <HorizontalStackLayout Spacing="6">
                                <Ellipse WidthRequest="7" HeightRequest="7" VerticalOptions="Center"
                                         Fill="{Binding Alert.Severity, Converter={StaticResource StatusText}}" />
                                <Label Style="{StaticResource PillText}" Text="{Binding Alert.SeverityText}"
                                       TextColor="{Binding Alert.Severity, Converter={StaticResource StatusText}}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Label Text="{Binding Alert.Rule}" FontSize="22" FontFamily="Display" />
                        <Label Text="{Binding Alert.Device}" FontFamily="BodySemibold" FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenDeviceCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Style="{StaticResource Faint}" Text="{Binding RaisedText}" />
                        <Label Style="{StaticResource Caption}" Text="{Binding Alert.Note}" FontAttributes="Italic" IsVisible="{Binding Alert.HasNote}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">
                            <Button Text="Acknowledge" Command="{Binding AcknowledgeCommand}" IsVisible="{Binding CanAcknowledge}" />
                            <Button Text="Unacknowledge" Style="{StaticResource SecondaryButton}" Command="{Binding UnacknowledgeCommand}" IsVisible="{Binding CanUnacknowledge}" />
                            <Button Grid.Column="1" Text="Open device" Style="{StaticResource SecondaryButton}" Command="{Binding OpenDeviceCommand}" IsVisible="{Binding HasDevice}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- A card per section; rows split by a line, fields and the rule's condition monospaced. -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding CardGroups}" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="sections:SectionGroup">
                            <Border Style="{StaticResource Card}" Padding="16,14">
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource CardTitle}" Text="{Binding Name}" Margin="0,0,0,4" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding .}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="sections:SectionRow">
                                                <VerticalStackLayout Spacing="6" Padding="0,6,0,0">
                                                    <!-- A line between list rows; none within the rule's block. -->
                                                    <BoxView Style="{StaticResource Divider}" Margin="0,0,0,4" IsVisible="{Binding HasDivider}" />
                                                    <Label Style="{StaticResource Caption}" Text="{Binding Title}" IsVisible="{Binding HasCaptionTitle}" />
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding HasHeadingTitle}">
                                                        <Label Text="{Binding Title}" FontFamily="BodySemibold" FontSize="14" />
                                                        <Label Grid.Column="1" Text="{Binding Value}" IsVisible="{Binding HasValue}" FontSize="13"
                                                               HorizontalTextAlignment="End"
                                                               TextColor="{Binding Status, Converter={StaticResource StatusText}}" />
                                                    </Grid>
                                                    <!-- Why it fired's fields, one to a line - name, then value - as the mock-up. -->
                                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Fields}" IsVisible="{Binding HasFields}">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="sections:SectionField">
                                                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="2*,3*" ColumnSpacing="12" RowSpacing="8" Padding="0,4,0,4">
                                                                    <Grid.Triggers>
                                                                        <!-- The fields the rule doesn't test, after "Show all fields". -->
                                                                        <DataTrigger TargetType="Grid" Binding="{Binding IsSecondary}" Value="True">
                                                                            <Setter Property="Opacity" Value="0.65" />
                                                                        </DataTrigger>
                                                                    </Grid.Triggers>
                                                                    <BoxView Grid.ColumnSpan="2" Style="{StaticResource Divider}" />
                                                                    <Label Grid.Row="1" Style="{StaticResource Caption}" Text="{Binding Name}"
                                                                           FontFamily="Mono" FontSize="12.5" LineBreakMode="CharacterWrap" />
                                                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Value}"
                                                                           FontFamily="Mono" FontSize="13" LineBreakMode="CharacterWrap" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>
                                                    <!-- The rule's condition as the mock-up's code block; prose (notes, procedure) as text. -->
                                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12,10"
                                                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource CodeDark}}"
                                                            IsVisible="{Binding HasCode}">
                                                        <Label Text="{Binding Subtitle}" FontFamily="Mono" FontSize="12.5" LineHeight="1.3"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource Gray100}}" />
                                                    </Border>
                                                    <Label Text="{Binding Subtitle}" FontSize="14" LineBreakMode="WordWrap"
                                                           IsVisible="{Binding HasText}" />
                                                    <Label Text="{Binding Detail}" IsVisible="{Binding HasDetail}" FontFamily="Mono" FontSize="11.5"
                                                           LineBreakMode="WordWrap" Style="{StaticResource Faint}" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <!-- "Show all fields", in Why it fired's own card. -->
                                    <Button Style="{StaticResource LinkButton}" HorizontalOptions="Start" Padding="0" Margin="0,6,0,0"
                                            Text="{Binding FooterText}" Command="{Binding FooterCommand}" IsVisible="{Binding HasFooter}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
