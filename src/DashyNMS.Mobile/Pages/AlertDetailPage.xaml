<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.AlertDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    xmlns:sections="clr-namespace:DashyNMS.Mobile.DeviceSections;assembly=DashyNMS.Mobile.Shared"
    x:DataType="vm:AlertDetailViewModel"
    Title="{Binding Title}">

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}" Padding="16,8,16,0">
        <CollectionView ItemsSource="{Binding Groups}" IsGrouped="True" SelectionMode="None">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="8" Padding="0,0,0,4">
                    <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

                    <!-- A recovery notification can point at an alert LibreNMS has since dropped. -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding IsGone}">
                        <Label Text="This alert has cleared, and LibreNMS no longer lists it." />
                    </Border>

                    <!-- As the mock-ups: the severity as a pill, the rule as the title,
                         then the device and when. -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasAlert}">
                        <VerticalStackLayout Spacing="6">
                            <Border Style="{StaticResource Pill}" BackgroundColor="{Binding Alert.Severity, Converter={StaticResource StatusTint}}">
                                <HorizontalStackLayout Spacing="6">
                                    <Ellipse WidthRequest="7" HeightRequest="7" VerticalOptions="Center"
                                             Fill="{Binding Alert.Severity, Converter={StaticResource StatusText}}" />
                                    <Label Style="{StaticResource PillText}" Text="{Binding Alert.SeverityText}"
                                           TextColor="{Binding Alert.Severity, Converter={StaticResource StatusText}}" />
                                </HorizontalStackLayout>
                            </Border>
                            <Label Text="{Binding Alert.Rule}" FontSize="22" FontFamily="Display" />
                            <Label Text="{Binding Alert.Device}" FontFamily="BodySemibold"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenDeviceCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Style="{StaticResource Faint}" Text="{Binding Alert.Summary}" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Acknowledge…" Command="{Binding AcknowledgeCommand}" IsVisible="{Binding CanAcknowledge}" />
                        <Button Text="Unacknowledge" Style="{StaticResource SecondaryButton}" Command="{Binding UnacknowledgeCommand}" IsVisible="{Binding CanUnacknowledge}" />
                        <Button Grid.Column="1" Text="Open device" Style="{StaticResource SecondaryButton}" Command="{Binding OpenDeviceCommand}" IsVisible="{Binding HasDevice}" />
                    </Grid>

                    <!-- Why it fired shows what the rule tests; this adds everything else measured (#46). -->
                    <Button Text="{Binding AllFieldsText}" Command="{Binding ToggleAllFieldsCommand}" IsVisible="{Binding HasMoreFields}"
                            Style="{StaticResource LinkButton}" HorizontalOptions="Start" Padding="0" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="sections:SectionGroup">
                    <Label Style="{StaticResource SectionHeader}" Text="{Binding Name}" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="sections:SectionRow">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout>
                                <Label Text="{Binding Title}" FontFamily="BodySemibold" />
                                <!-- Fault values and rule conditions: shown whole, not truncated. -->
                                <Label Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" LineBreakMode="WordWrap" />
                                <Label Style="{StaticResource Caption}" Text="{Binding Detail}" IsVisible="{Binding HasDetail}"
                                       FontSize="12" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding Value}" IsVisible="{Binding HasValue}"
                                   VerticalOptions="Start" HorizontalTextAlignment="End"
                                   TextColor="{Binding Status, Converter={StaticResource StatusText}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </RefreshView>

</ContentPage>
