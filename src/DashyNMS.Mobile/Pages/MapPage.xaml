<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.MapPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:map="clr-namespace:DashyNMS.Mobile.Map;assembly=DashyNMS.Mobile.Shared"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    x:DataType="map:MapViewModel"
    SafeAreaEdges="All"
    Title="Map">
    <Grid x:Name="Canvas" SafeAreaEdges="None">
        <WebView x:Name="MapView" />
        <Grid x:Name="Overlay" RowDefinitions="Auto,Auto,*,Auto" SafeAreaEdges="None" InputTransparent="True" CascadeInputTransparent="False">
            <controls:PageHeader x:Name="Header" Title="Map" BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">
                <controls:PageHeader.Actions>
                    <HorizontalStackLayout Spacing="4">
                        <controls:IconButton x:Name="LocationsButton" Kind="Plain" Icon="{x:Static controls:Icons.Pin}" SemanticProperties.Description="Choose a map location" />
                        <controls:IconButton x:Name="RefreshButton" Kind="Plain" Icon="{x:Static controls:Icons.Rediscover}" Command="{Binding RefreshCommand}" SemanticProperties.Description="Refresh the map" />
                    </HorizontalStackLayout>
                </controls:PageHeader.Actions>
            </controls:PageHeader>
            <VerticalStackLayout x:Name="Status" BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" Grid.Row="1" Spacing="4" SafeAreaEdges="None">
                <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
                <Label Style="{StaticResource Caption}" Text="{Binding UnplacedText}" IsVisible="{Binding HasUnplacedText}" />
                <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" IsVisible="{Binding HasEmptyText}" />
                <Button Text="Retry" Style="{StaticResource LinkButton}" Command="{Binding RefreshCommand}" IsVisible="{Binding HasError}" />
            </VerticalStackLayout>
            <BoxView Grid.Row="2" HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
                <BoxView.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
                    <GradientStop Offset="1" Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" />
                </LinearGradientBrush></BoxView.Background>
            </BoxView>
            <controls:BusyCard Grid.Row="2" Text="Loading the map…" IsVisible="{Binding IsBusy}" />
        </Grid>
        <ContentView x:Name="RowMeasure" Opacity="0" InputTransparent="True" AutomationProperties.ExcludedWithChildren="True" />
        <!-- The tapped location's devices. -->
        <Border x:Name="SelectionCard" VerticalOptions="End" Style="{StaticResource Card}" Margin="8" IsVisible="False">
            <Grid RowDefinitions="Auto,Auto,Auto">
                <Button x:Name="CloseSelection" HorizontalOptions="End" Style="{StaticResource LinkButton}" Text="Close" Clicked="OnCloseSelection" />
                <ScrollView x:Name="HeadingScroll" Grid.Row="1" SafeAreaEdges="None">
                    <VerticalStackLayout x:Name="SelectionHeading">
                        <Label Text="{Binding SelectedLocation}" FontFamily="BodySemibold" FontSize="16" VerticalOptions="Center" LineBreakMode="WordWrap" />
                        <!-- The whole location on the Devices tab, filtered to it (#84). -->
                        <Button Style="{StaticResource LinkButton}" Text="Show in Devices" Command="{Binding ShowInDevicesCommand}"
                            IsVisible="{Binding HasSingleLocation}" />
                    </VerticalStackLayout>
                </ScrollView>
                <CollectionView x:Name="DeviceList" Grid.Row="2" ItemsSource="{Binding Devices}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceItem">
                            <Grid Padding="0,8" MinimumHeightRequest="44" RowDefinitions="Auto,Auto,Auto"
                                  AutomationProperties.IsInAccessibleTree="True" SemanticProperties.Hint="Open device details">
                                <SemanticProperties.Description><Binding Path="Description" /></SemanticProperties.Description>
                                <Grid.GestureRecognizers><TapGestureRecognizer
                                    Command="{Binding OpenDeviceCommand, Source={RelativeSource AncestorType={x:Type map:MapViewModel}}, x:DataType=map:MapViewModel}"
                                    CommandParameter="{Binding .}" /></Grid.GestureRecognizers>
                                <Label Text="{Binding Name}" LineBreakMode="WordWrap" HorizontalTextAlignment="Start" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Grid.Row="1" Text="{Binding Details}" IsVisible="{Binding HasDetails}" Style="{StaticResource Caption}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Grid.Row="2" Text="{Binding StateText}" LineBreakMode="WordWrap" TextColor="{Binding State, Converter={StaticResource StatusText}}" AutomationProperties.IsInAccessibleTree="False" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
