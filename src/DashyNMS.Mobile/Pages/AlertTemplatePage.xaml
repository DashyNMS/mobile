<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.AlertTemplatePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:rules="clr-namespace:DashyNMS.Mobile.Rules;assembly=DashyNMS.Mobile.Shared"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    x:DataType="rules:AlertTemplateViewModel"
    SafeAreaEdges="Container"
    Title="{Binding Title}">

    <!-- One alert template, read-only (#22), laid out as a rule's page (#122): a header card,
         the titles and body as written, then the rules that use it. -->
    <!-- The busy card while it loads, or after a pull; no platform spinner (#111, #123). -->
    <Grid x:Name="Root">
    <controls:BusyCard x:Name="Busy" ZIndex="1" IsVisible="False" VerticalOptions="Start" Margin="16,64,16,0" />
    <RefreshView x:Name="PullRefresh" Command="{Binding RefreshCommand}">
        <ScrollView x:Name="Scroller">
            <Grid x:Name="ReadingColumn">
                <VerticalStackLayout x:Name="ContentColumn" Padding="16,0,16,24" Spacing="12">

                    <controls:BackBar x:Name="TopBar" />

                    <Border Style="{StaticResource Card}" Padding="14,12" IsVisible="{Binding HasError}"
                            BackgroundColor="{StaticResource CriticalTint}" Stroke="{StaticResource CriticalStroke}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding ErrorMessage}" FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
                            <Label Text="Showing the last loaded content." IsVisible="{Binding HasLoaded}" Style="{StaticResource Caption}" />
                            <Button Text="Retry" SemanticProperties.Description="Retry loading the template" IsEnabled="{Binding IsNotBusy}" MinimumHeightRequest="44" Style="{StaticResource LinkButton}" Command="{Binding RefreshCommand}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16" IsVisible="{Binding HasLoaded}">
                        <VerticalStackLayout Spacing="4">
                            <Label Style="{StaticResource Faint}" Text="Template" />
                            <Label Text="{Binding Title}" FontSize="22" FontFamily="Display" />
                            <Label Style="{StaticResource Caption}" Text="{Binding TemplateIdentity}" />
                            <Label Style="{StaticResource Faint}" Text="{Binding UsedBy}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Style="{StaticResource SectionHeader}" Text="Alert title" Margin="4,8,0,0" IsVisible="{Binding HasAlertTitle}" />
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12,10" IsVisible="{Binding HasAlertTitle}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource CodeDark}}">
                        <Label Text="{Binding AlertTitle}" FontFamily="Mono" FontSize="12.5" LineBreakMode="CharacterWrap"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource Gray100}}" />
                    </Border>

                    <Label Style="{StaticResource SectionHeader}" Text="Recovery title" Margin="4,8,0,0" IsVisible="{Binding HasRecoveryTitle}" />
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12,10" IsVisible="{Binding HasRecoveryTitle}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource CodeDark}}">
                        <Label Text="{Binding RecoveryTitle}" FontFamily="Mono" FontSize="12.5" LineBreakMode="CharacterWrap"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource Gray100}}" />
                    </Border>

                    <!-- Plain source wraps visually without changing its whitespace or interpreting markup. -->
                    <Label Style="{StaticResource SectionHeader}" Text="Body" Margin="4,8,0,0" IsVisible="{Binding HasLoaded}" />
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12,10" IsVisible="{Binding HasLoaded}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource CodeDark}}">
                            <Label Text="{Binding Body}" TextType="Text" FontFamily="Mono" FontSize="12" LineHeight="1.3" LineBreakMode="CharacterWrap"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource Gray100}}" />
                    </Border>

                    <!-- The rules using it (#122), as the rules list shows them; each opens its rule. -->
                    <Label Style="{StaticResource SectionHeader}" Text="Used by" Margin="4,8,0,0" IsVisible="{Binding HasRules}" />
                    <Label Text="{Binding RulesStatus}" Style="{StaticResource Caption}" IsVisible="{Binding HasRulesStatus}" />
                    <Button Text="Retry" SemanticProperties.Description="Retry loading related rules" MinimumHeightRequest="44" Style="{StaticResource LinkButton}" IsVisible="{Binding CanRetryRules}" IsEnabled="{Binding IsNotBusy}" Command="{Binding RefreshCommand}" />
                    <Border Style="{StaticResource ListCard}" IsVisible="{Binding HasRules}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rules}" Margin="0,-1,0,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="rules:AlertRuleItem">
                                    <Grid Style="{StaticResource ListRow}" MinimumHeightRequest="44" SemanticProperties.Description="{Binding RelatedRuleDescription}" SemanticProperties.Hint="Opens the read-only rule" ColumnDefinitions="Auto,*,Auto" RowDefinitions="*,Auto" ColumnSpacing="12">
                                        <Grid.Triggers>
                                            <DataTrigger TargetType="Grid" Binding="{Binding IsDisabled}" Value="True">
                                                <Setter Property="Opacity" Value="0.55" />
                                            </DataTrigger>
                                        </Grid.Triggers>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding OpenRuleCommand, Source={RelativeSource AncestorType={x:Type rules:AlertTemplateViewModel}}, x:DataType=rules:AlertTemplateViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Ellipse AutomationProperties.IsInAccessibleTree="False" Style="{StaticResource Dot}" Fill="{Binding Severity, Converter={StaticResource StatusColor}}"
                                                 VerticalOptions="Start" Margin="0,6,0,0" />
                                        <VerticalStackLayout AutomationProperties.ExcludedWithChildren="True" Grid.Column="1" Spacing="2">
                                            <Label Style="{StaticResource RowTitle}" Text="{Binding Name}" />
                                            <Label Text="{Binding Summary}" Style="{StaticResource Caption}" />
                                            <Label Text="{Binding Condition}" FontFamily="Mono" FontSize="12.5" LineBreakMode="CharacterWrap"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource Gray100}}" />
                                        </VerticalStackLayout>
                                        <Label AutomationProperties.IsInAccessibleTree="False" Grid.Column="2" Style="{StaticResource Chevron}" VerticalOptions="Center" />
                                        <BoxView Grid.Row="1" Grid.ColumnSpan="3" HeightRequest="1" Margin="0,11,0,0" Color="Transparent" />
                                        <BoxView Grid.ColumnSpan="3" Style="{StaticResource RowLine}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </RefreshView>
    <BoxView x:Name="Fade" HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
        <BoxView.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" Offset="0" />
                <GradientStop Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" Offset="1" />
            </LinearGradientBrush>
        </BoxView.Background>
    </BoxView>
    </Grid>

</ContentPage>
