<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.GroupsLocationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    xmlns:sections="clr-namespace:DashyNMS.Mobile.DeviceSections;assembly=DashyNMS.Mobile.Shared"
    x:DataType="vm:GroupsLocationsViewModel"
    SafeAreaEdges="Container"
    Title="Groups &amp; locations">
    <Grid SafeAreaEdges="None" x:Name="Body" RowDefinitions="Auto,*">
        <!-- The app's own header, as every page: the title, "‹ Back" when pushed (#142). -->
        <controls:PageHeader x:Name="Header" Title="Groups &amp; locations" Margin="0" />
        <Grid SafeAreaEdges="None" Grid.Row="1">


    <Grid SafeAreaEdges="None" RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="0,8,0,0">

        <Grid SafeAreaEdges="None" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Style="{StaticResource Chip}" Text="Groups" HeightRequest="-1" MinimumHeightRequest="44" SemanticProperties.Description="{Binding GroupsDescription}" Command="{Binding ShowGroupsCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowingGroups}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1" Style="{StaticResource Chip}" Text="Locations" HeightRequest="-1" MinimumHeightRequest="44" SemanticProperties.Description="{Binding LocationsDescription}" Command="{Binding ShowLocationsCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowingLocations}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <controls:SearchField Grid.Row="1" Margin="0,6,0,0">
            <Entry x:Name="Search" Text="{Binding SearchText}" Placeholder="Search" SemanticProperties.Description="Search groups and locations" Completed="OnSearchCompleted" />
        </controls:SearchField>

        <Label Grid.Row="2" Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

        <controls:BusyCard Grid.Row="3" Text="Loading groups and locations…" IsVisible="{Binding IsBusy}" />
        <RefreshView SafeAreaEdges="None" Grid.Row="4" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView x:Name="List" ItemsSource="{Binding Places}" SelectionMode="None">
                <CollectionView.Header><BoxView HeightRequest="20" Color="Transparent" /></CollectionView.Header>
                <CollectionView.Footer><BoxView x:Name="ListFoot" Color="Transparent" /></CollectionView.Footer>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,32" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="sections:SectionRow">
                        <Border Style="{StaticResource Card}" SemanticProperties.Hint="Opens Devices filtered to this group or location">
                            <SemanticProperties.Description>
                                <MultiBinding StringFormat="{}{0}, {1}, {2}, {3}">
                                    <Binding Path="Title" />
                                    <Binding Path="Subtitle" />
                                    <Binding Path="Value" />
                                    <Binding Path="Detail" />
                                </MultiBinding>
                            </SemanticProperties.Description>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:GroupsLocationsViewModel}}, x:DataType=vm:GroupsLocationsViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid SafeAreaEdges="None" AutomationProperties.ExcludedWithChildren="True" ColumnDefinitions="10,*,Auto" ColumnSpacing="12">
                                <Ellipse Style="{StaticResource Dot}" Fill="{Binding Status, Converter={StaticResource StatusColor}}" />
                                <VerticalStackLayout SafeAreaEdges="None" Grid.Column="1">
                                    <Label Text="{Binding Title}" FontFamily="BodySemibold" LineBreakMode="WordWrap" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" LineBreakMode="WordWrap" />

                                    <Label Text="{Binding Value}" LineBreakMode="WordWrap" />
                                    <Label Text="{Binding Detail}" IsVisible="{Binding HasDetail}" FontSize="12" LineBreakMode="WordWrap"
                                           TextColor="{Binding Status, Converter={StaticResource StatusText}}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="20" VerticalOptions="Center" Style="{StaticResource Caption}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        <BoxView Grid.Row="4" HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

    </Grid>
        </Grid>
    </Grid>

</ContentPage>
