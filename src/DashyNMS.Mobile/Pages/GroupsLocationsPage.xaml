<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.GroupsLocationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    xmlns:sections="clr-namespace:DashyNMS.Mobile.DeviceSections;assembly=DashyNMS.Mobile.Shared"
    x:DataType="vm:GroupsLocationsViewModel"
    SafeAreaEdges="Container"
    Title="Groups &amp; locations">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16,8,16,0">

        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Style="{StaticResource Chip}" Text="Groups" Command="{Binding ShowGroupsCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowingGroups}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1" Style="{StaticResource Chip}" Text="Locations" Command="{Binding ShowLocationsCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowingLocations}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <SearchBar Grid.Row="1" Text="{Binding SearchText}" Placeholder="Search" Margin="0,6,0,0" />

        <Label Grid.Row="2" Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

        <RefreshView Grid.Row="3" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Places}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,32" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="sections:SectionRow">
                        <Border Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:GroupsLocationsViewModel}}, x:DataType=vm:GroupsLocationsViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="10,*,Auto,Auto" ColumnSpacing="12">
                                <Ellipse Style="{StaticResource Dot}" Fill="{Binding Status, Converter={StaticResource StatusColor}}" />
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding Title}" FontFamily="BodySemibold" LineBreakMode="TailTruncation" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                    <Label Text="{Binding Value}" HorizontalTextAlignment="End" />
                                    <Label Text="{Binding Detail}" IsVisible="{Binding HasDetail}" FontSize="12" HorizontalTextAlignment="End"
                                           TextColor="{Binding Status, Converter={StaticResource StatusText}}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="3" Text="›" FontSize="20" VerticalOptions="Center" Style="{StaticResource Caption}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
