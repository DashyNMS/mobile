<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.NotifyRulePickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:alerts="clr-namespace:DashyNMS.Mobile.Alerts;assembly=DashyNMS.Mobile.Shared"
    x:DataType="alerts:NotifyRulePickerViewModel"
    Title="Add a rule">

    <controls:SetupLayout x:Name="Setup">
        <controls:SetupLayout.Header>
            <controls:PageHeader x:Name="Header" Title="Add a rule" />
        </controls:SetupLayout.Header>
        <controls:SetupLayout.Body>
            <Grid SafeAreaEdges="None" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10" Padding="0,20,0,0">
                <controls:SetupSection Label="Choose a rule">
                    <Label Style="{StaticResource Caption}" Text="{Binding Intro}" />
                </controls:SetupSection>
                <controls:SearchField Grid.Row="1">
                    <Entry x:Name="Search" Text="{Binding SearchText}" Placeholder="Search alert rules"
                           SemanticProperties.Description="Search alert rules" />
                </controls:SearchField>
                <VerticalStackLayout Grid.Row="2" Spacing="4">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                    <Label Style="{StaticResource Caption}" Text="Loading alert rules…" IsVisible="{Binding IsBusy}" />
                    <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
                    <Label Style="{StaticResource Caption}" Text="Go back and reopen Add a rule to try again." IsVisible="{Binding HasError}" />
                    <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" />
                </VerticalStackLayout>
                <CollectionView x:Name="List" Grid.Row="3" ItemsSource="{Binding Rules}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="alerts:NotifyRuleChoice">
                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12"
                                  SemanticProperties.Description="{Binding SelectionDescription}">
                                <Grid.Triggers>
                                    <DataTrigger TargetType="Grid" Binding="{Binding CanAdd}" Value="False">
                                        <Setter Property="Opacity" Value="0.65" />
                                    </DataTrigger>
                                </Grid.Triggers>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding ChooseCommand, Source={RelativeSource AncestorType={x:Type alerts:NotifyRulePickerViewModel}}, x:DataType=alerts:NotifyRulePickerViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Ellipse Style="{StaticResource Dot}" Fill="{Binding Severity, Converter={StaticResource StatusColor}}"
                                         VerticalOptions="Start" Margin="0,6,0,0" AutomationProperties.IsInAccessibleTree="False" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Style="{StaticResource RowTitle}" Text="{Binding Name}" AutomationProperties.IsInAccessibleTree="False" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Detail}" AutomationProperties.IsInAccessibleTree="False" />
                                </VerticalStackLayout>
                                <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" Margin="0,11,0,0" Color="Transparent" />
                                <BoxView Grid.ColumnSpan="2" Style="{StaticResource RowLine}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </controls:SetupLayout.Body>
    </controls:SetupLayout>

</ContentPage>
