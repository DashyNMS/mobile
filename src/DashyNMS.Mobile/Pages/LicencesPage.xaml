<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="DashyNMS.Mobile.Pages.LicencesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:pages="clr-namespace:DashyNMS.Mobile.Pages"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    x:DataType="vm:LicencesViewModel" Title="Open-source licences">
    <Grid x:Name="Root">
        <ScrollView x:Name="Scroller">
            <VerticalStackLayout x:Name="Body" Spacing="12">
                <controls:PageHeader x:Name="Header" Title="Open-source licences" />
                <Label Style="{StaticResource Caption}" Text="DashyNMS is built with these open-source components and uses OpenStreetMap's map data. Thank you to everyone who makes them." />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:LicenceItem">
                            <Border Style="{StaticResource Card}" Padding="16,14">
                                <VerticalStackLayout Spacing="8">
                                    <Label Style="{StaticResource RowTitle}" Text="{Binding Name}" LineBreakMode="CharacterWrap" SemanticProperties.HeadingLevel="Level2" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Use}" LineBreakMode="CharacterWrap" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Copyright}" LineBreakMode="CharacterWrap" />
                                    <Label Style="{StaticResource RowTitle}" Text="{Binding LicenceName}" SemanticProperties.HeadingLevel="Level3" />
                                    <pages:LicenceAction Text="{Binding ToggleDescription}" Command="{Binding ToggleCommand}" IsVisible="{Binding HasLicenceText}" />
                                    <Label Style="{StaticResource Error}" Text="{Binding LoadError}" />
                                    <Label Text="{Binding LicenceText}" IsVisible="{Binding IsExpanded}" LineBreakMode="CharacterWrap" TextType="Text" />
                                    <pages:LicenceAction Text="{Binding LinkText}"
                                        Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:LicencesViewModel}}, x:DataType=vm:LicencesViewModel}"
                                        CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Style="{StaticResource Caption}" Text="{Binding Trademarks}" LineBreakMode="CharacterWrap" />
            </VerticalStackLayout>
        </ScrollView>
        <BoxView x:Name="Fade" HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" Offset="0" />
                    <GradientStop Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>
    </Grid>
</ContentPage>
