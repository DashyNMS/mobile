<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.SpotlightPickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:dash="clr-namespace:DashyNMS.Mobile.Dashboard;assembly=DashyNMS.Mobile.Shared"
    x:DataType="dash:SpotlightPickerViewModel"
    Title="Spotlight">

    <!-- A log card's Spotlight (#270): the whole network, devices, a group or a location.
         The shared setup layout (#398) owns the header, insets and fixed Save. -->
    <controls:SetupLayout x:Name="Setup">
        <controls:SetupLayout.Header>
            <controls:PageHeader x:Name="Header" Title="Spotlight" />
        </controls:SetupLayout.Header>
        <controls:SetupLayout.Body>
            <Grid SafeAreaEdges="None" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                <!-- Whole network saves and returns straight away, unlike the choices below, so it says so. -->
                <controls:SetupSection Label="Whole network">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Style="{StaticResource Caption}" Text="Every device. Applies straight away."
                               VerticalOptions="Center" LineBreakMode="WordWrap" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Text="Use whole network"
                                Command="{Binding WholeNetworkCommand}" VerticalOptions="Center"
                                SemanticProperties.Hint="Saves the whole network as this card's Spotlight and goes back" />
                    </Grid>
                </controls:SetupSection>

                <controls:SetupSection Grid.Row="1" Label="Or keep it to">
                    <Border Style="{StaticResource SegmentBar}">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                            <Button Grid.Column="0" Style="{StaticResource Segment}" Text="Devices" FontSize="14"
                                    Command="{Binding ChooseKindCommand}" CommandParameter="0"
                                    SemanticProperties.Description="{Binding DevicesDescription}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsDevices}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource Segment}" Text="Group" FontSize="14"
                                    Command="{Binding ChooseKindCommand}" CommandParameter="1"
                                    SemanticProperties.Description="{Binding GroupDescription}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsGroup}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource Segment}" Text="Location" FontSize="14"
                                    Command="{Binding ChooseKindCommand}" CommandParameter="2"
                                    SemanticProperties.Description="{Binding LocationDescription}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsLocation}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </Border>
                </controls:SetupSection>

                <controls:SearchField Grid.Row="2">
                    <Entry x:Name="Search" Text="{Binding SearchText}" Placeholder="Search"
                        SemanticProperties.Description="Search" Completed="OnSearchCompleted" />
                </controls:SearchField>

                <!-- The count and prompt, as Sensors; both stay blank while an error explains the empty list. -->
                <VerticalStackLayout Grid.Row="3" Spacing="2" Margin="0,8,0,6">
                    <Label Style="{StaticResource Caption}" Text="{Binding SelectedText}" />
                    <Label Style="{StaticResource Caption}" Text="{Binding HintText}" />
                </VerticalStackLayout>

                <!-- Errors and loading sit above the results rather than over them (#398). -->
                <VerticalStackLayout Grid.Row="4" Spacing="4">
                    <VerticalStackLayout Spacing="2" Margin="0,0,0,8" IsVisible="{Binding HasError}">
                        <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" />
                        <Label Style="{StaticResource Caption}" Text="{Binding RecoveryText}" />
                    </VerticalStackLayout>
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>

                <CollectionView x:Name="List" Grid.Row="5" ItemsSource="{Binding Choices}" SelectionMode="None">
                    <CollectionView.Header>
                        <!-- The fade's height, so nothing is faded at rest. -->
                        <BoxView HeightRequest="20" Color="Transparent" InputTransparent="True" />
                    </CollectionView.Header>
                    <CollectionView.EmptyView>
                        <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" Margin="0,20,0,0" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dash:SpotlightChoice">
                            <Border Style="{StaticResource Card}"
                                SemanticProperties.Description="{Binding SelectionDescription}"
                                SemanticProperties.Hint="Chooses or clears this for the Spotlight">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding PickCommand, Source={RelativeSource AncestorType={x:Type dash:SpotlightPickerViewModel}}, x:DataType=dash:SpotlightPickerViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontFamily="BodySemibold" LineBreakMode="WordWrap" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <!-- Several devices: a check box. One group or location: a tick. -->
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected, Mode=OneWay}" CheckedChanged="OnChoiceCheckedChanged"
                                        IsVisible="{Binding AllowsSeveral}" AutomationProperties.IsInAccessibleTree="False" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="✓" FontSize="18" FontFamily="BodySemibold" VerticalOptions="Center"
                                           TextColor="{StaticResource ButtonPrimary}" IsVisible="{Binding IsSingle}"
                                           AutomationProperties.IsInAccessibleTree="False">
                                        <Label.Triggers>
                                            <!-- Hidden rather than collapsed, so ticking doesn't reflow the row. -->
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                <Setter Property="Opacity" Value="0" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <BoxView Grid.Row="5" HeightRequest="20" VerticalOptions="Start" InputTransparent="True" ZIndex="1">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
                            <GradientStop Offset="1" Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
            </Grid>
        </controls:SetupLayout.Body>
        <controls:SetupLayout.PrimaryAction>
            <Button Text="Save" Command="{Binding SaveCommand}" HorizontalOptions="Fill" Margin="0,12,0,0" />
        </controls:SetupLayout.PrimaryAction>
    </controls:SetupLayout>

</ContentPage>
