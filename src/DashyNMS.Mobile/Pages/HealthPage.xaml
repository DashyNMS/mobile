<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.HealthPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    xmlns:sections="clr-namespace:DashyNMS.Mobile.DeviceSections;assembly=DashyNMS.Mobile.Shared"
    x:DataType="vm:HealthViewModel"
    HideSoftInputOnTapped="True"
    SafeAreaEdges="Container"
    Title="Health">

    <!-- As the Health mock-up (#69): the four sensor types as a segmented
         control, then search, severity chips and the sensors in one card. -->
    <Grid SafeAreaEdges="None" x:Name="Body" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" Padding="16,0,16,0">

        <controls:PageHeader x:Name="Header" Note="{Binding Offline.OfflineText}" Title="Health">
            <controls:PageHeader.Actions>
                <controls:IconButton x:Name="SearchButton" Icon="{x:Static controls:Icons.Search}" Kind="Plain"
                    SemanticProperties.Description="Search sensors" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!-- Desktop's four Health categories. -->
        <Border Grid.Row="1" Style="{StaticResource SegmentBar}">
            <FlexLayout SafeAreaEdges="None" BindableLayout.ItemsSource="{Binding Categories}" Direction="Row" Wrap="Wrap">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:HealthCategoryOption">
                        <Button FlexLayout.Grow="1" Style="{StaticResource Segment}" Text="{Binding Label}" HeightRequest="-1" MinimumHeightRequest="44" Padding="10,8"
                                Command="{Binding SelectCategoryCommand, Source={RelativeSource AncestorType={x:Type vm:HealthViewModel}}, x:DataType=vm:HealthViewModel}"
                                CommandParameter="{Binding .}" SemanticProperties.Description="{Binding SelectionDescription}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </Border>

        <!-- Button-only search on both platforms. -->
        <Grid SafeAreaEdges="None" Grid.Row="2" x:Name="SearchSlot" IsClippedToBounds="True">
            <controls:SearchField x:Name="SearchField" VerticalOptions="Start" Margin="0,6,0,0">
                <Entry x:Name="Search" Text="{Binding SearchText}" Placeholder="Search sensors" SemanticProperties.Description="Search sensors" Completed="OnSearchCompleted" />
            </controls:SearchField>
        </Grid>

        <!-- Severity chips, as desktop's; counts are of the whole category. -->
        <FlexLayout SafeAreaEdges="None" Wrap="Wrap" Grid.Row="3" Margin="0,10,0,0">
            <Button CornerRadius="22" Style="{StaticResource Chip}" HeightRequest="-1" MinimumHeightRequest="44" Padding="14,8" Text="{Binding CriticalCount, StringFormat='Critical {0}'}" Command="{Binding ToggleCriticalCommand}" Margin="0,0,8,8" SemanticProperties.Description="{Binding CriticalFilterDescription}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowCritical}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource CriticalTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource CriticalStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button CornerRadius="22" Style="{StaticResource Chip}" HeightRequest="-1" MinimumHeightRequest="44" Padding="14,8" Text="{Binding WarningCount, StringFormat='Warning {0}'}" Command="{Binding ToggleWarningCommand}" Margin="0,0,8,8" SemanticProperties.Description="{Binding WarningFilterDescription}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowWarning}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource WarningTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource WarningStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WarningTextLight}, Dark={StaticResource WarningTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button CornerRadius="22" Style="{StaticResource Chip}" HeightRequest="-1" MinimumHeightRequest="44" Padding="14,8" Text="{Binding OkCount, StringFormat='OK {0}'}" Command="{Binding ToggleOkCommand}" Margin="0,0,8,8" SemanticProperties.Description="{Binding OkFilterDescription}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowOk}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource OkTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource OkStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OkTextLight}, Dark={StaticResource OkTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </FlexLayout>

        <!-- Its height kept while the count is still blank, so the chips never touch the list (#143). -->
        <Grid SafeAreaEdges="None" Grid.Row="4" ColumnDefinitions="*,Auto" Margin="4,6,0,4" MinimumHeightRequest="30">
            <Label Style="{StaticResource Faint}" Text="{Binding CountText}" VerticalOptions="Center" />
            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Text="Clear" Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}"
                    MinimumHeightRequest="44" />
        </Grid>

        <Label Grid.Row="5" Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

        <!-- Loading the first time, or after a pull: the busy card over the list (#111). -->
        <controls:BusyCard x:Name="Busy" Grid.Row="6" ZIndex="1" IsVisible="False" />
        <Border SafeAreaEdges="None" x:Name="ListCard" Grid.Row="6" Style="{StaticResource ListCard}" Margin="0,0,0,12">
            <Grid SafeAreaEdges="None">
                <RefreshView SafeAreaEdges="None" x:Name="PullRefresh" Command="{Binding RefreshCommand}">
                    <CollectionView controls:KeyboardDismiss.OnScroll="False" Margin="0,-1,0,0" ItemsSource="{Binding Sensors}" SelectionMode="None" x:Name="List">
                        <CollectionView.Header><BoxView HeightRequest="20" Color="Transparent" /></CollectionView.Header>
                        <CollectionView.Footer><BoxView x:Name="ListFoot" HeightRequest="0" Color="Transparent" /></CollectionView.Footer>
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="16,32" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="sections:SectionRow">
                                <Grid Style="{StaticResource ListRow}" Padding="14,11" ColumnDefinitions="10,*" ColumnSpacing="12"
                                      SemanticProperties.Description="{Binding HealthDescription}"
                                      SemanticProperties.Hint="Opens this device’s Sensors">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding OpenSensorCommand, Source={RelativeSource AncestorType={x:Type vm:HealthViewModel}}, x:DataType=vm:HealthViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Ellipse Style="{StaticResource Dot}" Fill="{Binding Status, Converter={StaticResource StatusColor}}" AutomationProperties.IsInAccessibleTree="False" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" AutomationProperties.ExcludedWithChildren="True">
                                        <Label Style="{StaticResource RowTitle}" Text="{Binding Title}" LineBreakMode="WordWrap" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}" LineBreakMode="WordWrap" />
                                        <Label Text="{Binding Value}" FontFamily="BodySemibold" LineBreakMode="WordWrap"
                                               TextColor="{Binding Status, Converter={StaticResource StatusText}}" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding HealthStatusText}" />
                                        <Label Style="{StaticResource Faint}" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <BoxView Grid.ColumnSpan="2" Style="{StaticResource RowLine}" InputTransparent="True" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
                <BoxView HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" Offset="0" />
                            <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLightClear}, Dark={StaticResource SurfaceDarkClear}}" Offset="1" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
            </Grid>
        </Border>

    </Grid>

</ContentPage>
