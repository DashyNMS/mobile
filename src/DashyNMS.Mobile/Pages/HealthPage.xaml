<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.HealthPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    xmlns:sections="clr-namespace:DashyNMS.Mobile.DeviceSections;assembly=DashyNMS.Mobile.Shared"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    x:DataType="vm:HealthViewModel"
    ios:Page.UseSafeArea="True"
    SafeAreaEdges="Container"
    Title="Health">

    <!-- As the Health mock-up (#69): the four sensor types as a segmented
         control, then search, severity chips and the sensors in one card. -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" Padding="16,8,16,0">

        <controls:PageHeader x:Name="Header" Title="Health" />

        <!-- Desktop's four Health categories. -->
        <Border Grid.Row="1" Style="{StaticResource SegmentBar}">
            <FlexLayout BindableLayout.ItemsSource="{Binding Categories}" Direction="Row" JustifyContent="SpaceBetween">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:HealthCategoryOption">
                        <Button Style="{StaticResource Segment}" Text="{Binding Label}" FlexLayout.Grow="1" FlexLayout.Basis="0"
                                Command="{Binding SelectCategoryCommand, Source={RelativeSource AncestorType={x:Type vm:HealthViewModel}}, x:DataType=vm:HealthViewModel}"
                                CommandParameter="{Binding .}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </Border>

        <!-- Slides out when the list is scrolled back up or pulled down - see SearchReveal.
             The gap below belongs to the chips, so it's the same with the box away (#83). -->
        <ContentView Grid.Row="2" x:Name="SearchSlot">
            <SearchBar x:Name="Search" Text="{Binding SearchText}" Placeholder="Search sensors" Margin="-6,6,-6,0" />
        </ContentView>

        <!-- Severity chips, as desktop's; counts are of the whole category. -->
        <HorizontalStackLayout Grid.Row="3" Spacing="8" Margin="0,10,0,0">
            <Button Style="{StaticResource Chip}" Text="{Binding CriticalCount, StringFormat='Critical {0}'}" Command="{Binding ToggleCriticalCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowCritical}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource CriticalTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource CriticalStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Style="{StaticResource Chip}" Text="{Binding WarningCount, StringFormat='Warning {0}'}" Command="{Binding ToggleWarningCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowWarning}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource WarningTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource WarningStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WarningTextLight}, Dark={StaticResource WarningTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Style="{StaticResource Chip}" Text="{Binding OkCount, StringFormat='OK {0}'}" Command="{Binding ToggleOkCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowOk}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource OkTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource OkStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OkTextLight}, Dark={StaticResource OkTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </HorizontalStackLayout>

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="4,6,0,4">
            <Label Style="{StaticResource Faint}" Text="{Binding CountText}" VerticalOptions="Center" />
            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Text="Clear" Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}"
                    HeightRequest="30" MinimumHeightRequest="30" />
        </Grid>

        <Label Grid.Row="5" Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

        <controls:LoadingIndicator Grid.Row="6" IsVisible="{Binding IsLoadingFirstTime}" InputTransparent="True" ZIndex="1" />
        <Border Grid.Row="6" Style="{StaticResource ListCard}" Margin="0,0,0,12">
            <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
                <CollectionView ItemsSource="{Binding Sensors}" SelectionMode="None" x:Name="List">
                    <CollectionView.EmptyView>
                        <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="16,32" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="sections:SectionRow">
                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="10,*,Auto" RowDefinitions="*,Auto" ColumnSpacing="12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenSensorCommand, Source={RelativeSource AncestorType={x:Type vm:HealthViewModel}}, x:DataType=vm:HealthViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Ellipse Style="{StaticResource Dot}" Fill="{Binding Status, Converter={StaticResource StatusColor}}" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Style="{StaticResource RowTitle}" Text="{Binding Title}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <!-- The reading, and the limit it's measured against under it. -->
                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                    <Label Text="{Binding Value}" FontFamily="BodySemibold" HorizontalOptions="End"
                                           TextColor="{Binding Status, Converter={StaticResource StatusText}}" />
                                    <Label Style="{StaticResource Faint}" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" FontSize="11"
                                           HorizontalOptions="End" />
                                </VerticalStackLayout>
                                <BoxView Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Divider}" Margin="0,11,0,0" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Border>

    </Grid>

</ContentPage>
