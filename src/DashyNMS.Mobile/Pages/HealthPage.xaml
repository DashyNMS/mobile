<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.HealthPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    xmlns:sections="clr-namespace:DashyNMS.Mobile.DeviceSections;assembly=DashyNMS.Mobile.Shared"
    x:DataType="vm:HealthViewModel"
    Title="Health">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Padding="16,8,16,0">

        <!-- Desktop's four Health categories. -->
        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Categories}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:HealthCategoryOption">
                        <Button Style="{StaticResource Chip}" Text="{Binding Label}"
                                Command="{Binding SelectCategoryCommand, Source={RelativeSource AncestorType={x:Type vm:HealthViewModel}}, x:DataType=vm:HealthViewModel}"
                                CommandParameter="{Binding .}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                                    <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <SearchBar Grid.Row="1" Text="{Binding SearchText}" Placeholder="Sensor or device" Margin="0,6,0,0" />

        <!-- Severity chips, as desktop's; counts are of the whole category. -->
        <HorizontalStackLayout Grid.Row="2" Spacing="8" Margin="0,6,0,0">
            <Button Style="{StaticResource Chip}" Text="{Binding CriticalCount, StringFormat='Critical {0}'}" Command="{Binding ToggleCriticalCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowCritical}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource CriticalTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource CriticalStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Style="{StaticResource Chip}" Text="{Binding WarningCount, StringFormat='Warning {0}'}" Command="{Binding ToggleWarningCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowWarning}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource WarningTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource WarningStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WarningTextLight}, Dark={StaticResource WarningTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Style="{StaticResource Chip}" Text="{Binding OkCount, StringFormat='OK {0}'}" Command="{Binding ToggleOkCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowOk}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource OkTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource OkStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OkTextLight}, Dark={StaticResource OkTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </HorizontalStackLayout>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="4,6,0,2">
            <Label Style="{StaticResource Caption}" Text="{Binding CountText}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Clear" Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                    Padding="8,0" HeightRequest="30" MinimumHeightRequest="30" />
        </Grid>

        <Label Grid.Row="4" Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

        <controls:LoadingIndicator Grid.Row="5" IsVisible="{Binding IsLoadingFirstTime}" InputTransparent="True" ZIndex="1" />
        <RefreshView Grid.Row="5" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Sensors}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,32" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="sections:SectionRow">
                        <Border Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding OpenSensorCommand, Source={RelativeSource AncestorType={x:Type vm:HealthViewModel}}, x:DataType=vm:HealthViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="12">
                                <Ellipse Style="{StaticResource Dot}" Fill="{Binding Status, Converter={StaticResource StatusColor}}" />
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}" LineBreakMode="TailTruncation" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" FontSize="12" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding Value}" VerticalOptions="Center" FontFamily="OpenSansSemibold"
                                       TextColor="{Binding Status, Converter={StaticResource StatusText}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
