<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.MaintenancePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    x:DataType="vm:MaintenanceViewModel"
    SafeAreaEdges="Container"
    Title="Schedule maintenance">
    <Grid RowDefinitions="Auto,*" SafeAreaEdges="None">
        <controls:PageHeader x:Name="Header" Title="Schedule maintenance" Margin="16,0,16,0" SafeAreaEdges="None" />
        <ScrollView x:Name="FormScroll" Grid.Row="1" SafeAreaEdges="None">
            <VerticalStackLayout x:Name="ContentColumn" Padding="16,20,16,24" Spacing="12" SafeAreaEdges="None">
                <Border Style="{StaticResource Card}">
                    <Label Text="{Binding DeviceName}" FontSize="20" FontFamily="BodySemibold" LineBreakMode="WordWrap" SemanticProperties.HeadingLevel="Level1" />
                </Border>
                <Grid x:Name="FormCards" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*" RowSpacing="12" ColumnSpacing="12" SafeAreaEdges="None">
                    <VerticalStackLayout x:Name="WhenSection" Grid.Row="0" Spacing="8" SafeAreaEdges="None">
                        <Label Style="{StaticResource SectionHeader}" Text="WHEN" />
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Start now" VerticalOptions="Center" />
                                    <Switch Grid.Column="1" IsToggled="{Binding StartNow}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding IsScheduledForLater}">
                                    <DatePicker Date="{Binding StartDate}" Format="ddd d MMM yyyy" />
                                    <TimePicker Grid.Column="1" Time="{Binding StartTime}" Format="HH:mm" />
                                </Grid>
                                <Label Style="{StaticResource Caption}" IsVisible="{Binding IsScheduledForLater}"
                                       Text="In the LibreNMS server's own time." />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout x:Name="DurationSection" Grid.Row="1" Spacing="8" SafeAreaEdges="None">
                        <Label Style="{StaticResource SectionHeader}" Text="{Binding DurationText, StringFormat='FOR {0}'}" />
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="8">
                                <FlexLayout BindableLayout.ItemsSource="{Binding Presets}" Wrap="Wrap">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DurationPreset">
                                            <Button Style="{StaticResource Chip}" Text="{Binding Label}" Margin="0,0,8,8"
                                                    Command="{Binding ApplyPresetCommand, Source={RelativeSource AncestorType={x:Type vm:MaintenanceViewModel}}, x:DataType=vm:MaintenanceViewModel}"
                                                    CommandParameter="{Binding .}" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                    <Label Text="Hours" VerticalOptions="Center" />
                                    <Stepper Grid.Column="1" Minimum="0" Maximum="168" Increment="1" Value="{Binding DurationHours}" />
                                    <Label Grid.Row="1" Text="Minutes" VerticalOptions="Center" />
                                    <Picker Grid.Row="1" Grid.Column="1" ItemsSource="{Binding MinuteChoices}" SelectedItem="{Binding DurationMinutes}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout x:Name="BehaviorSection" Grid.Row="2" Spacing="8" SafeAreaEdges="None">
                        <Label Style="{StaticResource SectionHeader}" Text="ALERTS DURING MAINTENANCE" />
                        <Border Style="{StaticResource Card}">
                            <Picker ItemsSource="{Binding Behaviors}"
                                    SelectedItem="{Binding SelectedBehavior}"
                                    ItemDisplayBinding="{Binding Label, x:DataType=vm:MaintenanceBehaviorOption}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout x:Name="DetailsSection" Grid.Row="3" Spacing="8" SafeAreaEdges="None">
                        <Label Style="{StaticResource SectionHeader}" Text="DETAILS (OPTIONAL)" />
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="8">
                                <Entry Text="{Binding MaintenanceTitle}" Placeholder="{Binding DeviceName}" />
                                <Editor Text="{Binding Notes}" Placeholder="Notes" AutoSize="TextChanges" MinimumHeightRequest="80" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
                <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

                <!-- The token isn't allowed to schedule maintenance (#144): no Schedule, and why. -->
                <Label Style="{StaticResource Caption}" Text="{Binding RefusedText}"
                       IsVisible="{Binding RefusedText, Converter={StaticResource IsNotNull}}" />
                <Button Text="Schedule" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" IsVisible="{Binding MaySchedule}" Margin="0,12,0,0" />
                <Button Text="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" />

            </VerticalStackLayout>
        </ScrollView>
        <BoxView Grid.Row="1" HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
                    <GradientStop Offset="1" Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>
    </Grid>
</ContentPage>
