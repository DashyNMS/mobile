<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.MaintenancePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    x:DataType="vm:MaintenanceViewModel"
    Title="Schedule maintenance">
    <controls:SetupLayout x:Name="Setup">
        <controls:SetupLayout.Header>
        <controls:PageHeader x:Name="Header" Title="Schedule maintenance" SafeAreaEdges="None" />
        </controls:SetupLayout.Header>
        <controls:SetupLayout.Body>
        <Grid SafeAreaEdges="None">
        <ScrollView x:Name="FormScroll" SafeAreaEdges="None">
            <VerticalStackLayout x:Name="ContentColumn" Padding="0,20,0,0" Spacing="12" SafeAreaEdges="None">
                <Border Style="{StaticResource Card}">
                    <Label Text="{Binding DeviceName}" FontSize="20" FontFamily="BodySemibold" LineBreakMode="WordWrap" SemanticProperties.HeadingLevel="Level1" />
                </Border>
                <Grid x:Name="FormCards" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*" RowSpacing="12" ColumnSpacing="12" SafeAreaEdges="None">
                    <VerticalStackLayout x:Name="WhenSection" Grid.Row="0" Spacing="8" SafeAreaEdges="None">
                        <Label Style="{StaticResource SectionHeader}" Text="WHEN" />
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Start now" VerticalOptions="Center" />
                                    <Switch Grid.Column="1" IsToggled="{Binding StartNow}" SemanticProperties.Description="Start now" />
                                </Grid>
                                <VerticalStackLayout IsVisible="{Binding IsScheduledForLater}">
                                    <controls:SetupSection Label="Start date">
                                        <DatePicker Date="{Binding StartDate}" Format="ddd d MMM yyyy" SemanticProperties.Description="Start date" />
                                    </controls:SetupSection>
                                    <controls:SetupSection Label="Start time">
                                        <TimePicker Time="{Binding StartTime}" Format="HH:mm" SemanticProperties.Description="Start time" />
                                    </controls:SetupSection>
                                </VerticalStackLayout>
                                <Label Style="{StaticResource Caption}" IsVisible="{Binding IsScheduledForLater}"
                                       Text="In the LibreNMS server's own time." />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout x:Name="DurationSection" Grid.Row="1" Spacing="8" SafeAreaEdges="None">
                        <Label Style="{StaticResource SectionHeader}" Text="{Binding DurationText, StringFormat='FOR {0}'}" />
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="8">
                                <FlexLayout BindableLayout.ItemsSource="{Binding Presets}" Wrap="Wrap">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DurationPreset">
                                            <Button Style="{StaticResource Chip}" Text="{Binding Label}" Margin="0,0,8,8"
                                                    Command="{Binding ApplyPresetCommand, Source={RelativeSource AncestorType={x:Type vm:MaintenanceViewModel}}, x:DataType=vm:MaintenanceViewModel}"
                                                    CommandParameter="{Binding .}" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                                <controls:SetupSection Label="Hours">
                                    <Stepper Minimum="0" Maximum="168" Increment="1" Value="{Binding DurationHours}" SemanticProperties.Description="Duration hours" />
                                </controls:SetupSection>
                                <controls:SetupSection Label="Minutes">
                                    <Picker ItemsSource="{Binding MinuteChoices}" SelectedItem="{Binding DurationMinutes}" SemanticProperties.Description="Duration minutes" />
                                </controls:SetupSection>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout x:Name="BehaviorSection" Grid.Row="2" Spacing="8" SafeAreaEdges="None">
                        <Label Style="{StaticResource SectionHeader}" Text="ALERTS DURING MAINTENANCE" />
                        <Border Style="{StaticResource Card}">
                            <Picker SemanticProperties.Description="Alerts during maintenance" ItemsSource="{Binding Behaviors}"
                                    SelectedItem="{Binding SelectedBehavior}"
                                    ItemDisplayBinding="{Binding Label, x:DataType=vm:MaintenanceBehaviorOption}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout x:Name="DetailsSection" Grid.Row="3" Spacing="8" SafeAreaEdges="None">
                        <Label Style="{StaticResource SectionHeader}" Text="DETAILS (OPTIONAL)" />
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="8">
                                <controls:SetupSection Label="Title (optional)">
                                    <Entry Text="{Binding MaintenanceTitle}" Placeholder="{Binding DeviceName}" SemanticProperties.Description="Title (optional)" />
                                </controls:SetupSection>
                                <controls:SetupSection Label="Notes (optional)">
                                    <Editor Text="{Binding Notes}" Placeholder="Notes" AutoSize="TextChanges" MinimumHeightRequest="80" SemanticProperties.Description="Notes (optional)" />
                                </controls:SetupSection>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
                <Label x:Name="ValidationError" Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

                <!-- The token isn't allowed to schedule maintenance (#144): no Schedule, and why. -->
                <Label Style="{StaticResource Caption}" Text="{Binding RefusedText}"
                       IsVisible="{Binding RefusedText, Converter={StaticResource IsNotNull}}" />
                <Label Style="{StaticResource Caption}" Text="Back discards changes without scheduling maintenance." />

            </VerticalStackLayout>
        </ScrollView>
        <BoxView HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
                    <GradientStop Offset="1" Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>
        </Grid>
        </controls:SetupLayout.Body>
        <controls:SetupLayout.PrimaryAction>
            <Button Text="Schedule" Clicked="OnScheduleClicked" IsEnabled="{Binding SaveCommand.IsRunning, Converter={StaticResource Invert}}" IsVisible="{Binding MaySchedule}" Margin="0,12,0,0" />
        </controls:SetupLayout.PrimaryAction>
    </controls:SetupLayout>
</ContentPage>
