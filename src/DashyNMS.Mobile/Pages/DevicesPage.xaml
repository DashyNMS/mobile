<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    xmlns:cfg="clr-namespace:DesktopNMS.Core.Configuration;assembly=DesktopNMS.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    x:DataType="vm:DevicesViewModel"
    ios:Page.UseSafeArea="True"
    SafeAreaEdges="Container"
    Title="Devices">

    <!-- On an iPad or a Mac, the device you tap shows beside the list (#88). -->
    <controls:ListDetail x:Name="Split" Placeholder="Choose a device to see it here.">

    <Grid RowDefinitions="Auto,*" Padding="16,8,16,0">

    <controls:PageHeader x:Name="Header" Title="Devices" />

    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">

        <!-- Slides out when the list is scrolled back up or pulled down - see SearchReveal.
             The gap below belongs to the chips, so it's the same with the box away (#83). -->
        <Grid x:Name="SearchSlot" IsClippedToBounds="True">
            <SearchBar x:Name="Search" Text="{Binding SearchText}" Placeholder="Search devices" Margin="-6,2,-6,0" />
        </Grid>

        <!-- Desktop's state chips. Counts are of every device, whatever's filtered. -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,10,0,0">
            <HorizontalStackLayout Spacing="8">
                <Button Style="{StaticResource Chip}" Text="{Binding UpCount, StringFormat='Up {0}'}" Command="{Binding ToggleUpCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowUp}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource OkTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource OkStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OkTextLight}, Dark={StaticResource OkTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Style="{StaticResource Chip}" Text="{Binding DownCount, StringFormat='Down {0}'}" Command="{Binding ToggleDownCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowDown}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource CriticalTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource CriticalStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Style="{StaticResource Chip}" Text="{Binding MaintenanceCount, StringFormat='Maintenance {0}'}" Command="{Binding ToggleMaintenanceCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowMaintenance}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource MaintenanceTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource MaintenanceStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MaintenanceTextLight}, Dark={StaticResource MaintenanceTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Style="{StaticResource Chip}" Text="{Binding DisabledCount, StringFormat='Disabled {0}'}" Command="{Binding ToggleDisabledCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowDisabled}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource InactiveTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource InactiveStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InactiveTextLight}, Dark={StaticResource InactiveTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="4,6,0,2">
            <Label Style="{StaticResource Caption}" Text="{Binding CountText}" VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="Clear"
                    Command="{Binding ClearFiltersCommand}"
                    IsVisible="{Binding HasActiveFilters}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                    Padding="8,0" HeightRequest="30" MinimumHeightRequest="30" />
            <Button Grid.Column="2"
                    Style="{StaticResource Chip}"
                    Text="Sort &amp; filter"
                    Command="{Binding ToggleFilterPanelCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding HasPanelFilters}" Value="True">
                        <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- Sort, and desktop's Type / Location / Group filters, one choice each. -->
        <Border Grid.Row="3" Style="{StaticResource Card}" IsVisible="{Binding IsFilterPanelOpen}" Margin="0,4,0,6">
            <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="2" ColumnSpacing="8">
                <Label Style="{StaticResource Caption}" Text="Sort" VerticalOptions="Center" />
                <Picker Grid.Column="1" Title="Sort by"
                        ItemsSource="{Binding SortOptions}"
                        SelectedItem="{Binding SelectedSort}"
                        ItemDisplayBinding="{Binding Label, x:DataType=vm:SortOption}" />

                <Label Grid.Row="1" Style="{StaticResource Caption}" Text="Type" VerticalOptions="Center" />
                <Picker Grid.Row="1" Grid.Column="1" Title="Type"
                        ItemsSource="{Binding TypeOptions}"
                        SelectedItem="{Binding SelectedType}"
                        ItemDisplayBinding="{Binding Label, x:DataType=vm:FacetOption}" />

                <Label Grid.Row="2" Style="{StaticResource Caption}" Text="Location" VerticalOptions="Center" />
                <Picker Grid.Row="2" Grid.Column="1" Title="Location"
                        ItemsSource="{Binding LocationOptions}"
                        SelectedItem="{Binding SelectedLocation}"
                        ItemDisplayBinding="{Binding Label, x:DataType=vm:FacetOption}" />

                <Label Grid.Row="3" Style="{StaticResource Caption}" Text="Group" VerticalOptions="Center" />
                <Picker Grid.Row="3" Grid.Column="1" Title="Group"
                        ItemsSource="{Binding GroupOptions}"
                        SelectedItem="{Binding SelectedGroup}"
                        ItemDisplayBinding="{Binding Label, x:DataType=vm:FacetOption}" />
            </Grid>
        </Border>

        <!-- Desktop's "Recently viewed" strip. -->
        <VerticalStackLayout Grid.Row="4" IsVisible="{Binding ShowRecentlyViewed}" Margin="0,2,0,6" Spacing="4">
            <Label Style="{StaticResource SectionHeader}" Text="RECENTLY VIEWED" Margin="4,4,0,0" />
            <CollectionView ItemsSource="{Binding RecentlyViewed}" SelectionMode="None" HeightRequest="40">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="cfg:RecentlyViewedDevice">
                        <Button Style="{StaticResource Chip}"
                                Text="{Binding DisplayName}"
                                Command="{Binding OpenRecentCommand, Source={RelativeSource AncestorType={x:Type vm:DevicesViewModel}}, x:DataType=vm:DevicesViewModel}"
                                CommandParameter="{Binding .}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="5">
            <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
            <!-- How the last bulk action went: "Rediscovery requested for 5 devices." -->
            <Label Style="{StaticResource Caption}" Text="{Binding Selection.ResultText}" IsVisible="{Binding Selection.HasResult}"
                   Margin="4,0,4,6" />
        </VerticalStackLayout>

        <controls:LoadingIndicator Grid.Row="6" IsVisible="{Binding IsLoadingFirstTime}" InputTransparent="True" ZIndex="1" />
        <!-- The rows share one card, as the mock-ups group them (#69). -->
        <Border Grid.Row="6" Style="{StaticResource ListCard}" Margin="0,0,0,12">
        <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Devices}" SelectionMode="None" x:Name="List">
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" IsVisible="{Binding IsNotBusy}" HorizontalOptions="Center" Margin="0,32" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceItem">
                        <SwipeView Threshold="96">
                            <!-- Swipe right to show Pin (or Unpin), then tap it - never pinned by a stray swipe. -->
                            <SwipeView.LeftItems>
                                <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                                    <SwipeItem Text="{Binding PinText}"
                                               BackgroundColor="{StaticResource ButtonPrimary}"
                                               Command="{Binding TogglePinCommand, Source={RelativeSource AncestorType={x:Type vm:DevicesViewModel}}, x:DataType=vm:DevicesViewModel}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.LeftItems>

                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" RowDefinitions="*,Auto" ColumnSpacing="12"
                                  controls:LongPress.Command="{Binding HoldCommand, Source={RelativeSource AncestorType={x:Type vm:DevicesViewModel}}, x:DataType=vm:DevicesViewModel}"
                                  controls:LongPress.CommandParameter="{Binding .}"
                                  SemanticProperties.Hint="Touch and hold to select several">
                                <!-- Press and hold starts selecting several, with this one ticked (#85). -->
                                <!-- Tinted while its detail shows beside the list (#88); the card beneath shows through. -->
                                <Grid.Triggers>
                                    <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                                    </DataTrigger>
                                </Grid.Triggers>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenDeviceCommand, Source={RelativeSource AncestorType={x:Type vm:DevicesViewModel}}, x:DataType=vm:DevicesViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                    <Ellipse Style="{StaticResource Dot}" Fill="{Binding State, Converter={StaticResource StatusColor}}"
                                             IsVisible="{Binding Selection.IsOff, Source={RelativeSource AncestorType={x:Type vm:DevicesViewModel}}, x:DataType=vm:DevicesViewModel}" />
                                    <!-- Selecting (#85): a tick circle where the dot was. -->
                                    <controls:TickCircle IsTicked="{Binding IsTicked}"
                                                         IsVisible="{Binding Selection.IsSelecting, Source={RelativeSource AncestorType={x:Type vm:DevicesViewModel}}, x:DataType=vm:DevicesViewModel}" />
                                    <VerticalStackLayout Grid.Column="1">
                                        <HorizontalStackLayout Spacing="6">
                                            <Image Source="pin_marker.png" WidthRequest="14" HeightRequest="14"
                                                   VerticalOptions="Center" IsVisible="{Binding IsPinned}" />
                                            <Label Style="{StaticResource RowTitle}" Text="{Binding Name}" />
                                        </HorizontalStackLayout>
                                        <Label Style="{StaticResource Caption}" Text="{Binding Details}" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                        <Label Text="{Binding StateText}" HorizontalOptions="End" FontFamily="BodySemibold" FontSize="13"
                                               TextColor="{Binding State, Converter={StaticResource StatusText}}" />
                                        <Label Style="{StaticResource Faint}" Text="{Binding UptimeText}" HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                <BoxView Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Divider}" Margin="0,11,0,0" />
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        </Border>

        <!-- Selecting (#85): how many, select all, and what to do with them. -->
        <controls:BulkBar Grid.Row="7" Summary="{Binding Selection.Summary}" Progress="{Binding Selection.ProgressText}"
                          SelectAllText="{Binding SelectAllText}" SelectAllCommand="{Binding SelectAllCommand}"
                          DoneCommand="{Binding StopSelectingCommand}" IsVisible="{Binding Selection.IsSelecting}">
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Button Text="Maintenance" Command="{Binding ScheduleMaintenanceSelectedCommand}" IsEnabled="{Binding Selection.CanAct}" />
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Text="Rediscover"
                        Command="{Binding RediscoverSelectedCommand}" IsEnabled="{Binding Selection.CanAct}" />
                <Button Grid.Row="1" Style="{StaticResource SecondaryButton}" Text="Pin"
                        Command="{Binding PinSelectedCommand}" IsEnabled="{Binding Selection.CanAct}" IsVisible="{Binding PinningEnabled}" />
                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource SecondaryButton}" Text="Unpin"
                        Command="{Binding UnpinSelectedCommand}" IsEnabled="{Binding Selection.CanAct}" IsVisible="{Binding PinningEnabled}" />
            </Grid>
        </controls:BulkBar>

    </Grid>
    </Grid>
    </controls:ListDetail>

</ContentPage>
