<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.AlertsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    x:DataType="vm:AlertsViewModel"
    ios:Page.UseSafeArea="True"
    SafeAreaEdges="Container"
    Title="Alerts">

    <!-- For when Alerts is pushed from More and has the navigation bar; as a tab, the header has these. -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Logs" Command="{Binding OpenLogsCommand}" />
        <ToolbarItem Text="Export" IconImageSource="icon_export.png" Command="{Binding ExportCsvCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Padding="16,8,16,0">

        <controls:PageHeader x:Name="Header" Title="Alerts">
            <controls:PageHeader.Actions>
                <HorizontalStackLayout Spacing="4">
                    <Button Style="{StaticResource LinkButton}" Text="Logs" Command="{Binding OpenLogsCommand}" />
                    <controls:IconButton Kind="Plain" Icon="{x:Static controls:Icons.Export}" Command="{Binding ExportCsvCommand}"
                                         SemanticProperties.Description="Export as CSV" />
                </HorizontalStackLayout>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!-- Slides out when the list is scrolled back up or pulled down - see SearchReveal.
             The gap below belongs to the chips, so it's the same with the box away (#83). -->
        <Grid Grid.Row="1" x:Name="SearchSlot" IsClippedToBounds="True">
            <SearchBar x:Name="Search" Text="{Binding SearchText}" Placeholder="Search alerts" Margin="-6,2,-6,0" />
        </Grid>

        <!-- Desktop's filter chips. Counts are of open alerts, whatever's filtered. -->
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,10,0,0">
        <HorizontalStackLayout Spacing="8">
            <Button Style="{StaticResource Chip}"
                    Text="{Binding CriticalCount, StringFormat='Critical {0}'}"
                    Command="{Binding ToggleCriticalCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowCritical}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource CriticalTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource CriticalStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Style="{StaticResource Chip}"
                    Text="{Binding WarningCount, StringFormat='Warning {0}'}"
                    Command="{Binding ToggleWarningCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowWarning}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource WarningTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource WarningStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WarningTextLight}, Dark={StaticResource WarningTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <!-- LibreNMS's ok severity (#64). -->
            <Button Style="{StaticResource Chip}"
                    Text="{Binding OkCount, StringFormat='OK {0}'}"
                    Command="{Binding ToggleOkCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowOk}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource OkTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource OkStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OkTextLight}, Dark={StaticResource OkTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Style="{StaticResource Chip}"
                    Text="{Binding AcknowledgedCount, StringFormat='Acknowledged {0}'}"
                    Command="{Binding ToggleAcknowledgedCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowAcknowledged}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="4,6,0,4">
            <Label Style="{StaticResource Faint}" Text="{Binding CountText}" VerticalOptions="Center" />
            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Text="Clear"
                    Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}"
                    HeightRequest="30" MinimumHeightRequest="30" />
        </Grid>

        <Label Grid.Row="4" Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

        <controls:LoadingIndicator Grid.Row="5" IsVisible="{Binding IsLoadingFirstTime}" InputTransparent="True" ZIndex="1" />
        <!-- The rows share one card, as the mock-ups group them (#69). -->
        <Border Grid.Row="5" Style="{StaticResource ListCard}" Margin="0,0,0,12">
            <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
                <CollectionView ItemsSource="{Binding Alerts}" SelectionMode="None" x:Name="List">
                    <CollectionView.EmptyView>
                        <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" IsVisible="{Binding IsNotBusy}" HorizontalOptions="Center" Margin="0,32" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AlertItem">
                            <SwipeView Threshold="96">
                                <!-- Swipe left to show Acknowledge (or Unacknowledge), then tap it: revealing rather
                                     than acting, so a stray sideways scroll can't acknowledge anything. -->
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                                        <SwipeItem Text="Acknowledge"
                                                   BackgroundColor="{StaticResource OkTextLight}"
                                                   IsVisible="{Binding IsNotAcknowledged}"
                                                   Command="{Binding AcknowledgeCommand, Source={RelativeSource AncestorType={x:Type vm:AlertsViewModel}}, x:DataType=vm:AlertsViewModel}"
                                                   CommandParameter="{Binding .}" />
                                        <SwipeItem Text="Unacknowledge"
                                                   BackgroundColor="{StaticResource WarningTextLight}"
                                                   IsVisible="{Binding IsAcknowledged}"
                                                   Command="{Binding UnacknowledgeCommand, Source={RelativeSource AncestorType={x:Type vm:AlertsViewModel}}, x:DataType=vm:AlertsViewModel}"
                                                   CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Grid Style="{StaticResource ListRow}" ColumnDefinitions="10,*,Auto" RowDefinitions="*,Auto" ColumnSpacing="12">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding OpenAlertCommand, Source={RelativeSource AncestorType={x:Type vm:AlertsViewModel}}, x:DataType=vm:AlertsViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <!-- As the mock-ups: a status dot, the device, the rule, then the age at the right. -->
                                    <Ellipse Style="{StaticResource Dot}" Fill="{Binding Severity, Converter={StaticResource StatusColor}}"
                                             VerticalOptions="Start" Margin="0,6,0,0" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                        <Label Style="{StaticResource RowTitle}" Text="{Binding Device}" />
                                        <Label Text="{Binding Rule}" FontSize="14" LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource Gray100}}" />
                                        <Label Style="{StaticResource Faint}" Text="{Binding MetaText}" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding Note}" FontAttributes="Italic"
                                               LineBreakMode="TailTruncation" MaxLines="2"
                                               IsVisible="{Binding HasNote}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Style="{StaticResource Faint}" Text="{Binding ShortAge}" VerticalOptions="Start" Margin="0,2,0,0" />
                                    <BoxView Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Divider}" Margin="0,11,0,0" />
                                </Grid>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Border>

    </Grid>

</ContentPage>
