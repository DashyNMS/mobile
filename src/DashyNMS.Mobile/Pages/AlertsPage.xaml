<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.AlertsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    x:DataType="vm:AlertsViewModel"
    Title="Alerts">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,8,16,0">

        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Hide acknowledged" VerticalOptions="Center" />
            <Switch Grid.Column="1" IsToggled="{Binding HideAcknowledged}" />
        </Grid>

        <Label Grid.Row="1" Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

        <RefreshView Grid.Row="2" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Alerts}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource Caption}" Text="No open alerts." HorizontalOptions="Center" Margin="0,32" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AlertItem">
                        <SwipeView>
                            <!-- Swipe left: acknowledge (or unacknowledge if it already is). -->
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem Text="Acknowledge"
                                               BackgroundColor="{StaticResource Primary}"
                                               IsVisible="{Binding IsNotAcknowledged}"
                                               Command="{Binding AcknowledgeCommand, Source={RelativeSource AncestorType={x:Type vm:AlertsViewModel}}, x:DataType=vm:AlertsViewModel}"
                                               CommandParameter="{Binding .}" />
                                    <SwipeItem Text="Unacknowledge"
                                               BackgroundColor="{StaticResource WarningColor}"
                                               IsVisible="{Binding IsAcknowledged}"
                                               Command="{Binding UnacknowledgeCommand, Source={RelativeSource AncestorType={x:Type vm:AlertsViewModel}}, x:DataType=vm:AlertsViewModel}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border Style="{StaticResource Card}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenDeviceCommand, Source={RelativeSource AncestorType={x:Type vm:AlertsViewModel}}, x:DataType=vm:AlertsViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="6,*,Auto" ColumnSpacing="12">
                                    <BoxView Color="{Binding Severity, Converter={StaticResource StatusColor}}" CornerRadius="3" />
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="{Binding Rule}" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding Device}" LineBreakMode="TailTruncation" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding Summary}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding SeverityText}" VerticalOptions="Start"
                                           TextColor="{Binding Severity, Converter={StaticResource StatusColor}}" />
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
