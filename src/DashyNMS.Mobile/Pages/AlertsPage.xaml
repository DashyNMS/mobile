<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.AlertsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    x:DataType="vm:AlertsViewModel"
    Title="Alerts">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Logs" Command="{Binding OpenLogsCommand}" />
        <ToolbarItem Text="Export" Command="{Binding ExportCsvCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16,8,16,0">

        <SearchBar Text="{Binding SearchText}" Placeholder="Device, rule, note or alert id" />

        <!-- Desktop's filter chips. Counts are of open alerts, whatever's filtered. -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,6,0,0">
        <HorizontalStackLayout Spacing="8">
            <Button Style="{StaticResource Chip}"
                    Text="{Binding CriticalCount, StringFormat='Critical {0}'}"
                    Command="{Binding ToggleCriticalCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowCritical}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource CriticalTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource CriticalStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Style="{StaticResource Chip}"
                    Text="{Binding WarningCount, StringFormat='Warning {0}'}"
                    Command="{Binding ToggleWarningCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowWarning}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource WarningTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource WarningStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WarningTextLight}, Dark={StaticResource WarningTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <!-- LibreNMS's ok severity (#64). -->
            <Button Style="{StaticResource Chip}"
                    Text="{Binding OkCount, StringFormat='OK {0}'}"
                    Command="{Binding ToggleOkCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowOk}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource OkTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource OkStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OkTextLight}, Dark={StaticResource OkTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Style="{StaticResource Chip}"
                    Text="{Binding AcknowledgedCount, StringFormat='Acknowledged {0}'}"
                    Command="{Binding ToggleAcknowledgedCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowAcknowledged}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="4,6,0,2">
            <Label Style="{StaticResource Caption}" Text="{Binding CountText}" VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="Clear"
                    Command="{Binding ClearFiltersCommand}"
                    IsVisible="{Binding HasActiveFilters}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                    Padding="8,0"
                    HeightRequest="30"
                    MinimumHeightRequest="30" />
        </Grid>

        <Label Grid.Row="3" Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

        <controls:LoadingIndicator Grid.Row="4" IsVisible="{Binding IsLoadingFirstTime}" InputTransparent="True" ZIndex="1" />
        <RefreshView Grid.Row="4" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Alerts}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" IsVisible="{Binding IsNotBusy}" HorizontalOptions="Center" Margin="0,32" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AlertItem">
                        <SwipeView>
                            <!-- Swipe left: acknowledge (or unacknowledge if it already is). -->
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem Text="Acknowledge"
                                               BackgroundColor="{StaticResource OkTextLight}"
                                               IsVisible="{Binding IsNotAcknowledged}"
                                               Command="{Binding AcknowledgeCommand, Source={RelativeSource AncestorType={x:Type vm:AlertsViewModel}}, x:DataType=vm:AlertsViewModel}"
                                               CommandParameter="{Binding .}" />
                                    <SwipeItem Text="Unacknowledge"
                                               BackgroundColor="{StaticResource WarningColor}"
                                               IsVisible="{Binding IsAcknowledged}"
                                               Command="{Binding UnacknowledgeCommand, Source={RelativeSource AncestorType={x:Type vm:AlertsViewModel}}, x:DataType=vm:AlertsViewModel}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border Style="{StaticResource Card}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenAlertCommand, Source={RelativeSource AncestorType={x:Type vm:AlertsViewModel}}, x:DataType=vm:AlertsViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <!-- As the mock-ups: a status dot, the device, then the rule. -->
                                <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="12">
                                    <Ellipse Style="{StaticResource Dot}" Fill="{Binding Severity, Converter={StaticResource StatusColor}}"
                                             VerticalOptions="Start" Margin="0,6,0,0" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                        <Label Style="{StaticResource RowTitle}" Text="{Binding Device}" />
                                        <Label Text="{Binding Rule}" FontSize="14" LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource Gray100}}" />
                                        <Label Style="{StaticResource Faint}" Text="{Binding Summary}" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding Note}" FontAttributes="Italic"
                                               LineBreakMode="TailTruncation" MaxLines="2"
                                               IsVisible="{Binding HasNote}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalOptions="Start"
                                            BackgroundColor="{Binding Severity, Converter={StaticResource StatusTint}}">
                                        <Label Style="{StaticResource PillText}" Text="{Binding SeverityText}"
                                               TextColor="{Binding Severity, Converter={StaticResource StatusText}}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
