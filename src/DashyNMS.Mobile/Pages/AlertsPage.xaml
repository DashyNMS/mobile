<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.AlertsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    x:DataType="vm:AlertsViewModel"
    SafeAreaEdges="Container"
    Title="Alerts">

    <!-- On an iPad or a Mac, the alert you tap shows beside the list (#88). -->
    <!-- On iOS the list runs on down to the foot of the tab bar, under a
         bottom one, and the chips scroll in from under the camera, as on
         Devices; what can be tapped is placed clear of the camera and the
         glass from the page (see CoveredEdges), so nothing here keeps clear
         of the safe area on its own. -->
    <controls:ListDetail x:Name="Split" Placeholder="Choose an alert to see it here." SafeAreaEdges="None">

    <Grid x:Name="ListColumn" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" SafeAreaEdges="None">

        <controls:PageHeader x:Name="Header" Note="{Binding Offline.OfflineText}" Title="Alerts" Margin="16,0,16,0">
            <controls:PageHeader.Actions>
                <!-- Where there's no glass by the tab bar (Android, iOS before 26):
                     icons only, so the title keeps its line on a narrow phone. -->
                <HorizontalStackLayout x:Name="HeaderActions" Spacing="4" SafeAreaEdges="None">
                    <controls:IconButton Kind="Plain" Icon="{x:Static controls:Icons.Search}" Command="{Binding ToggleSearchCommand}"
                                         IsOn="{Binding IsSearchOpen}" SemanticProperties.Description="Search alerts" />
                    <controls:IconButton Kind="Plain" Icon="{x:Static controls:Icons.Export}" Command="{Binding ExportCsvCommand}"
                                         SemanticProperties.Description="Export as CSV" />
                </HorizontalStackLayout>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!-- Search when asked for (the glass button by the tab bar, or the
             header's icon): a field that slides down from beneath the title,
             the chips and list easing down with it, and back up when done
             (see the page). Clipped, so it comes from under the title. -->
        <Grid x:Name="SearchSlot" Grid.Row="1" HeightRequest="0" IsClippedToBounds="True" SafeAreaEdges="None">
            <!-- A text box rather than a SearchBar: UISearchBar draws its own
                 grey field, which sat inside this one as a box in a box. -->
            <Border x:Name="SearchField" Margin="16,4,16,8" Padding="14,0,4,0" VerticalOptions="Start" HeightRequest="46"
                    IsVisible="False" StrokeThickness="1" SafeAreaEdges="None"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource ChipStrokeDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="23" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="2" SafeAreaEdges="None">
                    <!-- Icons.Search, in the placeholder's colour. -->
                    <Path Data="M10.5 4A6.5 6.5 0 1 0 10.5 17A6.5 6.5 0 1 0 10.5 4Z M15.5 15.5 20 20" StrokeThickness="2" StrokeLineCap="Round"
                          WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" InputTransparent="True"
                          Stroke="{AppThemeBinding Light={StaticResource TextFaintLight}, Dark={StaticResource TextFaintDark}}" />
                    <Entry x:Name="Search" Grid.Column="1" Text="{Binding SearchText}" Placeholder="Search alerts" VerticalOptions="Center"
                           ReturnType="Search" ClearButtonVisibility="Never" Completed="OnSearchCompleted"
                           IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" MinimumHeightRequest="40" />
                </Grid>
            </Border>
        </Grid>

        <VerticalStackLayout x:Name="Notices" Grid.Row="2" Padding="16,0,16,0" SafeAreaEdges="None">
            <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
            <Label Style="{StaticResource Faint}" Text="{Binding NavigationNotice}" IsVisible="{Binding NavigationNotice, Converter={StaticResource IsNotNull}}" />
            <!-- How the last bulk action went: "Acknowledged 12 of 14 alerts. 2 failed: …" -->
            <Label Style="{StaticResource Caption}" Text="{Binding Selection.ResultText}" IsVisible="{Binding Selection.HasResult}"
                   Margin="4,0,4,6" />
            <!-- The token isn't allowed to acknowledge (#144): the swipe actions are gone, so say why. -->
            <Label Style="{StaticResource Caption}" Text="{Binding AcknowledgeRefusedText}"
                   IsVisible="{Binding AcknowledgeRefusedText, Converter={StaticResource IsNotNull}}" Margin="4,0,4,6" />
        </VerticalStackLayout>

        <!-- Desktop's filter chips. Counts are of open alerts, whatever's filtered.
             The strip reaches the screen's edge, so a chip scrolls in from under
             the camera; its padding (from the page) lets the last one scroll clear. -->
        <ScrollView x:Name="ChipStrip" Grid.Row="3" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="16,6,16,0" SafeAreaEdges="None">
        <HorizontalStackLayout Spacing="8" SafeAreaEdges="None">
            <Button Style="{StaticResource Chip}"
                    Text="{Binding CriticalCount, StringFormat='Critical {0}'}"
                    Command="{Binding ToggleCriticalCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowCritical}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource CriticalTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource CriticalStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Style="{StaticResource Chip}"
                    Text="{Binding WarningCount, StringFormat='Warning {0}'}"
                    Command="{Binding ToggleWarningCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowWarning}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource WarningTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource WarningStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WarningTextLight}, Dark={StaticResource WarningTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <!-- LibreNMS's ok severity (#64). -->
            <Button Style="{StaticResource Chip}"
                    Text="{Binding OkCount, StringFormat='OK {0}'}"
                    Command="{Binding ToggleOkCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowOk}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource OkTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource OkStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OkTextLight}, Dark={StaticResource OkTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Style="{StaticResource Chip}"
                    Text="{Binding AcknowledgedCount, StringFormat='Acknowledged {0}'}"
                    Command="{Binding ToggleAcknowledgedCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ShowAcknowledged}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </HorizontalStackLayout>
        </ScrollView>

        <!-- Its height kept while the count is still blank, so the chips never touch the list (#143).
             Under the count, what the chips don't show: a search put away, or
             the one group a notification opened - so a shortened list says why. -->
        <Grid x:Name="CountLine" Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="4" Margin="20,6,16,2" MinimumHeightRequest="30" SafeAreaEdges="None">
            <VerticalStackLayout VerticalOptions="Center" SafeAreaEdges="None">
                <Label Style="{StaticResource Caption}" Text="{Binding CountText}" />
                <Label Style="{StaticResource Faint}" Text="{Binding FiltersText}" IsVisible="{Binding HasFiltersText}" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="Clear"
                    Command="{Binding ClearFiltersCommand}"
                    IsVisible="{Binding HasActiveFilters}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                    Padding="8,0" HeightRequest="30" MinimumHeightRequest="30" VerticalOptions="Center" />
        </Grid>

        <!-- Loading the first time, or after a pull: the busy card over the list (#111). -->
        <controls:BusyCard x:Name="Busy" Grid.Row="5" ZIndex="1" IsVisible="False" />
        <!-- The rows share one card, as the mock-ups group them (#69). It runs
             on down to the tab bar's foot (margin from the page), as Devices'
             does; under a bottom tab bar the rows scroll beneath it, and the
             footer lets the last one scroll clear. -->
        <Border x:Name="ListCard" Grid.Row="5" Grid.RowSpan="2" Style="{StaticResource ListCard}" Margin="16,0,16,12" SafeAreaEdges="None">
            <RefreshView x:Name="PullRefresh" Command="{Binding RefreshCommand}" SafeAreaEdges="None">
                <CollectionView Margin="0,-1,0,0" ItemsSource="{Binding DisplayRows}" SelectionMode="None" x:Name="List">
                    <CollectionView.EmptyView>
                        <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" IsVisible="{Binding IsNotBusy}" HorizontalOptions="Center" Margin="0,32" />
                    </CollectionView.EmptyView>
                    <CollectionView.Footer>
                        <BoxView x:Name="ListFoot" HeightRequest="0" Color="Transparent" />
                    </CollectionView.Footer>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AlertItem">
                            <SwipeView Threshold="96" SafeAreaEdges="None">
                                <!-- Swipe left to show Acknowledge (or Unacknowledge), then tap it: revealing rather
                                     than acting, so a stray sideways scroll can't acknowledge anything. -->
                                <!-- The labels name the action's scope beside the glyphs, also read by VoiceOver. -->
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                                        <SwipeItemView IsVisible="{Binding ShowAcknowledge}"
                                                       Command="{Binding AcknowledgeCommand, Source={RelativeSource AncestorType={x:Type vm:AlertsViewModel}}, x:DataType=vm:AlertsViewModel}"
                                                       CommandParameter="{Binding .}"
                                                       SemanticProperties.Description="{Binding AcknowledgeLabel}">
                                            <Grid WidthRequest="112" BackgroundColor="{StaticResource OkTextLight}" RowDefinitions="Auto,Auto" RowSpacing="4" Padding="6,10">
                                                <Image Source="icon_acknowledge.png" WidthRequest="26" HeightRequest="26"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                                <Label Grid.Row="1" Text="{Binding AcknowledgeLabel}" FontSize="12" TextColor="White" HorizontalTextAlignment="Center" />
                                            </Grid>
                                        </SwipeItemView>
                                        <SwipeItemView IsVisible="{Binding ShowUnacknowledge}"
                                                       Command="{Binding UnacknowledgeCommand, Source={RelativeSource AncestorType={x:Type vm:AlertsViewModel}}, x:DataType=vm:AlertsViewModel}"
                                                       CommandParameter="{Binding .}"
                                                       SemanticProperties.Description="{Binding UnacknowledgeLabel}">
                                            <Grid WidthRequest="112" BackgroundColor="{StaticResource WarningTextLight}" RowDefinitions="Auto,Auto" RowSpacing="4" Padding="6,10">
                                                <Image Source="icon_unacknowledge.png" WidthRequest="26" HeightRequest="26"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                                <Label Grid.Row="1" Text="{Binding UnacknowledgeLabel}" FontSize="12" TextColor="White" HorizontalTextAlignment="Center" />
                                            </Grid>
                                        </SwipeItemView>
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" RowDefinitions="*,Auto" ColumnSpacing="12"
                                      controls:LongPress.Command="{Binding HoldCommand, Source={RelativeSource AncestorType={x:Type vm:AlertsViewModel}}, x:DataType=vm:AlertsViewModel}"
                                      controls:LongPress.CommandParameter="{Binding .}"
                                      SemanticProperties.Hint="{Binding InteractionHint}">
                                    <!-- Press and hold starts selecting several, with this one ticked (#85). -->
                                    <!-- Tinted while its detail shows beside the list (#88); the card beneath shows through. -->
                                    <Grid.Triggers>
                                        <DataTrigger TargetType="Grid" Binding="{Binding IsFaultChild}" Value="True">
                                            <Setter Property="Margin" Value="20,0,0,0" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                                        </DataTrigger>
                                    </Grid.Triggers>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding OpenAlertCommand, Source={RelativeSource AncestorType={x:Type vm:AlertsViewModel}}, x:DataType=vm:AlertsViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <!-- As Devices' rows: a status dot, the device, the rule, then at the
                                         right the severity in words - not only its colour - over the age. -->
                                    <Ellipse Style="{StaticResource Dot}" Fill="{Binding Severity, Converter={StaticResource StatusColor}}"
                                             VerticalOptions="Start" Margin="0,6,0,0"
                                             IsVisible="{Binding Selection.IsOff, Source={RelativeSource AncestorType={x:Type vm:AlertsViewModel}}, x:DataType=vm:AlertsViewModel}" />
                                    <!-- Selecting (#85): a tick circle where the dot was. -->
                                    <controls:TickCircle IsTicked="{Binding IsTicked}" VerticalOptions="Start"
                                                         IsVisible="{Binding Selection.IsSelecting, Source={RelativeSource AncestorType={x:Type vm:AlertsViewModel}}, x:DataType=vm:AlertsViewModel}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                        <Label Style="{StaticResource RowTitle}" Text="{Binding Device}" />
                                        <Label Text="{Binding RowRule}" FontSize="14" LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource Gray100}}" />
                                        <Label Style="{StaticResource Faint}" Text="{Binding MetaText}" />
                                        <Label Style="{StaticResource Faint}" Text="{Binding GroupTimesText}" IsVisible="{Binding IsGroupHeader}" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding ActionRefusedText}" IsVisible="{Binding ActionRefusedText, Converter={StaticResource IsNotNull}}" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding Note}" FontAttributes="Italic"
                                               LineBreakMode="TailTruncation" MaxLines="2"
                                               IsVisible="{Binding HasNote}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Start" Margin="0,2,0,0">
                                        <Label Text="{Binding SeverityText}" HorizontalOptions="End" FontFamily="BodySemibold" FontSize="13"
                                               TextColor="{Binding Severity, Converter={StaticResource StatusText}}" />
                                        <Label Style="{StaticResource Faint}" Text="{Binding ShortAge}" HorizontalOptions="End" />
                                        <!-- An alert group opens and closes in place: a chevron turned
                                             down while its faults show, rather than a line saying so. -->
                                        <Path Data="M9 6 15 12 9 18" StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                                              WidthRequest="16" HeightRequest="16" Aspect="Uniform" HorizontalOptions="End" Margin="0,4,0,0"
                                              Stroke="{AppThemeBinding Light={StaticResource TextFaintLight}, Dark={StaticResource TextFaintDark}}"
                                              IsVisible="{Binding IsGroupHeader}" InputTransparent="True"
                                              SemanticProperties.Description="{Binding ExpansionText}">
                                            <Path.Triggers>
                                                <DataTrigger TargetType="Path" Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Rotation" Value="90" />
                                                </DataTrigger>
                                            </Path.Triggers>
                                        </Path>
                                    </VerticalStackLayout>
                                    <!-- The bottom padding; the line itself is at the top of the row (#120). -->
                                    <BoxView Grid.Row="1" Grid.ColumnSpan="3" HeightRequest="1" Margin="0,11,0,0" Color="Transparent" />
                                    <BoxView Grid.ColumnSpan="3" Style="{StaticResource RowLine}" />
                                </Grid>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Border>

        <!-- Selecting (#85): how many, select all, and what to do with them -
             risen over the foot of the list, level with a side tab bar's (see the page). -->
        <controls:BulkBar x:Name="Bulk" Grid.Row="6" Summary="{Binding Selection.Summary}" Progress="{Binding Selection.ProgressText}"
                          SelectAllText="{Binding SelectAllText}" SelectAllCommand="{Binding SelectAllCommand}"
                          DoneCommand="{Binding StopSelectingCommand}" IsVisible="False" Margin="16,6,16,12" SafeAreaEdges="None">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" SafeAreaEdges="None">
                <Button Text="Acknowledge" Command="{Binding AcknowledgeSelectedCommand}" IsEnabled="{Binding Selection.CanAct}"
                        IsVisible="{Binding CanAcknowledge}" />
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Text="Unacknowledge"
                        Command="{Binding UnacknowledgeSelectedCommand}" IsEnabled="{Binding Selection.CanAct}"
                        IsVisible="{Binding CanAcknowledge}" />
                <Label Grid.ColumnSpan="2" Style="{StaticResource Caption}" Text="{Binding AcknowledgeRefusedText}"
                       IsVisible="{Binding AcknowledgeRefusedText, Converter={StaticResource IsNotNull}}" VerticalOptions="Center" />
            </Grid>
        </controls:BulkBar>

    </Grid>
    </controls:ListDetail>

</ContentPage>
