<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="DashyNMS.Mobile.Pages.NeighbourGroupsPage"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
 xmlns:topo="clr-namespace:DashyNMS.Mobile.Topology;assembly=DashyNMS.Mobile.Shared"
 x:DataType="topo:NeighbourGroupsViewModel" SafeAreaEdges="All" Title="Neighbourhoods">
 <Grid x:Name="Body" SafeAreaEdges="None" RowDefinitions="Auto,Auto,Auto,*" Padding="16,0">
  <controls:BackBar x:Name="TopBar">
   <controls:BackBar.Actions><Button Text="Add" Style="{StaticResource LinkButton}" Command="{Binding AddCommand}" MinimumHeightRequest="44" /></controls:BackBar.Actions>
  </controls:BackBar>
  <Label Grid.Row="1" Style="{StaticResource PageTitle}" Text="Neighbourhoods" SemanticProperties.HeadingLevel="Level1" />
  <VerticalStackLayout Grid.Row="2" Spacing="6">
   <Label Style="{StaticResource Caption}" Text="Group neighbours by their announced name, description, port or protocol, or the switch and port they use. These use desktop's neighbour view definitions. Reordering and deletion save immediately." />
   <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
   <Button Text="Retry neighbour counts" MinimumHeightRequest="44" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource SecondaryButton}" Command="{Binding RetryCountsCommand}" IsVisible="{Binding HasError}" />
  </VerticalStackLayout>
  <Grid Grid.Row="3" SafeAreaEdges="None">
   <RefreshView x:Name="PullRefresh" SafeAreaEdges="None" Command="{Binding RetryCountsCommand}">
    <CollectionView x:Name="List" ItemsSource="{Binding Groups}" SelectionMode="None">
     <CollectionView.Header><BoxView HeightRequest="20" Color="Transparent" /></CollectionView.Header>
     <CollectionView.Footer><BoxView x:Name="ListFoot" Color="Transparent" /></CollectionView.Footer>
     <CollectionView.EmptyView><Label Margin="0,20,0,16" Style="{StaticResource Caption}" Text="No neighbourhoods yet. Use Add to group neighbours by what they announce." /></CollectionView.EmptyView>
     <CollectionView.ItemTemplate>
      <DataTemplate x:DataType="topo:NeighbourGroupRow">
       <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14">
        <VerticalStackLayout Spacing="6">
         <Label Style="{StaticResource RowTitle}" Text="{Binding Name}" LineBreakMode="WordWrap" />
         <Label Style="{StaticResource Caption}" Text="{Binding Summary}" LineBreakMode="WordWrap" />
         <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
          <Button Text="Edit" MinimumHeightRequest="44" Style="{StaticResource SecondaryButton}"
           SemanticProperties.Description="{Binding Name, StringFormat='Edit neighbourhood {0}'}"
           Command="{Binding EditCommand, Source={RelativeSource AncestorType={x:Type topo:NeighbourGroupsViewModel}}, x:DataType=topo:NeighbourGroupsViewModel}" CommandParameter="{Binding .}" />
          <Button Grid.Column="1" Text="More" MinimumHeightRequest="44" Style="{StaticResource SecondaryButton}"
           SemanticProperties.Description="{Binding Name, StringFormat='More actions for neighbourhood {0}'}" Clicked="OnMore" />
         </Grid>
        </VerticalStackLayout>
       </Border>
      </DataTemplate>
     </CollectionView.ItemTemplate>
    </CollectionView>
   </RefreshView>
   <BoxView HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
    <BoxView.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
     <GradientStop Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" Offset="0" />
     <GradientStop Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" Offset="1" />
    </LinearGradientBrush></BoxView.Background>
   </BoxView>
   <controls:BusyCard x:Name="Busy" Text="Loading neighbour counts…" IsVisible="{Binding IsBusy}" VerticalOptions="Center" />
  </Grid>
 </Grid>
</ContentPage>
