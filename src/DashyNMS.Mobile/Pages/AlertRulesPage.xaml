<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.AlertRulesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:rules="clr-namespace:DashyNMS.Mobile.Rules;assembly=DashyNMS.Mobile.Shared"
    x:DataType="rules:AlertRulesViewModel"
    SafeAreaEdges="Container"
    Title="Alert rules">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16,8,16,0">

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Button Style="{StaticResource Chip}" Text="Alerting now" Command="{Binding ToggleAlertingCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding OnlyAlerting}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Label Grid.Column="1" Style="{StaticResource Caption}" Text="{Binding Summary}" VerticalOptions="Center" HorizontalTextAlignment="End" />
        </Grid>

        <SearchBar Grid.Row="1" Text="{Binding SearchText}" Placeholder="Search rules" Margin="0,6,0,0" />

        <Label Grid.Row="2" Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

        <RefreshView Grid.Row="3" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Rules}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,32" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <!-- Read-only (#22): the rule, where it applies, its condition on one line, and what it has alerting. -->
                    <DataTemplate x:DataType="rules:AlertRuleItem">
                        <Border Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type rules:AlertRulesViewModel}}, x:DataType=rules:AlertRulesViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="10,*,Auto,Auto" ColumnSpacing="12">
                                <Ellipse Style="{StaticResource Dot}" Fill="{Binding Severity, Converter={StaticResource StatusColor}}" VerticalOptions="Start" Margin="0,6,0,0">
                                    <Ellipse.Triggers>
                                        <DataTrigger TargetType="Ellipse" Binding="{Binding IsDisabled}" Value="True">
                                            <Setter Property="Opacity" Value="0.35" />
                                        </DataTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Name}" FontFamily="BodySemibold" LineBreakMode="TailTruncation" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Summary}" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Condition}" FontFamily="Mono" FontSize="12" LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding AlertingText}" IsVisible="{Binding IsAlerting}" FontSize="13" VerticalOptions="Center"
                                       TextColor="{Binding Severity, Converter={StaticResource StatusText}}" />
                                <Label Grid.Column="3" Text="›" FontSize="20" VerticalOptions="Center" Style="{StaticResource Caption}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
