<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.AlertRulesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:rules="clr-namespace:DashyNMS.Mobile.Rules;assembly=DashyNMS.Mobile.Shared"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    x:DataType="rules:AlertRulesViewModel"
    ios:Page.UseSafeArea="True"
    SafeAreaEdges="Container"
    Title="Alert rules">

    <!-- On an iPad or a Mac, the rule you tap shows beside the list (#88, #122). -->
    <controls:ListDetail x:Name="Split" Placeholder="Choose a rule to see it here.">

    <!-- As the other lists (#122): search that slides away, the chips, a count, then the rules in one card. -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Padding="16,8,16,0">

        <controls:PageHeader x:Name="Header" Title="Alert rules" />

        <!-- Slides out when the list is scrolled back up or pulled down - see SearchReveal. -->
        <Grid Grid.Row="1" x:Name="SearchSlot" IsClippedToBounds="True">
            <SearchBar x:Name="Search" Text="{Binding SearchText}" Placeholder="Search rules" Margin="-6,2,-6,0" />
        </Grid>

        <!-- Alerting, a divider, then the severities and Disabled - on to start, tapped off to hide. -->
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,10,0,0">
            <HorizontalStackLayout Spacing="8">
                <Button Style="{StaticResource Chip}" Text="{Binding AlertingCount, StringFormat='Alerting {0}'}" Command="{Binding ToggleAlertingCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding OnlyAlerting}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <BoxView WidthRequest="1" HeightRequest="20" VerticalOptions="Center" Margin="2,0"
                         Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource ChipStrokeDark}}" />
                <Button Style="{StaticResource Chip}" Text="{Binding CriticalCount, StringFormat='Critical {0}'}" Command="{Binding ToggleCriticalCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowCritical}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource CriticalTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource CriticalStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Style="{StaticResource Chip}" Text="{Binding WarningCount, StringFormat='Warning {0}'}" Command="{Binding ToggleWarningCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowWarning}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource WarningTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource WarningStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WarningTextLight}, Dark={StaticResource WarningTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Style="{StaticResource Chip}" Text="{Binding DisabledCount, StringFormat='Disabled {0}'}" Command="{Binding ToggleDisabledCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowDisabled}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource InactiveTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource InactiveStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InactiveTextLight}, Dark={StaticResource InactiveTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Shown, blank, while loading: its height is the gap between the chips and the list (#143). -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="4,6,0,4" MinimumHeightRequest="30">
            <Label Style="{StaticResource Faint}" Text="{Binding Summary}" VerticalOptions="Center" />
            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Text="Clear"
                    Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}"
                    HeightRequest="30" MinimumHeightRequest="30" />
        </Grid>

        <!-- LibreNMS's reason when the fetch fails, in a card of its own. -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8" IsVisible="{Binding HasError}"
                BackgroundColor="{StaticResource CriticalTint}" Stroke="{StaticResource CriticalStroke}">
            <Label Text="{Binding ErrorMessage}" FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
        </Border>

        <!-- Loading the first time, or after a pull: the busy card over the list (#111). -->
        <controls:BusyCard x:Name="Busy" Grid.Row="5" ZIndex="1" IsVisible="False" />
        <Border Grid.Row="5" Style="{StaticResource ListCard}" Margin="0,0,0,12">
            <RefreshView x:Name="PullRefresh" Command="{Binding RefreshCommand}">
                <CollectionView Margin="0,-1,0,0" x:Name="List" ItemsSource="{Binding Rules}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="8" Padding="20,32" IsVisible="{Binding IsEmpty}">
                            <Label Text="{Binding EmptyTitle}" FontFamily="BodySemibold" HorizontalTextAlignment="Center" />
                            <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" HorizontalTextAlignment="Center" />
                            <Button Style="{StaticResource LinkButton}" Text="Clear filters" HorizontalOptions="Center"
                                    Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <!-- Read-only (#22): a severity dot, the rule, its condition on one line,
                             where it applies and its template, and what it has alerting. -->
                        <DataTemplate x:DataType="rules:AlertRuleItem">
                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" RowDefinitions="*,Auto" ColumnSpacing="12">
                                <!-- A disabled rule is dimmed - kept, but quieter. -->
                                <Grid.Triggers>
                                    <DataTrigger TargetType="Grid" Binding="{Binding IsDisabled}" Value="True">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                </Grid.Triggers>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type rules:AlertRulesViewModel}}, x:DataType=rules:AlertRulesViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Ellipse Style="{StaticResource Dot}" Fill="{Binding Severity, Converter={StaticResource StatusColor}}"
                                         VerticalOptions="Start" Margin="0,6,0,0" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Style="{StaticResource RowTitle}" Text="{Binding Name}" />
                                    <Label Text="{Binding Condition}" FontFamily="Mono" FontSize="12.5" LineBreakMode="TailTruncation" MaxLines="1"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource Gray100}}" />
                                    <Label Style="{StaticResource Faint}" Text="{Binding DetailText}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Style="{StaticResource Faint}" Text="{Binding AlertingText}" IsVisible="{Binding IsAlerting}"
                                       TextColor="{Binding Severity, Converter={StaticResource StatusText}}" VerticalOptions="Start" Margin="0,2,0,0" />
                                <!-- The bottom padding; the line itself is at the top of the row (#120). -->
                                <BoxView Grid.Row="1" Grid.ColumnSpan="3" HeightRequest="1" Margin="0,11,0,0" Color="Transparent" />
                                <BoxView Grid.ColumnSpan="3" Style="{StaticResource RowLine}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Border>

    </Grid>

    </controls:ListDetail>

</ContentPage>
