<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.AlertRulesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:rules="clr-namespace:DashyNMS.Mobile.Rules;assembly=DashyNMS.Mobile.Shared"
    x:DataType="rules:AlertRulesViewModel"
    SafeAreaEdges="All"
    HideSoftInputOnTapped="True"
    Title="Alert rules">

    <!-- On an iPad or a Mac, the rule you tap shows beside the list (#88, #122). -->
    <controls:ListDetail SafeAreaEdges="None" x:Name="Split" Placeholder="Choose a rule to see it here.">

    <!-- Button-only search, chips, count, then rules in one card. -->
    <Grid x:Name="Body" SafeAreaEdges="None" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Padding="16,0,16,0">

        <controls:PageHeader x:Name="Header" Title="Alert rules">
            <controls:PageHeader.Actions>
            <controls:IconButton x:Name="SearchButton" Kind="Plain" Icon="{x:Static controls:Icons.Search}" SemanticProperties.Description="Search rules" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!-- Opens only from search actions; filtering must keep keyboard focus. -->
        <Grid SafeAreaEdges="None" Grid.Row="1" x:Name="SearchSlot" IsClippedToBounds="True">
            <controls:SearchField x:Name="SearchField" Margin="0,2,0,0">
                <Entry x:Name="Search" Text="{Binding SearchText}" Placeholder="Search rules" Completed="OnSearchCompleted" />
            </controls:SearchField>
        </Grid>

        <!-- Alerting, a divider, then the severities and Disabled - on to start, tapped off to hide. -->
        <ScrollView SafeAreaEdges="None" Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,10,0,0">
            <HorizontalStackLayout Spacing="8">
                <Button Style="{StaticResource Chip}" HeightRequest="-1" MinimumHeightRequest="44" Padding="14,8" CornerRadius="22" SemanticProperties.Description="{Binding AlertingFilterDescription}" Text="{Binding AlertingCount, StringFormat='Alerting {0}'}" Command="{Binding ToggleAlertingCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding OnlyAlerting}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <BoxView WidthRequest="1" HeightRequest="20" VerticalOptions="Center" Margin="2,0"
                         Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource ChipStrokeDark}}" />
                <Button Style="{StaticResource Chip}" HeightRequest="-1" MinimumHeightRequest="44" Padding="14,8" CornerRadius="22" SemanticProperties.Description="{Binding CriticalFilterDescription}" Text="{Binding CriticalCount, StringFormat='Critical {0}'}" Command="{Binding ToggleCriticalCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowCritical}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource CriticalTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource CriticalStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Style="{StaticResource Chip}" HeightRequest="-1" MinimumHeightRequest="44" Padding="14,8" CornerRadius="22" SemanticProperties.Description="{Binding WarningFilterDescription}" Text="{Binding WarningCount, StringFormat='Warning {0}'}" Command="{Binding ToggleWarningCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowWarning}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource WarningTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource WarningStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WarningTextLight}, Dark={StaticResource WarningTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Style="{StaticResource Chip}" HeightRequest="-1" MinimumHeightRequest="44" Padding="14,8" CornerRadius="22" SemanticProperties.Description="{Binding DisabledFilterDescription}" Text="{Binding DisabledCount, StringFormat='Disabled {0}'}" Command="{Binding ToggleDisabledCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowDisabled}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource InactiveTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource InactiveStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InactiveTextLight}, Dark={StaticResource InactiveTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Shown, blank, while loading: its height is the gap between the chips and the list (#143). -->
        <Grid SafeAreaEdges="None" Grid.Row="3" ColumnDefinitions="*,Auto" Margin="4,6,0,4" MinimumHeightRequest="30">
            <Label Style="{StaticResource Faint}" Text="{Binding Summary}" VerticalOptions="Center" />
            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Text="Clear"
                    Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}"
                    MinimumHeightRequest="44" />
        </Grid>

        <!-- LibreNMS's reason when the fetch fails, in a card of its own. -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8" IsVisible="{Binding HasError}"
                BackgroundColor="{StaticResource CriticalTint}" Stroke="{StaticResource CriticalStroke}">
            <Label Text="{Binding ErrorMessage}" FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
        </Border>

        <!-- Loading the first time, or after a pull: the busy card over the list (#111). -->
        <controls:BusyCard x:Name="Busy" Grid.Row="5" ZIndex="1" IsVisible="False" />
        <Border SafeAreaEdges="None" x:Name="ListCard" Grid.Row="5" Style="{StaticResource ListCard}" Margin="0,0,0,12">
            <Grid SafeAreaEdges="None">
            <RefreshView SafeAreaEdges="None" x:Name="PullRefresh" Command="{Binding RefreshCommand}">
                <CollectionView controls:KeyboardDismiss.OnScroll="False" Margin="0,-1,0,0" x:Name="List" ItemsSource="{Binding Rules}" SelectionMode="None">
                    <CollectionView.Header><BoxView HeightRequest="20" Color="Transparent" /></CollectionView.Header>
                    <CollectionView.Footer><BoxView x:Name="ListFoot" Color="Transparent" /></CollectionView.Footer>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="8" Padding="20,32" IsVisible="{Binding IsEmpty}">
                            <Label Text="{Binding EmptyTitle}" FontFamily="BodySemibold" HorizontalTextAlignment="Center" />
                            <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" HorizontalTextAlignment="Center" />
                            <Button Style="{StaticResource LinkButton}" Text="Clear filters" HorizontalOptions="Center"
                                    Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <!-- Read-only (#22): severity, the rule and complete wrapping condition,
                             where it applies and its template, and what it has alerting. -->
                        <DataTemplate x:DataType="rules:AlertRuleItem">
                            <Grid Padding="14,11" Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*" ColumnSpacing="12"
                                  SemanticProperties.Description="{Binding AccessibleDescription}" SemanticProperties.Hint="Opens this alert rule">
                                <Grid.Triggers>
                                    <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                                    </DataTrigger>
                                </Grid.Triggers>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type rules:AlertRulesViewModel}}, x:DataType=rules:AlertRulesViewModel}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Ellipse Style="{StaticResource Dot}" Fill="{Binding Severity, Converter={StaticResource StatusColor}}" AutomationProperties.IsInAccessibleTree="False" />
                                <VerticalStackLayout Grid.Column="1" Spacing="4" AutomationProperties.ExcludedWithChildren="True">
                                    <Label Style="{StaticResource RowTitle}" Text="{Binding Name}" LineBreakMode="WordWrap" />
                                    <Label Text="{Binding Condition}" FontFamily="Mono" FontSize="12.5" LineBreakMode="WordWrap" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding DetailText}" LineBreakMode="WordWrap" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding StateText}" LineBreakMode="WordWrap" />
                                    <Label Text="Selected" IsVisible="{Binding IsSelected}" />
                                </VerticalStackLayout>
                                <BoxView Grid.ColumnSpan="2" Style="{StaticResource RowLine}" InputTransparent="True" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        <BoxView Margin="1,1,1,0" HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
            <BoxView.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" Offset="0" /><GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLightClear}, Dark={StaticResource SurfaceDarkClear}}" Offset="1" /></LinearGradientBrush></BoxView.Background>
        </BoxView>
            </Grid>
        </Border>


    </Grid>

    </controls:ListDetail>

</ContentPage>
