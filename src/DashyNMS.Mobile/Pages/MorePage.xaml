<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.MorePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    x:DataType="vm:MoreViewModel"
    Shell.NavBarIsVisible="False" Title="More" SafeAreaEdges="Container">
    <Grid x:Name="Body" RowDefinitions="Auto,*" SafeAreaEdges="None">
        <controls:PageHeader x:Name="Header" Title="More" />
        <ScrollView x:Name="Scroller" Grid.Row="1" SafeAreaEdges="None">
            <VerticalStackLayout SafeAreaEdges="None" Spacing="8" Padding="0,20,0,0">
                <Label Style="{StaticResource Caption}" Text="Changes save automatically." />
                <Label Style="{StaticResource Caption}" Text="{Binding CapacityText}" />
                <Label Style="{StaticResource Caption}" Text="Dashboard and More always stay. Tabs follow the order below." />
                <!-- This is a fixed catalogue of eleven pages, not server results. -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:MoreGroup">
                            <VerticalStackLayout Spacing="4" Margin="0,16,0,0">
                                <Label Style="{StaticResource Caption}" FontFamily="BodySemibold" Text="{Binding Name}" SemanticProperties.HeadingLevel="Level2" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MoreItem">
                                            <Grid RowDefinitions="Auto,1" ColumnDefinitions="*,44" ColumnSpacing="8" Padding="0,4,0,0">
                                                <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48">
                                                    <VerticalStackLayout Grid.Column="0" Padding="0,8" Spacing="4" InputTransparent="True" AutomationProperties.ExcludedWithChildren="True">
                                                        <Label Text="{Binding Title}" FontFamily="BodySemibold" LineBreakMode="WordWrap" />
                                                        <Label Style="{StaticResource Caption}" Text="{Binding Summary}" IsVisible="{Binding HasSummary}" LineBreakMode="WordWrap" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="1" Style="{StaticResource Chevron}" InputTransparent="True" AutomationProperties.IsInAccessibleTree="False" Margin="8,0,0,0" />
                                                    <Button Grid.ColumnSpan="2" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Text="" MinimumHeightRequest="48" MinimumWidthRequest="44"
                                                            SemanticProperties.Description="{Binding OpenDescription}"
                                                            SemanticProperties.Hint="{Binding OpenHint}"
                                                            Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:MoreViewModel}}, x:DataType=vm:MoreViewModel}" CommandParameter="{Binding .}">
                                                        <Button.Style><Style TargetType="Button" /></Button.Style>
                                                    </Button>
                                                </Grid>
                                                <Grid Grid.Column="1" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                                                    <shapes:Path Data="{x:Static controls:Icons.Pin}" StrokeThickness="1.8" WidthRequest="24" HeightRequest="24" Aspect="None"
                                                        HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" AutomationProperties.IsInAccessibleTree="False"
                                                        Stroke="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" Fill="Transparent">
                                                        <shapes:Path.Triggers>
                                                            <DataTrigger TargetType="shapes:Path" Binding="{Binding IsPinned}" Value="True">
                                                                <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                                                            </DataTrigger>
                                                        </shapes:Path.Triggers>
                                                    </shapes:Path>
                                                    <Button BackgroundColor="Transparent" BorderWidth="0" Padding="0" Text="" MinimumHeightRequest="44" MinimumWidthRequest="44"
                                                            SemanticProperties.Description="{Binding PinDescription}"
                                                            SemanticProperties.Hint="{Binding PinHint}"
                                                            Command="{Binding TogglePinCommand, Source={RelativeSource AncestorType={x:Type vm:MoreViewModel}}, x:DataType=vm:MoreViewModel}" CommandParameter="{Binding .}">
                                                        <Button.Style><Style TargetType="Button" /></Button.Style>
                                                    </Button>
                                                </Grid>
                                                <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" Color="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}" InputTransparent="True" AutomationProperties.IsInAccessibleTree="False" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <BoxView x:Name="Foot" Color="Transparent" />
            </VerticalStackLayout>
        </ScrollView>
        <BoxView Grid.Row="1" HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" Offset="0" />
                    <GradientStop Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>
    </Grid>
</ContentPage>
