<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.MorePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    x:DataType="vm:MoreViewModel"
    Shell.NavBarIsVisible="False" Title="More">
    <Grid x:Name="Body" RowDefinitions="Auto,*" SafeAreaEdges="None">
        <controls:PageHeader x:Name="Header" Title="More" />
        <ScrollView x:Name="Scroller" Grid.Row="1" SafeAreaEdges="None">
            <VerticalStackLayout SafeAreaEdges="None" Spacing="8" Padding="0,20,0,0">
                <Label Style="{StaticResource Caption}" Text="Changes save automatically." />
                <Label Style="{StaticResource Caption}" Text="{Binding PinnedText}" />
                <Label Style="{StaticResource Caption}" Text="Pin up to three pages to the tab bar. Dashboard and More always stay. Tabs follow the page order below; pinning does not change their order." />
                <!-- This is a fixed catalogue of eleven pages, not server results. -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:MoreGroup">
                            <VerticalStackLayout>
                                <Label Style="{StaticResource SectionHeader}" Text="{Binding Name}" SemanticProperties.HeadingLevel="Level2" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MoreItem">
                                            <Border Style="{StaticResource Card}" Padding="12">
                                                <VerticalStackLayout Spacing="8">
                                                    <Border StrokeThickness="0" BackgroundColor="Transparent" Padding="0,8" MinimumHeightRequest="44"
                                                            SemanticProperties.Description="{Binding OpenDescription}"
                                                            SemanticProperties.Hint="{Binding OpenHint}">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:MoreViewModel}}, x:DataType=vm:MoreViewModel}" CommandParameter="{Binding .}" />
                                                        </Border.GestureRecognizers>
                                                        <VerticalStackLayout AutomationProperties.ExcludedWithChildren="True" Spacing="4">
                                                            <Label Text="{Binding Title}" FontFamily="BodySemibold" LineBreakMode="WordWrap" />
                                                            <Label Style="{StaticResource Caption}" Text="{Binding Description}" LineBreakMode="WordWrap" />
                                                            <Label Style="{StaticResource Caption}" Text="{Binding PinState}" LineBreakMode="WordWrap" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <Button Style="{StaticResource SecondaryButton}" Text="{Binding PinLabel}" MinimumHeightRequest="44"
                                                            SemanticProperties.Description="{Binding PinDescription}"
                                                            SemanticProperties.Hint="{Binding PinHint}"
                                                            Command="{Binding TogglePinCommand, Source={RelativeSource AncestorType={x:Type vm:MoreViewModel}}, x:DataType=vm:MoreViewModel}" CommandParameter="{Binding .}" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <BoxView x:Name="Foot" Color="Transparent" />
            </VerticalStackLayout>
        </ScrollView>
        <BoxView Grid.Row="1" HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" Offset="0" />
                    <GradientStop Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>
    </Grid>
</ContentPage>
