<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:logs="clr-namespace:DashyNMS.Mobile.Logs;assembly=DashyNMS.Mobile.Shared"
    xmlns:sections="clr-namespace:DashyNMS.Mobile.DeviceSections;assembly=DashyNMS.Mobile.Shared"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    x:DataType="logs:LogsViewModel"
    ios:Page.UseSafeArea="True"
    SafeAreaEdges="Container"
    Title="Logs">

    <!-- As the Logs mock-up (#69): Event log / Alert log as a segmented
         control, and the entries in one card with the time at the right. -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16,8,16,0">

        <!-- Graylog has its own page in More, so it isn't repeated here. -->
        <controls:PageHeader x:Name="Header" Title="Logs" />

        <Border Grid.Row="1" Style="{StaticResource SegmentBar}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                <Button Style="{StaticResource Segment}" Text="Event log" FontSize="14" Command="{Binding ShowEventLogCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowingEventLog}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource Segment}" Text="Alert log" FontSize="14" Command="{Binding ShowAlertLogCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowingAlertLog}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </Border>

        <!-- Out of sight until the list is scrolled or pulled down - see SearchReveal. -->
        <SearchBar Grid.Row="2" x:Name="Search" Text="{Binding SearchText}" Placeholder="Search the log" Margin="-6,6,-6,0" />

        <Label Grid.Row="3" Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

        <Border Grid.Row="4" Style="{StaticResource ListCard}" Margin="0,0,0,12">
            <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
                <CollectionView ItemsSource="{Binding Entries}" SelectionMode="None" x:Name="List">
                    <CollectionView.EmptyView>
                        <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="16,32" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="sections:SectionRow">
                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="10,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type logs:LogsViewModel}}, x:DataType=logs:LogsViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Ellipse Style="{StaticResource Dot}" Fill="{Binding Status, Converter={StaticResource StatusColor}}" VerticalOptions="Center" />
                                <!-- Device (and type, user), then the time at the right. -->
                                <Label Grid.Column="1" Style="{StaticResource RowTitle}" Text="{Binding Subtitle}" />
                                <Label Grid.Column="2" Style="{StaticResource Faint}" Text="{Binding Detail}" VerticalOptions="Center" />
                                <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Title}" FontSize="14"
                                       LineBreakMode="WordWrap" MaxLines="3"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource Gray100}}" />
                                <Label Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource PillText}" Text="{Binding Value}"
                                       IsVisible="{Binding HasValue}" Margin="0,2,0,0"
                                       TextColor="{Binding Status, Converter={StaticResource StatusText}}" />
                                <BoxView Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource Divider}" Margin="0,11,0,0" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.Footer>
                        <Button Style="{StaticResource SecondaryButton}" Text="Load more" Command="{Binding LoadMoreCommand}"
                                IsVisible="{Binding CanLoadMore}" Margin="14,12" />
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>
        </Border>

    </Grid>

</ContentPage>
