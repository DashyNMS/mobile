<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:logs="clr-namespace:DashyNMS.Mobile.Logs;assembly=DashyNMS.Mobile.Shared"
    x:DataType="logs:LogsViewModel"
    HideSoftInputOnTapped="True"
    SafeAreaEdges="Container"
    Title="{Binding Title}">

    <ContentPage.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource Chip}" x:Key="LogChoice">
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="HeightRequest" Value="-1" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="MaximumWidthRequest" Value="{Binding Width, Source={x:Reference ListColumn}}" />
        </Style>
    </ContentPage.Resources>
    <!-- On an iPad or a Mac, the entry you tap shows beside the list (#88). -->
    <controls:ListDetail x:Name="Split" SafeAreaEdges="None" Placeholder="Choose an entry to see it here.">

    <!-- As the Logs mock-up (#118): Event log / Alert log, search, the filter
         chips, a summary, then the entries in one card - Graylog's layout. -->
    <Grid x:Name="ListColumn" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" Padding="16,0,16,0" SafeAreaEdges="None">

        <!-- Graylog has its own page in More, so it isn't repeated here. -->
        <controls:PageHeader x:Name="Header" Title="{Binding Title}">
            <controls:PageHeader.Actions>
                <controls:IconButton x:Name="SearchButton" Kind="Plain" Icon="{x:Static controls:Icons.Search}" SemanticProperties.Description="Search the log" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!-- A device's Event log is the event log only. -->
        <Border Grid.Row="1" Style="{StaticResource SegmentBar}" IsVisible="{Binding ShowsLogSwitch}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                <Button Style="{StaticResource Segment}" Text="Event log" FontSize="14" Command="{Binding ShowEventLogCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowingEventLog}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource Segment}" Text="Alert log" FontSize="14" Command="{Binding ShowAlertLogCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowingAlertLog}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </Border>

        <Grid x:Name="SearchSlot" Grid.Row="2" HeightRequest="0" IsClippedToBounds="True" SafeAreaEdges="None">
            <controls:SearchField x:Name="SearchField" Margin="0,4,0,8" VerticalOptions="Start" IsVisible="False">
                <Entry x:Name="Search" Text="{Binding SearchText}" Placeholder="{Binding SearchPlaceholder}" Completed="OnSearchCompleted" />
            </controls:SearchField>
        </Grid>

        <!-- Native choices retain the horizontal strip; fixed scope is read-only. -->
        <ScrollView Grid.Row="3" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,10,0,0">
            <HorizontalStackLayout Spacing="8">

                <Label Text="{Binding DeviceChipText, StringFormat='Device: {0}'}" IsVisible="{Binding IsDeviceFixed}" LineBreakMode="WordWrap" VerticalOptions="Center" MaximumWidthRequest="{Binding Width, Source={x:Reference ListColumn}}" />
                <Button Style="{StaticResource LogChoice}" Text="{Binding DeviceChipText, StringFormat='Device: {0} ▾'}" Command="{Binding ChooseDeviceCommand}" IsVisible="{Binding IsDeviceFixed, Converter={StaticResource Invert}}" />
                <Button Style="{StaticResource LogChoice}" Text="Clear device" Command="{Binding ClearDeviceCommand}" IsVisible="{Binding CanClearDevice}" />
                <Button Style="{StaticResource LogChoice}" Text="{Binding TypeChipText, StringFormat='Type: {0} ▾'}" Command="{Binding ChooseTypeCommand}" IsVisible="{Binding ShowingEventLog}" />
                <Button Style="{StaticResource LogChoice}" Text="{Binding StateChipText, StringFormat='State: {0} ▾'}" Command="{Binding ChooseStateCommand}" IsVisible="{Binding ShowingAlertLog}" />

                <Button Style="{StaticResource LogChoice}" Text="{Binding RangeChipText, StringFormat='{0} ▾'}" Command="{Binding ChooseRangeCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsRangeSet}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- Auto-refresh (#214), as desktop's logs: off until switched on; its interval beside it. -->
                <Button Style="{StaticResource LogChoice}" Text="Auto-refresh: Off" Command="{Binding ToggleAutoRefreshCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding AutoRefresh.IsOn}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                            <Setter Property="Text" Value="Auto-refresh: On" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Style="{StaticResource LogChoice}" Text="{Binding AutoRefresh.IntervalText, StringFormat='Interval: {0} ▾'}"
                        Command="{Binding ChooseAutoRefreshIntervalCommand}" IsVisible="{Binding AutoRefresh.IsOn}" />

            </HorizontalStackLayout>
        </ScrollView>

        <!-- Its height kept while the summary is still blank, so the chips never touch the list (#143). -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="4,6,0,4" MinimumHeightRequest="30">
            <VerticalStackLayout VerticalOptions="Center">
                <Label Style="{StaticResource Faint}" Text="{Binding SummaryText}" />
                <!-- A failed auto-refresh: quiet, with the rows and filters left as they were. -->
                <Label Style="{StaticResource Faint}" Text="{Binding RefreshProblem}" IsVisible="{Binding HasRefreshProblem}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Text="Clear filters"
                    Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}"
                    MinimumHeightRequest="44" />
        </Grid>

        <!-- LibreNMS's reason when a load fails, in a card of its own. -->
        <Border Grid.Row="5" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8" IsVisible="{Binding HasError}"
                BackgroundColor="{StaticResource CriticalTint}" Stroke="{StaticResource CriticalStroke}">
            <Label Text="{Binding ErrorMessage}" FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
        </Border>

        <!-- Loading the first time, or after a pull: the busy card over the list (#111). -->
        <controls:BusyCard x:Name="Busy" Grid.Row="6" ZIndex="1" IsVisible="False" />
        <!-- The rows share one card, as the other lists do (#69). -->
        <Border x:Name="ListCard" Grid.Row="6" SafeAreaEdges="None" Style="{StaticResource ListCard}" Margin="0,0,0,12">
            <Grid>
            <RefreshView SafeAreaEdges="None" x:Name="PullRefresh" Command="{Binding RefreshCommand}">
                <CollectionView controls:KeyboardDismiss.OnScroll="False" Margin="0,-1,0,0" ItemsSource="{Binding Entries}" SelectionMode="None" x:Name="List">
                    <CollectionView.Header><BoxView HeightRequest="20" Color="Transparent" InputTransparent="True" /></CollectionView.Header>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="8" Padding="20,40,20,32" IsVisible="{Binding IsEmpty}">
                            <Label Text="{Binding EmptyTitle}" FontFamily="BodySemibold" HorizontalTextAlignment="Center" />
                            <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" HorizontalTextAlignment="Center" />
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Fill" Margin="0,4,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Text="Look further back"
                                        Command="{Binding LoadMoreCommand}" IsVisible="{Binding CanLoadMore}" />
                                <Button Style="{StaticResource LinkButton}" Text="Clear filters"
                                        Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="logs:LogEntryItem">
                            <VerticalStackLayout>
                                <Label Style="{StaticResource SectionHeader}" Text="{Binding DayHeader}" IsVisible="{Binding HasDayHeader}" Margin="14,14,14,2" SemanticProperties.HeadingLevel="Level2" />
                                <Grid Padding="14,12">
                                    <BoxView Style="{StaticResource RowLine}" />
                                    <VerticalStackLayout Spacing="6" InputTransparent="True" AutomationProperties.ExcludedWithChildren="True">
                                        <Label Text="{Binding DeviceName}" LineBreakMode="WordWrap" IsVisible="{Binding ShowsDevice, Source={RelativeSource AncestorType={x:Type logs:LogsViewModel}}, x:DataType=logs:LogsViewModel}" />
                                        <Label Text="{Binding FullText}" TextType="Text" LineBreakMode="WordWrap" />
                                        <Label Text="{Binding StatusText}" />
                                        <Label Style="{StaticResource Faint}" Text="{Binding MetaText}" IsVisible="{Binding HasMeta}" LineBreakMode="WordWrap" />
                                        <Label Style="{StaticResource Faint}" Text="{Binding TimeText}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <Button BackgroundColor="Transparent" BorderWidth="0" Text="" HorizontalOptions="Fill" VerticalOptions="Fill" MinimumHeightRequest="44"
                                            SemanticProperties.Description="{Binding OpenDescription}"
                                            Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type logs:LogsViewModel}}, x:DataType=logs:LogsViewModel}" CommandParameter="{Binding .}" />
                                </Grid>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <!-- Further back, as the card's last row. -->
                    <CollectionView.Footer>
                        <VerticalStackLayout>
                        <Grid IsVisible="{Binding CanLoadMore}">
                            <BoxView Style="{StaticResource Divider}" VerticalOptions="Start" />
                            <Button Style="{StaticResource LinkButton}" Text="Load more" Command="{Binding LoadMoreCommand}"
                                    HorizontalOptions="Fill" HeightRequest="48" />
                        </Grid>
                        <BoxView x:Name="ListFoot" HeightRequest="24" Color="Transparent" InputTransparent="True" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>
                <BoxView HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" Offset="0" />
                            <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLightClear}, Dark={StaticResource SurfaceDarkClear}}" Offset="1" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
            </Grid>
        </Border>

    </Grid>

    </controls:ListDetail>

</ContentPage>
