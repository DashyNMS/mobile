<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.GraphPickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:dash="clr-namespace:DashyNMS.Mobile.Dashboard;assembly=DashyNMS.Mobile.Shared"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    xmlns:models="clr-namespace:DesktopNMS.Core.Models;assembly=DesktopNMS.Core"
    x:DataType="dash:GraphPickerViewModel"
    Title="Dashboard graph">

    <controls:SetupLayout x:Name="Setup">
        <controls:SetupLayout.Header>
            <controls:PageHeader x:Name="Header" Title="Choose a graph" />
        </controls:SetupLayout.Header>
        <controls:SetupLayout.Body>
            <Grid SafeAreaEdges="None" RowDefinitions="Auto,Auto,*">
                <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
                <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

                <!-- Step one: the device. -->
                <Grid Grid.Row="2" RowDefinitions="Auto,*" IsVisible="{Binding ChoosingDevice}">
                    <SearchBar Text="{Binding DeviceSearch}" Placeholder="Which device?"
                        SemanticProperties.Description="Which device?" />
                    <CollectionView x:Name="DeviceList" Grid.Row="1" ItemsSource="{Binding Devices}" SelectionMode="None" Margin="0,6,0,0">
                        <CollectionView.EmptyView>
                            <Label Text="No devices found" Style="{StaticResource Caption}"
                                IsVisible="{Binding IsBusy, Converter={StaticResource Invert}}" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeviceItem">
                                <Border Style="{StaticResource Card}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding ChooseDeviceCommand, Source={RelativeSource AncestorType={x:Type dash:GraphPickerViewModel}}, x:DataType=dash:GraphPickerViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Name}" FontFamily="BodySemibold" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding Details}" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <!-- Step two: the graph and range. -->
                <ScrollView x:Name="FormScroll" SafeAreaEdges="None" Grid.Row="2" IsVisible="{Binding HasDevice}">
                    <VerticalStackLayout Spacing="8">
                        <controls:SetupSection Label="Card title (optional)">
                            <Entry Text="{Binding CardTitle}" Placeholder="Card title"
                                SemanticProperties.Description="Card title (optional)" />
                        </controls:SetupSection>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding SelectedDevice.Name}" FontFamily="BodySemibold" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Change device" Command="{Binding ChangeDeviceCommand}" BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </Grid>
                        <!-- Show: the device's own graphs or one of its ports (#172), as desktop's Graph widget. -->
                        <controls:SetupSection Label="Show">
                            <Picker Title="Show" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                                ItemDisplayBinding="{Binding Label, x:DataType=dash:GraphSource}" />
                        </controls:SetupSection>
                        <controls:SetupSection Label="Graph">
                            <Picker Title="Graph" ItemsSource="{Binding Graphs}" SelectedItem="{Binding SelectedGraph}"
                                ItemDisplayBinding="{Binding Description, x:DataType=models:GraphType}" />
                        </controls:SetupSection>
                        <controls:SetupSection Label="Time range">
                            <Picker Title="Time range" ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}"
                                ItemDisplayBinding="{Binding Label, x:DataType=dash:GraphRangeChoice}" />
                        </controls:SetupSection>
                    </VerticalStackLayout>
                </ScrollView>

            </Grid>
        </controls:SetupLayout.Body>
        <controls:SetupLayout.PrimaryAction>
            <Button Text="Save" Command="{Binding SaveCommand}" HorizontalOptions="Fill" Margin="0,12,0,0" />
        </controls:SetupLayout.PrimaryAction>
    </controls:SetupLayout>

</ContentPage>
