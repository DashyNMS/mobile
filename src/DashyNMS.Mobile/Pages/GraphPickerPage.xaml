<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.GraphPickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dash="clr-namespace:DashyNMS.Mobile.Dashboard;assembly=DashyNMS.Mobile.Shared"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    xmlns:models="clr-namespace:DesktopNMS.Core.Models;assembly=DesktopNMS.Core"
    x:DataType="dash:GraphPickerViewModel"
    Title="Dashboard graph">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,8,16,0">

        <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <!-- Step one: the device. -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*" IsVisible="{Binding ChoosingDevice}">
            <SearchBar Text="{Binding DeviceSearch}" Placeholder="Which device?" />
            <CollectionView Grid.Row="1" ItemsSource="{Binding Devices}" SelectionMode="None" Margin="0,6,0,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceItem">
                        <Border Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding ChooseDeviceCommand, Source={RelativeSource AncestorType={x:Type dash:GraphPickerViewModel}}, x:DataType=dash:GraphPickerViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" FontFamily="BodySemibold" />
                                <Label Style="{StaticResource Caption}" Text="{Binding Details}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Step two: the graph and range. -->
        <VerticalStackLayout Grid.Row="2" Spacing="8" IsVisible="{Binding HasDevice}">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding SelectedDevice.Name}" FontFamily="BodySemibold" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Change device" Command="{Binding ChangeDeviceCommand}" BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
            </Grid>
            <Picker Title="Graph" ItemsSource="{Binding Graphs}" SelectedItem="{Binding SelectedGraph}"
                    ItemDisplayBinding="{Binding Description, x:DataType=models:GraphType}" />
            <Picker Title="Time range" ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}"
                    ItemDisplayBinding="{Binding Label, x:DataType=dash:GraphRangeChoice}" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
