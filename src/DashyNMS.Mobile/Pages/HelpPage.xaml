<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.HelpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:help="clr-namespace:DashyNMS.Mobile.Help;assembly=DashyNMS.Mobile.Shared"
    x:DataType="help:HelpViewModel"
    SafeAreaEdges="All"
    HideSoftInputOnTapped="True"
    Title="Help">

    <!-- With room, the page you choose shows beside the contents (#668). -->
    <controls:ListDetail SafeAreaEdges="None" x:Name="Split" Placeholder="Choose a page to read it here.">

    <Grid x:Name="Body" SafeAreaEdges="None" RowDefinitions="Auto,Auto,*">

        <controls:PageHeader x:Name="Header" Title="Help" Margin="16,0">
            <controls:PageHeader.Actions>
                <controls:IconButton x:Name="SearchButton" Kind="Plain" Icon="{x:Static controls:Icons.Search}" SemanticProperties.Description="Search help" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Grid SafeAreaEdges="None" Grid.Row="1" x:Name="SearchSlot" IsClippedToBounds="True">
            <controls:SearchField x:Name="SearchField" Margin="16,2,16,0">
                <Entry x:Name="Search" Text="{Binding SearchText}" Placeholder="Search help" Completed="OnSearchCompleted" />
            </controls:SearchField>
        </Grid>


        <Border SafeAreaEdges="None" x:Name="ListCard" Grid.Row="2" Style="{OnPlatform iOS={StaticResource OpenListCard}, Default={StaticResource ListCard}}" Margin="16,0">
            <Grid SafeAreaEdges="None">
                <CollectionView controls:KeyboardDismiss.OnScroll="False" x:Name="List" ItemsSource="{Binding Rows}" SelectionMode="None">
                    <!-- Which search the list shows, scrolling with it, so a short window keeps room for results. -->
                    <CollectionView.Header>
                        <VerticalStackLayout Padding="14,20,14,0">
                            <VerticalStackLayout x:Name="ResultLine" Spacing="0" IsVisible="{Binding IsSearching}">
                                <Label x:Name="Results" Style="{StaticResource Caption}" Text="{Binding ResultsText}" LineBreakMode="WordWrap" />
                                <Button Style="{StaticResource LinkButton}" Text="Clear search" MinimumHeightRequest="44" HorizontalOptions="Start" Padding="0,0,8,0" Command="{Binding ClearSearchCommand}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </CollectionView.Header>
                    <!-- Which release the pages describe, at the foot of the contents as on desktop. -->
                    <CollectionView.Footer>
                        <VerticalStackLayout Padding="14,16,14,0">
                            <Label Style="{StaticResource Faint}" Text="{Binding ReleaseText}" LineBreakMode="WordWrap" />
                            <BoxView x:Name="ListFoot" HeightRequest="0" Color="Transparent" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="8" Padding="20,32">
                            <Label Text="No help to show" FontFamily="BodySemibold" HorizontalTextAlignment="Center" IsVisible="{Binding IsEmpty}" />
                            <Label Style="{StaticResource Caption}" HorizontalTextAlignment="Center" IsVisible="{Binding IsEmpty}"
                                   Text="The guide in this build couldn't be read. Reinstalling DashyNMS restores it." />
                            <Label Text="No matches" FontFamily="BodySemibold" HorizontalTextAlignment="Center" IsVisible="{Binding ShowNoResults}" />
                            <Label Style="{StaticResource Caption}" HorizontalTextAlignment="Center" IsVisible="{Binding ShowNoResults}"
                                   Text="Try fewer words, or clear the search to see every page." />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="help:HelpRow">
                            <VerticalStackLayout Padding="14,0">
                                <Label Style="{StaticResource SectionHeader}" Text="{Binding Group}" IsVisible="{Binding HasGroup}" Margin="0,22,0,4"
                                       SemanticProperties.HeadingLevel="Level2" />
                                <BoxView Style="{StaticResource Divider}" IsVisible="{Binding HasLine}" InputTransparent="True" AutomationProperties.IsInAccessibleTree="False" />
                                <controls:SettingsOverviewRow Title="{Binding Title}" Summary="{Binding Summary}" IsCurrent="{Binding IsCurrent}"
                                    Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type help:HelpViewModel}}, x:DataType=help:HelpViewModel}"
                                    CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <BoxView Margin="1,1,1,0" HeightRequest="20" VerticalOptions="Start" InputTransparent="True" AutomationProperties.IsInAccessibleTree="False">
                    <BoxView.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" Offset="0" />
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLightClear}, Dark={StaticResource SurfaceDarkClear}}" Offset="1" />
                    </LinearGradientBrush></BoxView.Background>
                </BoxView>
            </Grid>
        </Border>
        <controls:FootFade x:Name="BottomFade" Grid.Row="2" />

    </Grid>

    </controls:ListDetail>

</ContentPage>
