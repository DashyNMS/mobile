<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.UnimusBackupsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:unimus="clr-namespace:DashyNMS.Mobile.Unimus;assembly=DashyNMS.Mobile.Shared"
    x:DataType="unimus:UnimusBackupsViewModel"
    SafeAreaEdges="Container"
    Title="Config backups">

    <!-- A device's Unimus backups (#21), newest first, in one card. Compare
         turns taps into choices, and diffs the two chosen. -->
    <Grid x:Name="Body" RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16,0,16,0" SafeAreaEdges="None">
        <controls:PageHeader x:Name="Header" SafeAreaEdges="None" Title="Config backups">
            <controls:PageHeader.Actions>
                <Button x:Name="CompareToggle" Style="{StaticResource LinkButton}" Text="{Binding CompareText}" Command="{Binding ToggleCompareCommand}"
                        IsVisible="{Binding CanCompare}" IsEnabled="{Binding IsNotBusy}" MinimumHeightRequest="44" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <VerticalStackLayout Grid.Row="1" Spacing="4" Margin="4,0,4,12">
            <Label Text="{Binding DeviceName}" Style="{StaticResource RowTitle}" LineBreakMode="WordWrap" />
            <Label Text="{Binding DeviceIdentity}" Style="{StaticResource Caption}" />
            <Label Text="{Binding HistoryText}" Style="{StaticResource Faint}" />
            <Label Style="{StaticResource Caption}" Text="{Binding CompareHint}" IsVisible="{Binding IsComparing}" />
        </VerticalStackLayout>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8" IsVisible="{Binding HasError}"
                BackgroundColor="{StaticResource CriticalTint}" Stroke="{StaticResource CriticalStroke}">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding ErrorMessage}" FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
                <Label Text="Previously loaded history remains visible." IsVisible="{Binding HasBackups}" Style="{StaticResource Caption}" />
                <Button Text="Retry" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" MinimumHeightRequest="44" />
            </VerticalStackLayout>
        </Border>

        <controls:BusyCard x:Name="Busy" Grid.Row="3" ZIndex="1" IsVisible="False" />
        <Border Grid.Row="3" Style="{StaticResource ListCard}" SafeAreaEdges="None" Margin="0">
            <Grid SafeAreaEdges="None">
            <RefreshView SafeAreaEdges="None" x:Name="PullRefresh" Command="{Binding RefreshCommand}">
                <CollectionView x:Name="Rows" Margin="0,-1,0,0" ItemsSource="{Binding Backups}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="8" Padding="20,32" IsVisible="{Binding IsEmpty}">
                            <Label Text="No backups" FontFamily="BodySemibold" HorizontalTextAlignment="Center" />
                            <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.Header><BoxView HeightRequest="20" Color="Transparent" /></CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="unimus:UnimusBackupItem">
                            <Grid Style="{StaticResource ListRow}" MinimumHeightRequest="44" ColumnDefinitions="Auto,*,Auto" RowDefinitions="*,Auto" ColumnSpacing="12"
                                  SemanticProperties.Description="{Binding ContentDescription}" SemanticProperties.Hint="Open backup, or toggle selection in Compare mode">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type unimus:UnimusBackupsViewModel}}, x:DataType=unimus:UnimusBackupsViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <!-- Compare's choice: filled when chosen. -->
                                <Ellipse WidthRequest="20" HeightRequest="20" StrokeThickness="2" VerticalOptions="Center"
                                         AutomationProperties.ExcludedWithChildren="True"
                                         Stroke="{StaticResource ButtonPrimary}" Fill="Transparent"
                                         IsVisible="{Binding IsComparing, Source={RelativeSource AncestorType={x:Type unimus:UnimusBackupsViewModel}}, x:DataType=unimus:UnimusBackupsViewModel}">
                                    <Ellipse.Triggers>
                                        <DataTrigger TargetType="Ellipse" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource ButtonPrimary}" />
                                        </DataTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" AutomationProperties.ExcludedWithChildren="True">
                                    <Label Style="{StaticResource RowTitle}" Text="{Binding VersionText}" LineBreakMode="WordWrap" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding ExactDateText}" LineBreakMode="WordWrap" />
                                    <Label Style="{StaticResource Faint}" Text="{Binding StatusText}" />
                                    <Label Style="{StaticResource Caption}" Text="Selected for comparison" IsVisible="{Binding IsSelected}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Style="{StaticResource Chevron}"
                                       AutomationProperties.ExcludedWithChildren="True"
                                       IsVisible="{Binding IsComparing, Converter={StaticResource Invert}, Source={RelativeSource AncestorType={x:Type unimus:UnimusBackupsViewModel}}, x:DataType=unimus:UnimusBackupsViewModel}" />
                                <BoxView Grid.Row="1" Grid.ColumnSpan="3" HeightRequest="1" Margin="0,11,0,0" Color="Transparent" />
                                <BoxView Grid.ColumnSpan="3" Style="{StaticResource RowLine}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.Footer>
                        <BoxView x:Name="RowFoot" HeightRequest="20" Color="Transparent" InputTransparent="True" />
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>
        <BoxView Margin="1,1,1,0" HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                    <GradientStop Offset="1" Color="{AppThemeBinding Light={StaticResource SurfaceLightClear}, Dark={StaticResource SurfaceDarkClear}}" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>
            </Grid>
        </Border>

        <Button x:Name="CompareButton" Grid.Row="4" Text="Compare" Command="{Binding CompareSelectedCommand}" Margin="0,0,0,12"
                IsVisible="{Binding IsComparing}" />

    </Grid>

</ContentPage>
