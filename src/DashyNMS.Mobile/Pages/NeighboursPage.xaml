<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.NeighboursPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:topo="clr-namespace:DashyNMS.Mobile.Topology;assembly=DashyNMS.Mobile.Shared"
    x:DataType="topo:NeighboursViewModel"
    SafeAreaEdges="Container"
    Title="Neighbours">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16,8,16,0">

        <SearchBar Text="{Binding SearchText}" Placeholder="Device, port or platform" />

        <HorizontalStackLayout Grid.Row="1" Spacing="8" Margin="0,6,0,0">
            <Button Style="{StaticResource Chip}" Text="{Binding ProblemCount, StringFormat='Down only ({0})'}" Command="{Binding ToggleProblemsOnlyCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ProblemsOnly}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource CriticalTint}" />
                        <Setter Property="BorderColor" Value="{StaticResource CriticalStroke}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </HorizontalStackLayout>

        <Label Grid.Row="2" Style="{StaticResource Caption}" Text="{Binding CountText}" Margin="4,6,0,2" />
        <Label Grid.Row="3" Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

        <RefreshView Grid.Row="4" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Links}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,32" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="topo:NeighbourLink">
                        <Border Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type topo:NeighboursViewModel}}, x:DataType=topo:NeighboursViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="12">
                                <Ellipse Style="{StaticResource Dot}" Fill="{Binding Row.Status, Converter={StaticResource StatusColor}}" />
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding Row.Title}" FontFamily="BodySemibold" LineBreakMode="TailTruncation" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Row.Subtitle}" LineBreakMode="TailTruncation" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Row.Detail}" IsVisible="{Binding Row.HasDetail}" FontSize="12"
                                           TextColor="{Binding Row.Status, Converter={StaticResource StatusText}}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding Row.Value}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
