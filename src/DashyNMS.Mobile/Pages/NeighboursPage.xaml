<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.NeighboursPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:topo="clr-namespace:DashyNMS.Mobile.Topology;assembly=DashyNMS.Mobile.Shared"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    x:DataType="topo:NeighboursViewModel"
    ios:Page.UseSafeArea="True"
    SafeAreaEdges="Container"
    Title="Neighbours">

    <!-- Neighbourhoods are desktop's neighbour views, shared through its settings (#98).
         Pushed from More, the navigation bar has the button; as a tab, the header. -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Neighbourhoods" Command="{Binding EditGroupsCommand}" />
    </ContentPage.ToolbarItems>

    <!-- On an iPad or a Mac, the link you tap shows beside the list (#88). -->
    <controls:ListDetail x:Name="Split" Placeholder="Choose a neighbour to see the link here.">

    <!-- Laid out as the Devices tab (#98) and brought up to date (#121): search, the chips as the
         network map's, a count, then the rows in one card with the busy card over it. -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Padding="16,8,16,0">

        <controls:PageHeader x:Name="Header" Title="Neighbours">
            <controls:PageHeader.Actions>
                <Button Style="{StaticResource LinkButton}" Text="Neighbourhoods" Command="{Binding EditGroupsCommand}" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!-- Slides out when the list is scrolled back up or pulled down - see SearchReveal. -->
        <Grid Grid.Row="1" x:Name="SearchSlot" IsClippedToBounds="True">
            <SearchBar x:Name="Search" Text="{Binding SearchText}" Placeholder="Search names, ports, platforms" Margin="-6,2,-6,0" />
        </Grid>

        <!-- Up and Down (both on to start), a divider, then All and each neighbourhood. -->
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,10,0,0">
            <HorizontalStackLayout Spacing="8">
                <Button Style="{StaticResource Chip}" Text="{Binding UpCount, StringFormat='Up {0}'}" Command="{Binding ToggleUpCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowUp}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource OkTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource OkStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OkTextLight}, Dark={StaticResource OkTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Style="{StaticResource Chip}" Text="{Binding DownCount, StringFormat='Down {0}'}" Command="{Binding ToggleDownCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowDown}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource CriticalTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource CriticalStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <!-- Between the state chips and the neighbourhoods. -->
                <BoxView WidthRequest="1" HeightRequest="20" VerticalOptions="Center" Margin="2,0"
                         Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource ChipStrokeDark}}" />
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Groups}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="topo:NeighbourGroupChip">
                            <Button Style="{StaticResource Chip}" Text="{Binding Text}"
                                    Command="{Binding SelectGroupCommand, Source={RelativeSource AncestorType={x:Type topo:NeighboursViewModel}}, x:DataType=topo:NeighboursViewModel}"
                                    CommandParameter="{Binding .}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                                        <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </ScrollView>

        <Label Grid.Row="3" Style="{StaticResource Faint}" Text="{Binding CountText}" Margin="4,6,0,4" IsVisible="{Binding HasLoaded}" />

        <!-- LibreNMS's reason when the fetch fails, in a card of its own. -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8" IsVisible="{Binding HasError}"
                BackgroundColor="{StaticResource CriticalTint}" Stroke="{StaticResource CriticalStroke}">
            <Label Text="{Binding ErrorMessage}" FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
        </Border>

        <!-- Loading the first time, or after a pull: the busy card over the list (#111). -->
        <controls:BusyCard x:Name="Busy" Grid.Row="5" ZIndex="1" IsVisible="False" />
        <Border Grid.Row="5" Style="{StaticResource ListCard}" Margin="0,0,0,12">
            <RefreshView x:Name="PullRefresh" Command="{Binding RefreshCommand}">
                <CollectionView Margin="0,-1,0,0" x:Name="List" ItemsSource="{Binding Links}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="8" Padding="20,32" IsVisible="{Binding IsEmpty}">
                            <Label Text="{Binding EmptyTitle}" FontFamily="BodySemibold" HorizontalTextAlignment="Center" />
                            <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" HorizontalTextAlignment="Center" />
                            <Button Style="{StaticResource LinkButton}" Text="Clear filters" HorizontalOptions="Center"
                                    Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="topo:NeighbourLink">
                            <!-- A status dot, the neighbour, the two ports, then what it is - or why it's down - and the protocol. -->
                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" RowDefinitions="*,Auto" ColumnSpacing="12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type topo:NeighboursViewModel}}, x:DataType=topo:NeighboursViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Ellipse Style="{StaticResource Dot}" Fill="{Binding Row.Status, Converter={StaticResource StatusColor}}"
                                         VerticalOptions="Start" Margin="0,6,0,0" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Style="{StaticResource RowTitle}" Text="{Binding Row.Title}" />
                                    <Label Text="{Binding PortsText}" FontFamily="Mono" FontSize="12.5" LineBreakMode="TailTruncation" MaxLines="1"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource Gray100}}" />
                                    <Label Style="{StaticResource Faint}" Text="{Binding NoteText}" IsVisible="{Binding HasNote}" LineBreakMode="TailTruncation">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsProblem}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Style="{StaticResource Faint}" Text="{Binding Row.Value}" VerticalOptions="Start" Margin="0,2,0,0" />
                                <!-- The bottom padding; the line itself is at the top of the row (#120). -->
                                <BoxView Grid.Row="1" Grid.ColumnSpan="3" HeightRequest="1" Margin="0,11,0,0" Color="Transparent" />
                                <BoxView Grid.ColumnSpan="3" Style="{StaticResource RowLine}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Border>

    </Grid>

    </controls:ListDetail>

</ContentPage>
