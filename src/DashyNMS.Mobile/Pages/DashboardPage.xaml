<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    xmlns:sections="clr-namespace:DashyNMS.Mobile.DeviceSections;assembly=DashyNMS.Mobile.Shared"
    xmlns:cfg="clr-namespace:DesktopNMS.Core.Configuration;assembly=DesktopNMS.Core"
    xmlns:pages="clr-namespace:DashyNMS.Mobile.Pages"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    x:DataType="vm:DashboardViewModel"
    Title="Dashboard">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Customise" Command="{Binding CustomiseCommand}" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <!-- One template per card kind (DashboardLayout); each reads from the card's Dashboard. -->
        <pages:DashboardCardTemplateSelector x:Key="CardTemplates">

            <pages:DashboardCardTemplateSelector.AlertsGauge>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource SectionHeader}" Text="ALERTS" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Dashboard.CriticalAlerts}" FontSize="28" TextColor="{StaticResource CriticalColor}" />
                                    <Label Style="{StaticResource Caption}" Text="Critical" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Dashboard.WarningAlerts}" FontSize="28" TextColor="{StaticResource WarningColor}" />
                                    <Label Style="{StaticResource Caption}" Text="Warning" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Dashboard.AcknowledgedAlerts}" FontSize="28" />
                                    <Label Style="{StaticResource Caption}" Text="Acknowledged" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                        <!-- Desktop's alerts gauge, as a bar: each severity's share of open alerts. -->
                        <Border StrokeThickness="0" HeightRequest="8" StrokeShape="RoundRectangle 4" IsVisible="{Binding Dashboard.HasOpenAlerts}">
                            <Grid ColumnSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Dashboard.CriticalShare, Converter={StaticResource Star}}" />
                                    <ColumnDefinition Width="{Binding Dashboard.WarningShare, Converter={StaticResource Star}}" />
                                    <ColumnDefinition Width="{Binding Dashboard.AcknowledgedShare, Converter={StaticResource Star}}" />
                                </Grid.ColumnDefinitions>
                                <BoxView Color="{StaticResource CriticalColor}" />
                                <BoxView Grid.Column="1" Color="{StaticResource WarningColor}" />
                                <BoxView Grid.Column="2" Color="{StaticResource InactiveColor}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.AlertsGauge>

            <pages:DashboardCardTemplateSelector.DeviceStatus>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource SectionHeader}" Text="DEVICES" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Dashboard.DevicesUp}" FontSize="28" TextColor="{StaticResource OkColor}" />
                                    <Label Style="{StaticResource Caption}" Text="Up" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Dashboard.DevicesDown}" FontSize="28" TextColor="{StaticResource CriticalColor}" />
                                    <Label Style="{StaticResource Caption}" Text="Down" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Dashboard.DevicesInactive}" FontSize="28" TextColor="{StaticResource InactiveColor}" />
                                    <Label Style="{StaticResource Caption}" Text="Disabled / ignored" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.DeviceStatus>

            <pages:DashboardCardTemplateSelector.Alerts>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource SectionHeader}" Text="NEEDS ATTENTION" />
                        <Label Style="{StaticResource Caption}" Text="Nothing needs attention." IsVisible="{Binding Dashboard.HasNoAlerts}" Margin="4,0" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Dashboard.TopAlerts}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AlertItem">
                                    <Border Style="{StaticResource Card}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding OpenAlertCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, x:DataType=vm:DashboardViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="6,*" ColumnSpacing="12">
                                            <BoxView Color="{Binding Severity, Converter={StaticResource StatusColor}}" CornerRadius="3" />
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Text="{Binding Rule}" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" />
                                                <Label Style="{StaticResource Caption}" Text="{Binding Device}" LineBreakMode="TailTruncation" />
                                                <Label Style="{StaticResource Caption}" Text="{Binding Summary}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.Alerts>

            <pages:DashboardCardTemplateSelector.PinnedDevices>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource SectionHeader}" Text="PINNED DEVICES" />
                        <Label Style="{StaticResource Caption}" Text="Pin a device from Devices or its Device View to see it here."
                               IsVisible="{Binding Dashboard.HasPinnedDevices, Converter={StaticResource Invert}}" Margin="4,0" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Dashboard.PinnedDevices}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeviceItem">
                                    <Border Style="{StaticResource Card}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding OpenPinnedCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, x:DataType=vm:DashboardViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="12,*,Auto" ColumnSpacing="12">
                                            <Ellipse Fill="{Binding State, Converter={StaticResource StatusColor}}" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" />
                                                <Label Style="{StaticResource Caption}" Text="{Binding Details}" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding StateText}" VerticalOptions="Center"
                                                   TextColor="{Binding State, Converter={StaticResource StatusColor}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.PinnedDevices>

            <pages:DashboardCardTemplateSelector.RecentlyViewed>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource SectionHeader}" Text="RECENTLY VIEWED" />
                        <Label Style="{StaticResource Caption}" Text="Devices you open show here."
                               IsVisible="{Binding Dashboard.HasRecentlyViewed, Converter={StaticResource Invert}}" Margin="4,0" />
                        <FlexLayout BindableLayout.ItemsSource="{Binding Dashboard.RecentlyViewed}" Wrap="Wrap">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="cfg:RecentlyViewedDevice">
                                    <Button Style="{StaticResource Chip}" Text="{Binding DisplayName}" Margin="0,0,8,8"
                                            Command="{Binding OpenRecentCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, x:DataType=vm:DashboardViewModel}"
                                            CommandParameter="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.RecentlyViewed>

            <pages:DashboardCardTemplateSelector.Sensors>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource SectionHeader}" Text="SENSORS" />
                            <Button Grid.Column="1" Text="Choose" Command="{Binding Dashboard.PickSensorsCommand}" BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                    Padding="8,0" HeightRequest="30" MinimumHeightRequest="30" VerticalOptions="End" />
                        </Grid>
                        <Label Style="{StaticResource Caption}" Text="Choose sensors to keep an eye on here." IsVisible="{Binding Dashboard.HasNoPinnedSensors}" Margin="4,0" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Dashboard.PinnedSensors}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="sections:SectionRow">
                                    <Border Style="{StaticResource Card}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding OpenRowCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, x:DataType=vm:DashboardViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="6,*,Auto" ColumnSpacing="12">
                                            <BoxView Color="{Binding Status, Converter={StaticResource StatusColor}}" CornerRadius="3" />
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" />
                                                <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding Value}" VerticalOptions="Center" FontFamily="OpenSansSemibold"
                                                   TextColor="{Binding Status, Converter={StaticResource StatusColor}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.Sensors>

            <pages:DashboardCardTemplateSelector.Graph>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource SectionHeader}" Text="{Binding Dashboard.GraphTitle}" LineBreakMode="TailTruncation" />
                            <Button Grid.Column="1" Text="Change" Command="{Binding Dashboard.PickGraphCommand}" BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                    Padding="8,0" HeightRequest="30" MinimumHeightRequest="30" VerticalOptions="End" />
                        </Grid>
                        <Label Style="{StaticResource Caption}" Text="Choose a device and one of its graphs." IsVisible="{Binding Dashboard.GraphNeedsSetUp}" Margin="4,0" />
                        <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding Dashboard.GraphPage, Converter={StaticResource IsNotNull}}">
                            <Grid>
                                <controls:GraphView Html="{Binding Dashboard.GraphPage}" />
                                <!-- The web view would swallow taps; this opens the device's graphs. -->
                                <BoxView Color="Transparent">
                                    <BoxView.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Dashboard.OpenGraphCommand}" />
                                    </BoxView.GestureRecognizers>
                                </BoxView>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.Graph>

            <pages:DashboardCardTemplateSelector.Wireless>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource SectionHeader}" Text="WIRELESS" />
                            <Label Grid.Column="1" Style="{StaticResource Caption}" Text="{Binding Dashboard.WirelessSummary}" VerticalOptions="End" />
                        </Grid>
                        <Label Style="{StaticResource Caption}" Text="No wireless controllers found." IsVisible="{Binding Dashboard.HasNoWirelessControllers}" Margin="4,0" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Dashboard.WirelessControllers}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="sections:SectionRow">
                                    <Border Style="{StaticResource Card}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding OpenRowCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, x:DataType=vm:DashboardViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="12,*,Auto" ColumnSpacing="12">
                                            <Ellipse Fill="{Binding Status, Converter={StaticResource StatusColor}}" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" />
                                                <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding Value}" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.Wireless>

            <pages:DashboardCardTemplateSelector.Empty>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <ContentView />
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.Empty>

        </pages:DashboardCardTemplateSelector>
    </ContentPage.Resources>

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="4">

                <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Cards}"
                                     BindableLayout.ItemTemplateSelector="{StaticResource CardTemplates}"
                                     Spacing="12" />

                <Label Style="{StaticResource Caption}"
                       Text="{Binding LastUpdated, StringFormat='Updated {0:HH:mm:ss}. Pull down to refresh.'}"
                       HorizontalOptions="Center"
                       Margin="0,16,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
