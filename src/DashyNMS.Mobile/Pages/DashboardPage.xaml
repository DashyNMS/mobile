<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    xmlns:sections="clr-namespace:DashyNMS.Mobile.DeviceSections;assembly=DashyNMS.Mobile.Shared"
    xmlns:dash="clr-namespace:DashyNMS.Mobile.Dashboard;assembly=DashyNMS.Mobile.Shared"
    xmlns:pages="clr-namespace:DashyNMS.Mobile.Pages"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:views="clr-namespace:DashyNMS.Mobile.Views"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    x:DataType="vm:DashboardViewModel"
    Shell.NavBarIsVisible="False"
    ios:Page.UseSafeArea="True"
    Title="Dashboard">

    <!-- Each widget is one card, its title inside, as in the design
         mock-ups: counts as tiles, lists as rows with a status dot. -->
    <ContentPage.Resources>
        <!-- A card just added from the card picker is outlined for a moment where it lands (#140). -->
        <Style x:Key="DashCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsHighlighted, x:DataType=vm:DashboardCard}" Value="True">
                    <Setter Property="Stroke" Value="{StaticResource PrimaryStroke}" />
                    <Setter Property="StrokeThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One template per card kind (DashboardLayout); each reads from the card's Dashboard. -->
        <pages:DashboardCardTemplateSelector x:Key="CardTemplates">

            <!-- Each count opens its tab filtered to it (#32, #34, #64). -->
            <pages:DashboardCardTemplateSelector.AlertsGauge>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <Border Style="{StaticResource DashCard}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Style="{StaticResource CardTitle}" Text="Alerts" />
                                <Label Grid.Column="1" Style="{StaticResource CardNote}"
                                       Text="{Binding Dashboard.LastUpdated, StringFormat='Checked {0:HH:mm}'}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                <Border Style="{StaticResource Tile}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Dashboard.ShowAlertsCommand}" CommandParameter="critical" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Style="{StaticResource TileNumber}" Text="{Binding Dashboard.CriticalAlerts}"
                                               TextColor="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
                                        <Label Style="{StaticResource Caption}" FontSize="14" Text="Critical" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Tile}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Dashboard.ShowAlertsCommand}" CommandParameter="warning" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Style="{StaticResource TileNumber}" Text="{Binding Dashboard.WarningAlerts}"
                                               TextColor="{AppThemeBinding Light={StaticResource WarningTextLight}, Dark={StaticResource WarningTextDark}}" />
                                        <Label Style="{StaticResource Caption}" FontSize="14" Text="Warning" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource Tile}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Dashboard.ShowAlertsCommand}" CommandParameter="ok" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Style="{StaticResource TileNumber}" Text="{Binding Dashboard.OkAlerts}"
                                               TextColor="{AppThemeBinding Light={StaticResource OkTextLight}, Dark={StaticResource OkTextDark}}" />
                                        <Label Style="{StaticResource Caption}" FontSize="14" Text="OK" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Dashboard.ShowAlertsCommand}" CommandParameter="acknowledged" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Style="{StaticResource TileNumber}" Text="{Binding Dashboard.AcknowledgedAlerts}"
                                               TextColor="{AppThemeBinding Light={StaticResource InactiveTextLight}, Dark={StaticResource InactiveTextDark}}" />
                                        <Label Style="{StaticResource Caption}" FontSize="14" Text="Acknowledged" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.AlertsGauge>

            <pages:DashboardCardTemplateSelector.DeviceStatus>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <Border Style="{StaticResource DashCard}">
                        <VerticalStackLayout Spacing="10">
                            <Label Style="{StaticResource CardTitle}" Text="Devices" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                <Border Style="{StaticResource Tile}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Dashboard.ShowDevicesCommand}" CommandParameter="up" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Style="{StaticResource TileNumber}" Text="{Binding Dashboard.DevicesUp}"
                                               TextColor="{AppThemeBinding Light={StaticResource OkTextLight}, Dark={StaticResource OkTextDark}}" />
                                        <Label Style="{StaticResource Caption}" FontSize="14" Text="Up" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Tile}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Dashboard.ShowDevicesCommand}" CommandParameter="down" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Style="{StaticResource TileNumber}" Text="{Binding Dashboard.DevicesDown}"
                                               TextColor="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
                                        <Label Style="{StaticResource Caption}" FontSize="14" Text="Down" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource Tile}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Dashboard.ShowDevicesCommand}" CommandParameter="maintenance" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Style="{StaticResource TileNumber}" Text="{Binding Dashboard.DevicesMaintenance}"
                                               TextColor="{AppThemeBinding Light={StaticResource MaintenanceTextLight}, Dark={StaticResource MaintenanceTextDark}}" />
                                        <Label Style="{StaticResource Caption}" FontSize="14" Text="Maintenance" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Dashboard.ShowDevicesCommand}" CommandParameter="disabled" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Style="{StaticResource TileNumber}" Text="{Binding Dashboard.DevicesInactive}"
                                               TextColor="{AppThemeBinding Light={StaticResource InactiveTextLight}, Dark={StaticResource InactiveTextDark}}" />
                                        <Label Style="{StaticResource Caption}" FontSize="14" Text="Disabled" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.DeviceStatus>

            <pages:DashboardCardTemplateSelector.Alerts>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <Border Style="{StaticResource DashCard}">
                        <VerticalStackLayout Spacing="4">
                            <!-- Desktop's Alerts widget's title chips (#140): critical, warning,
                                 and whether acknowledged ones count. See all is at the foot. -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Style="{StaticResource CardTitle}" Text="Needs attention" VerticalOptions="Center" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                    <Button Style="{StaticResource Chip}" Text="{Binding Dashboard.CriticalAlerts, StringFormat='● {0}'}"
                                            HeightRequest="32" MinimumHeightRequest="32" Padding="10,0" Command="{Binding ToggleCriticalCommand}"
                                            SemanticProperties.Description="Show critical alerts">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding ShowsCritical}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource CriticalTint}" />
                                                <Setter Property="BorderColor" Value="{StaticResource CriticalStroke}" />
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <Button Style="{StaticResource Chip}" Text="{Binding Dashboard.WarningAlerts, StringFormat='● {0}'}"
                                            HeightRequest="32" MinimumHeightRequest="32" Padding="10,0" Command="{Binding ToggleWarningCommand}"
                                            SemanticProperties.Description="Show warning alerts">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding ShowsWarning}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource WarningTint}" />
                                                <Setter Property="BorderColor" Value="{StaticResource WarningStroke}" />
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WarningTextLight}, Dark={StaticResource WarningTextDark}}" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <Button Style="{StaticResource Chip}" Text="{Binding Dashboard.AcknowledgedAlerts, StringFormat='✓ {0}'}"
                                            HeightRequest="32" MinimumHeightRequest="32" Padding="10,0" Command="{Binding ToggleAcknowledgedCommand}"
                                            SemanticProperties.Description="Include acknowledged alerts">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IncludesAcknowledged}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                                                <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </HorizontalStackLayout>
                            </Grid>
                            <Label Style="{StaticResource Caption}" Text="Nothing needs attention." IsVisible="{Binding Dashboard.HasNoAlerts}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Dashboard.TopAlerts}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AlertItem">
                                        <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="44">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding OpenAlertCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, x:DataType=vm:DashboardViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Ellipse Style="{StaticResource Dot}" Fill="{Binding Severity, Converter={StaticResource StatusColor}}" />
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Style="{StaticResource RowTitle}" Text="{Binding Device}" />
                                                <Label Style="{StaticResource Caption}" Text="{Binding Rule}" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <!-- The device, the alert, then how long ago at the right (#69). -->
                                            <Label Grid.Column="2" Style="{StaticResource Faint}" Text="{Binding ShortAge}" VerticalOptions="Start" Margin="0,3,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Button Style="{StaticResource LinkButton}" Text="See all alerts" HorizontalOptions="Start"
                                    Command="{Binding Dashboard.ShowAlertsCommand}" CommandParameter="all"
                                    HeightRequest="36" MinimumHeightRequest="36" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.Alerts>

            <pages:DashboardCardTemplateSelector.PinnedDevices>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <Border Style="{StaticResource DashCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Style="{StaticResource CardTitle}" Text="Pinned" />
                            <Label Style="{StaticResource Caption}" Text="Pin a device from Devices or its Device View to see it here."
                                   IsVisible="{Binding Dashboard.HasPinnedDevices, Converter={StaticResource Invert}}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Dashboard.PinnedDevices}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DeviceItem">
                                        <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="44">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding OpenPinnedCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, x:DataType=vm:DashboardViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Ellipse Style="{StaticResource Dot}" Fill="{Binding State, Converter={StaticResource StatusColor}}" />
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Style="{StaticResource RowTitle}" Text="{Binding Name}" />
                                                <Label Style="{StaticResource Caption}" Text="{Binding Details}" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Style="{StaticResource Faint}" Text="{Binding StateText}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.PinnedDevices>

            <pages:DashboardCardTemplateSelector.RecentlyViewed>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <!-- As desktop's widget (#140): the state, name, hardware and location, and when it was opened. -->
                    <Border Style="{StaticResource DashCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Style="{StaticResource CardTitle}" Text="Recently viewed" />
                            <Label Style="{StaticResource Caption}" Text="Devices you open show here."
                                   IsVisible="{Binding Dashboard.HasRecentlyViewed, Converter={StaticResource Invert}}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Dashboard.RecentlyViewed}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RecentDeviceRow">
                                        <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="44">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding OpenRecentCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, x:DataType=vm:DashboardViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Ellipse Style="{StaticResource Dot}" Fill="{Binding Status, Converter={StaticResource StatusColor}}" />
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Style="{StaticResource RowTitle}" Text="{Binding Name}" />
                                                <Label Style="{StaticResource Caption}" Text="{Binding Details}" IsVisible="{Binding HasDetails}" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Style="{StaticResource Faint}" Text="{Binding ViewedText}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.RecentlyViewed>

            <pages:DashboardCardTemplateSelector.Sensors>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <Border Style="{StaticResource DashCard}">
                        <VerticalStackLayout Spacing="4">
                            <!-- Chosen in Customise (Set up), or from this hint - not a button on the card. -->
                            <Label Style="{StaticResource CardTitle}" Text="{Binding Title}" LineBreakMode="TailTruncation" Margin="0,0,0,4" />
                            <Label Style="{StaticResource Caption}" Text="Tap to choose sensors to keep an eye on here." IsVisible="{Binding HasNoSensors}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Dashboard.PickSensorsCommand}" CommandParameter="{Binding .}" />
                                </Label.GestureRecognizers>
                            </Label>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sensors}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="sections:SectionRow">
                                        <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="44">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding OpenRowCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, x:DataType=vm:DashboardViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Ellipse Style="{StaticResource Dot}" Fill="{Binding Status, Converter={StaticResource StatusColor}}" />
                                            <VerticalStackLayout Grid.Column="1">
                                                <!-- The device, then the sensor under it, as desktop's rows (#140). -->
                                                <Label Style="{StaticResource RowTitle}" Text="{Binding Subtitle}" LineBreakMode="TailTruncation" />
                                                <Label Style="{StaticResource Caption}" Text="{Binding Title}" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding Value}" VerticalOptions="Center" FontFamily="BodySemibold"
                                                   TextColor="{Binding Status, Converter={StaticResource StatusText}}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.Sensors>

            <pages:DashboardCardTemplateSelector.Graph>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <Border Style="{StaticResource DashCard}">
                        <VerticalStackLayout Spacing="8">
                            <!-- Its range in the title, as desktop's graph widget (#140); the graph itself in Edit dashboard's Set up. -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Style="{StaticResource CardTitle}" Text="{Binding Title}" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                <Button Grid.Column="1" Style="{StaticResource Chip}" Text="{Binding GraphRangeText}" Command="{Binding ChooseGraphRangeCommand}"
                                        HeightRequest="32" MinimumHeightRequest="32" Padding="10,0"
                                        IsVisible="{Binding GraphNeedsSetUp, Converter={StaticResource Invert}}" />
                            </Grid>
                            <Label Style="{StaticResource Caption}" Text="Tap to choose a device and one of its graphs." IsVisible="{Binding GraphNeedsSetUp}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Dashboard.PickGraphCommand}" CommandParameter="{Binding .}" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Grid IsVisible="{Binding GraphPage, Converter={StaticResource IsNotNull}}">
                                <controls:GraphView Html="{Binding GraphPage}" />
                                <!-- The web view would swallow taps; this opens the device's graphs. -->
                                <BoxView Color="Transparent">
                                    <BoxView.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Dashboard.OpenGraphCommand}" CommandParameter="{Binding .}" />
                                    </BoxView.GestureRecognizers>
                                </BoxView>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.Graph>

            <pages:DashboardCardTemplateSelector.Wireless>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <Border Style="{StaticResource DashCard}">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Style="{StaticResource CardTitle}" Text="Wireless" />
                                <Label Grid.Column="1" Style="{StaticResource CardNote}" Text="{Binding Dashboard.WirelessSummary}" />
                            </Grid>
                            <Label Style="{StaticResource Caption}" Text="No wireless controllers found." IsVisible="{Binding Dashboard.HasNoWirelessControllers}" />
                            <!-- The fleet's clients first, as desktop's widget (#140). -->
                            <HorizontalStackLayout Spacing="8" IsVisible="{Binding Dashboard.HasNoWirelessControllers, Converter={StaticResource Invert}}">
                                <Label Text="{Binding Dashboard.WirelessClientsText}" FontFamily="Display" FontSize="26" VerticalOptions="End" />
                                <Label Style="{StaticResource Caption}" Text="{Binding Dashboard.WirelessClientsNote}" VerticalOptions="End" Margin="0,0,0,4" />
                            </HorizontalStackLayout>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Dashboard.WirelessControllers}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="sections:SectionRow">
                                        <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="44">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding OpenRowCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, x:DataType=vm:DashboardViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Ellipse Style="{StaticResource Dot}" Fill="{Binding Status, Converter={StaticResource StatusColor}}" />
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Style="{StaticResource RowTitle}" Text="{Binding Title}" />
                                                <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding Value}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.Wireless>

            <!-- Top interfaces, Top errors and Top devices (#103), as desktop's widgets:
                 a row per port (or device) with its in and out, and a bar - how full
                 the port is, or against the top row. "Top 5" and the In and Out
                 headings are desktop's controls (#140); the title is in Set up. -->
            <pages:DashboardCardTemplateSelector.Top>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <Border Style="{StaticResource DashCard}">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Style="{StaticResource CardTitle}" Text="{Binding Title}" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                <Button Grid.Column="1" Style="{StaticResource Chip}" Text="{Binding TopCountText, StringFormat='{0} ▾'}"
                                        Command="{Binding ChooseTopCountCommand}" HeightRequest="32" MinimumHeightRequest="32" Padding="10,0"
                                        SemanticProperties.Description="How many to show" />
                            </Grid>
                            <Label Style="{StaticResource Caption}" Text="{Binding TopEmptyText}" IsVisible="{Binding HasNoTopRows}" />
                            <!-- In and Out rank by themselves; tapped again, by both - desktop's headings (#140). -->
                            <Grid ColumnDefinitions="*,80,80" ColumnSpacing="8" Margin="0,4,0,0" IsVisible="{Binding HasNoTopRows, Converter={StaticResource Invert}}">
                                <Label Style="{StaticResource Faint}" Text="{Binding TopNameHeading}" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="IN" Style="{StaticResource LinkButton}" FontSize="12" Padding="0" HeightRequest="32" MinimumHeightRequest="32"
                                        HorizontalOptions="End" Command="{Binding RankHeadingCommand}" CommandParameter="In"
                                        TextColor="{AppThemeBinding Light={StaticResource TextFaintLight}, Dark={StaticResource TextFaintDark}}"
                                        SemanticProperties.Description="Rank by traffic in">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding RanksByIn}" Value="True">
                                            <Setter Property="Text" Value="IN ▾" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Button" Binding="{Binding RanksByTotal}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Grid.Column="2" Text="OUT" Style="{StaticResource LinkButton}" FontSize="12" Padding="0" HeightRequest="32" MinimumHeightRequest="32"
                                        HorizontalOptions="End" Command="{Binding RankHeadingCommand}" CommandParameter="Out"
                                        TextColor="{AppThemeBinding Light={StaticResource TextFaintLight}, Dark={StaticResource TextFaintDark}}"
                                        SemanticProperties.Description="Rank by traffic out">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding RanksByOut}" Value="True">
                                            <Setter Property="Text" Value="OUT ▾" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Button" Binding="{Binding RanksByTotal}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopRows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="dash:TopRow">
                                        <Grid ColumnDefinitions="10,*,80,80" RowDefinitions="Auto,Auto" ColumnSpacing="8" Padding="0,8" MinimumHeightRequest="44">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding OpenTopRowCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, x:DataType=vm:DashboardViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Ellipse Style="{StaticResource Dot}" Fill="{Binding DeviceState, Converter={StaticResource StatusColor}}" />
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Style="{StaticResource RowTitle}" Text="{Binding Title}" LineBreakMode="TailTruncation" />
                                                <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding InText}" HorizontalTextAlignment="End" VerticalOptions="Start" FontFamily="BodySemibold"
                                                   TextColor="{Binding Severity, Converter={StaticResource StatusText}}" />
                                            <Label Grid.Column="3" Text="{Binding OutText}" HorizontalTextAlignment="End" VerticalOptions="Start" FontFamily="BodySemibold"
                                                   TextColor="{Binding Severity, Converter={StaticResource StatusText}}" />
                                            <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0" HeightRequest="4"
                                                         Progress="{Binding Bar}" ProgressColor="{StaticResource PrimaryStroke}">
                                                <ProgressBar.Triggers>
                                                    <DataTrigger TargetType="ProgressBar" Binding="{Binding Severity}" Value="{x:Static sections:RowStatus.Warning}">
                                                        <Setter Property="ProgressColor" Value="{StaticResource WarningColor}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="ProgressBar" Binding="{Binding Severity}" Value="{x:Static sections:RowStatus.Critical}">
                                                        <Setter Property="ProgressColor" Value="{StaticResource CriticalColor}" />
                                                    </DataTrigger>
                                                </ProgressBar.Triggers>
                                            </ProgressBar>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Style="{StaticResource Faint}" Text="{Binding TopFootnote}" IsVisible="{Binding HasTopFootnote}" Margin="0,4,0,0" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.Top>

            <pages:DashboardCardTemplateSelector.Empty>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <ContentView />
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.Empty>

        </pages:DashboardCardTemplateSelector>
    </ContentPage.Resources>


    <Grid RowDefinitions="Auto,*">

        <!-- The logo, name and Customise stay put; the cards scroll beneath
             them, fading out as they pass under (Customise is the sliders
             button - #30, #41). -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="16,16,16,8">
            <!-- The logo is the refresh indicator: its heartbeat sweeps while the
                 dashboard loads - every time, pulled or not - then rests. -->
            <controls:HeartbeatLogo WidthRequest="34" HeightRequest="34" VerticalOptions="Center"
                                    IsBeating="{Binding IsBusy}" />
            <Label Grid.Column="1" Text="DashyNMS" FontSize="22" FontFamily="Display" VerticalOptions="Center" />
            <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                    SemanticProperties.Description="Edit dashboard" SemanticProperties.Hint="Order, remove and add cards">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CustomiseCommand}" />
                </Border.GestureRecognizers>
                <!-- Sliders, from Lucide's "sliders-horizontal" (ISC licence); drawn, not an image, so it follows the theme. -->
                <Path Data="M21 4H14 M10 4H3 M21 12H12 M8 12H3 M21 20H16 M12 20H3 M14 2V6 M8 10V14 M16 18V22"
                      Stroke="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                      StrokeThickness="1.8" StrokeLineCap="Round"
                      WidthRequest="24" HeightRequest="24" Aspect="None"
                      HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <!-- Pull to refresh, with no spinner of its own (see the
                 code-behind): the logo's heartbeat shows the load. -->
            <RefreshView x:Name="Refresh" Command="{Binding RefreshCommand}">
                <!-- No scroll bar: it sat beside the first cards, looking like one of
                     their own (#29). -->
                <ScrollView x:Name="Scroller" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Padding="16,8,16,16" Spacing="4">

                        <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

                        <!-- An empty dashboard (#140): desktop's welcome card - the starter
                             dashboard or the card picker, and a checklist that ticks itself off. -->
                        <Border Style="{StaticResource Card}" Padding="18,20" Margin="0,4,0,0" IsVisible="{Binding ShowWelcome}">
                            <VerticalStackLayout Spacing="14">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <controls:HeartbeatLogo WidthRequest="52" HeightRequest="52" VerticalOptions="Center" IsBeating="{Binding IsBusy}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="Welcome to DashyNMS" FontFamily="Display" FontSize="21" SemanticProperties.HeadingLevel="Level1" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding Welcome.ServerSummary}" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Label Text="Your dashboard is empty. Start with a ready-made one, or pick the cards you want." FontSize="15" />
                                <VerticalStackLayout Spacing="8">
                                    <Button Text="Use the starter dashboard" Command="{Binding UseStarterCommand}" />
                                    <Button Style="{StaticResource SecondaryButton}" Text="Choose cards…" Command="{Binding ChooseCardsCommand}" />
                                    <Label Style="{StaticResource Faint}" Text="{Binding Welcome.StarterText}" />
                                </VerticalStackLayout>
                                <BoxView Style="{StaticResource Divider}" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Style="{StaticResource SectionHeader}" Text="Get set up" />
                                    <Label Grid.Column="1" Style="{StaticResource Faint}" Text="{Binding Welcome.StepsText}" VerticalOptions="Center" />
                                </Grid>
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Welcome.Steps}" Margin="0,-8,0,0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="dash:WelcomeStep">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,6" MinimumHeightRequest="48">
                                                <Border WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10" StrokeThickness="1.5"
                                                        VerticalOptions="Center" BackgroundColor="Transparent"
                                                        Stroke="{AppThemeBinding Light={StaticResource TextFaintLight}, Dark={StaticResource TextFaintDark}}">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource OkColor}" />
                                                            <Setter Property="Stroke" Value="{StaticResource OkColor}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Label Text="✓" FontSize="12" FontFamily="BodySemibold" TextColor="White"
                                                           HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsDone}" />
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                                    <Label Text="{Binding Text}" FontSize="14.5">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextFaintLight}, Dark={StaticResource TextFaintDark}}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                    <Label Style="{StaticResource Faint}" Text="{Binding Tip}" IsVisible="{Binding ShowTip}" />
                                                </VerticalStackLayout>
                                                <Button Grid.Column="2" Style="{StaticResource LinkButton}" Text="{Binding ActionText}"
                                                        Command="{Binding Action}" IsVisible="{Binding ShowAction}" VerticalOptions="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Button Style="{StaticResource LinkButton}" Text="Don't show again" Command="{Binding DismissWelcomeCommand}"
                                        HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Empty, with the welcome card turned off: just how to start. -->
                        <Border Style="{StaticResource Card}" Padding="20,28" Margin="0,4,0,0" IsVisible="{Binding ShowEmpty}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="No cards" FontFamily="BodySemibold" FontSize="16" HorizontalTextAlignment="Center" />
                                <Label Style="{StaticResource Caption}" HorizontalTextAlignment="Center"
                                       Text="Add the cards you want, or start with the starter dashboard." />
                                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,8,0,0">
                                    <Button Text="Add card" Command="{Binding ChooseCardsCommand}" />
                                    <Button Style="{StaticResource SecondaryButton}" Text="Use the starter" Command="{Binding UseStarterCommand}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- One column on a phone; on an iPad or a Mac, as many as fit
                             side by side (#88), in the order they're customised. -->
                        <controls:CardGrid x:Name="CardList" BindableLayout.ItemsSource="{Binding Cards}"
                                           BindableLayout.ItemTemplateSelector="{StaticResource CardTemplates}"
                                           MinColumnWidth="340" MaxColumns="3" Gap="12" />

                        <Label Style="{StaticResource Faint}"
                               Text="{Binding LastUpdated, StringFormat='Updated {0:HH:mm:ss}. Pull down to refresh.'}"
                               HorizontalOptions="Center"
                               Margin="0,16,0,0" />

                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>

            <!-- What just changed, with Undo (#140). -->
            <views:DashboardToastView BindingContext="{Binding Toast}" ZIndex="2" />

            <!-- The cards fade out as they scroll up under the header. -->
            <BoxView HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
                        <GradientStop Offset="1" Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>
        </Grid>

    </Grid>

</ContentPage>
