<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    xmlns:sections="clr-namespace:DashyNMS.Mobile.DeviceSections;assembly=DashyNMS.Mobile.Shared"
    xmlns:cfg="clr-namespace:DesktopNMS.Core.Configuration;assembly=DesktopNMS.Core"
    xmlns:pages="clr-namespace:DashyNMS.Mobile.Pages"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    x:DataType="vm:DashboardViewModel"
    Shell.NavBarIsVisible="False"
    ios:Page.UseSafeArea="True"
    Title="Dashboard">

    <!-- Each widget is one card, its title inside, as in the design
         mock-ups: counts as tiles, lists as rows with a status dot. -->
    <ContentPage.Resources>
        <!-- One template per card kind (DashboardLayout); each reads from the card's Dashboard. -->
        <pages:DashboardCardTemplateSelector x:Key="CardTemplates">

            <!-- Each count opens its tab filtered to it (#32, #34, #64). -->
            <pages:DashboardCardTemplateSelector.AlertsGauge>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Style="{StaticResource CardTitle}" Text="Alerts" />
                                <Label Grid.Column="1" Style="{StaticResource CardNote}"
                                       Text="{Binding Dashboard.LastUpdated, StringFormat='Checked {0:HH:mm}'}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                <Border Style="{StaticResource Tile}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Dashboard.ShowAlertsCommand}" CommandParameter="critical" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Style="{StaticResource TileNumber}" Text="{Binding Dashboard.CriticalAlerts}"
                                               TextColor="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
                                        <Label Style="{StaticResource Caption}" FontSize="14" Text="Critical" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Tile}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Dashboard.ShowAlertsCommand}" CommandParameter="warning" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Style="{StaticResource TileNumber}" Text="{Binding Dashboard.WarningAlerts}"
                                               TextColor="{AppThemeBinding Light={StaticResource WarningTextLight}, Dark={StaticResource WarningTextDark}}" />
                                        <Label Style="{StaticResource Caption}" FontSize="14" Text="Warning" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource Tile}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Dashboard.ShowAlertsCommand}" CommandParameter="ok" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Style="{StaticResource TileNumber}" Text="{Binding Dashboard.OkAlerts}"
                                               TextColor="{AppThemeBinding Light={StaticResource OkTextLight}, Dark={StaticResource OkTextDark}}" />
                                        <Label Style="{StaticResource Caption}" FontSize="14" Text="OK" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Dashboard.ShowAlertsCommand}" CommandParameter="acknowledged" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Style="{StaticResource TileNumber}" Text="{Binding Dashboard.AcknowledgedAlerts}"
                                               TextColor="{AppThemeBinding Light={StaticResource InactiveTextLight}, Dark={StaticResource InactiveTextDark}}" />
                                        <Label Style="{StaticResource Caption}" FontSize="14" Text="Acknowledged" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.AlertsGauge>

            <pages:DashboardCardTemplateSelector.DeviceStatus>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="10">
                            <Label Style="{StaticResource CardTitle}" Text="Devices" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                <Border Style="{StaticResource Tile}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Dashboard.ShowDevicesCommand}" CommandParameter="up" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Style="{StaticResource TileNumber}" Text="{Binding Dashboard.DevicesUp}"
                                               TextColor="{AppThemeBinding Light={StaticResource OkTextLight}, Dark={StaticResource OkTextDark}}" />
                                        <Label Style="{StaticResource Caption}" FontSize="14" Text="Up" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Tile}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Dashboard.ShowDevicesCommand}" CommandParameter="down" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Style="{StaticResource TileNumber}" Text="{Binding Dashboard.DevicesDown}"
                                               TextColor="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
                                        <Label Style="{StaticResource Caption}" FontSize="14" Text="Down" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource Tile}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Dashboard.ShowDevicesCommand}" CommandParameter="maintenance" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Style="{StaticResource TileNumber}" Text="{Binding Dashboard.DevicesMaintenance}"
                                               TextColor="{AppThemeBinding Light={StaticResource MaintenanceTextLight}, Dark={StaticResource MaintenanceTextDark}}" />
                                        <Label Style="{StaticResource Caption}" FontSize="14" Text="Maintenance" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Dashboard.ShowDevicesCommand}" CommandParameter="disabled" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Style="{StaticResource TileNumber}" Text="{Binding Dashboard.DevicesInactive}"
                                               TextColor="{AppThemeBinding Light={StaticResource InactiveTextLight}, Dark={StaticResource InactiveTextDark}}" />
                                        <Label Style="{StaticResource Caption}" FontSize="14" Text="Disabled" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.DeviceStatus>

            <pages:DashboardCardTemplateSelector.Alerts>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Style="{StaticResource CardTitle}" Text="Needs attention" />
                                <Button Grid.Column="1" Style="{StaticResource LinkButton}" Text="See all"
                                        Command="{Binding Dashboard.ShowAlertsCommand}" CommandParameter="all"
                                        HeightRequest="32" MinimumHeightRequest="32" />
                            </Grid>
                            <Label Style="{StaticResource Caption}" Text="Nothing needs attention." IsVisible="{Binding Dashboard.HasNoAlerts}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Dashboard.TopAlerts}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AlertItem">
                                        <Grid ColumnDefinitions="10,*" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="44">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding OpenAlertCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, x:DataType=vm:DashboardViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Ellipse Style="{StaticResource Dot}" Fill="{Binding Severity, Converter={StaticResource StatusColor}}" />
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Style="{StaticResource RowTitle}" Text="{Binding Device}" />
                                                <Label Style="{StaticResource Caption}" Text="{Binding Rule}" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.Alerts>

            <pages:DashboardCardTemplateSelector.PinnedDevices>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Style="{StaticResource CardTitle}" Text="Pinned" />
                            <Label Style="{StaticResource Caption}" Text="Pin a device from Devices or its Device View to see it here."
                                   IsVisible="{Binding Dashboard.HasPinnedDevices, Converter={StaticResource Invert}}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Dashboard.PinnedDevices}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DeviceItem">
                                        <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="44">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding OpenPinnedCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, x:DataType=vm:DashboardViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Ellipse Style="{StaticResource Dot}" Fill="{Binding State, Converter={StaticResource StatusColor}}" />
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Style="{StaticResource RowTitle}" Text="{Binding Name}" />
                                                <Label Style="{StaticResource Caption}" Text="{Binding Details}" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Style="{StaticResource Faint}" Text="{Binding StateText}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.PinnedDevices>

            <pages:DashboardCardTemplateSelector.RecentlyViewed>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="10">
                            <Label Style="{StaticResource CardTitle}" Text="Recently viewed" />
                            <Label Style="{StaticResource Caption}" Text="Devices you open show here."
                                   IsVisible="{Binding Dashboard.HasRecentlyViewed, Converter={StaticResource Invert}}" />
                            <FlexLayout BindableLayout.ItemsSource="{Binding Dashboard.RecentlyViewed}" Wrap="Wrap">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="cfg:RecentlyViewedDevice">
                                        <Button Style="{StaticResource Chip}" Text="{Binding DisplayName}" Margin="0,0,8,8"
                                                Command="{Binding OpenRecentCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, x:DataType=vm:DashboardViewModel}"
                                                CommandParameter="{Binding .}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.RecentlyViewed>

            <pages:DashboardCardTemplateSelector.Sensors>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Style="{StaticResource CardTitle}" Text="Sensors" />
                                <Button Grid.Column="1" Style="{StaticResource LinkButton}" Text="Choose" Command="{Binding Dashboard.PickSensorsCommand}"
                                        HeightRequest="32" MinimumHeightRequest="32" />
                            </Grid>
                            <Label Style="{StaticResource Caption}" Text="Choose sensors to keep an eye on here." IsVisible="{Binding Dashboard.HasNoPinnedSensors}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Dashboard.PinnedSensors}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="sections:SectionRow">
                                        <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="44">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding OpenRowCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, x:DataType=vm:DashboardViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Ellipse Style="{StaticResource Dot}" Fill="{Binding Status, Converter={StaticResource StatusColor}}" />
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Style="{StaticResource RowTitle}" Text="{Binding Title}" />
                                                <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding Value}" VerticalOptions="Center" FontFamily="OpenSansSemibold"
                                                   TextColor="{Binding Status, Converter={StaticResource StatusText}}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.Sensors>

            <pages:DashboardCardTemplateSelector.Graph>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Style="{StaticResource CardTitle}" Text="{Binding Dashboard.GraphTitle}" LineBreakMode="TailTruncation" />
                                <Button Grid.Column="1" Style="{StaticResource LinkButton}" Text="Change" Command="{Binding Dashboard.PickGraphCommand}"
                                        HeightRequest="32" MinimumHeightRequest="32" />
                            </Grid>
                            <Label Style="{StaticResource Caption}" Text="Choose a device and one of its graphs." IsVisible="{Binding Dashboard.GraphNeedsSetUp}" />
                            <Grid IsVisible="{Binding Dashboard.GraphPage, Converter={StaticResource IsNotNull}}">
                                <controls:GraphView Html="{Binding Dashboard.GraphPage}" />
                                <!-- The web view would swallow taps; this opens the device's graphs. -->
                                <BoxView Color="Transparent">
                                    <BoxView.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Dashboard.OpenGraphCommand}" />
                                    </BoxView.GestureRecognizers>
                                </BoxView>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.Graph>

            <pages:DashboardCardTemplateSelector.Wireless>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Style="{StaticResource CardTitle}" Text="Wireless" />
                                <Label Grid.Column="1" Style="{StaticResource CardNote}" Text="{Binding Dashboard.WirelessSummary}" />
                            </Grid>
                            <Label Style="{StaticResource Caption}" Text="No wireless controllers found." IsVisible="{Binding Dashboard.HasNoWirelessControllers}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Dashboard.WirelessControllers}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="sections:SectionRow">
                                        <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="44">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding OpenRowCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, x:DataType=vm:DashboardViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Ellipse Style="{StaticResource Dot}" Fill="{Binding Status, Converter={StaticResource StatusColor}}" />
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Style="{StaticResource RowTitle}" Text="{Binding Title}" />
                                                <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding Value}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.Wireless>

            <pages:DashboardCardTemplateSelector.Empty>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <ContentView />
                </DataTemplate>
            </pages:DashboardCardTemplateSelector.Empty>

        </pages:DashboardCardTemplateSelector>
    </ContentPage.Resources>

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
        <!-- No scroll bar: it sat beside the first cards, looking like one of
             their own (#29). -->
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16" Spacing="4">

                <!-- The logo and name instead of a title bar, scrolling away
                     with the cards; Customise is the sliders button (#30, #41). -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,0,0,8">
                    <Image Source="dashynms_logo.png" WidthRequest="34" HeightRequest="34" VerticalOptions="Center"
                           SemanticProperties.Description="DashyNMS logo" />
                    <Label Grid.Column="1" Text="DashyNMS" FontSize="22" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                    <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                            SemanticProperties.Description="Customise the dashboard" SemanticProperties.Hint="Choose and order the cards">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CustomiseCommand}" />
                        </Border.GestureRecognizers>
                        <!-- Sliders, from Lucide's "sliders-horizontal" (ISC licence); drawn, not an image, so it follows the theme. -->
                        <Path Data="M21 4H14 M10 4H3 M21 12H12 M8 12H3 M21 20H16 M12 20H3 M14 2V6 M8 10V14 M16 18V22"
                              Stroke="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                              StrokeThickness="1.8" StrokeLineCap="Round"
                              WidthRequest="24" HeightRequest="24" Aspect="None"
                              HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
                <controls:LoadingIndicator IsVisible="{Binding IsLoadingFirstTime}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Cards}"
                                     BindableLayout.ItemTemplateSelector="{StaticResource CardTemplates}"
                                     Spacing="12" />

                <Label Style="{StaticResource Faint}"
                       Text="{Binding LastUpdated, StringFormat='Updated {0:HH:mm:ss}. Pull down to refresh.'}"
                       HorizontalOptions="Center"
                       Margin="0,16,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
