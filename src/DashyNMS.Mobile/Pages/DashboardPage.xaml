<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    x:DataType="vm:DashboardViewModel"
    Title="Dashboard">

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="4">

                <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

                <Label Style="{StaticResource SectionHeader}" Text="ALERTS" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="{Binding CriticalAlerts}" FontSize="28" TextColor="{StaticResource CriticalColor}" />
                            <Label Style="{StaticResource Caption}" Text="Critical" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="{Binding WarningAlerts}" FontSize="28" TextColor="{StaticResource WarningColor}" />
                            <Label Style="{StaticResource Caption}" Text="Warning" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="{Binding AcknowledgedAlerts}" FontSize="28" />
                            <Label Style="{StaticResource Caption}" Text="Acknowledged" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label Style="{StaticResource SectionHeader}" Text="DEVICES" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="{Binding DevicesUp}" FontSize="28" TextColor="{StaticResource OkColor}" />
                            <Label Style="{StaticResource Caption}" Text="Up" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="{Binding DevicesDown}" FontSize="28" TextColor="{StaticResource CriticalColor}" />
                            <Label Style="{StaticResource Caption}" Text="Down" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="{Binding DevicesInactive}" FontSize="28" TextColor="{StaticResource InactiveColor}" />
                            <Label Style="{StaticResource Caption}" Text="Disabled / ignored" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label Style="{StaticResource SectionHeader}" Text="NEEDS ATTENTION" />
                <Label Style="{StaticResource Caption}" Text="Nothing needs attention." IsVisible="{Binding HasNoAlerts}" Margin="4,0" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopAlerts}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AlertItem">
                            <Border Style="{StaticResource Card}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenDeviceCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, x:DataType=vm:DashboardViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="6,*" ColumnSpacing="12">
                                    <BoxView Color="{Binding Severity, Converter={StaticResource StatusColor}}" CornerRadius="3" />
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="{Binding Rule}" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding Device}" LineBreakMode="TailTruncation" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding Summary}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Style="{StaticResource Caption}"
                       Text="{Binding LastUpdated, StringFormat='Updated {0:HH:mm:ss}. Pull down to refresh.'}"
                       HorizontalOptions="Center"
                       Margin="0,16,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
