<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.UnimusDiffPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:unimus="clr-namespace:DashyNMS.Mobile.Unimus;assembly=DashyNMS.Mobile.Shared"
    x:DataType="unimus:UnimusDiffViewModel"
    SafeAreaEdges="Container" Title="Changes">
    <Grid x:Name="Body" RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16,0,16,0" SafeAreaEdges="None">
        <controls:PageHeader x:Name="Header" SafeAreaEdges="None" Title="Changes">
            <controls:PageHeader.Actions>
                <Button x:Name="ShareButton" Style="{StaticResource LinkButton}" Text="Share" Command="{Binding ShareCommand}"
                        MinimumHeightRequest="44" MinimumWidthRequest="44" SemanticProperties.Description="Share complete diff" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>
        <VerticalStackLayout Grid.Row="1" Margin="4,0,4,8" Spacing="4">
            <Label Style="{StaticResource RowTitle}" Text="{Binding DeviceName}" LineBreakMode="WordWrap" />
            <Label Style="{StaticResource Caption}" Text="{Binding OriginalIdentity}" LineBreakMode="WordWrap" />
            <Label Style="{StaticResource Caption}" Text="{Binding RevisedIdentity}" LineBreakMode="WordWrap" />
            <Label Style="{StaticResource Caption}" Text="{Binding SummaryText}" />
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="2" Spacing="4" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" MinimumHeightRequest="44">
                <Switch IsToggled="{Binding OnlyChanged}" SemanticProperties.Description="Only changes" />
                <Label Grid.Column="1" Text="Only changes" AutomationProperties.ExcludedWithChildren="True" Style="{StaticResource Caption}" VerticalOptions="Center" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" MinimumHeightRequest="44">
                <Switch IsToggled="{Binding IgnoreEmptyLines}" SemanticProperties.Description="Ignore blank lines" />
                <Label Grid.Column="1" Text="Ignore blank lines" AutomationProperties.ExcludedWithChildren="True" Style="{StaticResource Caption}" VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="3" IsVisible="{Binding HasError}" Spacing="8">
            <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" />
            <Button Text="Retry" Style="{StaticResource SecondaryButton}" Command="{Binding RetryCommand}" MinimumHeightRequest="44" />
        </VerticalStackLayout>
        <controls:BusyCard Grid.Row="4" Text="Comparing…" IsVisible="{Binding IsBusy}" ZIndex="1" />
        <Border Grid.Row="4" Style="{StaticResource ListCard}" SafeAreaEdges="None" Margin="0" Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource CodeDark}}">
            <Grid>
                <CollectionView x:Name="Rows" ItemsSource="{Binding Lines}" SelectionMode="None">
                    <CollectionView.Header>
                        <BoxView HeightRequest="20" Color="Transparent" InputTransparent="True" />
                    </CollectionView.Header>
                    <CollectionView.EmptyView>
                        <Label Style="{StaticResource Caption}" Text="No differences with the current comparison options."
                               IsVisible="{Binding IsEmpty}" HorizontalTextAlignment="Center" Margin="20,32" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="unimus:UnimusDiffItem">
                            <VerticalStackLayout Spacing="0">
                                <Grid Padding="8,2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" IsVisible="{Binding IsContent}"
                                      SemanticProperties.Description="{Binding ContentDescription}">
                                    <Grid.Triggers>
                                        <DataTrigger TargetType="Grid" Binding="{Binding IsAdded}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource OkTint}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Grid" Binding="{Binding IsRemoved}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource CriticalTint}" />
                                        </DataTrigger>
                                    </Grid.Triggers>
                                    <Label Text="{Binding NumberText}" FontFamily="Mono" FontSize="12" AutomationProperties.ExcludedWithChildren="True"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource Gray100}}" />
                                    <Label Grid.Column="1" Text="{Binding Prefix}" FontFamily="Mono" FontSize="14" AutomationProperties.ExcludedWithChildren="True"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource Gray100}}" />
                                    <Label Grid.Column="2" Text="{Binding Text}" FontFamily="Mono" FontSize="14" LineBreakMode="CharacterWrap"
                                           AutomationProperties.ExcludedWithChildren="True"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource Gray100}}" />
                                </Grid>
                                <Label Text="{Binding HiddenText}" Style="{StaticResource Caption}" IsVisible="{Binding IsHidden}" AutomationProperties.ExcludedWithChildren="True" />
                                <Button Text="Show context" Style="{StaticResource SecondaryButton}" IsVisible="{Binding IsHidden}" MinimumHeightRequest="44"
                                        SemanticProperties.Description="{Binding ContextActionDescription}"
                                        Command="{Binding ExpandCommand, Source={RelativeSource AncestorType={x:Type unimus:UnimusDiffViewModel}}, x:DataType=unimus:UnimusDiffViewModel}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.Footer>
                        <BoxView x:Name="RowFoot" HeightRequest="20" Color="Transparent" InputTransparent="True" />
                    </CollectionView.Footer>
                </CollectionView>
                <BoxView HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource CodeDark}}" />
                            <GradientStop Offset="1" Color="{AppThemeBinding Light='#00EEF1F5', Dark='#000D1015'}" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
