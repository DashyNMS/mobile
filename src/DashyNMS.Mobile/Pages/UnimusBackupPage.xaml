<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.UnimusBackupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:unimus="clr-namespace:DashyNMS.Mobile.Unimus;assembly=DashyNMS.Mobile.Shared"
    x:DataType="unimus:UnimusBackupViewModel"
    SafeAreaEdges="Container"
    Title="{Binding Title}">

    <!-- One backup (#21): numbered, monospaced, and searched down to the matching lines. -->
    <Grid x:Name="Body" RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16,0,16,0" SafeAreaEdges="None">
        <controls:PageHeader x:Name="Header" SafeAreaEdges="None" Title="{Binding Title}">
            <controls:PageHeader.Actions>
                <HorizontalStackLayout Spacing="8">
                <controls:IconButton Icon="{x:Static controls:Icons.Search}" Kind="Plain" Text="Search" MinimumHeightRequest="44" MinimumWidthRequest="44" SemanticProperties.Description="Search this backup" Clicked="OnSearchClicked" />
                <Button Style="{StaticResource LinkButton}" Text="Share" MinimumHeightRequest="44" MinimumWidthRequest="44" SemanticProperties.Description="Share complete backup" Command="{Binding ShareCommand}" />
                </HorizontalStackLayout>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Grid x:Name="SearchSlot" Grid.Row="1" IsClippedToBounds="True" SafeAreaEdges="None">
            <controls:SearchField x:Name="SearchBox" Margin="0,2,0,0" VerticalOptions="Start">
                <Entry x:Name="SearchEntry" Text="{Binding SearchText}" Placeholder="Search this backup" Completed="OnSearchCompleted" />
            </controls:SearchField>
        </Grid>

        <VerticalStackLayout Grid.Row="2" Spacing="4" Margin="4,6,0,6">
            <Label Style="{StaticResource RowTitle}" Text="{Binding Subtitle}" LineBreakMode="WordWrap" />
            <Label Style="{StaticResource Caption}" Text="{Binding VersionTime}" LineBreakMode="WordWrap" />
            <Label Style="{StaticResource Faint}" Text="{Binding CountText}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="3">
            <Label Style="{StaticResource Caption}" Text="{Binding ShareStatus}" IsVisible="{Binding HasShareStatus}" />
            <VerticalStackLayout IsVisible="{Binding HasError}">
            <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" />
            <Button Text="Retry" Style="{StaticResource LinkButton}" MinimumHeightRequest="44" Command="{Binding RetryCommand}" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <controls:BusyCard Grid.Row="4" Text="Loading backup…" IsVisible="{Binding IsBusy}" ZIndex="1" />
        <Border Grid.Row="4" Style="{StaticResource ListCard}" SafeAreaEdges="None" Margin="0" Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource CodeDark}}">
            <Grid SafeAreaEdges="None">
            <CollectionView controls:KeyboardDismiss.OnScroll="False" x:Name="Rows" ItemsSource="{Binding Lines}" SelectionMode="None">
                <CollectionView.Header>
                    <BoxView HeightRequest="20" Color="Transparent" InputTransparent="True" />
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                           HorizontalTextAlignment="Center" Margin="20,32" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="unimus:UnimusLine">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="8,1">
                            <Label Text="{Binding NumberText}" FontFamily="Mono" FontSize="11" HorizontalTextAlignment="End"
                                   AutomationProperties.ExcludedWithChildren="True"
                                   TextColor="{AppThemeBinding Light={StaticResource TextFaintLight}, Dark={StaticResource TextFaintDark}}" />
                            <Label Grid.Column="1" Text="{Binding Text}" FontFamily="Mono" FontSize="12" LineBreakMode="CharacterWrap"
                                   SemanticProperties.Description="{Binding ContentDescription}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource Gray100}}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <BoxView x:Name="RowFoot" HeightRequest="24" Color="Transparent" InputTransparent="True" />
                </CollectionView.Footer>
            </CollectionView>
        <BoxView Margin="1,1,1,0" HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource CodeDark}}" />
                    <GradientStop Offset="1" Color="{AppThemeBinding Light=#00EEF1F5, Dark=#000D1015}" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>
            </Grid>
        </Border>

    </Grid>

</ContentPage>
