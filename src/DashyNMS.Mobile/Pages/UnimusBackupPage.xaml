<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.UnimusBackupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:unimus="clr-namespace:DashyNMS.Mobile.Unimus;assembly=DashyNMS.Mobile.Shared"
    x:DataType="unimus:UnimusBackupViewModel"
    SafeAreaEdges="Container"
    Title="{Binding Title}">

    <!-- One backup (#21): numbered, monospaced, and searched down to the matching lines. -->
    <Grid x:Name="Body" RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16,0,16,0" SafeAreaEdges="None">
        <controls:PageHeader x:Name="Header" SafeAreaEdges="None" Title="{Binding Title}">
            <controls:PageHeader.Actions>
                <Button Style="{StaticResource LinkButton}" Text="Share" Command="{Binding ShareCommand}" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <SearchBar Grid.Row="1" Text="{Binding SearchText}" Placeholder="Search this backup" Margin="-6,2,-6,0" />

        <Label Grid.Row="2" Style="{StaticResource Faint}" Margin="4,6,0,6">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="{Binding Subtitle}" />
                    <Span Text=" · " />
                    <Span Text="{Binding CountText}" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <Label Grid.Row="3" Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

        <controls:BusyCard Grid.Row="4" Text="Loading backup…" IsVisible="{Binding IsBusy}" ZIndex="1" />
        <Border Grid.Row="4" Style="{StaticResource ListCard}" SafeAreaEdges="None" Margin="0" Padding="0,6"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource CodeDark}}">
            <CollectionView x:Name="Rows" ItemsSource="{Binding Lines}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                           HorizontalTextAlignment="Center" Margin="20,32" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="unimus:UnimusLine">
                        <Grid ColumnDefinitions="40,*" ColumnSpacing="8" Padding="8,1">
                            <Label Text="{Binding NumberText}" FontFamily="Mono" FontSize="11" HorizontalTextAlignment="End"
                                   TextColor="{AppThemeBinding Light={StaticResource TextFaintLight}, Dark={StaticResource TextFaintDark}}" />
                            <Label Grid.Column="1" Text="{Binding Text}" FontFamily="Mono" FontSize="12" LineBreakMode="CharacterWrap"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource Gray100}}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <BoxView x:Name="RowFoot" HeightRequest="24" Color="Transparent" InputTransparent="True" />
                </CollectionView.Footer>
            </CollectionView>
        </Border>
        <BoxView Grid.Row="4" HeightRequest="12" VerticalOptions="Start" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
                    <GradientStop Offset="1" Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>
    </Grid>

</ContentPage>
