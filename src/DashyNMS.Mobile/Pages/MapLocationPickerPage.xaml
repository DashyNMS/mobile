<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.MapLocationPickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:map="clr-namespace:DashyNMS.Mobile.Map;assembly=DashyNMS.Mobile.Shared"
    x:DataType="map:MapLocationPickerViewModel"
    Title="Locations">
    <controls:SetupLayout x:Name="Setup">
        <controls:SetupLayout.Header>
            <controls:PageHeader x:Name="Header" Title="Choose a location" />
        </controls:SetupLayout.Header>
        <controls:SetupLayout.Body>
            <Grid RowDefinitions="Auto,*" SafeAreaEdges="None">
                <VerticalStackLayout Spacing="8" Padding="0,0,0,8">
                    <controls:SearchField>
                        <Entry x:Name="SearchEntry" Text="{Binding SearchText}" Placeholder="Location name or coordinates"
                               SemanticProperties.Description="Search map locations by name or coordinates" />
                    </controls:SearchField>
                    <Label Style="{StaticResource Caption}" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" />
                    <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
                    <Label Style="{StaticResource Caption}" Text="Go back and reopen the location picker to use the current map." IsVisible="{Binding HasError}" />
                </VerticalStackLayout>
                <Grid Grid.Row="1" SafeAreaEdges="None">
                <CollectionView x:Name="DeviceList" ItemsSource="{Binding Choices}"
                                SelectionMode="None" controls:KeyboardDismiss.OnScroll="True">
                    <CollectionView.Header>
                        <BoxView HeightRequest="20" Color="Transparent" InputTransparent="True" />
                    </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="map:MapLocationChoice">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,6" MinimumHeightRequest="44"
                                    AutomationProperties.IsInAccessibleTree="True"
                                    SemanticProperties.Description="{Binding Description}"
                                    SemanticProperties.Hint="Selects this location and returns immediately">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding ChooseCommand, Source={RelativeSource AncestorType={x:Type map:MapLocationPickerViewModel}}, x:DataType=map:MapLocationPickerViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource RowTitle}" Text="{Binding Name}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Details}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                    <Label Style="{StaticResource Caption}" Text="Selected" IsVisible="{Binding IsSelected}" AutomationProperties.IsInAccessibleTree="False" />
                                </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <BoxView HeightRequest="12" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
            <BoxView HeightRequest="20" VerticalOptions="Start" InputTransparent="True" ZIndex="1">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
                        <GradientStop Offset="1" Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>
            </Grid>
            </Grid>
        </controls:SetupLayout.Body>
    </controls:SetupLayout>
</ContentPage>
