<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.UnimusSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:unimus="clr-namespace:DashyNMS.Mobile.Unimus;assembly=DashyNMS.Mobile.Shared"
    x:DataType="unimus:UnimusSettingsViewModel"
    Title="Unimus">
    <controls:SetupLayout x:Name="Setup">
        <controls:SetupLayout.Header>
            <controls:PageHeader x:Name="Header" Title="Unimus" />
        </controls:SetupLayout.Header>
        <controls:SetupLayout.Body>
            <Grid SafeAreaEdges="None">
                <ScrollView x:Name="FormScroll" SafeAreaEdges="None">
                    <VerticalStackLayout Padding="0,20,0,0" Spacing="8">
                        <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout>
                                    <Label Text="Unimus" />
                                    <Label Style="{StaticResource Caption}"
                                           Text="Config backups and what changed between them, on each device's page. DashyNMS talks to Unimus directly, with its own API token." />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding Enabled}" VerticalOptions="Center"
                                        SemanticProperties.Description="Enable Unimus" />
                            </Grid>
                        </Border>

                        <Label Style="{StaticResource SectionHeader}" Text="SERVER" />
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="8">
                                <controls:SetupSection Label="Address">
                                    <Entry Text="{Binding Url}" Placeholder="unimus.example.com" Keyboard="Url"
                                           IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                                           SemanticProperties.Description="Unimus server address" />
                                </controls:SetupSection>
                                <controls:SetupSection Label="API token">
                                    <VerticalStackLayout Spacing="4">
                                        <Entry Text="{Binding TokenInput}" IsPassword="True"
                                               IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                                               SemanticProperties.Description="Unimus API token" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding TokenStatusText}" />
                                    </VerticalStackLayout>
                                </controls:SetupSection>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,6,0,0">
                                    <VerticalStackLayout>
                                        <Label Text="Allow untrusted certificate" />
                                        <Label Style="{StaticResource Caption}" Text="Only for a self-signed server you trust: any certificate is then accepted." />
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="1" IsToggled="{Binding AllowUntrustedCertificate}" VerticalOptions="Center"
                                            SemanticProperties.Description="Allow untrusted certificate" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Label Style="{StaticResource Caption}" Text="Test checks these draft connection settings without saving them." />
                        <Button Style="{StaticResource SecondaryButton}" Text="Test connection" Command="{Binding TestCommand}" IsEnabled="{Binding IsNotBusy}" Margin="0,12,0,0" />
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                        <Label Text="{Binding TestResultText}" IsVisible="{Binding HasTestResult}" HorizontalTextAlignment="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding TestSucceeded}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource OkColor}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding TestSucceeded}" Value="False">
                                    <Setter Property="TextColor" Value="{StaticResource CriticalColor}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <Label Style="{StaticResource SectionHeader}" Text="MATCHING DEVICES" />
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="8">
                                <controls:SetupSection Label="LibreNMS domain (optional)">
                                    <Entry Text="{Binding MyDomain}" Placeholder="example.net" Keyboard="Url"
                                           IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" SemanticProperties.Description="LibreNMS domain (optional)" />
                                </controls:SetupSection>
                                <Label Style="{StaticResource Caption}"
                                       Text="Devices are matched to Unimus by host name, then IP address. If LibreNMS adds a domain to short names (its mydomain setting), enter it here too." />
                            </VerticalStackLayout>
                        </Border>

                        <controls:SetupSection Label="Saved token" IsVisible="{Binding CanForgetToken}">
                            <VerticalStackLayout Spacing="4">
                                <Label Style="{StaticResource Caption}"
                                       Text="Forget removes the saved token from this phone immediately after confirmation, without saving this form." />
                                <Button Style="{StaticResource SecondaryButton}" Text="Forget saved token"
                                        Command="{Binding ForgetTokenCommand}" />
                            </VerticalStackLayout>
                        </controls:SetupSection>
                    </VerticalStackLayout>
                </ScrollView>
                <BoxView HeightRequest="20" VerticalOptions="Start" InputTransparent="True" ZIndex="1">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
                            <GradientStop Offset="1" Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
            </Grid>
        </controls:SetupLayout.Body>
        <controls:SetupLayout.PrimaryAction>
            <Button Text="Save" Command="{Binding SaveCommand}" HorizontalOptions="Fill" Margin="0,12,0,0" />
        </controls:SetupLayout.PrimaryAction>
    </controls:SetupLayout>
</ContentPage>
