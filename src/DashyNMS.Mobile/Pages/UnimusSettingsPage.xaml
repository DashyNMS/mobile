<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.UnimusSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:unimus="clr-namespace:DashyNMS.Mobile.Unimus;assembly=DashyNMS.Mobile.Shared"
    x:DataType="unimus:UnimusSettingsViewModel"
    ios:Page.UseSafeArea="True"
    SafeAreaEdges="Container"
    Title="Unimus">
    <Grid RowDefinitions="Auto,*">
        <!-- The app's own header, as every page: the title, "‹ Back" when pushed (#142). -->
        <controls:PageHeader x:Name="Header" Title="Unimus" Margin="16,0,16,0">
            <controls:PageHeader.Actions>
                <Button Style="{StaticResource LinkButton}" Text="Save" Command="{Binding SaveCommand}" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <ScrollView Grid.Row="1">
            <controls:ReadableColumn>
                <VerticalStackLayout Padding="16" Spacing="4">

                    <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="Unimus" />
                                <Label Style="{StaticResource Caption}"
                                       Text="Config backups and what changed between them, on each device's page. DashyNMS talks to Unimus directly, with its own API token." />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding Enabled}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Label Style="{StaticResource SectionHeader}" Text="SERVER" />
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Address" />
                            <Entry Text="{Binding Url}" Placeholder="unimus.example.com" Keyboard="Url"
                                   IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />

                            <Label Text="API token" />
                            <Entry Text="{Binding TokenInput}" IsPassword="True"
                                   IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                            <Label Style="{StaticResource Caption}" Text="{Binding TokenStatusText}" />
                            <Button Text="Forget saved token" Command="{Binding ForgetTokenCommand}"
                                    IsVisible="{Binding CanForgetToken}" HorizontalOptions="Start" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,6,0,0">
                                <VerticalStackLayout>
                                    <Label Text="Allow untrusted certificate" />
                                    <Label Style="{StaticResource Caption}" Text="Only for a self-signed server you trust: any certificate is then accepted." />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding AllowUntrustedCertificate}" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="Test connection" Command="{Binding TestCommand}" IsEnabled="{Binding IsNotBusy}" Margin="0,12,0,0" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                    <Label Text="{Binding TestResultText}" IsVisible="{Binding HasTestResult}" HorizontalTextAlignment="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding TestSucceeded}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource OkColor}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding TestSucceeded}" Value="False">
                                <Setter Property="TextColor" Value="{StaticResource CriticalColor}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <Label Style="{StaticResource SectionHeader}" Text="MATCHING DEVICES" />
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="LibreNMS domain (optional)" />
                            <Entry Text="{Binding MyDomain}" Placeholder="example.net" Keyboard="Url"
                                   IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                            <Label Style="{StaticResource Caption}"
                                   Text="Devices are matched to Unimus by host name, then IP address. If LibreNMS adds a domain to short names (its mydomain setting), enter it here too." />
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="Save" Command="{Binding SaveCommand}" Margin="0,16,0,0" />

                </VerticalStackLayout>
            </controls:ReadableColumn>
        </ScrollView>
    </Grid>

</ContentPage>
