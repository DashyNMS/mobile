<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="DashyNMS.Mobile.Pages.NeighbourGroupEditorPage"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
 xmlns:topo="clr-namespace:DashyNMS.Mobile.Topology;assembly=DashyNMS.Mobile.Shared"
 x:DataType="topo:NeighbourGroupEditorViewModel" Title="{Binding Heading}" HideSoftInputOnTapped="True">
 <controls:SetupLayout x:Name="Setup">
  <controls:SetupLayout.Header><controls:PageHeader x:Name="Header" Title="{Binding Heading}" /></controls:SetupLayout.Header>
  <controls:SetupLayout.Body>
   <ScrollView x:Name="FormScroll" SafeAreaEdges="None">
    <VerticalStackLayout Spacing="12" Padding="0,8,0,12">
     <Label Style="{StaticResource Caption}" Text="Save applies the name and rules. Back discards these changes. Deleting a saved neighbourhood applies straight away." />
     <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
     <controls:SetupSection Label="Name">
      <Border Style="{StaticResource Field}"><Entry Text="{Binding Name}" Placeholder="Wireless APs" SemanticProperties.Description="Neighbourhood name" /></Border>
     </controls:SetupSection>
     <controls:SetupSection Label="Match">
      <Picker Title="Match rules" ItemsSource="{Binding MatchChoices}" SelectedIndex="{Binding MatchIndex}" SemanticProperties.Description="How neighbourhood rules match" />
     </controls:SetupSection>
     <Label Style="{StaticResource Faint}" Text="{Binding GroupMatchText}" IsVisible="{Binding HasGroupMatchText}" />
     <Label Style="{StaticResource SectionHeader}" Text="Rules" SemanticProperties.HeadingLevel="Level2" />
     <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rules}" Spacing="8">
      <BindableLayout.ItemTemplate>
       <DataTemplate x:DataType="topo:NeighbourRuleRow">
        <Border Style="{StaticResource Card}">
         <VerticalStackLayout Spacing="8">
          <Label Style="{StaticResource Caption}" Text="{Binding UnsupportedText}" IsVisible="{Binding IsUnsupported}" LineBreakMode="WordWrap" />
          <VerticalStackLayout Spacing="8" IsVisible="{Binding IsSupported}">
           <controls:SetupSection Label="Field"><Picker Title="Rule field" ItemsSource="{Binding Fields}" SelectedIndex="{Binding FieldIndex}" SemanticProperties.Description="Neighbour rule field" /></controls:SetupSection>
           <controls:SetupSection Label="Test"><Picker Title="Rule test" ItemsSource="{Binding Operators}" SelectedIndex="{Binding OperatorIndex}" SemanticProperties.Description="Neighbour rule test" /></controls:SetupSection>
           <controls:SetupSection Label="Value"><Border Style="{StaticResource Field}"><Entry Text="{Binding Value}" Placeholder="Value" SemanticProperties.Description="Neighbour rule value" /></Border></controls:SetupSection>
           <Label Style="{StaticResource Error}" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" LineBreakMode="WordWrap" />
          </VerticalStackLayout>
          <Label Style="{StaticResource Faint}" Text="{Binding MatchText}" IsVisible="{Binding HasMatchText}" />
          <Button Style="{StaticResource SecondaryButton}" Text="Remove rule" MinimumHeightRequest="44"
           SemanticProperties.Description="{Binding RemovalDescription}"
           Command="{Binding RemoveRuleCommand, Source={RelativeSource AncestorType={x:Type topo:NeighbourGroupEditorViewModel}}, x:DataType=topo:NeighbourGroupEditorViewModel}" CommandParameter="{Binding .}" />
         </VerticalStackLayout>
        </Border>
       </DataTemplate>
      </BindableLayout.ItemTemplate>
     </VerticalStackLayout>
     <Button Style="{StaticResource SecondaryButton}" Text="Add a rule" MinimumHeightRequest="44" Command="{Binding AddRuleCommand}" />
     <Button Style="{StaticResource DangerButton}" Text="Delete neighbourhood" MinimumHeightRequest="44" Command="{Binding DeleteCommand}" IsVisible="{Binding IsExisting}" />
    </VerticalStackLayout>
   </ScrollView>
  </controls:SetupLayout.Body>
  <controls:SetupLayout.PrimaryAction><Button Text="Save" Command="{Binding SaveCommand}" Margin="0,12,0,0" /></controls:SetupLayout.PrimaryAction>
 </controls:SetupLayout>
</ContentPage>
