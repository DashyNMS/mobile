<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.SensorDefinitionsSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    x:DataType="vm:SensorDefinitionsSettingsViewModel"
    Title="Sensor definitions">
    <controls:SetupLayout x:Name="Setup">
        <controls:SetupLayout.Header>
            <controls:PageHeader x:Name="Header" Title="Sensor definitions" />
        </controls:SetupLayout.Header>
        <controls:SetupLayout.Body>
            <ScrollView x:Name="FormScroll" SafeAreaEdges="None">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
                    <Label Style="{StaticResource Caption}" Text="Save applies the settings below. Back discards changes." />
                    <controls:SetupSection Label="Sensor definitions">
                        <VerticalStackLayout Spacing="4">
                            <Switch IsToggled="{Binding Enabled}" HorizontalOptions="Start"
                                    SemanticProperties.Description="Enable sensor definitions" />
                            <Label Style="{StaticResource Caption}"
                                   Text="Names and colours for state sensors (&quot;Ready&quot;, &quot;Fan failed&quot;), from a catalogue on GitHub that updates without an app release. Checked at most once a day; the downloaded copy works offline. Saving with this off deletes it." />
                        </VerticalStackLayout>
                    </controls:SetupSection>
                    <controls:SetupSection Label="Source">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Use my own repository" />
                            <Switch IsToggled="{Binding UseCustomRepository}" HorizontalOptions="Start"
                                    SemanticProperties.Description="Use my own repository" />
                            <Label Style="{StaticResource Caption}" Text="A public GitHub repository laid out like DashyNMS/sensor-definitions." />
                            <Entry Text="{Binding CustomRepository}" Placeholder="https://github.com/owner/sensor-definitions"
                                   Keyboard="Url" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                                   SemanticProperties.Description="Custom repository address"
                                   IsVisible="{Binding UseCustomRepository}" />
                            <Label Style="{StaticResource Caption}" Text="{Binding SourceText}" LineBreakMode="CharacterWrap" />
                        </VerticalStackLayout>
                    </controls:SetupSection>
                    <controls:SetupSection Label="Installed catalogue">
                        <VerticalStackLayout Spacing="8">
                            <Label Style="{StaticResource Caption}" Text="Read-only catalogue details. Update now applies straight away using the saved source." />
                            <Label Style="{StaticResource Caption}" Text="{Binding SavedSourceText}" LineBreakMode="CharacterWrap" />
                            <controls:SetupSection Label="Version">
                                <Label Text="{Binding VersionText}" />
                            </controls:SetupSection>
                            <controls:SetupSection Label="Last checked">
                                <Label Text="{Binding LastCheckText}" />
                            </controls:SetupSection>
                            <Button Style="{StaticResource SecondaryButton}" Text="Update now"
                                    Command="{Binding UpdateNowCommand}" IsEnabled="{Binding CanUpdate}" />
                            <Label Style="{StaticResource Caption}" Text="{Binding UpdateExplanation}" />
                            <ActivityIndicator IsRunning="{Binding IsUpdating}" IsVisible="{Binding IsUpdating}" />
                            <Label Style="{StaticResource Caption}" Text="{Binding StatusText}" />
                        </VerticalStackLayout>
                    </controls:SetupSection>
                </VerticalStackLayout>
            </ScrollView>
        </controls:SetupLayout.Body>
        <controls:SetupLayout.PrimaryAction>
            <Button Text="Save" Command="{Binding SaveCommand}" HorizontalOptions="Fill" Margin="0,12,0,0" />
        </controls:SetupLayout.PrimaryAction>
    </controls:SetupLayout>
</ContentPage>
