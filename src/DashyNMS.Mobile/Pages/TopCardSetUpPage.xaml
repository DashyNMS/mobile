<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.TopCardSetUpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:dash="clr-namespace:DashyNMS.Mobile.Dashboard;assembly=DashyNMS.Mobile.Shared"
    x:DataType="dash:TopCardSetUpViewModel"
    ios:Page.UseSafeArea="True"
    SafeAreaEdges="Container"
    Title="{Binding KindTitle}">

    <ScrollView>
        <controls:ReadableColumn>
            <VerticalStackLayout Padding="16,4,16,16" Spacing="12">

                <controls:BackBar x:Name="TopBar">
                    <controls:BackBar.Actions>
                        <Button Style="{StaticResource LinkButton}" Text="Save" Command="{Binding SaveCommand}" />
                    </controls:BackBar.Actions>
                </controls:BackBar>
                <Label Style="{StaticResource PageTitle}" Text="{Binding KindTitle}" SemanticProperties.HeadingLevel="Level1" Margin="0,-12,0,0" />

                <!-- The card's own title (#103); blank, it's the kind's. -->
                <Entry Text="{Binding CardTitle}" Placeholder="Card title (optional)" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="Rows" VerticalOptions="Center" />
                            <Picker Grid.Column="1" Title="Rows" ItemsSource="{Binding Counts}" SelectedItem="{Binding SelectedCount}"
                                    MinimumWidthRequest="120" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="Rank by" VerticalOptions="Center" />
                            <Picker Grid.Column="1" Title="Rank by" ItemsSource="{Binding Ranks}" SelectedItem="{Binding SelectedRank}"
                                    ItemDisplayBinding="{Binding Label, x:DataType=dash:RankChoice}"
                                    MinimumWidthRequest="180" VerticalOptions="Center" />
                        </Grid>
                        <!-- Top errors only: a healthy network says so rather than listing zeros. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsErrors}">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Hide ports with no errors" />
                                <Label Style="{StaticResource Caption}" Text="Off lists every port, errors or not." />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding HideQuiet}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Style="{StaticResource Caption}"
                       Text="The same options as the card on DashyNMS desktop, so it looks alike in both." />

            </VerticalStackLayout>
        </controls:ReadableColumn>
    </ScrollView>

</ContentPage>
