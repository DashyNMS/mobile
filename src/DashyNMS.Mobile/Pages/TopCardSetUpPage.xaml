<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.TopCardSetUpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:dash="clr-namespace:DashyNMS.Mobile.Dashboard;assembly=DashyNMS.Mobile.Shared"
    x:DataType="dash:TopCardSetUpViewModel"
    Title="{Binding KindTitle}">

    <!-- The shared setup layout (#397): a fixed heading, full-width scrolling fields and Save fixed at the page base. -->
    <controls:SetupLayout x:Name="Setup">
        <controls:SetupLayout.Header>
            <controls:PageHeader x:Name="Header" Title="{Binding KindTitle}" />
        </controls:SetupLayout.Header>
        <controls:SetupLayout.Body>
            <ScrollView x:Name="FormScroll" SafeAreaEdges="None">
                <VerticalStackLayout Spacing="8">
                    <!-- The card's own title (#103); blank, it's the kind's. First, as in Graph setup. -->
                    <controls:SetupSection Label="Card title (optional)">
                        <Entry Text="{Binding CardTitle}" Placeholder="Card title"
                            SemanticProperties.Description="Card title (optional)" />
                    </controls:SetupSection>
                    <!-- Labels sit above their pickers so large text never crowds a row. -->
                    <controls:SetupSection Label="Rows">
                        <Picker Title="Rows" ItemsSource="{Binding Counts}" SelectedItem="{Binding SelectedCount}"
                            SemanticProperties.Description="Rows" />
                    </controls:SetupSection>
                    <controls:SetupSection Label="Rank by">
                        <Picker Title="Rank by" ItemsSource="{Binding Ranks}" SelectedItem="{Binding SelectedRank}"
                            ItemDisplayBinding="{Binding Label, x:DataType=dash:RankChoice}"
                            SemanticProperties.Description="Rank by" />
                    </controls:SetupSection>
                    <!-- Top errors only: a healthy network says so rather than listing zeros. -->
                    <controls:SetupSection Label="Quiet ports" IsVisible="{Binding IsErrors}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Hide ports with no errors" LineBreakMode="WordWrap" />
                                <Label Style="{StaticResource Caption}" Text="Off lists every port, errors or not." LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding HideQuiet}" VerticalOptions="Center"
                                SemanticProperties.Description="Hide ports with no errors" />
                        </Grid>
                    </controls:SetupSection>
                    <Label Style="{StaticResource Caption}"
                           Text="The same options as the card on DashyNMS desktop, so it looks alike in both." />
                </VerticalStackLayout>
            </ScrollView>
        </controls:SetupLayout.Body>
        <controls:SetupLayout.PrimaryAction>
            <Button Text="Save" Command="{Binding SaveCommand}" HorizontalOptions="Fill" Margin="0,12,0,0" />
        </controls:SetupLayout.PrimaryAction>
    </controls:SetupLayout>

</ContentPage>
