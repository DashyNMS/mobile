<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.GraylogSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:graylog="clr-namespace:DashyNMS.Mobile.Graylog;assembly=DashyNMS.Mobile.Shared"
    x:DataType="graylog:GraylogSettingsViewModel"
    Title="Graylog">
    <controls:SetupLayout x:Name="Setup">
        <controls:SetupLayout.Header>
            <controls:PageHeader x:Name="Header" Title="Graylog" />
        </controls:SetupLayout.Header>
        <controls:SetupLayout.Body>
            <ScrollView x:Name="Form" SafeAreaEdges="None">
                <VerticalStackLayout Padding="0,20,0,8" Spacing="4">
                    <Label x:Name="SaveError" Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="Graylog" />
                                <Label Style="{StaticResource Caption}"
                                       Text="Messages from your Graylog server, network-wide (Alerts → Logs → Graylog) and on each device. DashyNMS talks to Graylog directly, with its own login." />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" SemanticProperties.Description="Enable Graylog" IsToggled="{Binding Enabled}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Label Style="{StaticResource SectionHeader}" Text="SERVER" />
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <controls:SetupSection Label="Address">
                                <Entry SemanticProperties.Description="Graylog server address" Text="{Binding Server}" Placeholder="graylog.example.com" Keyboard="Url"
                                   IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                            </controls:SetupSection>

                            <controls:SetupSection Label="Port (optional)">
                                <Entry SemanticProperties.Description="Port (optional)" Text="{Binding PortText}" Placeholder="Blank for 443 (or 80 over http)" Keyboard="Numeric" />
                            </controls:SetupSection>

                            <controls:SetupSection Label="Version">
                                <Picker Title="Version" ItemsSource="{Binding VersionLabels}" SelectedIndex="{Binding VersionIndex}" />
                            </controls:SetupSection>

                            <controls:SetupSection Label="Search API path" IsVisible="{Binding IsBaseUriVisible}">
                                <Entry SemanticProperties.Description="Search API path" Text="{Binding BaseUri}" Placeholder="/api/search/universal/relative"
                                       IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                            </controls:SetupSection>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,6,0,0">
                                <VerticalStackLayout>
                                    <Label Text="Allow untrusted certificate" />
                                    <Label Style="{StaticResource Caption}" Text="Only for a self-signed server you trust: any certificate is then accepted." />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" SemanticProperties.Description="Allow untrusted certificate" IsToggled="{Binding AllowUntrustedCertificate}" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Label Style="{StaticResource SectionHeader}" Text="LOGIN" />
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <controls:SetupSection Label="Username or access token">
                                <Entry SemanticProperties.Description="Username or access token" Text="{Binding Username}" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                            </controls:SetupSection>

                            <controls:SetupSection Label="Password">
                                <Entry SemanticProperties.Description="Password" Text="{Binding PasswordInput}" IsPassword="True" Placeholder="&quot;token&quot; with an access token"
                                   IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                            </controls:SetupSection>
                            <Label Style="{StaticResource Caption}" Text="{Binding PasswordStatusText}" />

                        </VerticalStackLayout>
                    </Border>

                    <Label Style="{StaticResource Caption}" Text="Test checks this draft without saving it. Save applies your changes; Back discards them." />
                    <Button Style="{StaticResource SecondaryButton}" Text="Test connection" Command="{Binding TestCommand}" IsEnabled="{Binding IsNotBusy}" Margin="0,12,0,0" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                    <Label Text="{Binding TestResultText}" IsVisible="{Binding HasTestResult}" HorizontalTextAlignment="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding TestSucceeded}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource OkColor}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding TestSucceeded}" Value="False">
                                <Setter Property="TextColor" Value="{StaticResource CriticalColor}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <Label Style="{StaticResource SectionHeader}" Text="MESSAGES" />
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <controls:SetupSection Label="Time zone">
                                <Entry SemanticProperties.Description="Time zone" Text="{Binding Timezone}" Placeholder="e.g. Europe/London"
                                   IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                            </controls:SetupSection>
                            <Label Style="{StaticResource Caption}" Text="{Binding TimezoneStatusText}" />

                            <controls:SetupSection Label="A device's messages start at">
                                <Picker Title="Level" ItemsSource="{Binding LevelLabels}" SelectedIndex="{Binding DeviceLogLevel}" />
                            </controls:SetupSection>

                            <controls:SetupSection Label="Field matched against device addresses">
                                <Entry SemanticProperties.Description="Field matched against device addresses" Text="{Binding QueryField}" Placeholder="source" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                            </controls:SetupSection>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,6,0,0">
                                <VerticalStackLayout>
                                    <Label Text="Match any address" />
                                    <Label Style="{StaticResource Caption}" Text="Every IP address on the device's interfaces, not just its main address and names." />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" SemanticProperties.Description="Match any device address" IsToggled="{Binding MatchAnyAddress}" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout IsVisible="{Binding CanForgetPassword}" Spacing="4" Margin="0,8,0,0">
                        <Label Style="{StaticResource SectionHeader}" Text="SAVED PASSWORD" />
                        <Label Style="{StaticResource Caption}" Text="Forget removes the saved password from this phone immediately after confirmation, without saving this draft." />
                        <Button Style="{StaticResource SecondaryButton}" Text="Forget saved password"
                                Command="{Binding ForgetPasswordCommand}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </controls:SetupLayout.Body>
        <controls:SetupLayout.PrimaryAction>
            <Button Text="Save" Command="{Binding SaveCommand}" Margin="0,8,0,0" />
        </controls:SetupLayout.PrimaryAction>
    </controls:SetupLayout>
</ContentPage>
