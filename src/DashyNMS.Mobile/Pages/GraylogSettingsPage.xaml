<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.GraylogSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:graylog="clr-namespace:DashyNMS.Mobile.Graylog;assembly=DashyNMS.Mobile.Shared"
    x:DataType="graylog:GraylogSettingsViewModel"
    Title="Graylog">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="4">

            <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout>
                        <Label Text="Graylog" />
                        <Label Style="{StaticResource Caption}"
                               Text="Messages from your Graylog server, network-wide (Alerts → Logs → Graylog) and on each device. DashyNMS talks to Graylog directly, with its own login." />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding Enabled}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Label Style="{StaticResource SectionHeader}" Text="SERVER" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Address" />
                    <Entry Text="{Binding Server}" Placeholder="graylog.example.com" Keyboard="Url"
                           IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />

                    <Label Text="Port (optional)" />
                    <Entry Text="{Binding PortText}" Placeholder="Blank for 443 (or 80 over http)" Keyboard="Numeric" />

                    <Label Text="Version" />
                    <Picker Title="Version" ItemsSource="{Binding VersionLabels}" SelectedIndex="{Binding VersionIndex}" />

                    <VerticalStackLayout IsVisible="{Binding IsBaseUriVisible}" Spacing="8">
                        <Label Text="Search API path" />
                        <Entry Text="{Binding BaseUri}" Placeholder="/api/search/universal/relative"
                               IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,6,0,0">
                        <VerticalStackLayout>
                            <Label Text="Allow untrusted certificate" />
                            <Label Style="{StaticResource Caption}" Text="Only for a self-signed server you trust: any certificate is then accepted." />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding AllowUntrustedCertificate}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Style="{StaticResource SectionHeader}" Text="LOGIN" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Username or access token" />
                    <Entry Text="{Binding Username}" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />

                    <Label Text="Password" />
                    <Entry Text="{Binding PasswordInput}" IsPassword="True" Placeholder="&quot;token&quot; with an access token"
                           IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                    <Label Style="{StaticResource Caption}" Text="{Binding PasswordStatusText}" />
                    <Button Text="Forget saved password" Command="{Binding ForgetPasswordCommand}"
                            IsVisible="{Binding CanForgetPassword}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Test connection" Command="{Binding TestCommand}" IsEnabled="{Binding IsNotBusy}" Margin="0,12,0,0" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding TestResultText}" IsVisible="{Binding HasTestResult}" HorizontalTextAlignment="Center">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding TestSucceeded}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource OkColor}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding TestSucceeded}" Value="False">
                        <Setter Property="TextColor" Value="{StaticResource CriticalColor}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <Label Style="{StaticResource SectionHeader}" Text="MESSAGES" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Time zone" />
                    <Entry Text="{Binding Timezone}" Placeholder="e.g. Europe/London"
                           IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                    <Label Style="{StaticResource Caption}" Text="{Binding TimezoneStatusText}" />

                    <Label Text="A device's messages start at" Margin="0,6,0,0" />
                    <Picker Title="Level" ItemsSource="{Binding LevelLabels}" SelectedIndex="{Binding DeviceLogLevel}" />

                    <Label Text="Field matched against device addresses" Margin="0,6,0,0" />
                    <Entry Text="{Binding QueryField}" Placeholder="source" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,6,0,0">
                        <VerticalStackLayout>
                            <Label Text="Match any address" />
                            <Label Style="{StaticResource Caption}" Text="Every IP address on the device's interfaces, not just its main address and names." />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding MatchAnyAddress}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Save" Command="{Binding SaveCommand}" Margin="0,16,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
