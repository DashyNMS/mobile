<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.SensorPickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:dash="clr-namespace:DashyNMS.Mobile.Dashboard;assembly=DashyNMS.Mobile.Shared"
    x:DataType="dash:SensorPickerViewModel"
    Title="Dashboard sensors">

    <controls:SetupLayout x:Name="Setup">
        <controls:SetupLayout.Header>
            <controls:PageHeader x:Name="Header" Title="Choose sensors" />
        </controls:SetupLayout.Header>
        <controls:SetupLayout.Body>
            <Grid SafeAreaEdges="None" RowDefinitions="Auto,Auto,Auto,Auto,*">
                <controls:SearchField>
                    <Entry x:Name="Search" Text="{Binding SearchText}" Placeholder="Sensor or device"
                        SemanticProperties.Description="Search sensors or devices" Completed="OnSearchCompleted" />
                </controls:SearchField>
                <Label Grid.Row="1" Style="{StaticResource Caption}" Text="{Binding SelectedText}" Margin="0,8,0,4" />
                <Label Grid.Row="2" Style="{StaticResource Caption}" Text="{Binding HintText}" Margin="0,0,0,6" />
                <VerticalStackLayout Grid.Row="3" Spacing="4">
                    <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
                    <Button Text="Retry loading sensors" Command="{Binding LoadCommand}" BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                        IsVisible="{Binding HasError}" IsEnabled="{Binding IsNotBusy}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>

                <CollectionView x:Name="List" Grid.Row="4" ItemsSource="{Binding Sensors}" SelectionMode="None">
                    <CollectionView.Header>
                        <!-- Starts below the 20pt top fade, so only scrolled content passes beneath it. -->
                        <controls:SetupSection Label="Card title (optional)" Margin="0,20,0,8">
                            <Entry Text="{Binding CardTitle}" Placeholder="Card title"
                                SemanticProperties.Description="Card title (optional)" />
                        </controls:SetupSection>
                    </CollectionView.Header>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dash:PickableSensor">
                            <Border Style="{StaticResource Card}"
                                SemanticProperties.Description="{Binding SelectionDescription}"
                                SemanticProperties.Hint="Adds or removes this sensor">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding ToggleCommand, Source={RelativeSource AncestorType={x:Type dash:SensorPickerViewModel}}, x:DataType=dash:SensorPickerViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Row.Title}" FontFamily="BodySemibold" LineBreakMode="WordWrap" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding DeviceName}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Row.Value}" VerticalOptions="Center"
                                           TextColor="{Binding Row.Status, Converter={StaticResource StatusText}}" />
                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsPicked, Mode=OneWay}" CheckedChanged="OnSensorCheckedChanged"
                                        AutomationProperties.IsInAccessibleTree="False" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <BoxView Grid.Row="4" HeightRequest="20" VerticalOptions="Start" InputTransparent="True" ZIndex="1">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
                            <GradientStop Offset="1" Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
            </Grid>
        </controls:SetupLayout.Body>
        <controls:SetupLayout.PrimaryAction>
            <Button Text="Save" Command="{Binding SaveCommand}" HorizontalOptions="Fill" Margin="0,12,0,0" />
        </controls:SetupLayout.PrimaryAction>
    </controls:SetupLayout>

</ContentPage>
