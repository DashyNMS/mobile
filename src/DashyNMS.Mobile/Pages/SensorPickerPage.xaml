<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.SensorPickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:dash="clr-namespace:DashyNMS.Mobile.Dashboard;assembly=DashyNMS.Mobile.Shared"
    x:DataType="dash:SensorPickerViewModel"
    ios:Page.UseSafeArea="True"
    SafeAreaEdges="Container"
    Title="Dashboard sensors">

    <Grid SafeAreaEdges="None" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" Padding="16,0,16,0">

        <controls:BackBar x:Name="TopBar" />
        <Label Grid.Row="1" Style="{StaticResource PageTitle}" Text="Choose sensors" SemanticProperties.HeadingLevel="Level1" />

        <!-- The card's own title (#87): "Core switch temps". -->
        <VerticalStackLayout Grid.Row="2" Spacing="4" Margin="0,0,0,8">
            <Label Style="{StaticResource Caption}" Text="Card title (optional)" />
            <Entry Text="{Binding CardTitle}" Placeholder="Card title" />
        </VerticalStackLayout>

        <Border Grid.Row="3" Margin="0,4,0,8" Padding="14,0,4,0" HeightRequest="46" StrokeThickness="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource ChipStrokeDark}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="23" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="2">
                <Path Data="M10.5 4A6.5 6.5 0 1 0 10.5 17A6.5 6.5 0 1 0 10.5 4Z M15.5 15.5 20 20" StrokeThickness="2" StrokeLineCap="Round"
                      WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" InputTransparent="True"
                      Stroke="{AppThemeBinding Light={StaticResource TextFaintLight}, Dark={StaticResource TextFaintDark}}" />
                <Entry x:Name="Search" Grid.Column="1" Text="{Binding SearchText}" Placeholder="Sensor or device"
                       SemanticProperties.Description="Search sensors or devices" VerticalOptions="Center" MinimumHeightRequest="40"
                       ReturnType="Search" ClearButtonVisibility="WhileEditing" Completed="OnSearchCompleted"
                       IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
            </Grid>
        </Border>
        <Label Grid.Row="4" Style="{StaticResource Caption}" Text="{Binding HintText}" Margin="4,6" />
        <Label Grid.Row="5" Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
        <ActivityIndicator Grid.Row="5" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <CollectionView x:Name="List" Grid.Row="6" ItemsSource="{Binding Sensors}" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dash:PickableSensor">
                    <Border Style="{StaticResource Card}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding ToggleCommand, Source={RelativeSource AncestorType={x:Type dash:SensorPickerViewModel}}, x:DataType=dash:SensorPickerViewModel}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="{Binding Row.Title}" FontFamily="BodySemibold" LineBreakMode="TailTruncation" />
                                <Label Style="{StaticResource Caption}" Text="{Binding DeviceName}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding Row.Value}" VerticalOptions="Center"
                                   TextColor="{Binding Row.Status, Converter={StaticResource StatusText}}" />
                            <CheckBox Grid.Column="2" IsChecked="{Binding IsPicked}" IsEnabled="False" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
