<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.AlertRulePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:rules="clr-namespace:DashyNMS.Mobile.Rules;assembly=DashyNMS.Mobile.Shared"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    x:DataType="rules:AlertRuleViewModel"
    SafeAreaEdges="Container"
    Title="{Binding Title}">

    <!-- One rule, read-only (#22): what it matches, where, how it notifies, its template, and its alerts now. -->
    <!-- The busy card while it loads, or after a pull; no platform spinner (#111, #123). -->
    <Grid>
    <controls:BusyCard x:Name="Busy" ZIndex="1" IsVisible="False" />
    <RefreshView x:Name="PullRefresh" Command="{Binding RefreshCommand}">
        <ScrollView>
            <controls:ReadableColumn>
                <VerticalStackLayout Padding="16,8,16,16" Spacing="12">

                    <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

                    <!-- ==================== The condition ==================== -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasLoaded}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="10">
                                <Ellipse Style="{StaticResource Dot}" Fill="{Binding Severity, Converter={StaticResource StatusColor}}" />
                                <Label Grid.Column="1" Style="{StaticResource CardTitle}" Text="{Binding SeverityText}" />
                                <Label Grid.Column="2" Style="{StaticResource CardNote}" Text="Disabled" IsVisible="{Binding IsDisabled}" />
                            </Grid>
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12,10"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource CodeDark}}">
                                <Label Text="{Binding Condition}" FontFamily="Mono" FontSize="12.5" LineHeight="1.3"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource Gray100}}" />
                            </Border>
                            <Label Style="{StaticResource Caption}" Text="{Binding ConditionNote}" IsVisible="{Binding HasConditionNote}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- ==================== Where and how ==================== -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasLoaded}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="130,*" ColumnSpacing="12">
                                <Label Style="{StaticResource Caption}" Text="Applies to" />
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="{Binding TargetSummary}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding TargetNames}" IsVisible="{Binding HasTargetNames}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="130,*" ColumnSpacing="12">
                                <Label Style="{StaticResource Caption}" Text="Recovery alerts" />
                                <Label Grid.Column="1" Text="{Binding RecoveryText}" />
                            </Grid>
                            <Grid ColumnDefinitions="130,*" ColumnSpacing="12">
                                <Label Style="{StaticResource Caption}" Text="Acknowledgement alerts" />
                                <Label Grid.Column="1" Text="{Binding AcknowledgementText}" />
                            </Grid>
                            <!-- The phone's own choice (#102): its alerts still list and count, only quietly. -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding CanChangeNotifications}">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="Notify me" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding NotificationsNote}" IsVisible="{Binding HasNotificationsNote}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding Notifies}" VerticalOptions="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="130,*,Auto" ColumnSpacing="12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenTemplateCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Style="{StaticResource Caption}" Text="Template" />
                                <Label Grid.Column="1" Text="{Binding TemplateName}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasTemplate}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Grid.Column="2" Text="›" FontSize="20" Style="{StaticResource Caption}" IsVisible="{Binding HasTemplate}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ==================== Notes and procedure ==================== -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasNotes}">
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource CardTitle}" Text="Notes" />
                            <Label Text="{Binding Notes}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasProcedure}">
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource CardTitle}" Text="Procedure" />
                            <Label Text="{Binding Procedure}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- ==================== Alerting now ==================== -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasLoaded}">
                        <VerticalStackLayout Spacing="4">
                            <Label Style="{StaticResource CardTitle}" Text="Alerting now" />
                            <Label Style="{StaticResource Caption}" Text="Nothing - no open alerts from this rule." IsVisible="{Binding HasNoAlerts}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Alerts}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AlertItem">
                                        <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="44">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding OpenAlertCommand, Source={RelativeSource AncestorType={x:Type rules:AlertRuleViewModel}}, x:DataType=rules:AlertRuleViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Ellipse Style="{StaticResource Dot}" Fill="{Binding Severity, Converter={StaticResource StatusColor}}" />
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Style="{StaticResource RowTitle}" Text="{Binding Device}" />
                                                <Label Style="{StaticResource Caption}" Text="{Binding StateText}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Style="{StaticResource Faint}" Text="{Binding ShortAge}" VerticalOptions="Start" Margin="0,3,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </controls:ReadableColumn>
        </ScrollView>
    </RefreshView>
    </Grid>

</ContentPage>
