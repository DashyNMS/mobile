<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:views="clr-namespace:DashyNMS.Mobile.Views"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    xmlns:alerts="clr-namespace:DashyNMS.Mobile.Alerts;assembly=DashyNMS.Mobile.Shared"
    xmlns:alerting="clr-namespace:DesktopNMS.Core.Alerting;assembly=DesktopNMS.Core"
    x:Class="DashyNMS.Mobile.Pages.SettingsSectionPage"
    x:DataType="vm:SettingsViewModel"
    Title="Settings">
    <controls:SetupLayout x:Name="Setup">
        <controls:SetupLayout.Header>
            <controls:PageHeader x:Name="Header" Title="Settings" Note="Changes save automatically." />
        </controls:SetupLayout.Header>
        <controls:SetupLayout.Body>
            <Grid RowDefinitions="*,Auto" SafeAreaEdges="None">
                <ScrollView x:Name="FormScroll" SafeAreaEdges="None">
                    <VerticalStackLayout Spacing="8" Padding="0,20,0,8">
                        <!-- ==================== Server ==================== -->
                        <VerticalStackLayout x:Name="Server" Spacing="8" IsVisible="False">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="8">
                                    <controls:SetupSection Label="Address">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding ServerUrl}" LineBreakMode="CharacterWrap" />
                                            <!-- Plain http: the token and everything loaded go unencrypted (#3). -->
                                            <Label Text="Not secure - this server doesn't use HTTPS" FontSize="12" IsVisible="{Binding IsServerInsecure}" TextColor="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
                                        </VerticalStackLayout>
                                    </controls:SetupSection>
                                    <controls:SetupSection Label="LibreNMS">
                                        <Label Text="{Binding ServerVersion}" />
                                    </controls:SetupSection>
                                </VerticalStackLayout>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout>
                                        <Label Text="Server stores timestamps in UTC" />
                                        <Label Style="{StaticResource Caption}" Text="Turn on if alert times look off by your UTC offset. Same as desktop's setting." />
                                    </VerticalStackLayout>
                                    <Switch SemanticProperties.Description="Server stores timestamps in UTC" Grid.Column="1" IsToggled="{Binding ServerTimestampsAreUtc}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                        <!-- ==================== Appearance ==================== -->
                        <Border x:Name="Appearance" Style="{StaticResource Card}" IsVisible="False">
                            <VerticalStackLayout Spacing="8">
                                <controls:SetupSection Label="Light or dark">
                                    <Picker Title="Appearance" ItemsSource="{Binding AppearanceLabels}" SelectedIndex="{Binding AppearanceIndex}" />
                                </controls:SetupSection>
                                <!-- Desktop's own setting, shared (#106). -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="Jiggle physics on the network map" />
                                        <Label Style="{StaticResource Caption}" Text="Devices wobble like jelly when you drag them, and what they're linked to wobbles too. Just for fun: a device is always saved where you drop it. Nothing moves with Reduce Motion on." />
                                    </VerticalStackLayout>
                                    <Switch SemanticProperties.Description="Jiggle physics on the network map" Grid.Column="1" IsToggled="{Binding JigglePhysicsOnMaps}" VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                        <!-- ==================== Devices ==================== -->
                        <VerticalStackLayout x:Name="Devices" Spacing="8" IsVisible="False">
                            <Border Style="{StaticResource Card}">
                                <controls:SetupSection Label="Device names">
                                    <VerticalStackLayout Spacing="4">
                                        <VerticalStackLayout VerticalOptions="Center">
                                            <Label Style="{StaticResource Caption}" Text="Which name devices go by in lists and titles, as on desktop." />
                                        </VerticalStackLayout>
                                        <Picker Title="Device names" ItemsSource="{Binding DeviceNameStyles}" SelectedIndex="{Binding DeviceNameStyleIndex}" />
                                    </VerticalStackLayout>
                                </controls:SetupSection>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout>
                                            <Label Text="Recently viewed" />
                                            <Label Style="{StaticResource Caption}" Text="The strip on the Devices page and the dashboard card, as on desktop." />
                                        </VerticalStackLayout>
                                        <Switch SemanticProperties.Description="Recently viewed" Grid.Column="1" IsToggled="{Binding ShowRecentlyViewed}" VerticalOptions="Center" />
                                    </Grid>
                                    <controls:SetupSection Label="How many to keep" IsVisible="{Binding ShowRecentlyViewed}">
                                        <Picker Title="How many to keep" ItemsSource="{Binding RecentlyViewedCountLabels}" SelectedIndex="{Binding RecentlyViewedCountIndex}" />
                                    </controls:SetupSection>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                        <!-- ==================== Alert checks ==================== -->
                        <VerticalStackLayout x:Name="AlertChecks" Spacing="8" IsVisible="False">
                            <Border Style="{StaticResource Card}">
                                <controls:SetupSection Label="Check alerts every">
                                    <VerticalStackLayout Spacing="4">
                                        <VerticalStackLayout VerticalOptions="Center">
                                            <Label Style="{StaticResource Caption}" Text="While DashyNMS is open. In the background, your phone decides how often." />
                                        </VerticalStackLayout>
                                        <Picker Title="Check alerts every" ItemsSource="{Binding PollIntervalLabels}" SelectedIndex="{Binding PollIntervalIndex}" />
                                    </VerticalStackLayout>
                                </controls:SetupSection>
                            </Border>
                            <Border Style="{StaticResource Card}" IsVisible="{Binding CanShowAppBadge}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout>
                                            <Label Text="Alert count on the app icon" />
                                            <Label Style="{StaticResource Caption}" Text="Open alerts, as desktop's Alerts tab badge. Updated with each alert check." />
                                        </VerticalStackLayout>
                                        <Switch SemanticProperties.Description="Alert count on the app icon" Grid.Column="1" IsToggled="{Binding ShowAppBadge}" VerticalOptions="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowAppBadge}">
                                        <Label Text="Count acknowledged alerts too" VerticalOptions="Center" />
                                        <Switch SemanticProperties.Description="Count acknowledged alerts too" Grid.Column="1" IsToggled="{Binding BadgeIncludesAcknowledged}" />
                                    </Grid>
                                    <!-- So a phone full of warnings needn't look like an outage (#96); the Alerts tab's dot follows it too. -->
                                    <controls:SetupSection Label="Count alerts from" IsVisible="{Binding ShowAppBadge}">
                                        <VerticalStackLayout Spacing="4">
                                            <VerticalStackLayout VerticalOptions="Center">
                                                <Label Style="{StaticResource Caption}" Text="For the app icon and the Alerts tab's dot." />
                                            </VerticalStackLayout>
                                            <Picker Title="Count alerts from" ItemsSource="{Binding BadgeThresholdLabels}" SelectedIndex="{Binding BadgeThresholdIndex}" VerticalOptions="Center" />
                                        </VerticalStackLayout>
                                    </controls:SetupSection>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                        <!-- ==================== Notifications ==================== -->
                        <VerticalStackLayout x:Name="Notifications" Spacing="8" IsVisible="False">
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout>
                                        <Label Text="Alert notifications" />
                                        <Label Style="{StaticResource Caption}" Text="Checks every few minutes while DashyNMS is open, and in the background when your phone allows it." />
                                    </VerticalStackLayout>
                                    <Switch SemanticProperties.Description="Alert notifications" Grid.Column="1" IsToggled="{Binding NotificationsEnabled}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}" IsVisible="{Binding NotificationsEnabled}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Style="{StaticResource CardTitle}" Text="Notify me about" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Critical alerts" VerticalOptions="Center" />
                                        <Switch SemanticProperties.Description="Critical alerts" Grid.Column="1" IsToggled="{Binding NotifyCritical}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Warnings" VerticalOptions="Center" />
                                        <Switch SemanticProperties.Description="Warnings" Grid.Column="1" IsToggled="{Binding NotifyWarning}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="When an alert recovers" VerticalOptions="Center" />
                                        <Switch SemanticProperties.Description="When an alert recovers" Grid.Column="1" IsToggled="{Binding NotifyOnRecovery}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="When someone acknowledges an alert" VerticalOptions="Center" />
                                        <Switch SemanticProperties.Description="When someone acknowledges an alert" Grid.Column="1" IsToggled="{Binding NotifyOnAcknowledge}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                            <Border Style="{StaticResource Card}" IsVisible="{Binding NotificationsEnabled}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Quiet hours" VerticalOptions="Center" FontFamily="BodySemibold" />
                                        <Switch SemanticProperties.Description="Quiet hours" Grid.Column="1" IsToggled="{Binding QuietHoursEnabled}" />
                                    </Grid>
                                    <VerticalStackLayout Spacing="8" IsVisible="{Binding QuietHoursEnabled}">
                                        <controls:SetupSection Label="From">
                                            <Picker Title="Quiet hours start" ItemsSource="{Binding Hours}" SelectedIndex="{Binding QuietHoursStart}" />
                                        </controls:SetupSection>
                                        <controls:SetupSection Label="To">
                                            <Picker Title="Quiet hours end" ItemsSource="{Binding Hours}" SelectedIndex="{Binding QuietHoursEnd}" />
                                        </controls:SetupSection>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="Still notify critical alerts" VerticalOptions="Center" />
                                            <Switch SemanticProperties.Description="Still notify critical alerts" Grid.Column="1" IsToggled="{Binding QuietHoursAllowCritical}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                            <!-- Which alerts notify (#167): Core's three modes, as desktop's Settings. Each keeps its own
                         list. Only notifications change: alerts still show and count everywhere. -->
                            <Label Style="{StaticResource SectionHeader}" Text="Which alerts notify you" Margin="4,4,0,-4" IsVisible="{Binding NotificationsEnabled}" />
                            <Border Style="{StaticResource Card}" Padding="14,0" IsVisible="{Binding NotificationsEnabled}">
                                <VerticalStackLayout>
                                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="52" Padding="0,6">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SetNotifyModeCommand}" CommandParameter="{x:Static alerting:NotificationRuleMode.All}" />
                                        </Grid.GestureRecognizers>
                                        <VerticalStackLayout VerticalOptions="Center">
                                            <Label Text="Every alert" />
                                            <Label Style="{StaticResource Caption}" Text="All alert rules notify" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="✓" FontFamily="BodySemibold" FontSize="18" VerticalOptions="Center" TextColor="{StaticResource ButtonPrimary}" IsVisible="{Binding IsEveryAlert}" />
                                    </Grid>
                                    <BoxView Style="{StaticResource Divider}" />
                                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="52" Padding="0,6">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SetNotifyModeCommand}" CommandParameter="{x:Static alerting:NotificationRuleMode.AllExcept}" />
                                        </Grid.GestureRecognizers>
                                        <VerticalStackLayout VerticalOptions="Center">
                                            <Label Text="Every alert except…" />
                                            <Label Style="{StaticResource Caption}" Text="{Binding AllExceptDetail}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="✓" FontFamily="BodySemibold" FontSize="18" VerticalOptions="Center" TextColor="{StaticResource ButtonPrimary}" IsVisible="{Binding IsAllExcept}" />
                                    </Grid>
                                    <BoxView Style="{StaticResource Divider}" />
                                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="52" Padding="0,6">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SetNotifyModeCommand}" CommandParameter="{x:Static alerting:NotificationRuleMode.Only}" />
                                        </Grid.GestureRecognizers>
                                        <VerticalStackLayout VerticalOptions="Center">
                                            <Label Text="Only these rules" />
                                            <Label Style="{StaticResource Caption}" Text="{Binding OnlyRulesDetail}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="✓" FontFamily="BodySemibold" FontSize="18" VerticalOptions="Center" TextColor="{StaticResource ButtonPrimary}" IsVisible="{Binding IsOnlyRules}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                            <!-- The chosen mode's list, with Add a rule (on every device) and Remove, with Undo. -->
                            <VerticalStackLayout Spacing="8" IsVisible="{Binding NotificationsEnabled}">
                                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasNotifyRuleList}">
                                    <Label Style="{StaticResource SectionHeader}" Text="{Binding NotifyListTitle}" Margin="4,4,0,0" />
                                    <Border Style="{StaticResource Card}" Padding="14,10" IsVisible="{Binding IsOnlyEmpty}">
                                        <Label Text="Nothing will notify you. Add a rule below, or choose Every alert." FontSize="14" FontFamily="BodySemibold" />
                                    </Border>
                                    <Border Style="{StaticResource Card}" Padding="14,0">
                                        <VerticalStackLayout>
                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding NotifyRuleList}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="alerting:NotificationRuleEntry">
                                                        <VerticalStackLayout>
                                                            <VerticalStackLayout MinimumHeightRequest="52" Spacing="4">
                                                                <Label Text="{Binding Description}" VerticalOptions="Center" />
                                                                <Button Style="{StaticResource LinkButton}" Text="Remove" Command="{Binding RemoveNotifyRuleCommand, Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, x:DataType=vm:SettingsViewModel}" CommandParameter="{Binding .}" VerticalOptions="Center" HorizontalOptions="Start" />
                                                            </VerticalStackLayout>
                                                            <BoxView Style="{StaticResource Divider}" />
                                                        </VerticalStackLayout>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                            <Button Style="{StaticResource LinkButton}" Text="+ Add a rule" HorizontalOptions="Start" Command="{Binding AddNotifyRuleCommand}" MinimumHeightRequest="52" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Label Style="{StaticResource Caption}" Text="{Binding NotifyListHint}" Margin="4,0" />
                                </VerticalStackLayout>
                                <Label Style="{StaticResource Caption}" Margin="4,0" IsVisible="{Binding IsEveryAlert}" Text="Every alert rule notifies you, at the severities above. To leave one out, choose Every alert except…, or Change on one of its alerts." />
                            </VerticalStackLayout>
                            <Border Style="{StaticResource Card}" IsVisible="{Binding NotificationsEnabled}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanHideNotificationDetails}">
                                        <VerticalStackLayout>
                                            <Label Text="Hide details on the lock screen" />
                                            <Label Style="{StaticResource Caption}" Text="A locked phone shows how serious an alert is, but not the device or rule." />
                                        </VerticalStackLayout>
                                        <Switch SemanticProperties.Description="Hide details on the lock screen" Grid.Column="1" IsToggled="{Binding HideNotificationDetails}" VerticalOptions="Center" />
                                    </Grid>
                                    <Label Style="{StaticResource Caption}" IsVisible="{Binding CanHideNotificationDetails, Converter={StaticResource Invert}}" Text="A locked iPhone hides alert details while Show Previews is set to When Unlocked (Settings → Notifications)." />
                                </VerticalStackLayout>
                            </Border>
                            <Label Style="{StaticResource Faint}" Margin="4,0" Text="Sounds and how each kind of alert appears are set in your phone's notification settings for DashyNMS." />
                        </VerticalStackLayout>
                        <!-- ==================== Lock screen ==================== -->
                        <Border x:Name="LockScreen" Style="{StaticResource Card}" IsVisible="False">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout>
                                    <Label Text="Hide alert details" />
                                    <Label Style="{StaticResource Caption}" Text="Lock screen widgets show counts only - no device or rule names - for anyone who picks up your phone." />
                                </VerticalStackLayout>
                                <Switch SemanticProperties.Description="Hide alert details" Grid.Column="1" IsToggled="{Binding HideLockScreenDetails}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <!-- ==================== Error reports and usage ==================== -->
                        <!-- The sheet's two choices (#216); each applies at once, and off deletes what's waiting to be sent. -->
                        <VerticalStackLayout x:Name="Diagnostics" Spacing="8" IsVisible="False">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout>
                                            <Label Text="Share error reports" />
                                            <Label Style="{StaticResource Caption}" Text="When something goes wrong: the app version, the phone's operating system and its version, the processor type, and where in the app's code it happened." />
                                        </VerticalStackLayout>
                                        <Switch SemanticProperties.Description="Share error reports" Grid.Column="1" IsToggled="{Binding ShareErrorReports}" VerticalOptions="Center" />
                                    </Grid>
                                    <BoxView Style="{StaticResource Divider}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout>
                                            <Label Text="Share usage and performance" />
                                            <Label Style="{StaticResource Caption}" Text="How often the app starts and which features are used, how long pages and requests take, responsiveness and memory. With both on, how each time it was open ended, under a random ID that's new each time. No user or install ID." />
                                        </VerticalStackLayout>
                                        <Switch SemanticProperties.Description="Share usage and performance" Grid.Column="1" IsToggled="{Binding ShareUsage}" VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                            <Label Style="{StaticResource Caption}" Margin="4,0" Text="Never sent: your server's address, device names or addresses, tokens or passwords, readings, logs, or anything you type. Turning a choice off deletes anything not yet sent." />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
                <!-- A measured row keeps Undo reachable without covering the final setting. -->
                <views:UndoToastView Grid.Row="1" BindingContext="{Binding Toast}" Margin="0,8,0,0" />
                <BoxView HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
                            <GradientStop Offset="1" Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
            </Grid>
        </controls:SetupLayout.Body>
    </controls:SetupLayout>
</ContentPage>
