<?xml version="1.0" encoding="utf-8" ?>
<!--
    Any Device View section: its rows, in titled groups. On iOS it runs to
    the screen's edges - under the tab bar, the camera and a side tab bar's
    column - with every edge placed in PlaceControls (#344), so the rows use
    the whole screen rather than a column in the middle of it.
-->
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.DeviceSectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:sections="clr-namespace:DashyNMS.Mobile.DeviceSections;assembly=DashyNMS.Mobile.Shared"
    x:DataType="sections:DeviceSectionViewModel"
    SafeAreaEdges="Container"
    Title="{Binding Title}">

    <Grid x:Name="Root" RowDefinitions="Auto,Auto,Auto,Auto,*" SafeAreaEdges="None">

        <!-- The app's own header, as every page: the title, "‹ Back" when pushed (#142).
             On iOS 26 and later Back is glass by the tab bar instead. -->
        <controls:PageHeader x:Name="Header" Title="{Binding Title}" Margin="16,0,16,0" SafeAreaEdges="None">
            <controls:PageHeader.Actions>
                <!-- Where there's no glass by the tab bar (Android, iOS before 26): the search icon. -->
                <controls:IconButton x:Name="HeaderSearch" Kind="Plain" Icon="{x:Static controls:Icons.Search}" Command="{Binding ToggleSearchCommand}"
                                     IsOn="{Binding IsSearchOpen}" SemanticProperties.Description="{Binding SearchLabel}" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!-- Search when asked for (#349), as on Devices and Alerts: a field that
             slides down from beneath the title, the list easing down with it,
             and back up when done. Clipped, so it comes from under the title. -->
        <Grid x:Name="SearchSlot" Grid.Row="1" HeightRequest="0" IsClippedToBounds="True" SafeAreaEdges="None">
            <!-- A text box rather than a SearchBar: UISearchBar draws its own
                 grey field, which sat inside this one as a box in a box. -->
            <Border x:Name="SearchField" Margin="16,4,16,8" Padding="14,0,4,0" VerticalOptions="Start" HeightRequest="46"
                    IsVisible="False" StrokeThickness="1" SafeAreaEdges="None"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource ChipStrokeDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="23" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="2" SafeAreaEdges="None">
                    <!-- Icons.Search, in the placeholder's colour. -->
                    <Path Data="M10.5 4A6.5 6.5 0 1 0 10.5 17A6.5 6.5 0 1 0 10.5 4Z M15.5 15.5 20 20" StrokeThickness="2" StrokeLineCap="Round"
                          WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" InputTransparent="True"
                          Stroke="{AppThemeBinding Light={StaticResource TextFaintLight}, Dark={StaticResource TextFaintDark}}" />
                    <Entry x:Name="Search" Grid.Column="1" Text="{Binding SearchText}" Placeholder="{Binding SearchLabel}" VerticalOptions="Center"
                           ReturnType="Search" ClearButtonVisibility="Never" Completed="OnSearchCompleted"
                           IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" MinimumHeightRequest="40" />
                </Grid>
            </Border>
        </Grid>

        <!-- Ports only: the order and grouping, by port ID until chosen, then remembered (#92). -->
        <Grid x:Name="PortOptions" Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8" Margin="16,4,16,0"
              IsVisible="{Binding IsPorts}" SafeAreaEdges="None">
            <Picker Title="Sort by" ItemsSource="{Binding PortSortOptions}" SelectedItem="{Binding SelectedPortSort}" />
            <Picker Grid.Column="1" Title="Group" ItemsSource="{Binding PortGroupingOptions}" SelectedItem="{Binding SelectedPortGrouping}" />
        </Grid>

        <Label x:Name="ErrorLine" Grid.Row="3" Margin="16,8,16,0" Style="{StaticResource Error}" Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}" />

        <controls:BusyCard x:Name="Busy" Grid.Row="4" Margin="16,8,16,0" Text="Loading…" IsVisible="{Binding IsLoadingFirstTime}"
                           ZIndex="1" VerticalOptions="Start" />

        <!-- The rows run on beneath a bottom tab bar to the screen's foot, the
             footer letting the last one scroll clear of it; one column on a
             phone, more across a wide screen (PlaceControls). -->
        <RefreshView x:Name="Refresh" Grid.Row="4" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}" SafeAreaEdges="None">
            <CollectionView x:Name="List" ItemsSource="{Binding Groups}" IsGrouped="True" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout x:Name="ListLayout" Orientation="Vertical" Span="1" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <!-- Room for the fade above, so the first heading starts clear of it. -->
                <CollectionView.Header>
                    <BoxView HeightRequest="8" Color="Transparent" InputTransparent="True" />
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,32" />
                </CollectionView.EmptyView>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="sections:SectionGroup">
                        <Label Style="{StaticResource SectionHeader}" Text="{Binding Name}" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="sections:SectionRow">
                        <Border Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding OpenLinkCommand, Source={RelativeSource AncestorType={x:Type sections:DeviceSectionViewModel}}, x:DataType=sections:DeviceSectionViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <!-- No spacing after the indent: with none, the gap still pushed
                                 every row's text in past its group's heading (#344). -->
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
                                <!-- Inventory nesting. -->
                                <BoxView Grid.RowSpan="2" WidthRequest="{Binding Indent}" Color="Transparent" />

                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding Title}" FontFamily="BodySemibold" LineBreakMode="TailTruncation" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Detail}" IsVisible="{Binding HasDetail}"
                                           FontSize="12" LineBreakMode="WordWrap" MaxLines="3" />
                                </VerticalStackLayout>

                                <!-- Kept to a width so a long value can't squeeze the row's name away. -->
                                <Label Grid.Column="2" Margin="10,0,0,0" Text="{Binding Value}" IsVisible="{Binding HasValue}"
                                       MaximumWidthRequest="180" MaxLines="2" LineBreakMode="WordWrap"
                                       VerticalOptions="Center" HorizontalTextAlignment="End"
                                       TextColor="{Binding Status, Converter={StaticResource StatusText}}" />

                                <Label Grid.Column="3" Margin="10,0,0,0" Style="{StaticResource Chevron}" IsVisible="{Binding IsLink}" />

                                <!-- CPU / memory / storage use. -->
                                <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0"
                                             Progress="{Binding Bar}" IsVisible="{Binding HasBar}"
                                             ProgressColor="{Binding Status, Converter={StaticResource StatusColor}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <BoxView x:Name="ListFoot" HeightRequest="24" Color="Transparent" InputTransparent="True" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <!-- The rows fade out as they scroll up under the header, as the Dashboard's cards. -->
        <BoxView Grid.Row="4" HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
                    <GradientStop Offset="1" Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

    </Grid>

</ContentPage>
