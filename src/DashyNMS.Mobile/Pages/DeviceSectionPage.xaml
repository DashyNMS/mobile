<?xml version="1.0" encoding="utf-8" ?>
<!--
    Any Device View section: its rows, in titled groups. On iOS the page
    places its edges in PlaceControls (#344), using the available width;
    on iOS the list viewport reaches the measured pill base when available;
    Android retains its native clearance fallback. The footer clears glass.
-->
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.DeviceSectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:sections="clr-namespace:DashyNMS.Mobile.DeviceSections;assembly=DashyNMS.Mobile.Shared"
    x:DataType="sections:DeviceSectionViewModel"
    HideSoftInputOnTapped="True"
    SafeAreaEdges="Container"
    Title="{Binding Title}">

    <Grid x:Name="Root" RowDefinitions="Auto,Auto,Auto,Auto,*" SafeAreaEdges="None">

        <!-- The app's own header, as every page: the title, "‹ Back" when pushed (#142).
             On iOS 26 and later Back is glass by the tab bar instead. -->
        <controls:PageHeader x:Name="Header" Title="{Binding Title}" Margin="16,0,16,0" SafeAreaEdges="None">
            <controls:PageHeader.Actions>
                <!-- Where there's no glass by the tab bar (Android, iOS before 26): search, and Ports' Sort &amp; filter. -->
                <HorizontalStackLayout x:Name="HeaderActions" Spacing="4" SafeAreaEdges="None">
                    <controls:IconButton x:Name="SearchButton" Kind="Plain" Icon="{x:Static controls:Icons.Search}"
                                         IsOn="{Binding IsSearchOpen}" SemanticProperties.Description="{Binding SearchLabel}" />
                    <controls:IconButton Kind="Plain" Icon="{x:Static controls:Icons.Filter}" Command="{Binding ToggleFilterPanelCommand}"
                                         IsOn="{Binding HasPanelFilters}" IsVisible="{Binding IsPorts}" SemanticProperties.Description="Sort and filter" />
                    <controls:IconButton Kind="Plain" Icon="{x:Static controls:Icons.Filter}" Command="{Binding ToggleFilterPanelCommand}"
                                         IsVisible="{Binding HasTreeOptions}" IsEnabled="{Binding CanUseTreeOptions}" SemanticProperties.Description="Tree options" />
                </HorizontalStackLayout>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!-- Search when asked for (#349), as on Devices and Alerts: a field that
             slides down from beneath the title, the list easing down with it,
             and back up when done. Clipped, so it comes from under the title. -->
        <Grid x:Name="SearchSlot" Grid.Row="1" HeightRequest="0" IsClippedToBounds="True" SafeAreaEdges="None">
            <controls:SearchField x:Name="SearchField" Margin="16,4,16,8" VerticalOptions="Start" IsVisible="False">
                <Entry x:Name="Search" Text="{Binding SearchText}" Placeholder="{Binding SearchLabel}" Completed="OnSearchCompleted" />
            </controls:SearchField>
        </Grid>

        <!-- Once search and Sort &amp; filter are put away, what narrows or orders the list (#350). -->
        <Label x:Name="FilterLine" Grid.Row="2" Margin="20,4,16,0" Style="{StaticResource Faint}" Text="{Binding FiltersText}"
               IsVisible="{Binding HasFiltersText}" LineBreakMode="TailTruncation" />

        <Grid x:Name="ErrorLine" SafeAreaEdges="None" Grid.Row="3" Margin="16,8,16,0" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasError}">
            <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" />
            <Button Grid.Column="1" Text="Retry" MinimumHeightRequest="44"
                    IsEnabled="{Binding IsNotBusy}" Command="{Binding RefreshCommand}" />
        </Grid>
        <Label Grid.Row="3" Margin="{Binding Margin, Source={x:Reference ErrorLine}}" Style="{StaticResource Caption}" Text="Updating…" IsVisible="{Binding IsUpdatingSensors}" />

        <controls:BusyCard x:Name="Busy" Grid.Row="4" Margin="16,8,16,0" Text="Loading…" IsVisible="{Binding IsLoadingFirstTime}"
                           ZIndex="1" VerticalOptions="Start" />

        <!-- On iOS the viewport reaches the measured pill base when available;
             Android retains its native fallback. The footer keeps
             the final row clear of bottom glass and visible overlays. One column
             on a phone, more across a wide screen (PlaceControls). -->
        <Grid x:Name="SectionBody" Grid.Row="4" RowDefinitions="Auto,*" ColumnDefinitions="*" SafeAreaEdges="None">
        <controls:DeviceNeighbourGraph x:Name="NeighbourGraph" HeightRequest="280" IsVisible="{Binding IsNeighbours}" Margin="16,8" />
        <RefreshView x:Name="Refresh" Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}" SafeAreaEdges="None">
            <CollectionView x:Name="List" ItemsSource="{Binding Groups}" IsGrouped="True" SelectionMode="None" controls:KeyboardDismiss.OnScroll="False">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout x:Name="ListLayout" Orientation="Vertical" Span="1" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <!-- Room for the fade above, so the first heading starts clear of it. -->
                <CollectionView.Header>
                    <VerticalStackLayout Padding="0,20,0,0" Spacing="6">
                        <VerticalStackLayout IsVisible="{Binding IsInventory}" Spacing="6">
                            <Label Style="{StaticResource Caption}" Text="{Binding InventorySummary}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,32" />
                </CollectionView.EmptyView>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="sections:SectionGroup">
                        <Label Style="{StaticResource SectionHeader}" Text="{Binding Name}" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="sections:SectionRow">
                        <Border Style="{StaticResource Card}" BindingContextChanged="OnRowBindingContextChanged">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding PortLayout}" Value="True">
                                    <Setter Property="StrokeThickness" Value="2" />
                                    <Setter Property="Padding" Value="0" />
                                </DataTrigger>
                                <MultiTrigger TargetType="Border">
                                    <MultiTrigger.Conditions>
                                        <BindingCondition Binding="{Binding PortLayout}" Value="True" />
                                        <BindingCondition Binding="{Binding PortHasStatusBorder}" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Stroke" Value="{Binding PortVisualStatus, Converter={StaticResource StatusColor}}" />
                                </MultiTrigger>
                            </Border.Triggers>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <VerticalStackLayout>
                            <VerticalStackLayout IsVisible="{Binding RoutingLayout}" Spacing="4"
                                SemanticProperties.Description="{Binding RoutingDescription}" AutomationProperties.IsInAccessibleTree="True">
                                <Label Text="{Binding RoutingTitleText}" FontFamily="BodySemibold" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Style="{StaticResource Caption}" Text="{Binding RoutingKind}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Text="{Binding RoutingValueText}" TextColor="{Binding Status, Converter={StaticResource StatusText}}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Text="{Binding RoutingStatusText}" IsVisible="{Binding HasRoutingStatus}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Style="{StaticResource Caption}" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                            </VerticalStackLayout>
                            <VerticalStackLayout IsVisible="{Binding ArpLayout}" Spacing="4"
                                                 SemanticProperties.Description="{Binding ArpDescription}" AutomationProperties.IsInAccessibleTree="True">
                                <Label Text="{Binding ArpIpText}" FontFamily="BodySemibold" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Style="{StaticResource Caption}" Text="{Binding ArpMacText}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Style="{StaticResource Caption}" Text="{Binding ArpInterfaceText}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                            </VerticalStackLayout>
                            <VerticalStackLayout IsVisible="{Binding FdbLayout}" Spacing="4"
                                                 SemanticProperties.Description="{Binding FdbDescription}" AutomationProperties.IsInAccessibleTree="True">
                                <Label Text="{Binding FdbMacText}" FontFamily="BodySemibold" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Style="{StaticResource Caption}" Text="{Binding FdbVlanText}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                            </VerticalStackLayout>
                            <VerticalStackLayout IsVisible="{Binding VlanLayout}" Spacing="4"
                                                 SemanticProperties.Description="{Binding VlanDescription}" AutomationProperties.IsInAccessibleTree="True">
                                <Label Text="{Binding Title}" FontFamily="BodySemibold" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Style="{StaticResource Caption}" Text="{Binding VlanNameText}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Style="{StaticResource Caption}" Text="{Binding VlanPortsText}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinimumHeightRequest="44" IsVisible="{Binding NeighbourLayout}"
                                  SemanticProperties.Description="{Binding NeighbourAction}" AutomationProperties.IsInAccessibleTree="True">
                                <Label Text="{Binding NeighbourSummary}" LineBreakMode="WordWrap" AutomationProperties.ExcludedWithChildren="True" />
                                <Label Grid.Column="1" Style="{StaticResource Chevron}" IsVisible="{Binding CanOpenNeighbour}" AutomationProperties.ExcludedWithChildren="True" />
                            </Grid>
                            <controls:PortReadout IsVisible="{Binding PortLayout}" />
                            <!-- No spacing after the indent: with none, the gap still pushed
                                 every row's text in past its group's heading (#344). -->
                            <VerticalStackLayout>
                            <VerticalStackLayout IsVisible="{Binding ResourceLayout}" Spacing="4"
                                                 SemanticProperties.Description="{Binding ResourceDescription}" AutomationProperties.IsInAccessibleTree="True">
                                <Label Text="{Binding Title}" FontFamily="BodySemibold" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Text="{Binding ResourceKind}" Style="{StaticResource Caption}" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Text="{Binding Value}" LineBreakMode="WordWrap" TextColor="{Binding Status, Converter={StaticResource StatusText}}" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" Style="{StaticResource Caption}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Text="{Binding ResourceStatusText}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                <ProgressBar Progress="{Binding Bar}" IsVisible="{Binding HasBar}" ProgressColor="{Binding Status, Converter={StaticResource StatusColor}}" AutomationProperties.IsInAccessibleTree="False" />
                            </VerticalStackLayout>
                            <VerticalStackLayout IsVisible="{Binding SensorLayout}" Spacing="4"
                                                 SemanticProperties.Description="{Binding SensorDescription}" AutomationProperties.IsInAccessibleTree="True">
                                <Label Text="{Binding Title}" FontFamily="BodySemibold" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Text="{Binding Value}" LineBreakMode="WordWrap" TextColor="{Binding Status, Converter={StaticResource StatusText}}" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" Style="{StaticResource Caption}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Text="{Binding SensorStatusText}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                            </VerticalStackLayout>
                            <VerticalStackLayout IsVisible="{Binding AvailabilityLayout}" Spacing="4"
                                                 SemanticProperties.Description="{Binding ContentDescription}" AutomationProperties.IsInAccessibleTree="True">
                                <Label Text="{Binding Title}" FontFamily="BodySemibold" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" Style="{StaticResource Caption}" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Text="{Binding Value}" LineBreakMode="WordWrap" TextColor="{Binding Status, Converter={StaticResource StatusText}}" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Style="{StaticResource Caption}" AutomationProperties.IsInAccessibleTree="False" />
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">

                                <Grid.Triggers>
                                    <DataTrigger TargetType="Grid" Binding="{Binding RoutingLayout}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Grid" Binding="{Binding ArpLayout}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Grid" Binding="{Binding FdbLayout}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Grid" Binding="{Binding VlanLayout}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Grid" Binding="{Binding NeighbourLayout}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Grid" Binding="{Binding PortLayout}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Grid" Binding="{Binding ResourceLayout}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Grid" Binding="{Binding SensorLayout}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Grid" Binding="{Binding AvailabilityLayout}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Grid.Triggers>
                                <!-- Inventory nesting. -->
                                <BoxView Grid.RowSpan="2" WidthRequest="{Binding Indent}" Color="Transparent" />

                                <VerticalStackLayout Grid.Column="1">
                                    <VerticalStackLayout.Triggers>
                                        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding InventoryLayout}" Value="True">
                                            <Setter Property="Grid.ColumnSpan" Value="3" />
                                        </DataTrigger>
                                    </VerticalStackLayout.Triggers>
                                    <Button Style="{StaticResource LinkButton}" Text="{Binding ExpansionGlyph}" MinimumHeightRequest="44" MinimumWidthRequest="44" IsVisible="{Binding CanExpand}"
                                            HorizontalOptions="Start" SemanticProperties.Description="{Binding ExpansionLabel}"
                                            Command="{Binding ToggleInventoryCommand, Source={RelativeSource AncestorType={x:Type sections:DeviceSectionViewModel}}, x:DataType=sections:DeviceSectionViewModel}"
                                            CommandParameter="{Binding .}" />
                                    <Label Text="{Binding Title}" FontFamily="BodySemibold" LineBreakMode="TailTruncation">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding InventoryLayout}" Value="True">
                                                <Setter Property="LineBreakMode" Value="WordWrap" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Style="{StaticResource Caption}" Text="{Binding Value}" IsVisible="{Binding InventoryClassVisible}" LineBreakMode="WordWrap" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}"
                                           LineBreakMode="WordWrap" />
                                    <Button Style="{StaticResource LinkButton}" Text="Copy serial" MinimumHeightRequest="44" SemanticProperties.Description="{Binding CopySerialLabel}" IsVisible="{Binding HasSerial}"
                                            HorizontalOptions="Start" Clicked="OnCopySerial" CommandParameter="{Binding Serial}" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Fields}" IsVisible="{Binding HasFields}" Spacing="2">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="sections:SectionField">
                                                <Label Style="{StaticResource Caption}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Name}" FontFamily="BodySemibold" />
                                                            <Span Text=": " />
                                                            <Span Text="{Binding Value}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                    <Label Style="{StaticResource Caption}" Text="{Binding Detail}" IsVisible="{Binding HasDetail}"
                                           FontSize="12" LineBreakMode="WordWrap" MaxLines="3">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding InventoryLayout}" Value="True">
                                                <Setter Property="MaxLines" Value="-1" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>

                                <!-- Kept to a width so a long value can't squeeze the row's name away. -->
                                <Label Grid.Column="2" Margin="10,0,0,0" Text="{Binding Value}" IsVisible="{Binding HasValue}"
                                       MaximumWidthRequest="180" MaxLines="2" LineBreakMode="WordWrap"
                                       VerticalOptions="Center" HorizontalTextAlignment="End"
                                       TextColor="{Binding Status, Converter={StaticResource StatusText}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding InventoryLayout}" Value="True">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label Grid.Column="3" Margin="10,0,0,0" Style="{StaticResource Chevron}" IsVisible="{Binding IsLink}" />

                                <!-- CPU / memory / storage use. -->
                                <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0"
                                             Progress="{Binding Bar}" IsVisible="{Binding HasBar}"
                                             ProgressColor="{Binding Status, Converter={StaticResource StatusColor}}" />
                            </Grid>
                            </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <BoxView x:Name="ListFoot" HeightRequest="24" Color="Transparent" InputTransparent="True" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>
        <!-- Fade belongs to the list surface, including the neighbours split column. -->
        <BoxView x:Name="ListFade" Grid.Row="1" HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
                    <GradientStop Offset="1" Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>
        </Grid>

        <!-- Behind the Sort &amp; filter card the list fades back gradually; a tap on it puts the card away. -->
        <BoxView x:Name="Dim" Grid.Row="2" Grid.RowSpan="3" IsVisible="False" Opacity="0"
                 Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />

        <!-- Ports' order and grouping (#92), by port ID until chosen, then remembered: a card
             that rises from the foot of the screen near the glass button that opens it (#350). -->
        <Border x:Name="FilterCard" Grid.Row="4" Style="{StaticResource Card}" IsVisible="False" VerticalOptions="End"
                Margin="16,6,16,12" SafeAreaEdges="None">
            <Grid RowDefinitions="Auto,*" RowSpacing="6" SafeAreaEdges="None">
                <Grid ColumnDefinitions="*,Auto" SafeAreaEdges="None">
                    <Label Style="{StaticResource CardTitle}" Text="{Binding PanelTitle}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Style="{StaticResource LinkButton}" Text="Done" MinimumHeightRequest="44" Command="{Binding CloseFilterPanelCommand}" />
                </Grid>
                <ScrollView x:Name="FilterScroll" Grid.Row="1" SafeAreaEdges="None">
                <VerticalStackLayout Spacing="6">
                <VerticalStackLayout IsVisible="{Binding IsInventory}" IsEnabled="{Binding CanUseTreeOptions}" Spacing="6">
                            <FlexLayout Wrap="Wrap" Direction="Row">
                                <Button Style="{StaticResource LinkButton}" Text="Expand all" MinimumHeightRequest="44" Command="{Binding ExpandInventoryCommand}" />
                                <Button Style="{StaticResource LinkButton}" Text="Collapse all" MinimumHeightRequest="44" Command="{Binding CollapseInventoryCommand}" />
                            </FlexLayout>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Switch MinimumHeightRequest="44" IsToggled="{Binding ShowInventoryPorts}" SemanticProperties.Description="{Binding ShowInventoryPortsText}" />
                                <Label Grid.Column="1" Style="{StaticResource Caption}" Text="{Binding ShowInventoryPortsText}" VerticalOptions="Center" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                            </Grid>
                </VerticalStackLayout>
                <Grid IsVisible="{Binding IsPorts}" ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4" SafeAreaEdges="None">
                    <Label Style="{StaticResource Caption}" Text="Sort" VerticalOptions="Center" />
                    <Picker Grid.Row="1" Title="Sort by" MinimumHeightRequest="44" Focused="OnFilterPickerFocused" ItemsSource="{Binding PortSortOptions}" SelectedItem="{Binding SelectedPortSort}" />
                    <Label Grid.Row="2" Style="{StaticResource Caption}" Text="Group" VerticalOptions="Center" />
                    <Picker Grid.Row="3" Title="Group" MinimumHeightRequest="44" Focused="OnFilterPickerFocused" ItemsSource="{Binding PortGroupingOptions}" SelectedItem="{Binding SelectedPortGrouping}" />
                </Grid>
                </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>


    </Grid>

</ContentPage>
