<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.GraylogDevicePickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:graylog="clr-namespace:DashyNMS.Mobile.Graylog;assembly=DashyNMS.Mobile.Shared"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    x:DataType="graylog:GraylogDevicePickerViewModel"
    ios:Page.UseSafeArea="True"
    SafeAreaEdges="Container"
    Title="Device">

    <!-- The Graylog page's Device chip (#117): suggestions first, then search every device. -->
    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16,4,16,0">

        <controls:BackBar x:Name="TopBar">
            <controls:BackBar.Actions>
                <Button Style="{StaticResource LinkButton}" Text="Any device" Command="{Binding ChooseAnyCommand}"
                        IsVisible="{Binding CanChooseAny}" />
            </controls:BackBar.Actions>
        </controls:BackBar>
        <Label Grid.Row="1" Style="{StaticResource PageTitle}" Text="Device" SemanticProperties.HeadingLevel="Level1" />

        <SearchBar Grid.Row="2" Text="{Binding SearchText}" Placeholder="Name, hostname or IP" Margin="-6,2,-6,0" />

        <ScrollView Grid.Row="3">
            <controls:ReadableColumn>
                <VerticalStackLayout Padding="0,0,0,24">
                    <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
                    <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                           HorizontalTextAlignment="Center" Margin="0,32" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="graylog:GraylogDeviceGroup">
                                <VerticalStackLayout>
                                    <Label Style="{StaticResource SectionHeader}" Text="{Binding Name}" />
                                    <Border Style="{StaticResource ListCard}">
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding .}" Margin="0,-1,0,0">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="graylog:GraylogDeviceChoice">
                                                    <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" RowDefinitions="*,Auto" ColumnSpacing="12">
                                                        <Grid.GestureRecognizers>
                                                            <TapGestureRecognizer
                                                                Command="{Binding ChooseCommand, Source={RelativeSource AncestorType={x:Type graylog:GraylogDevicePickerViewModel}}, x:DataType=graylog:GraylogDevicePickerViewModel}"
                                                                CommandParameter="{Binding .}" />
                                                        </Grid.GestureRecognizers>
                                                        <Ellipse Style="{StaticResource Dot}" Fill="{Binding Status, Converter={StaticResource StatusColor}}"
                                                                 VerticalOptions="Start" Margin="0,6,0,0" />
                                                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                            <Label Style="{StaticResource RowTitle}" Text="{Binding Name}" />
                                                            <Label Style="{StaticResource Faint}" Text="{Binding Details}" IsVisible="{Binding HasDetails}"
                                                                   LineBreakMode="TailTruncation" />
                                                        </VerticalStackLayout>
                                                        <!-- How many of the messages on screen it sent. -->
                                                        <Label Grid.Column="2" Style="{StaticResource Faint}" Text="{Binding CountText}" VerticalOptions="Start" Margin="0,2,0,0" />
                                                        <BoxView Grid.Row="1" Grid.ColumnSpan="3" HeightRequest="1" Margin="0,11,0,0" Color="Transparent" />
                                                        <BoxView Grid.ColumnSpan="3" Style="{StaticResource RowLine}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </controls:ReadableColumn>
        </ScrollView>

    </Grid>

</ContentPage>
