<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.GraylogDevicePickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:graylog="clr-namespace:DashyNMS.Mobile.Graylog;assembly=DashyNMS.Mobile.Shared"
    x:DataType="graylog:GraylogDevicePickerViewModel"
    Title="Device">
    <controls:SetupLayout x:Name="Setup">
        <controls:SetupLayout.Header>
            <controls:PageHeader x:Name="Header" Title="Choose a device" />
        </controls:SetupLayout.Header>
        <controls:SetupLayout.Body>
            <Grid RowDefinitions="Auto,*" SafeAreaEdges="None">
                <VerticalStackLayout Spacing="8" Padding="0,0,0,8">
                    <controls:SetupSection Label="Scope" IsVisible="{Binding CanChooseAny}">
                        <VerticalStackLayout Spacing="4">
                            <Label Style="{StaticResource Caption}" Text="Remove the device filter. Applies straight away." />
                            <Button Style="{StaticResource SecondaryButton}" Text="Any device" Command="{Binding ChooseAnyCommand}" />
                        </VerticalStackLayout>
                    </controls:SetupSection>
                    <controls:SearchField>
                        <Entry x:Name="SearchEntry" Text="{Binding SearchText}" Placeholder="Name, hostname or IP"
                               SemanticProperties.Description="Search all devices by name, hostname or IP" />
                    </controls:SearchField>
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                    <Label Style="{StaticResource Caption}" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" />
                    <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
                    <Label Style="{StaticResource Caption}" Text="Reopen the device picker to load devices again." IsVisible="{Binding HasError}" />
                </VerticalStackLayout>
                <Grid Grid.Row="1" SafeAreaEdges="None">
                <CollectionView x:Name="DeviceList" ItemsSource="{Binding Groups}" IsGrouped="True"
                                SelectionMode="None" controls:KeyboardDismiss.OnScroll="True">
                    <CollectionView.Header>
                        <BoxView HeightRequest="20" Color="Transparent" InputTransparent="True" />
                    </CollectionView.Header>
                    <CollectionView.GroupHeaderTemplate>
                        <DataTemplate x:DataType="graylog:GraylogDeviceGroup">
                            <Label Style="{StaticResource SectionHeader}" Text="{Binding Name}" SemanticProperties.HeadingLevel="Level2" />
                        </DataTemplate>
                    </CollectionView.GroupHeaderTemplate>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="graylog:GraylogDeviceChoice">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,6"
                                    AutomationProperties.IsInAccessibleTree="True"
                                    SemanticProperties.Description="{Binding AccessibilityDescription}"
                                    SemanticProperties.Hint="Selects this device and returns immediately">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding ChooseCommand, Source={RelativeSource AncestorType={x:Type graylog:GraylogDevicePickerViewModel}}, x:DataType=graylog:GraylogDevicePickerViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Ellipse AutomationProperties.IsInAccessibleTree="False" Style="{StaticResource Dot}" Fill="{Binding Status, Converter={StaticResource StatusColor}}" VerticalOptions="Start" Margin="0,6,0,0" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Style="{StaticResource RowTitle}" Text="{Binding Name}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding Details}" IsVisible="{Binding HasDetails}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Style="{StaticResource Faint}" Text="{Binding CountText}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <BoxView HeightRequest="12" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
            <BoxView HeightRequest="20" VerticalOptions="Start" InputTransparent="True" ZIndex="1">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
                        <GradientStop Offset="1" Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>
            </Grid>
            </Grid>
        </controls:SetupLayout.Body>
    </controls:SetupLayout>
</ContentPage>
