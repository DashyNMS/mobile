<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.ThresholdsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    x:DataType="vm:ThresholdsViewModel"
    Title="Health thresholds">
    <controls:SetupLayout x:Name="Setup">
        <controls:SetupLayout.Header>
            <controls:PageHeader x:Name="Header" Title="Health thresholds" />
        </controls:SetupLayout.Header>
        <controls:SetupLayout.Body>
            <ScrollView x:Name="FormScroll" SafeAreaEdges="None">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="ValidationError" Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

                    <Label Style="{StaticResource SectionHeader}" Text="OPTICAL POWER (dBm)" />
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Style="{StaticResource Caption}" Text="Weaker is more negative." />
                            <controls:SetupSection Label="Warning at or below (dBm)">
                                <Entry Text="{Binding DbmWarning}" Keyboard="Numeric" HandlerChanged="OnNumericHandlerChanged"
                                       SemanticProperties.Description="Optical power: warning at or below (dBm)" />
                            </controls:SetupSection>
                            <controls:SetupSection Label="Critical at or below (dBm)">
                                <Entry Text="{Binding DbmCritical}" Keyboard="Numeric" HandlerChanged="OnNumericHandlerChanged"
                                       SemanticProperties.Description="Optical power: critical at or below (dBm)" />
                            </controls:SetupSection>
                        </VerticalStackLayout>
                    </Border>

                    <Label Style="{StaticResource SectionHeader}" Text="SIGNAL (dBm)" />
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Style="{StaticResource Caption}" Text="Wireless signal strength." />
                            <controls:SetupSection Label="Warning at or below (dBm)">
                                <Entry Text="{Binding SignalWarning}" Keyboard="Numeric" HandlerChanged="OnNumericHandlerChanged"
                                       SemanticProperties.Description="Signal: warning at or below (dBm)" />
                            </controls:SetupSection>
                            <controls:SetupSection Label="Critical at or below (dBm)">
                                <Entry Text="{Binding SignalCritical}" Keyboard="Numeric" HandlerChanged="OnNumericHandlerChanged"
                                       SemanticProperties.Description="Signal: critical at or below (dBm)" />
                            </controls:SetupSection>
                        </VerticalStackLayout>
                    </Border>

                    <Label Style="{StaticResource SectionHeader}" Text="TEMPERATURE (°C)" />
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Style="{StaticResource Caption}" Text="Too cold or too hot." />
                            <controls:SetupSection Label="Low critical (°C)">
                                <Entry Text="{Binding TemperatureLowCritical}" Keyboard="Numeric" HandlerChanged="OnNumericHandlerChanged"
                                       SemanticProperties.Description="Temperature: low critical (°C)" />
                            </controls:SetupSection>
                            <controls:SetupSection Label="Low warning (°C)">
                                <Entry Text="{Binding TemperatureLowWarning}" Keyboard="Numeric" HandlerChanged="OnNumericHandlerChanged"
                                       SemanticProperties.Description="Temperature: low warning (°C)" />
                            </controls:SetupSection>
                            <controls:SetupSection Label="High warning (°C)">
                                <Entry Text="{Binding TemperatureHighWarning}" Keyboard="Numeric" HandlerChanged="OnNumericHandlerChanged"
                                       SemanticProperties.Description="Temperature: high warning (°C)" />
                            </controls:SetupSection>
                            <controls:SetupSection Label="High critical (°C)">
                                <Entry Text="{Binding TemperatureHighCritical}" Keyboard="Numeric" HandlerChanged="OnNumericHandlerChanged"
                                       SemanticProperties.Description="Temperature: high critical (°C)" />
                            </controls:SetupSection>
                        </VerticalStackLayout>
                    </Border>

                    <Label Style="{StaticResource SectionHeader}" Text="FAN SPEED (RPM)" />
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Style="{StaticResource Caption}" Text="Too slow or too fast." />
                            <controls:SetupSection Label="Low critical (RPM)">
                                <Entry Text="{Binding FanLowCritical}" Keyboard="Numeric" HandlerChanged="OnNumericHandlerChanged"
                                       SemanticProperties.Description="Fan speed: low critical (RPM)" />
                            </controls:SetupSection>
                            <controls:SetupSection Label="Low warning (RPM)">
                                <Entry Text="{Binding FanLowWarning}" Keyboard="Numeric" HandlerChanged="OnNumericHandlerChanged"
                                       SemanticProperties.Description="Fan speed: low warning (RPM)" />
                            </controls:SetupSection>
                            <controls:SetupSection Label="High warning (RPM)">
                                <Entry Text="{Binding FanHighWarning}" Keyboard="Numeric" HandlerChanged="OnNumericHandlerChanged"
                                       SemanticProperties.Description="Fan speed: high warning (RPM)" />
                            </controls:SetupSection>
                            <controls:SetupSection Label="High critical (RPM)">
                                <Entry Text="{Binding FanHighCritical}" Keyboard="Numeric" HandlerChanged="OnNumericHandlerChanged"
                                       SemanticProperties.Description="Fan speed: high critical (RPM)" />
                            </controls:SetupSection>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="Always use these thresholds" />
                                <Label Style="{StaticResource Caption}"
                                       Text="Off: a sensor's own limits set in LibreNMS win for the bounds they set, as on desktop. On: these apply everywhere." />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding OverrideSensorLimits}" VerticalOptions="Center"
                                    SemanticProperties.Description="Always use these thresholds" />
                        </Grid>
                    </Border>

                    <Button Style="{StaticResource SecondaryButton}" Text="Reset to desktop's defaults" Command="{Binding ResetToDefaultsCommand}" Margin="0,16,0,0" />

                    <Label Style="{StaticResource Caption}" Text="Reset changes these fields only. Save applies them; Back discards changes." />
                </VerticalStackLayout>
            </ScrollView>
        </controls:SetupLayout.Body>
        <controls:SetupLayout.PrimaryAction>
            <Button Text="Save" IsEnabled="{Binding SaveCommand.IsRunning, Converter={StaticResource Invert}}" Clicked="OnSaveClicked" HorizontalOptions="Fill" Margin="0,12,0,0" />
        </controls:SetupLayout.PrimaryAction>
    </controls:SetupLayout>
</ContentPage>
