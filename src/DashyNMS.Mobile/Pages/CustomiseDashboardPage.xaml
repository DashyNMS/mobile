<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.CustomiseDashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:views="clr-namespace:DashyNMS.Mobile.Views"
    xmlns:dash="clr-namespace:DashyNMS.Mobile.Dashboard;assembly=DashyNMS.Mobile.Shared"
    x:DataType="dash:CustomiseDashboardViewModel"
    ios:Page.UseSafeArea="True"
    SafeAreaEdges="Container"
    Title="Edit dashboard">

    <!-- As the Edit dashboard mock-up (#140): the cards in one card, dragged to
         reorder, removed with Undo, set up, duplicated or added below from ⋯;
         then the free spot at the end - desktop's "+" space (#145). -->
    <Grid RowDefinitions="Auto,Auto,*">
        <controls:BackBar x:Name="TopBar" Margin="16,0,16,0" />
        <Label Grid.Row="1" Style="{StaticResource PageTitle}" Text="Edit dashboard" SemanticProperties.HeadingLevel="Level1" Margin="16,0" />

        <!-- Not in a ReadableColumn: a CollectionView needs the page's height to scroll. -->
        <CollectionView Grid.Row="2" x:Name="List" ItemsSource="{Binding Cards}" SelectionMode="None"
                        CanReorderItems="True" ReorderCompleted="OnReorderCompleted" Margin="16,0"
                        MaximumWidthRequest="720">
                <CollectionView.Header>
                    <Label Style="{StaticResource Caption}" Margin="4,4,4,12"
                           Text="Drag ≡ to reorder; ⋯ duplicates a card or adds one below it. Changes save as you make them. Remove every card to see the welcome card again." />
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <Border Style="{StaticResource Card}" Padding="20,28">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="No cards" FontFamily="BodySemibold" FontSize="16" HorizontalTextAlignment="Center" />
                            <Label Style="{StaticResource Caption}" HorizontalTextAlignment="Center"
                                   Text="The dashboard shows its welcome card. Add a card to start again." />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dash:DashboardCardOption">
                        <!-- Each card a row, spaced so a drag has room. -->
                        <Grid Padding="0,0,0,8">
                            <Border Style="{StaticResource Card}" Padding="4,0,6,0">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource PrimaryStroke}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="40,*,Auto,Auto,Auto" ColumnSpacing="2" MinimumHeightRequest="64">
                                    <Label Text="≡" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource TextFaintLight}, Dark={StaticResource TextFaintDark}}"
                                           SemanticProperties.Description="Drag to reorder" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1" Padding="0,10">
                                        <Label Text="{Binding Title}" FontFamily="BodySemibold" FontSize="15" LineBreakMode="TailTruncation" />
                                        <Label Style="{StaticResource Faint}" Text="{Binding Subtitle}" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <!-- Sensors, Graph and Top cards: their own set-up. -->
                                    <Button Grid.Column="2" Text="Set up" Style="{StaticResource LinkButton}" IsVisible="{Binding CanSetUp}"
                                            VerticalOptions="Center"
                                            Command="{Binding SetUpCommand, Source={RelativeSource AncestorType={x:Type dash:CustomiseDashboardViewModel}}, x:DataType=dash:CustomiseDashboardViewModel}"
                                            CommandParameter="{Binding .}" />
                                    <!-- Duplicate (where it can be copied) and Add a card below (#145). -->
                                    <Button Grid.Column="3" Text="⋯" Style="{StaticResource LinkButton}" FontSize="20" WidthRequest="44"
                                            VerticalOptions="Center" SemanticProperties.Description="{Binding Title, StringFormat='More for {0}'}"
                                            Command="{Binding MoreCommand, Source={RelativeSource AncestorType={x:Type dash:CustomiseDashboardViewModel}}, x:DataType=dash:CustomiseDashboardViewModel}"
                                            CommandParameter="{Binding .}" />
                                    <!-- Any card comes off; Undo is in the toast. -->
                                    <Border Grid.Column="4" WidthRequest="44" HeightRequest="44" StrokeThickness="0" BackgroundColor="Transparent"
                                            VerticalOptions="Center" SemanticProperties.Description="{Binding Title, StringFormat='Remove {0}'}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding RemoveCommand, Source={RelativeSource AncestorType={x:Type dash:CustomiseDashboardViewModel}}, x:DataType=dash:CustomiseDashboardViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border WidthRequest="22" HeightRequest="22" StrokeThickness="0" StrokeShape="RoundRectangle 11"
                                                BackgroundColor="{StaticResource CriticalColor}" HorizontalOptions="Center" VerticalOptions="Center">
                                            <BoxView WidthRequest="10" HeightRequest="2" Color="White" CornerRadius="1"
                                                     HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <!-- The free spot where the next card goes, as desktop's "+ Add widget" space (#145). -->
                    <Grid Padding="0,0,0,96">
                        <Border StrokeThickness="1.5" StrokeDashArray="4,3" StrokeShape="RoundRectangle 16" MinimumHeightRequest="64"
                                BackgroundColor="Transparent" Stroke="{StaticResource PrimaryStroke}"
                                SemanticProperties.Description="Add a card">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddCardCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="+ Add a card" FontFamily="BodySemibold" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </Border>
                    </Grid>
                </CollectionView.Footer>
            </CollectionView>

        <!-- What just changed, with Undo (#140). -->
        <views:DashboardToastView Grid.Row="2" BindingContext="{Binding Toast}" />
    </Grid>

</ContentPage>
