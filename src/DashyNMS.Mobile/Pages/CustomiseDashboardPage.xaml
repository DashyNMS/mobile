<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.CustomiseDashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:dash="clr-namespace:DashyNMS.Mobile.Dashboard;assembly=DashyNMS.Mobile.Shared"
    x:DataType="dash:CustomiseDashboardViewModel"
    Title="Customise dashboard">

    <ScrollView>
        <controls:ReadableColumn>
            <VerticalStackLayout Padding="16" Spacing="8">

                <Label Style="{StaticResource Caption}"
                       Text="Choose the cards to show, and their order. Changes save as you make them." />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Cards}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dash:DashboardCardOption">
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Title}" FontFamily="BodySemibold" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding Description}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="▲" WidthRequest="40" Padding="0" BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                                            Command="{Binding MoveUpCommand, Source={RelativeSource AncestorType={x:Type dash:CustomiseDashboardViewModel}}, x:DataType=dash:CustomiseDashboardViewModel}"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="2" Text="▼" WidthRequest="40" Padding="0" BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                                            Command="{Binding MoveDownCommand, Source={RelativeSource AncestorType={x:Type dash:CustomiseDashboardViewModel}}, x:DataType=dash:CustomiseDashboardViewModel}"
                                            CommandParameter="{Binding .}" />
                                    <Switch Grid.Column="3" IsToggled="{Binding IsShown}" VerticalOptions="Center" />
                                    <Button Grid.Row="1" Grid.ColumnSpan="4" Text="Set up…" HorizontalOptions="Start" Margin="0,6,0,0"
                                            IsVisible="{Binding CanSetUp}"
                                            Command="{Binding SetUpCommand, Source={RelativeSource AncestorType={x:Type dash:CustomiseDashboardViewModel}}, x:DataType=dash:CustomiseDashboardViewModel}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Button Text="Back to the standard dashboard" Command="{Binding ResetToDefaultsCommand}" Margin="0,12,0,0" />

            </VerticalStackLayout>
        </controls:ReadableColumn>
    </ScrollView>

</ContentPage>
