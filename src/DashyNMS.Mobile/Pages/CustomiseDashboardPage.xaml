<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.CustomiseDashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:views="clr-namespace:DashyNMS.Mobile.Views"
    xmlns:dash="clr-namespace:DashyNMS.Mobile.Dashboard;assembly=DashyNMS.Mobile.Shared"
    x:DataType="dash:CustomiseDashboardViewModel"
    SafeAreaEdges="Container"
    Title="Edit dashboard">

    <!-- As the Edit dashboard mock-up (#140), in the dashboard's columns (#401):
         cards dragged to reorder, removed with Undo, set up, duplicated, moved
         or added after from ⋯; then the free spot at the end - desktop's "+"
         space (#145). -->
    <Grid SafeAreaEdges="None" RowDefinitions="Auto,Auto,*">
        <controls:BackBar x:Name="TopBar" Margin="16,0,16,0" />
        <Grid x:Name="Heading" Grid.Row="1" SafeAreaEdges="None" Margin="16,0" Padding="0,16,0,4">
            <Label Style="{StaticResource PageTitle}" Text="Edit dashboard" SemanticProperties.HeadingLevel="Level1" />
        </Grid>

        <!-- Not in a ReadableColumn: a CollectionView needs the page's height to scroll. -->
        <CollectionView Grid.Row="2" x:Name="List" ItemsSource="{Binding Cards}" SelectionMode="None"
                        CanReorderItems="True" ReorderCompleted="OnReorderCompleted" Margin="16,0" ItemSizingStrategy="MeasureAllItems">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout x:Name="CardLayout" Orientation="Vertical" Span="1" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <Label Style="{StaticResource Caption}" Margin="4,20,4,12"
                           Text="Drag to reorder. Changes save automatically." />
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <Border Style="{StaticResource Card}" Padding="20,28" Margin="0,20,0,0">
                        <VerticalStackLayout Spacing="8" SafeAreaEdges="None">
                            <Label Text="No cards" FontFamily="BodySemibold" FontSize="16" HorizontalTextAlignment="Center" />
                            <Label Style="{StaticResource Caption}" HorizontalTextAlignment="Center"
                                   Text="The dashboard shows its welcome card. Add a card to start again." />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dash:DashboardCardOption">
                        <!-- Each card a row, spaced so a drag has room. -->
                        <Grid SafeAreaEdges="None">
                            <Border Style="{StaticResource Card}" Padding="8,8,8,4">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource PrimaryStroke}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="32,*,44" RowDefinitions="Auto,Auto" ColumnSpacing="4" SafeAreaEdges="None" MinimumHeightRequest="64">
                                    <!-- Six 3pt dots in a 24pt box, drawn at their own size: Uniform
                                         stretched the marks' 10pt bounds to fill the box and clipped the
                                         outer strokes. Screen readers move cards from ⋯ instead. -->
                                    <Path Data="M7.5 6A1.5 1.5 0 1 0 10.5 6A1.5 1.5 0 1 0 7.5 6Z M13.5 6A1.5 1.5 0 1 0 16.5 6A1.5 1.5 0 1 0 13.5 6Z M7.5 12A1.5 1.5 0 1 0 10.5 12A1.5 1.5 0 1 0 7.5 12Z M13.5 12A1.5 1.5 0 1 0 16.5 12A1.5 1.5 0 1 0 13.5 12Z M7.5 18A1.5 1.5 0 1 0 10.5 18A1.5 1.5 0 1 0 7.5 18Z M13.5 18A1.5 1.5 0 1 0 16.5 18A1.5 1.5 0 1 0 13.5 18Z"
                                          Fill="{AppThemeBinding Light={StaticResource TextFaintLight}, Dark={StaticResource TextFaintDark}}"
                                          WidthRequest="24" HeightRequest="24" Aspect="None"
                                          HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True"
                                          AutomationProperties.IsInAccessibleTree="False" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4" Padding="0,8" SafeAreaEdges="None"
                                                         SemanticProperties.Description="{Binding AccessibleDescription}"
                                                         SemanticProperties.Hint="Use More to move it">
                                        <!-- Read once, through the stack's description, not again line by line. -->
                                        <Label Text="{Binding Title}" FontFamily="BodySemibold" FontSize="15" LineBreakMode="WordWrap"
                                               AutomationProperties.IsInAccessibleTree="False" />
                                        <Label Style="{StaticResource Faint}" Text="{Binding Subtitle}" LineBreakMode="WordWrap"
                                               AutomationProperties.IsInAccessibleTree="False" />
                                    </VerticalStackLayout>
                                    <!-- Each supported card opens its own setup, including Spotlight for logs. -->
                                    <Button Grid.Row="1" Grid.Column="1" HorizontalOptions="Start" Text="Set up" Style="{StaticResource LinkButton}" IsVisible="{Binding CanSetUp}"
                                            VerticalOptions="Center" SemanticProperties.Description="{Binding SetUpDescription}"
                                            Command="{Binding SetUpCommand, Source={RelativeSource AncestorType={x:Type dash:CustomiseDashboardViewModel}}, x:DataType=dash:CustomiseDashboardViewModel}"
                                            CommandParameter="{Binding .}" />
                                    <!-- Duplicate (where it can be copied), Add a card after (#145), moves and Remove. -->
                                    <Button Grid.Column="2" Text="⋯" Style="{StaticResource LinkButton}" FontSize="20" WidthRequest="44"
                                            VerticalOptions="Center" SemanticProperties.Description="{Binding MoreDescription}"
                                            Command="{Binding MoreCommand, Source={RelativeSource AncestorType={x:Type dash:CustomiseDashboardViewModel}}, x:DataType=dash:CustomiseDashboardViewModel}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <!-- The free spot where the next card goes, as desktop's "+ Add widget" space (#145). -->
                    <Grid x:Name="Footer" Padding="0,12,0,24" SafeAreaEdges="None">
                        <Button Text="+ Add a card" Command="{Binding AddCardCommand}"
                                MinimumHeightRequest="64"
                                SemanticProperties.Description="Add a card" />
                    </Grid>
                </CollectionView.Footer>
            </CollectionView>

        <!-- What just changed, with Undo (#140). -->
        <BoxView Grid.Row="2" HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
                    <GradientStop Offset="1" Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>
        <views:DashboardToastView x:Name="Toast" Grid.Row="2" BindingContext="{Binding Toast}" />
    </Grid>

</ContentPage>
