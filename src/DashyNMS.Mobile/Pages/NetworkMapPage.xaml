<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.NetworkMapPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:topo="clr-namespace:DashyNMS.Mobile.Topology;assembly=DashyNMS.Mobile.Shared"
    x:DataType="topo:NetworkMapViewModel"
    SafeAreaEdges="Container"
    Title="Network map">

    <!-- As desktop's Network map (#86): LibreNMS's links drawn as a diagram.
         Drag to move around, pinch to zoom, tap a device for its connections
         then drag it to move it, double-tap to zoom in. -->
    <!-- Search, then a strip of chips, then the map with the rest of the
         screen - Location and Group are chips, not pickers, and nothing sits
         on top of the map but Fit (#110). -->
    <!-- On iOS the map runs on under the camera and the tab bar, and the
         chips scroll in from under the camera, so the screen feels as big as
         it is; the header, Fit and the device card stay clear of them. The
         page places those itself (see CoveredEdges), so nothing here keeps
         clear of the safe area on its own. -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" SafeAreaEdges="None">

        <controls:PageHeader x:Name="Header" Title="Network map" Margin="16,0,16,0">
            <controls:PageHeader.Actions>
                <!-- Icons only, so the title keeps its line on a narrow phone (#296). -->
                <HorizontalStackLayout Spacing="4">
                    <controls:IconButton x:Name="SearchButton" Kind="Plain" Icon="{x:Static controls:Icons.Search}" Command="{Binding ToggleSearchCommand}"
                                         IsOn="{Binding IsSearchOpen}" SemanticProperties.Description="Find a device" />
                    <controls:IconButton x:Name="RefreshButton" Kind="Plain" Icon="{x:Static controls:Icons.Rediscover}" Command="{Binding RefreshCommand}"
                                         SemanticProperties.Description="Refresh the map" />
                </HorizontalStackLayout>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <VerticalStackLayout x:Name="SearchPanel" Grid.Row="1" Padding="16,0,16,0" SafeAreaEdges="None">
            <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
        </VerticalStackLayout>

        <ScrollView x:Name="ChipStrip" Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="16,4,16,8" SafeAreaEdges="None">
            <HorizontalStackLayout Spacing="8" SafeAreaEdges="None">
                <!-- Location, device group (desktop's own scope), or both: tap to choose. -->
                <Button Style="{StaticResource Chip}" Text="{Binding LocationChipText}" Command="{Binding ChooseLocationCommand}"
                        SemanticProperties.Hint="Show only the devices at one location">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsLocationFiltered}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Style="{StaticResource Chip}" Text="{Binding GroupChipText}" Command="{Binding ChooseGroupCommand}"
                        SemanticProperties.Hint="Show only the devices in one group">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsGroupFiltered}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <BoxView WidthRequest="1" HeightRequest="20" VerticalOptions="Center"
                         Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource ChipStrokeDark}}" />
                <!-- What switches see that LibreNMS doesn't monitor, drawn small and square - off by default. -->
                <Button Style="{StaticResource Chip}" Text="Neighbours" Command="{Binding ToggleNeighboursCommand}"
                        SemanticProperties.Hint="Also show what switches see that LibreNMS doesn't monitor">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowNeighbours}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <!-- Devices with no links at all, in a grid below the rest - off by default, as desktop. -->
                <Button Style="{StaticResource Chip}" Text="Unlinked" Command="{Binding ToggleUnlinkedDevicesCommand}"
                        SemanticProperties.Hint="Also show devices with no links">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowUnlinkedDevices}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <!-- Out of the header, where it crowded the title on a narrow phone (#296);
                     on iOS 26 and later it's in the glass by the tab bar instead (see the page). -->
                <Button x:Name="ResetLayoutChip" Style="{StaticResource Chip}" Text="Reset layout" Command="{Binding ResetLayoutCommand}"
                        SemanticProperties.Hint="Forget where devices were moved to and lay the map out again" />
            </HorizontalStackLayout>
        </ScrollView>

        <!-- The map itself, on down behind the device card; see NetworkMapDrawable for how it's drawn. -->
        <Grid x:Name="MapArea" Grid.Row="3" Grid.RowSpan="2" SafeAreaEdges="None">
            <GraphicsView x:Name="MapCanvas" />

            <!-- The map fades out as it passes up under the chips, as the Dashboard's cards do under its header. -->
            <BoxView HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
                        <GradientStop Offset="1" Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>
        </Grid>

        <!-- What sits on the map, above the device card and inside the edges
             the camera and tab bar leave (set from the page) - also what Fit
             fits to. Touches between them go through to the map. -->
        <Grid x:Name="MapControls" Grid.Row="3" SafeAreaEdges="None" InputTransparent="True" CascadeInputTransparent="False">
            <Label Style="{StaticResource Faint}" Text="{Binding SummaryText}" Margin="16,6" InputTransparent="True"
                   HorizontalOptions="Start" VerticalOptions="End" />

            <!-- Fit floats in the corner, out of the map's way - on iOS 26 and
                 later it's in the glass by the tab bar instead (see the page). -->
            <controls:IconButton x:Name="FitButton" Kind="Filled" Icon="{x:Static controls:Icons.Fit}"
                                 WidthRequest="48" HeightRequest="48" Margin="12" HorizontalOptions="End" VerticalOptions="End"
                                 SemanticProperties.Description="Fit the whole map">
                <controls:IconButton.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </controls:IconButton.StrokeShape>
            </controls:IconButton>

            <!-- Centred over the map, the logo's heartbeat over what it's doing (#109). -->
            <controls:BusyCard Text="Loading the network…" IsVisible="{Binding IsFetching}" />
            <controls:BusyCard Text="Laying out the map…" IsVisible="{Binding IsLayingOut}" />
            <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                   HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" Margin="32" />
        </Grid>

        <!-- Search when asked for (the glass button by the tab bar, or the
             header's icon where there's no glass): a field floating over the
             top of the map, where the keyboard can't cover it, rather than a
             system bar wedged under the title (#296). It slides down from
             under the chips and back up when done (see the page), so its own
             strip, clipped, the width of the screen: it reaches past the map's
             controls as far as its row allows. -->
        <Grid x:Name="SearchSlot" Grid.Row="3" SafeAreaEdges="None" VerticalOptions="Start" IsClippedToBounds="True"
              InputTransparent="True" CascadeInputTransparent="False">
            <!-- A text box rather than a SearchBar: UISearchBar draws its own
                 grey field, which sat inside this one as a box in a box. -->
            <Border x:Name="SearchField" Margin="12,8" Padding="14,0,4,0" VerticalOptions="Start" HeightRequest="46"
                    IsVisible="False" StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource ChipStrokeDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="23" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="2">
                    <!-- Icons.Search, in the placeholder's colour. -->
                    <Path Data="M10.5 4A6.5 6.5 0 1 0 10.5 17A6.5 6.5 0 1 0 10.5 4Z M15.5 15.5 20 20" StrokeThickness="2" StrokeLineCap="Round"
                          WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" InputTransparent="True"
                          Stroke="{AppThemeBinding Light={StaticResource TextFaintLight}, Dark={StaticResource TextFaintDark}}" />
                    <Entry x:Name="Search" Grid.Column="1" Text="{Binding SearchText}" Placeholder="Find a device" VerticalOptions="Center"
                           ReturnType="Search" ClearButtonVisibility="Never" Completed="OnSearchCompleted"
                           IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" MinimumHeightRequest="40" />
                </Grid>
                </Border>
        </Grid>

        <!-- The tapped device: a compact bar - name, state, Open - that opens to
             what it's connected to (tap one to go there), so it doesn't cover
             half the map (#110). -->
        <!-- Capped lower on a short screen (see the page), so a selected device leaves most of the map (#296). -->
        <!-- Over the foot of the map, always clear of the camera and tab bar (margin set from the page). -->
        <Border x:Name="SelectionCard" Grid.Row="4" Style="{StaticResource Card}" Margin="12,6,12,12" SafeAreaEdges="None"
                IsVisible="{Binding HasSelectedNode}" MaximumHeightRequest="300">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                    <VerticalStackLayout VerticalOptions="Center">
                        <!-- Long device names wrap rather than lose their end beside Open and Close. -->
                        <Label Text="{Binding SelectedNode.Name}" FontFamily="BodySemibold" FontSize="16" LineBreakMode="WordWrap" MaxLines="3" />
                        <Label Style="{StaticResource Faint}" Text="{Binding SelectedNodeStateText}" />
                    </VerticalStackLayout>
                    <!-- A neighbour isn't a LibreNMS device: nothing to open. -->
                    <Button Grid.Column="1" Style="{StaticResource LinkButton}" Text="Open" Command="{Binding OpenSelectedDeviceCommand}"
                            IsVisible="{Binding HasSelectedDevice}" />
                    <Button Grid.Column="2" Style="{StaticResource LinkButton}" Text="Close" Command="{Binding ClearSelectionCommand}" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Style="{StaticResource Faint}" FontSize="12" Text="Drag it on the map to move it." VerticalOptions="Center" />
                    <Button Grid.Column="1" Style="{StaticResource LinkButton}" Text="{Binding ConnectionsText}"
                            Command="{Binding ToggleSelectionExpandedCommand}" HeightRequest="32" MinimumHeightRequest="32" />
                </Grid>
                <VerticalStackLayout Grid.Row="2" IsVisible="{Binding IsSelectionExpanded}" Spacing="4">
                    <Label Style="{StaticResource Caption}" Text="{Binding SelectedNode.Detail}" LineBreakMode="TailTruncation" />
                <CollectionView x:Name="ConnectionsList" ItemsSource="{Binding SelectedConnections}" SelectionMode="None" MaximumHeightRequest="200">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="topo:NetworkConnection">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,7">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectNeighbourCommand, Source={RelativeSource AncestorType={x:Type topo:NetworkMapViewModel}}, x:DataType=topo:NetworkMapViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Text="{Binding NeighbourName}" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1" Style="{StaticResource Faint}" Text="{Binding Ports}" FontFamily="Mono" FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>

</ContentPage>
