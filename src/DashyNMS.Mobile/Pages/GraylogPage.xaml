<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.GraylogPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:graylog="clr-namespace:DashyNMS.Mobile.Graylog;assembly=DashyNMS.Mobile.Shared"
    xmlns:sys="clr-namespace:System.Collections.Generic;assembly=System.Runtime"
    x:DataType="graylog:GraylogViewModel"
    Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16,8,16,0">

        <!-- LibreNMS's Graylog filters: time range, level and stream. -->
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8">
            <Picker Title="Time range" ItemsSource="{Binding RangeLabels}" SelectedIndex="{Binding RangeIndex}" />
            <Picker Grid.Column="1" Title="Level" ItemsSource="{Binding LevelLabels}" SelectedIndex="{Binding LevelIndex}" />
            <Picker Grid.Row="1" Grid.ColumnSpan="2" Title="Stream" ItemsSource="{Binding StreamLabels}" SelectedIndex="{Binding StreamIndex}" />
        </Grid>

        <SearchBar Grid.Row="1" Text="{Binding SearchText}" SearchCommand="{Binding SearchCommand}"
                   Placeholder="Search message text" Margin="0,6,0,0" />

        <Label Grid.Row="2" Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
        <Label Grid.Row="3" Style="{StaticResource Caption}" Text="{Binding SummaryText}" Margin="0,4" />

        <!-- Switched off, or missing a password: say where to set it up. -->
        <VerticalStackLayout Grid.Row="4" IsVisible="{Binding IsNotConfigured}" Spacing="12" Margin="0,32" HorizontalOptions="Center">
            <Label Style="{StaticResource Caption}" HorizontalTextAlignment="Center"
                   Text="Graylog isn't set up on this phone. Add your Graylog server in Settings to see its messages here." />
            <Button Text="Set up Graylog" Command="{Binding OpenSettingsCommand}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="4" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}" IsVisible="{Binding IsConfigured}">
            <CollectionView ItemsSource="{Binding Messages}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,32" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="graylog:GraylogMessageItem">
                        <Border Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding ToggleCommand, Source={RelativeSource AncestorType={x:Type graylog:GraylogViewModel}}, x:DataType=graylog:GraylogViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="6,*" ColumnSpacing="12">
                                <BoxView Color="{Binding Status, Converter={StaticResource StatusColor}}" CornerRadius="3" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding MessageText}" LineBreakMode="WordWrap" MaxLines="3"
                                           IsVisible="{Binding IsExpanded, Converter={StaticResource Invert}}" />
                                    <Label Text="{Binding FullText}" LineBreakMode="WordWrap" IsVisible="{Binding IsExpanded}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}" LineBreakMode="TailTruncation" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding TimeText}" FontSize="12" />

                                    <!-- Opened: every field, as desktop's details pane. -->
                                    <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="4" Margin="0,8,0,0">
                                        <Button Text="Open device" HorizontalOptions="Start" IsVisible="{Binding HasDevice}"
                                                Command="{Binding OpenDeviceCommand, Source={RelativeSource AncestorType={x:Type graylog:GraylogViewModel}}, x:DataType=graylog:GraylogViewModel}"
                                                CommandParameter="{Binding .}" />
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Fields}" Spacing="4">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="sys:KeyValuePair(x:String,x:String)">
                                                    <VerticalStackLayout>
                                                        <Label Style="{StaticResource Caption}" Text="{Binding Key}" FontSize="12" />
                                                        <Label Text="{Binding Value}" LineBreakMode="CharacterWrap" />
                                                    </VerticalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <Button Text="Load more" Command="{Binding LoadMoreCommand}" IsVisible="{Binding CanLoadMore}" Margin="0,8,0,16" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
