<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.GraylogPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:graylog="clr-namespace:DashyNMS.Mobile.Graylog;assembly=DashyNMS.Mobile.Shared"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    x:DataType="graylog:GraylogViewModel"
    ios:Page.UseSafeArea="True"
    SafeAreaEdges="Container"
    Title="{Binding Title}">

    <!-- On an iPad or a Mac, the message you tap shows beside the list (#88). -->
    <controls:ListDetail x:Name="Split" Placeholder="Choose a message to see it here.">

    <!-- As the Graylog mock-up (#117): search, the filter chips, then the messages in one card. -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Padding="16,8,16,0">

        <controls:PageHeader x:Name="Header" Title="Graylog" />

        <!-- Slides out when the list is scrolled back up or pulled down - see SearchReveal.
             Graylog searches on the search button rather than every keystroke. -->
        <Grid Grid.Row="1" x:Name="SearchSlot" IsClippedToBounds="True" IsVisible="{Binding IsConfigured}">
            <SearchBar x:Name="Search" Text="{Binding SearchText}" SearchCommand="{Binding SearchCommand}"
                       Placeholder="Search messages" Margin="-6,2,-6,0" />
        </Grid>

        <!-- LibreNMS's Graylog filters as chips: blue when not at the page's own start. -->
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,10,0,0"
                    IsVisible="{Binding IsConfigured}">
            <HorizontalStackLayout Spacing="8">

                <!-- Device: its chooser, and × to go back to every device's. Fixed on a device's own page. -->
                <Border x:Name="DeviceChip" StrokeShape="RoundRectangle 18" StrokeThickness="1" HeightRequest="36" Padding="14,0"
                        BackgroundColor="Transparent"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource ChipStrokeDark}}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding HasDeviceFilter}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                            <Setter Property="Stroke" Value="{StaticResource PrimaryStroke}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChooseDeviceCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="{Binding DeviceChipText}" FontSize="14" VerticalOptions="Center" MaximumWidthRequest="180"
                               LineBreakMode="TailTruncation">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding HasDeviceFilter}" Value="True">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="▾" FontSize="12" VerticalOptions="Center" IsVisible="{Binding HasDeviceFilter, Converter={StaticResource Invert}}" />
                        <Label Text="✕" FontSize="13" VerticalOptions="Center" Padding="2,8"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                               IsVisible="{Binding CanClearDevice}" SemanticProperties.Description="Show every device's messages">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ClearDeviceCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </Border>

                <Button Style="{StaticResource Chip}" Text="{Binding RangeChipText, StringFormat='{0} ▾'}" Command="{Binding ChooseRangeCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsRangeSet}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Style="{StaticResource Chip}" Text="{Binding LevelChipText, StringFormat='{0} ▾'}" Command="{Binding ChooseLevelCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsLevelSet}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Style="{StaticResource Chip}" Text="{Binding StreamChipText, StringFormat='{0} ▾'}" Command="{Binding ChooseStreamCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsStreamSet}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="4,6,0,4" IsVisible="{Binding IsConfigured}">
            <Label Style="{StaticResource Faint}" Text="{Binding SummaryText}" VerticalOptions="Center" />
            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Text="Clear"
                    Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}"
                    HeightRequest="30" MinimumHeightRequest="30" />
        </Grid>

        <!-- Graylog's own reason when a search fails, in a card of its own. -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8" IsVisible="{Binding HasError}"
                BackgroundColor="{StaticResource CriticalTint}" Stroke="{StaticResource CriticalStroke}">
            <Label Text="{Binding ErrorMessage}" FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
        </Border>

        <!-- Switched off, or missing a password: say where to set it up. -->
        <Border Grid.Row="5" Style="{StaticResource Card}" Padding="20,24" VerticalOptions="Start" Margin="0,6,0,0"
                IsVisible="{Binding IsNotConfigured}">
            <VerticalStackLayout Spacing="8">
                <Label Text="Connect Graylog" FontFamily="BodySemibold" FontSize="16" HorizontalTextAlignment="Center" />
                <Label Style="{StaticResource Caption}" HorizontalTextAlignment="Center"
                       Text="See your Graylog server's messages here, by device, level and stream. Add the server in Settings." />
                <Button Text="Set up Graylog" Command="{Binding OpenSettingsCommand}" HorizontalOptions="Center" Margin="0,8,0,0" />
            </VerticalStackLayout>
        </Border>

        <!-- Loading the first time, or after a pull: the busy card over the list (#111). -->
        <controls:BusyCard x:Name="Busy" Grid.Row="5" ZIndex="1" IsVisible="False" />
        <!-- The rows share one card, as the other lists do (#69). -->
        <Border Grid.Row="5" Style="{StaticResource ListCard}" Margin="0,0,0,12" IsVisible="{Binding IsConfigured}">
            <RefreshView x:Name="PullRefresh" Command="{Binding RefreshCommand}">
                <CollectionView Margin="0,-1,0,0" ItemsSource="{Binding Messages}" SelectionMode="None" x:Name="List">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="8" Padding="20,32" IsVisible="{Binding IsEmpty}">
                            <Label Text="No messages" FontFamily="BodySemibold" HorizontalTextAlignment="Center" />
                            <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" HorizontalTextAlignment="Center" />
                            <Button Style="{StaticResource LinkButton}" Text="Clear filters" HorizontalOptions="Center"
                                    Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="graylog:GraylogMessageItem">
                            <!-- A level dot, the sender, the message on one line, its level and
                                 facility, and the time at the right. -->
                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" RowDefinitions="*,Auto" ColumnSpacing="12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenMessageCommand, Source={RelativeSource AncestorType={x:Type graylog:GraylogViewModel}}, x:DataType=graylog:GraylogViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Ellipse Style="{StaticResource Dot}" Fill="{Binding Status, Converter={StaticResource StatusColor}}"
                                         VerticalOptions="Start" Margin="0,6,0,0" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <!-- Every row is the one device's once the Device chip is set. -->
                                    <Label Style="{StaticResource RowTitle}" Text="{Binding SourceText}"
                                           IsVisible="{Binding ShowsSource, Source={RelativeSource AncestorType={x:Type graylog:GraylogViewModel}}, x:DataType=graylog:GraylogViewModel}" />
                                    <Label Text="{Binding MessageText}" FontFamily="Mono" FontSize="12.5" LineBreakMode="TailTruncation" MaxLines="1"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource Gray100}}" />
                                    <Label Style="{StaticResource Faint}" Text="{Binding MetaText}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Style="{StaticResource Faint}" Text="{Binding ShortTimeText}" VerticalOptions="Start" Margin="0,2,0,0" />
                                <!-- The bottom padding; the line itself is at the top of the row (#120). -->
                                <BoxView Grid.Row="1" Grid.ColumnSpan="3" HeightRequest="1" Margin="0,11,0,0" Color="Transparent" />
                                <BoxView Grid.ColumnSpan="3" Style="{StaticResource RowLine}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <!-- The next page, as the card's last row. -->
                    <CollectionView.Footer>
                        <Grid IsVisible="{Binding CanLoadMore}">
                            <BoxView Style="{StaticResource Divider}" VerticalOptions="Start" />
                            <Button Style="{StaticResource LinkButton}" Text="Load more" Command="{Binding LoadMoreCommand}"
                                    HorizontalOptions="Fill" HeightRequest="48" />
                        </Grid>
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>
        </Border>

    </Grid>

    </controls:ListDetail>

</ContentPage>
