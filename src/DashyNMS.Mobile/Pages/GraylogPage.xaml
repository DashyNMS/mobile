<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DashyNMS.Mobile.Pages.GraylogPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:graylog="clr-namespace:DashyNMS.Mobile.Graylog;assembly=DashyNMS.Mobile.Shared"
    x:DataType="graylog:GraylogViewModel"
    SafeAreaEdges="Container"
    Title="{Binding Title}">

    <ContentPage.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource Chip}" x:Key="GraylogChoice">
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="HeightRequest" Value="-1" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="MaximumWidthRequest" Value="{Binding Width, Source={x:Reference ListCard}}" />
        </Style>
    </ContentPage.Resources>
    <!-- On an iPad or a Mac, the message you tap shows beside the list (#88). -->
    <controls:ListDetail x:Name="Split" SafeAreaEdges="None" Placeholder="Choose a message to see it here.">

    <!-- As the Event and Alert log page (#483, #517): search, a horizontal strip of
         filter choices, a summary and status in fixed rows, then the messages in one card. -->
    <Grid x:Name="ListColumn" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" SafeAreaEdges="None">

        <controls:PageHeader x:Name="Header" Margin="16,0" Title="Graylog">
            <controls:PageHeader.Actions>
                <controls:IconButton x:Name="SearchButton" IsVisible="{Binding IsConfigured}" Kind="Plain" Icon="{x:Static controls:Icons.Search}" SemanticProperties.Description="Search messages" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Grid x:Name="SearchSlot" Grid.Row="1" HeightRequest="0" IsClippedToBounds="True" SafeAreaEdges="None">
            <controls:SearchField x:Name="SearchField" Margin="16,4,16,8" VerticalOptions="Start" IsVisible="False">
                <Entry x:Name="Search" Text="{Binding SearchText}" Placeholder="Search messages" Completed="OnSearchCompleted" />
            </controls:SearchField>
        </Grid>

        <!-- The strip's clip spans the page so choices scroll beneath the camera;
             its padding keeps them clear at rest. A fixed device is read-only. -->
        <ScrollView x:Name="FilterStrip" SafeAreaEdges="None" Padding="16,0" Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,10,0,0"
                    IsVisible="{Binding IsConfigured}">
            <HorizontalStackLayout Spacing="8">

                <Label Text="{Binding DeviceFilterText, StringFormat='Device: {0}'}" IsVisible="{Binding IsDeviceFixed}" LineBreakMode="WordWrap" VerticalOptions="Center" MaximumWidthRequest="{Binding Width, Source={x:Reference ListCard}}" />
                <Button Style="{StaticResource GraylogChoice}" Text="{Binding DeviceFilterText, StringFormat='Device: {0} ▾'}" Command="{Binding ChooseDeviceCommand}" IsVisible="{Binding IsDeviceFixed, Converter={StaticResource Invert}}" />
                <Button Style="{StaticResource GraylogChoice}" Text="Clear device" Command="{Binding ClearDeviceCommand}" IsVisible="{Binding CanClearDevice}" />
                <Button Style="{StaticResource GraylogChoice}" Text="{Binding RangeChipText, StringFormat='Time: {0} ▾'}" Command="{Binding ChooseRangeCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsRangeSet}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Style="{StaticResource GraylogChoice}" Text="{Binding LevelChipText, StringFormat='Level: {0} ▾'}" Command="{Binding ChooseLevelCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsLevelSet}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Style="{StaticResource GraylogChoice}" Text="{Binding StreamChipText, StringFormat='Stream: {0} ▾'}" Command="{Binding ChooseStreamCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsStreamSet}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- Auto-refresh (#214), as desktop's logs: off until switched on; its interval beside it. -->
                <Button Style="{StaticResource GraylogChoice}" Text="Auto-refresh: Off" Command="{Binding ToggleAutoRefreshCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding AutoRefresh.IsOn}" Value="True">
                            <Setter Property="Text" Value="Auto-refresh: On" />
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                            <Setter Property="BorderColor" Value="{StaticResource PrimaryStroke}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Style="{StaticResource GraylogChoice}" Text="{Binding AutoRefresh.IntervalText, StringFormat='Interval: {0} ▾'}"
                        Command="{Binding ChooseAutoRefreshIntervalCommand}" IsVisible="{Binding AutoRefresh.IsOn}" />

            </HorizontalStackLayout>
        </ScrollView>

        <!-- Its height kept while the summary is still blank, so the choices never touch the list (#143). -->
        <Grid x:Name="Summary" Grid.Row="3" ColumnDefinitions="*,Auto" Margin="20,6,16,4" MinimumHeightRequest="30" IsVisible="{Binding IsConfigured}">
            <VerticalStackLayout VerticalOptions="Center">
                <Label Style="{StaticResource Faint}" Text="{Binding SummaryText}" LineBreakMode="WordWrap" />
                <!-- Stream choices unavailable, or a failed auto-refresh: quiet, with the rows and filters left as they were. -->
                <Label Style="{StaticResource Faint}" Text="{Binding StreamProblem}" IsVisible="{Binding HasStreamProblem}" LineBreakMode="WordWrap" />
                <Label Style="{StaticResource Faint}" Text="{Binding RefreshProblem}" IsVisible="{Binding HasRefreshProblem}" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Text="Clear filters"
                    Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}"
                    MinimumHeightRequest="44" />
        </Grid>

        <!-- Graylog's own reason when a search fails, in a card of its own. -->
        <Border x:Name="ErrorCard" Grid.Row="4" Style="{StaticResource Card}" Padding="14,12" Margin="16,0,16,8" IsVisible="{Binding HasError}"
                BackgroundColor="{StaticResource CriticalTint}" Stroke="{StaticResource CriticalStroke}">
            <Label Text="{Binding ErrorMessage}" FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
        </Border>

        <!-- Switched off, or missing a password: say where to set it up. -->
        <Border x:Name="SetupCard" Grid.Row="5" Style="{StaticResource Card}" Padding="20,24" VerticalOptions="Start" Margin="16,6,16,0"
                IsVisible="{Binding IsNotConfigured}">
            <VerticalStackLayout Spacing="8">
                <Label Text="Connect Graylog" FontFamily="BodySemibold" FontSize="16" HorizontalTextAlignment="Center" />
                <Label Style="{StaticResource Caption}" HorizontalTextAlignment="Center"
                       Text="See your Graylog server's messages here, by device, level and stream. Add the server in Settings." />
                <Button Text="Set up Graylog" Command="{Binding OpenSettingsCommand}" HorizontalOptions="Center" Margin="0,8,0,0" />
            </VerticalStackLayout>
        </Border>

        <!-- Loading the first time, or after a pull: the busy card over the list (#111). -->
        <controls:BusyCard x:Name="Busy" Margin="16,0" Grid.Row="5" ZIndex="1" IsVisible="False" />
        <!-- The rows share one card, as the other lists do (#69). -->
        <Border x:Name="ListCard" Grid.Row="5" SafeAreaEdges="None" Style="{StaticResource ListCard}" Margin="16,0,16,12" IsVisible="{Binding IsConfigured}">
            <Grid>
            <RefreshView SafeAreaEdges="None" x:Name="PullRefresh" Command="{Binding RefreshCommand}">
                <CollectionView controls:KeyboardDismiss.OnScroll="False" Margin="0,-1,0,0" ItemsSource="{Binding Messages}" SelectionMode="None" x:Name="List">
                    <CollectionView.Header><BoxView HeightRequest="20" Color="Transparent" InputTransparent="True" /></CollectionView.Header>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="8" Padding="20,40,20,32" IsVisible="{Binding IsEmpty}">
                            <Label Text="No messages" FontFamily="BodySemibold" HorizontalTextAlignment="Center" />
                            <Label Style="{StaticResource Caption}" Text="{Binding EmptyText}" HorizontalTextAlignment="Center" />
                            <Button Style="{StaticResource LinkButton}" Text="Clear filters" HorizontalOptions="Center"
                                    Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="graylog:GraylogMessageItem">
                            <Grid>
                                <BoxView Style="{StaticResource RowLine}" Margin="0" />
                                <VerticalStackLayout Padding="14,10" Spacing="4" InputTransparent="True" AutomationProperties.ExcludedWithChildren="True">
                                    <Label Style="{StaticResource RowTitle}" Text="{Binding ListSourceText}" LineBreakMode="WordWrap" IsVisible="{Binding ShowsSource, Source={RelativeSource AncestorType={x:Type graylog:GraylogViewModel}}, x:DataType=graylog:GraylogViewModel}" />
                                    <Label Text="{Binding ListMessageText}" TextType="Text" LineBreakMode="WordWrap" />
                                    <Label Text="{Binding ListLevelText}" LineBreakMode="WordWrap" />
                                    <Label Style="{StaticResource Faint}" Text="{Binding ListFacilityText}" LineBreakMode="WordWrap" />
                                    <Label Style="{StaticResource Faint}" Text="{Binding DetailTimeText}" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <Button Text="" BackgroundColor="Transparent" BorderWidth="0" MinimumHeightRequest="44" HorizontalOptions="Fill" VerticalOptions="Fill"
                                        SemanticProperties.Description="{Binding OpenDescription}"
                                        Command="{Binding OpenMessageCommand, Source={RelativeSource AncestorType={x:Type graylog:GraylogViewModel}}, x:DataType=graylog:GraylogViewModel}" CommandParameter="{Binding .}">
                                    <Button.Style><Style TargetType="Button" /></Button.Style>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="Disabled" />
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Focused">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="PointerOver" />
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <!-- The next page, as the card's last row. -->
                    <CollectionView.Footer>
                        <VerticalStackLayout>
                        <Grid IsVisible="{Binding CanLoadMore}">
                            <BoxView Style="{StaticResource Divider}" VerticalOptions="Start" />
                            <Button Style="{StaticResource LinkButton}" Text="Load more" Command="{Binding LoadMoreCommand}"
                                    HorizontalOptions="Fill" HeightRequest="48" />
                        </Grid>
                        <BoxView x:Name="ListFoot" HeightRequest="24" Color="Transparent" InputTransparent="True" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>
                <BoxView Margin="1,1,1,0" HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" Offset="0" />
                            <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLightClear}, Dark={StaticResource SurfaceDarkClear}}" Offset="1" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
            </Grid>
        </Border>

    </Grid>

    </controls:ListDetail>

</ContentPage>
