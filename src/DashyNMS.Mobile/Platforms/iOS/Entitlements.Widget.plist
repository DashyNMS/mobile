<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used only for builds that embed the home-screen widget (IncludeIosWidget):
     the App Group the app and widget share the snapshot through. The App ID
     and its provisioning profile must have the App Groups capability for this
     group - see docs/RELEASING-IOS.md. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.net.pckp.DashyNMS</string>
	</array>
</dict>
</plist>
