<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- allowBackup off: the API token is keystore-encrypted and a restored
	     copy can't be decrypted on another device anyway, so backing it up
	     only produces a broken secret to clean up on first launch. -->
	<application android:allowBackup="false" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:label="DashyNMS"></application>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- Android 13+: asked for at sign-in, for alert notifications. -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!-- Android 11+: lets "SSH" and "Telnet" in Device View see whether an app handles those links. -->
	<queries>
		<intent>
			<action android:name="android.intent.action.VIEW" />
			<data android:scheme="ssh" />
		</intent>
		<intent>
			<action android:name="android.intent.action.VIEW" />
			<data android:scheme="telnet" />
		</intent>
	</queries>
</manifest>
