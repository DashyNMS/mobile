<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis 0: the widget is redrawn after each alert check
     (in the app, and WorkManager's background ones), not on a timer of its own. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="80dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/dashynms_widget"
    android:previewLayout="@layout/dashynms_widget"
    android:description="@string/widget_description" />
