<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DashyNMS.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:DashyNMS.Mobile.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="DashyNMS">

    <!-- Sign-in comes first; SignInPage moves on to //main once there is a session. -->
    <ShellContent
        Route="signin"
        Shell.NavBarIsVisible="False"
        ContentTemplate="{DataTemplate pages:SignInPage}" />

    <!-- Dashboard and More always; the pinned pages go between them, from
         code, as the user pins them in More (#68). -->
    <TabBar x:Name="MainTabs" Route="main">
        <Tab Title="Dashboard" Route="dashboard" Icon="tab_dashboard.png">
            <ShellContent ContentTemplate="{DataTemplate pages:DashboardPage}" />
        </Tab>
        <Tab Title="More" Route="more" Icon="tab_more.png">
            <ShellContent ContentTemplate="{DataTemplate pages:MorePage}" />
        </Tab>
    </TabBar>

</Shell>
