<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DashyNMS.Mobile.Views.NeighbourLinkView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:topo="clr-namespace:DashyNMS.Mobile.Topology;assembly=DashyNMS.Mobile.Shared"
    xmlns:sys="clr-namespace:System.Collections.Generic;assembly=System.Runtime"
    x:DataType="topo:NeighbourLinkViewModel">

    <!-- As the link mock-up (#121): "‹ Neighbours", the state, both ends side by side,
         a way to either device, then what the neighbour announces. -->
    <ScrollView>
        <controls:ReadableColumn>
            <VerticalStackLayout Padding="16,4,16,24" Spacing="12" IsVisible="{Binding HasLink}">

                <controls:BackBar x:Name="TopBar" />

                <Border Style="{StaticResource Pill}" Margin="4,0,0,0" BackgroundColor="{Binding Status, Converter={StaticResource StatusTint}}">
                    <HorizontalStackLayout Spacing="6">
                        <Ellipse WidthRequest="7" HeightRequest="7" VerticalOptions="Center"
                                 Fill="{Binding Status, Converter={StaticResource StatusColor}}" />
                        <Label Style="{StaticResource PillText}" Text="{Binding StatusText}"
                               TextColor="{Binding Status, Converter={StaticResource StatusText}}" />
                    </HorizontalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Link.RemoteName}" FontFamily="BodySemibold" FontSize="17" />
                        <Label Style="{StaticResource Faint}" Text="{Binding SubtitleText}" />

                        <!-- The switch's end, then the neighbour's: each device, its port and the port's state. -->
                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8" Margin="0,10,0,0">
                            <Border Style="{StaticResource Tile}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Link.Local.Name}" FontFamily="BodySemibold" FontSize="13" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Link.Local.Port}" FontFamily="Mono" FontSize="12.5" LineBreakMode="CharacterWrap" />
                                    <Label Style="{StaticResource Faint}" Text="{Binding Link.Local.StateText}"
                                           TextColor="{Binding Link.Local.Status, Converter={StaticResource StatusText}}" />
                                </VerticalStackLayout>
                            </Border>
                            <Label Grid.Column="1" Text="↔" FontSize="16" VerticalOptions="Center" Style="{StaticResource Faint}" />
                            <Border Grid.Column="2" Style="{StaticResource Tile}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Link.Remote.Name}" FontFamily="BodySemibold" FontSize="13" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Link.Remote.Port}" FontFamily="Mono" FontSize="12.5" LineBreakMode="CharacterWrap" />
                                    <Label Style="{StaticResource Faint}" Text="{Binding Link.Remote.StateText}"
                                           TextColor="{Binding Link.Remote.Status, Converter={StaticResource StatusText}}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Either end that LibreNMS polls. -->
                <Border Style="{StaticResource ListCard}">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="*,Auto" Padding="14,0" MinimumHeightRequest="48"
                              IsVisible="{Binding Link.Local.CanOpen}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenLocalCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding Link.Local.OpenText}" VerticalOptions="Center" LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                            <Label Grid.Column="1" Style="{StaticResource Chevron}" VerticalOptions="Center" />
                        </Grid>
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="*,Auto" Padding="14,0" MinimumHeightRequest="48"
                              IsVisible="{Binding Link.Remote.CanOpen}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenRemoteCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding Link.Remote.OpenText}" VerticalOptions="Center" LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                            <Label Grid.Column="1" Style="{StaticResource Chevron}" VerticalOptions="Center" />
                            <BoxView Grid.ColumnSpan="2" Style="{StaticResource Divider}" VerticalOptions="Start"
                                     IsVisible="{Binding Link.Local.CanOpen}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Style="{StaticResource SectionHeader}" Text="What it announces" Margin="4,8,0,0" />
                <Border Style="{StaticResource ListCard}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Fields}" Margin="0,-1,0,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="sys:KeyValuePair(x:String,x:String)">
                                <Grid ColumnDefinitions="2*,3*" RowDefinitions="Auto,Auto" ColumnSpacing="12" Padding="14,0,14,10">
                                    <BoxView Grid.ColumnSpan="2" Style="{StaticResource Divider}" Margin="-14,0,-14,10" />
                                    <Label Grid.Row="1" Style="{StaticResource Caption}" Text="{Binding Key}" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Value}" FontSize="13" LineBreakMode="CharacterWrap" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </controls:ReadableColumn>
    </ScrollView>

</ContentView>
