<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="DashyNMS.Mobile.Views.NeighbourLinkView"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
 xmlns:topo="clr-namespace:DashyNMS.Mobile.Topology;assembly=DashyNMS.Mobile.Shared"
 xmlns:sys="clr-namespace:System.Collections.Generic;assembly=System.Runtime"
 x:DataType="topo:NeighbourLinkViewModel" SafeAreaEdges="None">
 <Grid x:Name="Root" RowDefinitions="Auto,*" SafeAreaEdges="None" BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">
  <controls:BackBar x:Name="TopBar" />
  <Grid Grid.Row="1" x:Name="Viewport" SafeAreaEdges="None">
   <ScrollView x:Name="Scroller" SafeAreaEdges="None">
    <VerticalStackLayout x:Name="Column" Padding="0,20,0,24" Spacing="12">
     <Label Style="{StaticResource Caption}" Text="No link was supplied. Go back and choose a neighbour." IsVisible="{Binding HasNoLink}" />
     <VerticalStackLayout Spacing="12" IsVisible="{Binding HasLink}">
      <Label Text="Link" Style="{StaticResource PageTitle}" SemanticProperties.HeadingLevel="Level1" />
      <Label Text="{Binding StatusText}" TextColor="{Binding Status, Converter={StaticResource StatusText}}" LineBreakMode="WordWrap" />
      <Label Text="{Binding SubtitleText}" Style="{StaticResource Faint}" LineBreakMode="WordWrap" />
      <Border Style="{StaticResource Card}">
       <VerticalStackLayout Spacing="12">
        <Label Text="Local endpoint" Style="{StaticResource SectionHeader}" SemanticProperties.HeadingLevel="Level2" />
        <Label Text="{Binding Link.Local.Name}" LineBreakMode="CharacterWrap" />
        <Label Text="{Binding LocalPortText}" FontFamily="Mono" LineBreakMode="CharacterWrap" />
        <Label Text="{Binding LocalStateText}" Style="{StaticResource Caption}" TextColor="{Binding Link.Local.Status, Converter={StaticResource StatusText}}" />
        <Grid MinimumHeightRequest="44" Padding="0,8" AutomationProperties.IsInAccessibleTree="True" SemanticProperties.Description="{Binding LocalActionDescription}" IsVisible="{Binding Link.Local.CanOpen}">
         <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenLocalCommand}" /></Grid.GestureRecognizers>
         <Label Text="{Binding Link.Local.OpenText}" LineBreakMode="CharacterWrap" AutomationProperties.IsInAccessibleTree="False" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
        </Grid>
       </VerticalStackLayout>
      </Border>
      <Border Style="{StaticResource Card}">
       <VerticalStackLayout Spacing="12">
        <Label Text="Remote endpoint" Style="{StaticResource SectionHeader}" SemanticProperties.HeadingLevel="Level2" />
        <Label Text="{Binding Link.Remote.Name}" LineBreakMode="CharacterWrap" />
        <Label Text="{Binding RemotePortText}" FontFamily="Mono" LineBreakMode="CharacterWrap" />
        <Label Text="{Binding RemoteStateText}" Style="{StaticResource Caption}" TextColor="{Binding Link.Remote.Status, Converter={StaticResource StatusText}}" />
        <Grid MinimumHeightRequest="44" Padding="0,8" AutomationProperties.IsInAccessibleTree="True" SemanticProperties.Description="{Binding RemoteActionDescription}" IsVisible="{Binding Link.Remote.CanOpen}">
         <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenRemoteCommand}" /></Grid.GestureRecognizers>
         <Label Text="{Binding Link.Remote.OpenText}" LineBreakMode="CharacterWrap" AutomationProperties.IsInAccessibleTree="False" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
        </Grid>
       </VerticalStackLayout>
      </Border>
      <Label Text="What it announces" Style="{StaticResource SectionHeader}" SemanticProperties.HeadingLevel="Level2" />
      <Label Text="No announcement details supplied." IsVisible="{Binding HasNoFields}" Style="{StaticResource Caption}" />
      <VerticalStackLayout BindableLayout.ItemsSource="{Binding Fields}" Spacing="8">
       <BindableLayout.ItemTemplate>
        <DataTemplate x:DataType="sys:KeyValuePair(x:String,x:String)">
         <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="4">
          <Label Text="{Binding Key}" Style="{StaticResource Caption}" LineBreakMode="WordWrap" />
          <Label Text="{Binding Value}" LineBreakMode="WordWrap" />
         </VerticalStackLayout></Border>
        </DataTemplate>
       </BindableLayout.ItemTemplate>
      </VerticalStackLayout>
     </VerticalStackLayout>
    </VerticalStackLayout>
   </ScrollView>
   <BoxView HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
    <BoxView.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
     <GradientStop Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" Offset="0" />
     <GradientStop Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" Offset="1" />
    </LinearGradientBrush></BoxView.Background>
   </BoxView>
  </Grid>
 </Grid>
</ContentView>
