<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DashyNMS.Mobile.Views.AlertRuleView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:views="clr-namespace:DashyNMS.Mobile.Views"
    xmlns:rules="clr-namespace:DashyNMS.Mobile.Rules;assembly=DashyNMS.Mobile.Shared"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    x:DataType="rules:AlertRuleViewModel">

    <!-- One rule, read-only (#22), laid out as an alert's page (#122): a header card with the
         severity, name, where it applies and the condition; its settings in one card of rows;
         then what it has alerting, its notes and procedure. -->
    <!-- The busy card while it loads, or after a pull; no platform spinner (#111, #123). -->
    <Grid x:Name="Root">
    <controls:BusyCard x:Name="Busy" ZIndex="1" IsVisible="False" VerticalOptions="Start" Margin="16,64,16,0" />
    <RefreshView x:Name="PullRefresh" Command="{Binding RefreshCommand}">
        <ScrollView x:Name="Scroller">
            <Grid x:Name="ReadingColumn">
                <VerticalStackLayout x:Name="ContentColumn" Padding="16,0,16,24" Spacing="12">

                    <controls:BackBar x:Name="TopBar" />

                    <Border Style="{StaticResource Card}" Padding="14,12" IsVisible="{Binding HasError}"
                            BackgroundColor="{StaticResource CriticalTint}" Stroke="{StaticResource CriticalStroke}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding ErrorMessage}" FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource CriticalTextLight}, Dark={StaticResource CriticalTextDark}}" />
                            <Button SemanticProperties.Description="Retry loading the rule" Text="Retry" Style="{StaticResource LinkButton}" MinimumHeightRequest="44" Command="{Binding RefreshCommand}" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout IsVisible="{Binding HasSupplementaryStatus}">
                        <Label Text="{Binding SupplementaryStatus}" Style="{StaticResource Caption}" />
                        <Button SemanticProperties.Description="Retry loading rule details" Text="Retry" Style="{StaticResource LinkButton}" MinimumHeightRequest="44" Command="{Binding RefreshCommand}" />
                    </VerticalStackLayout>
                    <!-- ==================== The header ==================== -->
                    <Border Style="{StaticResource Card}" Padding="16" IsVisible="{Binding HasLoaded}">
                        <VerticalStackLayout Spacing="8">
                            <Border Style="{StaticResource Pill}" BackgroundColor="{Binding Severity, Converter={StaticResource StatusTint}}">
                                <HorizontalStackLayout Spacing="6">
                                    <Ellipse WidthRequest="7" HeightRequest="7" VerticalOptions="Center"
                                             Fill="{Binding Severity, Converter={StaticResource StatusColor}}" />
                                    <Label Style="{StaticResource PillText}" Text="{Binding SeverityText}"
                                           TextColor="{Binding Severity, Converter={StaticResource StatusText}}" />
                                </HorizontalStackLayout>
                            </Border>
                            <Label Text="{Binding Title}" FontSize="22" FontFamily="Display" />
                            <Label Style="{StaticResource Faint}" Text="{Binding HeaderText}" />
                            <Label Style="{StaticResource Caption}" Text="{Binding TargetNames}" IsVisible="{Binding HasTargetNames}" />
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12,10" Margin="0,4,0,0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource CodeDark}}">
                                <Label Text="{Binding Condition}" FontFamily="Mono" FontSize="12.5" LineHeight="1.3"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource Gray100}}" />
                            </Border>
                            <Label Style="{StaticResource Caption}" Text="{Binding ConditionNote}" IsVisible="{Binding HasConditionNote}" />
                            <Label Style="{StaticResource Caption}" Text="{Binding CompatibilityWarning}" IsVisible="{Binding HasCompatibilityWarning}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- ==================== How it notifies ==================== -->
                    <Border Style="{StaticResource ListCard}" IsVisible="{Binding HasLoaded}">
                        <VerticalStackLayout>
                            <VerticalStackLayout Padding="14,10" Spacing="4">
                                <Label Style="{StaticResource Caption}" Text="Recovery alerts" />
                                <Label Text="{Binding RecoveryText}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <BoxView Style="{StaticResource Divider}" />
                            <VerticalStackLayout Padding="14,10" Spacing="4">
                                <Label Style="{StaticResource Caption}" Text="Acknowledgement alerts" />
                                <Label Text="{Binding AcknowledgementText}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <BoxView Style="{StaticResource Divider}" />
                            <VerticalStackLayout Padding="14,10" Spacing="4">
                                <Label Style="{StaticResource Caption}" Text="Notify per entity" />
                                <Label Text="{Binding PerEntityText}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <BoxView Style="{StaticResource Divider}" />
                            <VerticalStackLayout Padding="14,10" Spacing="4">
                                <Label Style="{StaticResource Caption}" Text="Maximum entities" />
                                <Label Text="{Binding MaxEntitiesText}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <BoxView Style="{StaticResource Divider}" IsVisible="{Binding CanChangeNotifications}" />
                            <VerticalStackLayout Padding="14,10" Spacing="4" IsVisible="{Binding CanChangeNotifications}">
                                <Label Style="{StaticResource Caption}" Text="Notifications on this device" />
                                <Label Text="Changes save automatically." Style="{StaticResource Caption}" />
                                <Label Text="{Binding NotificationsText}" />
                                <Button Style="{StaticResource LinkButton}" Text="Change notifications" MinimumHeightRequest="44"
                                        SemanticProperties.Description="{Binding Title, StringFormat='Change notifications for {0}'}"
                                        Command="{Binding ChangeNotificationsCommand}" HorizontalOptions="Start" />
                            </VerticalStackLayout>
                            <BoxView Style="{StaticResource Divider}" />
                            <VerticalStackLayout Padding="14,10" Spacing="4">
                                <Label Style="{StaticResource Caption}" Text="Template" />
                                <Label Text="{Binding TemplateName}" IsVisible="{Binding HasNoTemplate}" />
                                <Border StrokeThickness="0" BackgroundColor="Transparent" MinimumHeightRequest="44"
                                        IsVisible="{Binding HasTemplate}" AutomationProperties.IsInAccessibleTree="True"
                                        SemanticProperties.Description="{Binding TemplateName, StringFormat='Open template {0}'}"
                                        SemanticProperties.Hint="Opens the read-only template">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenTemplateCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding TemplateName}" LineBreakMode="WordWrap" VerticalOptions="Center"
                                           AutomationProperties.IsInAccessibleTree="False" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ==================== Alerting now ==================== -->
                    <Label Style="{StaticResource SectionHeader}" Text="Alerting now" Margin="4,8,0,0" IsVisible="{Binding HasLoaded}" />
                    <Border Style="{StaticResource Card}" Padding="16,14" IsVisible="{Binding HasNoAlerts}">
                        <Label Style="{StaticResource Caption}" Text="Nothing - no open alerts from this rule." />
                    </Border>
                    <Border Style="{StaticResource ListCard}" IsVisible="{Binding HasAlerts}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Alerts}" Margin="0,-1,0,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AlertItem">
                                    <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*" Padding="14,11" MinimumHeightRequest="44"
                                          ColumnSpacing="12" AutomationProperties.IsInAccessibleTree="True"
                                          SemanticProperties.Description="{Binding RuleActionDescription}" SemanticProperties.Hint="Opens the alert">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenAlertCommand, Source={RelativeSource AncestorType={x:Type rules:AlertRuleViewModel}}, x:DataType=rules:AlertRuleViewModel}" CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Ellipse Style="{StaticResource Dot}" Fill="{Binding Severity, Converter={StaticResource StatusColor}}"
                                                 VerticalOptions="Start" Margin="0,6,0,0" AutomationProperties.IsInAccessibleTree="False" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" AutomationProperties.IsInAccessibleTree="False">
                                            <Label Style="{StaticResource RowTitle}" Text="{Binding Device}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                            <Label Style="{StaticResource Faint}" Text="{Binding StateText}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                            <Label Style="{StaticResource Faint}" Text="{Binding ShortAge}" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                        </VerticalStackLayout>
                                        <BoxView Grid.ColumnSpan="2" Style="{StaticResource RowLine}" AutomationProperties.IsInAccessibleTree="False" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ==================== Notes and procedure ==================== -->
                    <Label Style="{StaticResource SectionHeader}" Text="Notes" Margin="4,8,0,0" IsVisible="{Binding HasNotes}" />
                    <Border Style="{StaticResource Card}" Padding="16,14" IsVisible="{Binding HasNotes}">
                        <Label Text="{Binding Notes}" FontSize="14" />
                    </Border>
                    <Label Style="{StaticResource SectionHeader}" Text="Procedure" Margin="4,8,0,0" IsVisible="{Binding HasProcedure}" />
                    <Border Style="{StaticResource Card}" Padding="16,14" IsVisible="{Binding HasProcedure}">
                        <Label Text="{Binding Procedure}" FontSize="14" />
                    </Border>

                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </RefreshView>
    <BoxView HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
        <BoxView.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" Offset="0" />
                <GradientStop Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" Offset="1" />
            </LinearGradientBrush>
        </BoxView.Background>
    </BoxView>
    <views:UndoToastView x:Name="UndoOverlay" BindingContext="{Binding Toast}" ZIndex="2" />
    </Grid>

</ContentView>
