<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DashyNMS.Mobile.Views.AlertDetailView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:views="clr-namespace:DashyNMS.Mobile.Views"
    xmlns:vm="clr-namespace:DashyNMS.Mobile.ViewModels;assembly=DashyNMS.Mobile.Shared"
    xmlns:sections="clr-namespace:DashyNMS.Mobile.DeviceSections;assembly=DashyNMS.Mobile.Shared"
    x:DataType="vm:AlertDetailViewModel">

    <ContentView.Resources>
        <Style x:Key="DetailSecondary" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Style.Triggers>
                <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DetailLink" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Style.Triggers>
                <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </ContentView.Resources>

    <!-- As the Alert detail mock-up: "‹ Alerts", a header card with the
         severity, rule, device and the actions, then a card per section -
         why it fired, the rule, and its history on the device. -->
    <!-- On iOS the cards scroll on down to the foot of the screen, under a
         bottom tab bar, and the column is padded clear of the glass by the
         page or pane showing it (PlaceContent). -->
    <Grid x:Name="Root">
    <controls:BusyCard x:Name="Busy" ZIndex="1" IsVisible="False" VerticalOptions="Start" Margin="16,64,16,0" />
    <RefreshView x:Name="Refresh" Command="{Binding RefreshCommand}">
        <ScrollView x:Name="Scroller">
            <Grid x:Name="Readable">
                <VerticalStackLayout x:Name="Column" Padding="16,0,16,24" Spacing="12">

                    <controls:BackBar x:Name="TopBar" />

                    <Label Style="{StaticResource Error}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
                    <Button Text="Retry" SemanticProperties.Description="Retry loading alert details" MinimumHeightRequest="44" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" IsVisible="{Binding HasError}" IsEnabled="{Binding IsNotBusy}" />

                    <!-- A recovery notification can point at an alert LibreNMS has since dropped. -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding IsGone}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="This alert has moved on or is no longer visible to this account." />
                            <Button Style="{StaticResource SecondaryButton}" Text="Open device" Command="{Binding OpenDeviceCommand}" IsVisible="{Binding HasDevice}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16" IsVisible="{Binding HasAlert}">
                        <VerticalStackLayout Spacing="8">
                            <Border Style="{StaticResource Pill}" BackgroundColor="{Binding Alert.Severity, Converter={StaticResource StatusTint}}">
                                <HorizontalStackLayout Spacing="6">
                                    <Ellipse WidthRequest="7" HeightRequest="7" VerticalOptions="Center"
                                             Fill="{Binding Alert.Severity, Converter={StaticResource StatusText}}" />
                                    <Label Style="{StaticResource PillText}" Text="{Binding Alert.SeverityText}"
                                           TextColor="{Binding Alert.Severity, Converter={StaticResource StatusText}}" />
                                </HorizontalStackLayout>
                            </Border>
                            <Label Text="{Binding Alert.Rule}" FontSize="22" FontFamily="Display" />
                            <Label Text="{Binding Alert.StateText}" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Alert.Device}" FontFamily="BodySemibold" FontSize="15" />
                            <Label Style="{StaticResource Faint}" Text="{Binding RaisedText}" />
                            <Label Style="{StaticResource Caption}" Text="{Binding Alert.Note}" FontAttributes="Italic" IsVisible="{Binding Alert.HasNote}" />
                            <Label Style="{StaticResource Caption}" Text="{Binding GroupStatusText}" IsVisible="{Binding GroupStatusText, Converter={StaticResource IsNotNull}}" />

                            <VerticalStackLayout Spacing="6" Margin="0,8,0,0">
                                <Button Text="{Binding AcknowledgeLabel}" Command="{Binding AcknowledgeCommand}" IsVisible="{Binding CanAcknowledge}" />
                                <Button Text="{Binding UnacknowledgeLabel}" Style="{StaticResource DetailSecondary}" Command="{Binding UnacknowledgeCommand}" IsVisible="{Binding CanUnacknowledge}" />
                                <Button Text="Open device" Style="{StaticResource SecondaryButton}" Command="{Binding OpenDeviceCommand}" IsVisible="{Binding HasDevice}" />
                            </VerticalStackLayout>
                            <!-- The token isn't allowed to acknowledge (#144): say why the button's gone. -->
                            <Label Style="{StaticResource Caption}" Text="{Binding ActionResult}" IsVisible="{Binding ActionResult, Converter={StaticResource IsNotNull}}" />
                            <Label Style="{StaticResource Caption}" Text="{Binding FaultScopeText}" IsVisible="{Binding FaultScopeText, Converter={StaticResource IsNotNull}}" />
                            <Button Style="{StaticResource DetailLink}" Text="Acknowledge fault" Command="{Binding AcknowledgeFaultCommand}" IsVisible="{Binding CanAcknowledgeFault}" />
                            <Button Style="{StaticResource DetailLink}" Text="Unacknowledge fault" Command="{Binding UnacknowledgeFaultCommand}" IsVisible="{Binding CanUnacknowledgeFault}" />
                            <Label Style="{StaticResource Caption}" Text="{Binding AcknowledgeRefusedText}"
                                   IsVisible="{Binding AcknowledgeRefusedText, Converter={StaticResource IsNotNull}}" />
                            <!-- Which alerts notify (#167): Core's choices for this alert's rule, with Undo - notifications only. -->
                            <VerticalStackLayout Spacing="8" IsVisible="{Binding CanChangeNotifications}">
                                <Label Text="Notification changes save automatically on this device." Style="{StaticResource Caption}" />
                                <Label Style="{StaticResource Caption}" Text="{Binding NotificationsText}" VerticalOptions="Center" />
                                <Button Style="{StaticResource LinkButton}" Text="Change" Command="{Binding ChangeNotificationsCommand}"
                                        SemanticProperties.Description="Change notifications for this alert rule and device" MinimumHeightRequest="44" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- A card per section; rows split by a line, fields and the rule's condition monospaced. -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CardGroups}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="sections:SectionGroup">
                                <Border Style="{StaticResource Card}" Padding="16,14">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Style="{StaticResource CardTitle}" Text="{Binding Name}" Margin="0,0,0,4" />
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding .}" controls:RowLines.Between="True">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="sections:SectionRow">
                                                    <VerticalStackLayout Spacing="6" Padding="0,6,0,0">
                                                        <!-- A line between every pair of rows, whatever their kind, none above the first (#120). -->
                                                        <controls:RowDivider Margin="0,0,0,4" />
                                                        <Label Style="{StaticResource Caption}" Text="{Binding Title}" IsVisible="{Binding HasCaptionTitle}" />
                                                        <VerticalStackLayout Spacing="4" IsVisible="{Binding HasHeadingTitle}">
                                                            <Label Text="{Binding Title}" FontFamily="BodySemibold" FontSize="14" />
                                                            <Label Text="{Binding Value}" IsVisible="{Binding HasValue}" FontSize="13"
                                                                   TextColor="{Binding Status, Converter={StaticResource StatusText}}" />
                                                        </VerticalStackLayout>
                                                        <!-- Why it fired's fields, one to a line - name, then value - as the mock-up. -->
                                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Fields}" IsVisible="{Binding HasFields}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="sections:SectionField">
                                                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8" Padding="0,4,0,4">
                                                                        <Grid.Triggers>
                                                                            <!-- The fields the rule doesn't test, after "Show all fields". -->
                                                                            <DataTrigger TargetType="Grid" Binding="{Binding IsSecondary}" Value="True">
                                                                                <Setter Property="Opacity" Value="0.65" />
                                                                            </DataTrigger>
                                                                        </Grid.Triggers>
                                                                        <BoxView Style="{StaticResource Divider}" />
                                                                        <Label Grid.Row="1" Style="{StaticResource Caption}" Text="{Binding Name}"
                                                                               FontFamily="Mono" FontSize="12.5" LineBreakMode="CharacterWrap" />
                                                                        <Label Grid.Row="2" Text="{Binding Value}"
                                                                               FontFamily="Mono" FontSize="13" LineBreakMode="CharacterWrap" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </VerticalStackLayout>
                                                        <!-- The rule's condition as the mock-up's code block; prose (notes, procedure) as text. -->
                                                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12,10"
                                                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource CodeDark}}"
                                                                IsVisible="{Binding HasCode}">
                                                            <Label Text="{Binding Subtitle}" FontFamily="Mono" FontSize="12.5" LineHeight="1.3" LineBreakMode="CharacterWrap"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource Gray100}}" />
                                                        </Border>
                                                        <Label Text="{Binding Subtitle}" FontSize="14" LineBreakMode="WordWrap"
                                                               IsVisible="{Binding HasText}" />
                                                        <Label Text="{Binding Detail}" IsVisible="{Binding HasDetail}" FontFamily="Mono" FontSize="11.5"
                                                               LineBreakMode="WordWrap" Style="{StaticResource Faint}" />
                                                    </VerticalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <!-- "Show all fields", in Why it fired's own card. -->
                                        <Button Style="{StaticResource LinkButton}" MinimumHeightRequest="44" HorizontalOptions="Start" Padding="0" Margin="0,6,0,0"
                                                Text="{Binding FooterText}" Command="{Binding FooterCommand}" IsVisible="{Binding HasFooter}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </RefreshView>
    <!-- A notification change just made, with Undo (#167). -->
    <BoxView x:Name="Fade" HeightRequest="20" VerticalOptions="Start" InputTransparent="True">
        <BoxView.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" Offset="0" />
                <GradientStop Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" Offset="1" />
            </LinearGradientBrush>
        </BoxView.Background>
    </BoxView>
    <views:UndoToastView x:Name="UndoOverlay" BindingContext="{Binding Toast}" ZIndex="2" />
    </Grid>

</ContentView>
