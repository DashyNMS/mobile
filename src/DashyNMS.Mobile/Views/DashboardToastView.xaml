<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DashyNMS.Mobile.Views.DashboardToastView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dash="clr-namespace:DashyNMS.Mobile.Dashboard;assembly=DashyNMS.Mobile.Shared"
    x:DataType="dash:DashboardToast"
    VerticalOptions="End"
    Margin="12,0,12,16"
    IsVisible="{Binding IsShowing}">

    <!-- What just changed on the dashboard, with Undo (#140) - floating over the page. -->
    <Border StrokeShape="RoundRectangle 14" StrokeThickness="1" Padding="16,0,8,0" MinimumHeightRequest="52"
            BackgroundColor="{AppThemeBinding Light={StaticResource TextLight}, Dark=#2A3240}"
            Stroke="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource ChipStrokeDark}}">
        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,8" Radius="24" Opacity="0.4" />
        </Border.Shadow>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Label Text="✓" FontSize="17" FontFamily="BodySemibold" VerticalOptions="Center"
                   TextColor="{StaticResource OkTextDark}" />
            <Label Grid.Column="1" Text="{Binding Message}" FontSize="14" VerticalOptions="Center"
                   TextColor="{StaticResource TextDark}" LineBreakMode="WordWrap"
                   SemanticProperties.Description="{Binding Message}" />
            <Button Grid.Column="2" Text="Undo" Command="{Binding UndoCommand}" BackgroundColor="Transparent"
                    TextColor="{StaticResource PrimaryTextDark}" FontFamily="BodySemibold" FontSize="15"
                    Padding="12,0" HeightRequest="44" MinimumHeightRequest="44" />
        </Grid>
    </Border>

</ContentView>
