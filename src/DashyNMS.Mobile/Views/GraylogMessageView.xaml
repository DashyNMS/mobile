<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DashyNMS.Mobile.Views.GraylogMessageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:graylog="clr-namespace:DashyNMS.Mobile.Graylog;assembly=DashyNMS.Mobile.Shared"
    xmlns:sys="clr-namespace:System.Collections.Generic;assembly=System.Runtime"
    x:DataType="graylog:GraylogMessageViewModel">

    <!-- As the Graylog message mock-up (#117): "‹ Graylog", a header card with the
         level, sender and full text, the device's actions, then every field. -->
    <ScrollView>
        <controls:ReadableColumn>
            <VerticalStackLayout Padding="16,4,16,24" Spacing="12" IsVisible="{Binding HasMessage}">

                <controls:BackBar x:Name="TopBar" />

                <HorizontalStackLayout Spacing="10" Padding="4,0">
                    <Border Style="{StaticResource Pill}" BackgroundColor="{Binding Message.Status, Converter={StaticResource StatusTint}}"
                            IsVisible="{Binding Message.HasLevel}">
                        <HorizontalStackLayout Spacing="6">
                            <Ellipse WidthRequest="7" HeightRequest="7" VerticalOptions="Center"
                                     Fill="{Binding Message.Status, Converter={StaticResource StatusColor}}" />
                            <Label Style="{StaticResource PillText}" Text="{Binding Message.LevelText}"
                                   TextColor="{Binding Message.Status, Converter={StaticResource StatusText}}" />
                        </HorizontalStackLayout>
                    </Border>
                    <Label Style="{StaticResource Faint}" Text="{Binding Message.TimeText}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding Message.SourceText}" FontFamily="BodySemibold" FontSize="17" />
                        <Label Style="{StaticResource Faint}" Text="{Binding Message.OriginLine}" IsVisible="{Binding Message.HasOriginLine}" />
                        <!-- The whole message, line breaks and all, in the app's code well. -->
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12,10" Margin="0,6,0,0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource CodeDark}}">
                            <Label Text="{Binding Message.FullText}" FontFamily="Mono" FontSize="12.5" LineHeight="1.3" LineBreakMode="CharacterWrap"
                                   TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource Gray100}}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Narrow the list to this sender, or go to its device. -->
                <Border Style="{StaticResource ListCard}" IsVisible="{Binding HasActions}">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="*,Auto" Padding="14,0" MinimumHeightRequest="48"
                              IsVisible="{Binding CanShowOnly}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowOnlyCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding ShowOnlyText}" VerticalOptions="Center" LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </Grid>
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="*,Auto" Padding="14,0" MinimumHeightRequest="48"
                              IsVisible="{Binding HasDevice}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenDeviceCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="Open device" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                            <Label Grid.Column="1" Style="{StaticResource Chevron}" VerticalOptions="Center" />
                            <!-- Under Show only, when both show. -->
                            <BoxView Grid.ColumnSpan="2" Style="{StaticResource Divider}" VerticalOptions="Start"
                                     IsVisible="{Binding CanShowOnly}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Style="{StaticResource SectionHeader}" Text="All fields" Margin="4,8,0,0" />
                <Border Style="{StaticResource ListCard}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Message.Fields}" Margin="0,-1,0,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="sys:KeyValuePair(x:String,x:String)">
                                <Grid ColumnDefinitions="2*,3*" RowDefinitions="Auto,Auto" ColumnSpacing="12" Padding="14,0,14,10">
                                    <BoxView Grid.ColumnSpan="2" Style="{StaticResource Divider}" Margin="-14,0,-14,10" />
                                    <Label Grid.Row="1" Style="{StaticResource Caption}" Text="{Binding Key}"
                                           FontFamily="Mono" FontSize="12.5" LineBreakMode="CharacterWrap" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Value}"
                                           FontFamily="Mono" FontSize="13" LineBreakMode="CharacterWrap" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </controls:ReadableColumn>
    </ScrollView>

</ContentView>
