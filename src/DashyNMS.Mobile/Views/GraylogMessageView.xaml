<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="DashyNMS.Mobile.Views.GraylogMessageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:graylog="clr-namespace:DashyNMS.Mobile.Graylog;assembly=DashyNMS.Mobile.Shared"
    xmlns:sys="clr-namespace:System.Collections.Generic;assembly=System.Runtime"
    x:DataType="graylog:GraylogMessageViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">
    <Grid SafeAreaEdges="None" RowDefinitions="*">
        <ScrollView x:Name="Scroller" SafeAreaEdges="None">
            <VerticalStackLayout x:Name="ContentColumn" SafeAreaEdges="None" Padding="16,0,16,24" Spacing="12">
                <controls:BackBar x:Name="TopBar" />
                <Label Text="Message unavailable. Go back and select a message again." IsVisible="{Binding MissingMessage}" LineBreakMode="CharacterWrap" />
                <VerticalStackLayout Spacing="12" IsVisible="{Binding HasMessage}">
                    <Label Text="{Binding Message.DetailLevelText}" FontFamily="BodySemibold" LineBreakMode="CharacterWrap"
                           TextColor="{Binding Message.Status, Converter={StaticResource StatusText}}" />
                    <Label Style="{StaticResource Faint}" Text="{Binding Message.DetailTimeText}" LineBreakMode="CharacterWrap" />
                    <Border Style="{StaticResource Card}" Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Message.SourceText}" FontFamily="BodySemibold" FontSize="17" TextType="Text" LineBreakMode="CharacterWrap" />
                            <Label Style="{StaticResource Faint}" Text="{Binding Message.OriginLine}" IsVisible="{Binding Message.HasOriginLine}" TextType="Text" LineBreakMode="CharacterWrap" />
                            <Label Text="{Binding Message.FullText}" FontFamily="Mono" FontSize="13" TextType="Text" LineBreakMode="CharacterWrap" />
                        </VerticalStackLayout>
                    </Border>
                    <Border x:Name="ShowOnlyAction" Style="{StaticResource ListCard}" Padding="14,12" MinimumHeightRequest="44" IsVisible="{Binding CanShowOnly}"
                            AutomationProperties.IsInAccessibleTree="True" SemanticProperties.Description="{Binding ShowOnlyText}">
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowOnlyCommand}" /></Border.GestureRecognizers>
                        <Label Text="{Binding ShowOnlyText}" TextType="Text" LineBreakMode="CharacterWrap" AutomationProperties.IsInAccessibleTree="False" />
                    </Border>
                    <Border x:Name="DeviceAction" Style="{StaticResource ListCard}" Padding="14,12" MinimumHeightRequest="44" IsVisible="{Binding HasDevice}"
                            AutomationProperties.IsInAccessibleTree="True" SemanticProperties.Description="{Binding DeviceActionDescription}">
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenDeviceCommand}" /></Border.GestureRecognizers>
                        <Label Text="Open device" LineBreakMode="CharacterWrap" AutomationProperties.IsInAccessibleTree="False" />
                    </Border>
                    <Label Style="{StaticResource SectionHeader}" Text="All fields" SemanticProperties.HeadingLevel="Level1" />
                    <Border Style="{StaticResource ListCard}" Padding="14">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Message.Fields}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="sys:KeyValuePair(x:String,x:String)">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Style="{StaticResource Caption}" Text="{Binding Key}" FontFamily="Mono" TextType="Text" LineBreakMode="CharacterWrap" />
                                        <Label Text="{Binding Value}" FontFamily="Mono" TextType="Text" LineBreakMode="CharacterWrap" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <BoxView x:Name="Fade" HeightRequest="20" VerticalOptions="Start" InputTransparent="True" IsVisible="False">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" Offset="0" />
                    <GradientStop Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>
    </Grid>
</ContentView>
