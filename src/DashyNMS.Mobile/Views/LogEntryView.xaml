<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DashyNMS.Mobile.Views.LogEntryView"
    xmlns:controls="clr-namespace:DashyNMS.Mobile.Controls"
    xmlns:logs="clr-namespace:DashyNMS.Mobile.Logs;assembly=DashyNMS.Mobile.Shared"
    xmlns:sys="clr-namespace:System.Collections.Generic;assembly=System.Runtime"
    x:DataType="logs:LogEntryViewModel">
    <Grid x:Name="Root" SafeAreaEdges="None">
        <ScrollView x:Name="Scroller">
            <VerticalStackLayout x:Name="ContentColumn" SafeAreaEdges="None" Padding="16,0,16,24" Spacing="12">
                <controls:BackBar x:Name="TopBar" />
                <Label Text="Entry unavailable. Go back and select an entry again." IsVisible="{Binding MissingEntry}" />
                <VerticalStackLayout SafeAreaEdges="None" Spacing="12" IsVisible="{Binding HasEntry}">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding Entry.StatusText}" FontFamily="BodySemibold" />
                            <Label Text="{Binding Entry.FullText}" SemanticProperties.HeadingLevel="Level1" FontSize="18" TextType="Text" LineBreakMode="WordWrap" />
                            <Label Text="{Binding Entry.DeviceName}" FontFamily="BodySemibold" LineBreakMode="WordWrap" />
                            <Label Style="{StaticResource Faint}" Text="{Binding Entry.WhenText}" LineBreakMode="WordWrap" />
                            <Button Style="{StaticResource SecondaryButton}" Text="Open device" Command="{Binding OpenDeviceCommand}"
                                    MinimumHeightRequest="44" IsVisible="{Binding HasDevice}"
                                    SemanticProperties.Description="{Binding DeviceActionDescription}" LineBreakMode="WordWrap" />
                            <Button Style="{StaticResource SecondaryButton}" Text="Open rule" Command="{Binding OpenRuleCommand}" IsVisible="{Binding HasRule}" />
                        </VerticalStackLayout>
                    </Border>
                    <Label Style="{StaticResource SectionHeader}" Text="Details" SemanticProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource ListCard}" Padding="14">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Entry.Fields}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="sys:KeyValuePair(x:String,x:String)">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Style="{StaticResource Caption}" Text="{Binding Key}" LineBreakMode="WordWrap" />
                                        <Label Text="{Binding Value}" TextType="Text" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasNarrowing}">
                        <Button Text="{Binding ShowOnlyDeviceText}" Command="{Binding ShowOnlyDeviceCommand}" IsVisible="{Binding CanShowOnlyDevice}" Style="{StaticResource SecondaryButton}" LineBreakMode="WordWrap" />
                        <Button Text="{Binding ShowOnlyKindText}" Command="{Binding ShowOnlyKindCommand}" IsVisible="{Binding CanShowOnlyKind}" Style="{StaticResource SecondaryButton}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <BoxView x:Name="Fade" HeightRequest="20" VerticalOptions="Start" InputTransparent="True" IsVisible="False">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" Offset="0" />
                    <GradientStop Color="{AppThemeBinding Light={StaticResource BackgroundLightClear}, Dark={StaticResource BackgroundDarkClear}}" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>
    </Grid>
</ContentView>
