<Project Sdk="Microsoft.NET.Sdk">

	<!--
		The MAUI app head: pages, platform adapters and packaging. Anything that
		can be plain .NET belongs in DashyNMS.Mobile.Shared instead, where it can
		be unit tested without the MAUI workloads.

		iOS only builds on macOS (Apple's toolchain), so Linux/Windows build
		Android alone.
	-->

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

		<!-- -p:MobilePlatform=ios (or android) builds just that platform, so
		     only its workload is needed. Not -p:TargetFrameworks=...: a global
		     property reaches the referenced libraries too and breaks them, and
		     -f still restores every platform. -->
		<TargetFrameworks Condition="'$(MobilePlatform)' == 'ios'">net10.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="'$(MobilePlatform)' == 'android'">net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>DashyNMS.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>

		<!-- XAML compiled to C# at build time: faster start-up, and binding
		     mistakes surface as build errors rather than at runtime. -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<ApplicationTitle>DashyNMS</ApplicationTitle>
		<ApplicationId>net.pckp.DashyNMS</ApplicationId>

		<ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#11141A" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dashynms_logo.svg" BaseSize="96,96" />
		<MauiImage Update="Resources\Images\tab_*.svg" BaseSize="24,24" />
		<MauiImage Update="Resources\Images\pin_marker.svg" BaseSize="16,16" />
	</ItemGroup>

	<!-- The logo's ring runs almost to the edge of its artwork. Android masks
	     adaptive icons to a circle (or squircle) that only shows the middle
	     ~61%, so it gets a smaller foreground than iOS, whose rounded square
	     shows nearly everything. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.58" Color="#171B23" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'">
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.78" Color="#171B23" />
	</ItemGroup>

	<ItemGroup>
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<!-- Background alert checks on Android (see AndroidAlertScheduler).
	     Pinned to the release built on the same AndroidX Core (1.16) and
	     Lifecycle (2.9) as MAUI 10.0.20: newer ones pull those up underneath
	     MAUI, which breaks the build (core vs core-ktx duplicate classes) and
	     risks mismatched Lifecycle at runtime. Move it with MAUI, not ahead. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.10.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DashyNMS.Mobile.Shared\DashyNMS.Mobile.Shared.csproj" />
	</ItemGroup>

	<!-- The iOS home-screen widget: a Swift WidgetKit extension (ios-widget/),
	     built by xcodebuild beforehand and embedded with -p:IncludeIosWidget=true.
	     Opt-in because it needs the App Group capability on the App ID and a
	     profile of its own - builds without it are just the app, as before.
	     IosWidgetBuildOutput is xcodebuild's folder for the configuration and
	     SDK it built (Release-iphoneos, Debug-iphonesimulator). -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And '$(IncludeIosWidget)' == 'true'">
		<!-- Device builds only: entitlements make the build insist on a signing
		     identity, which a CI simulator build doesn't have. -->
		<CodesignEntitlements Condition="!$(RuntimeIdentifier.StartsWith('iossimulator'))">Platforms\iOS\Entitlements.Widget.plist</CodesignEntitlements>
		<IosWidgetBuildOutput Condition="'$(IosWidgetBuildOutput)' == ''">Release-iphoneos</IosWidgetBuildOutput>
	</PropertyGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And '$(IncludeIosWidget)' == 'true'">
		<!-- The .NET build re-signs the extension with the app's identity, and
		     without entitlements unless given them - which App Store Connect
		     rejects (90166). These are the ones xcodebuild signed it with (App
		     Group, application-identifier, team), from its .xcent; a simulator
		     build, unsigned, has none. -->
		<AdditionalAppExtensions Include="$(MSBuildThisFileDirectory)..\..\ios-widget\build">
			<Name>DashyNMSWidget</Name>
			<BuildOutput>$(IosWidgetBuildOutput)</BuildOutput>
			<CodesignEntitlements Condition="Exists('$(MSBuildThisFileDirectory)../../ios-widget/build/DashyNMSWidget.build/$(IosWidgetBuildOutput)/DashyNMSWidget.build/DashyNMSWidget.appex.xcent')">$(MSBuildThisFileDirectory)../../ios-widget/build/DashyNMSWidget.build/$(IosWidgetBuildOutput)/DashyNMSWidget.build/DashyNMSWidget.appex.xcent</CodesignEntitlements>
		</AdditionalAppExtensions>
	</ItemGroup>

</Project>
