<Project Sdk="Microsoft.NET.Sdk">

	<!--
		The MAUI app head: pages, platform adapters and packaging. Anything that
		can be plain .NET belongs in DashyNMS.Mobile.Shared instead, where it can
		be unit tested without the MAUI workloads.

		iOS only builds on macOS (Apple's toolchain), so Linux/Windows build
		Android alone.
	-->

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

		<!-- -p:MobilePlatform=ios (or android) builds just that platform, so
		     only its workload is needed. Not -p:TargetFrameworks=...: a global
		     property reaches the referenced libraries too and breaks them, and
		     -f still restores every platform. -->
		<TargetFrameworks Condition="'$(MobilePlatform)' == 'ios'">net10.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="'$(MobilePlatform)' == 'android'">net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>DashyNMS.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>

		<!-- XAML compiled to C# at build time: faster start-up, and binding
		     mistakes surface as build errors rather than at runtime. -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<ApplicationTitle>DashyNMS</ApplicationTitle>
		<ApplicationId>net.pckp.DashyNMS</ApplicationId>

		<ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#11141A" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dashynms_logo.svg" BaseSize="96,96" />
	</ItemGroup>

	<!-- The logo's ring runs almost to the edge of its artwork. Android masks
	     adaptive icons to a circle (or squircle) that only shows the middle
	     ~61%, so it gets a smaller foreground than iOS, whose rounded square
	     shows nearly everything. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.58" Color="#171B23" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'">
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.78" Color="#171B23" />
	</ItemGroup>

	<ItemGroup>
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<!-- Background alert checks on Android (see AndroidAlertScheduler). -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.11.2.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DashyNMS.Mobile.Shared\DashyNMS.Mobile.Shared.csproj" />
	</ItemGroup>

</Project>
