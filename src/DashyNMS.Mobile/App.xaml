<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:DashyNMS.Mobile.Converters"
             x:Class="DashyNMS.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:StatusColorConverter x:Key="StatusColor" />
            <converters:IsNotNullConverter x:Key="IsNotNull" />

            <!-- A card: the list rows and dashboard tiles. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource SurfaceDark}}" />
            </Style>

            <!-- A filter chip: outlined when off; the page's triggers fill it when on. -->
            <Style x:Key="Chip" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="HeightRequest" Value="34" />
                <Setter Property="MinimumHeightRequest" Value="34" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />
            </Style>

            <Style x:Key="Caption" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="Margin" Value="4,16,0,6" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
            </Style>

            <Style x:Key="Error" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource CriticalColor}" />
                <Setter Property="Margin" Value="0,8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
